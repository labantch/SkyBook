<aside class="flex-shrink-0 bg-midnight-800 text-slate-300 flex flex-col justify-between transition-all duration-300 z-30 border-r border-midnight-700/50 select-none w-64" data-purpose="app-sidebar" id="main-sidebar">
  <div>
    <div class="h-16 flex items-center justify-between px-4 border-b border-midnight-700/60">
      <div class="flex items-center space-x-3 overflow-hidden" id="brand-container">
