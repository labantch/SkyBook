@{
    Layout = null;
}
<!DOCTYPE html>
<html class="h-full bg-slate-100" lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - SkyBook Operations Console</title>
<link href="https://fonts.googleapis.com" rel="preconnect">
<link crossorigin href="https://fonts.gstatic.com" rel="preconnect">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Space+Grotesk:wght@@500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script>
  tailwind.config = {
    darkMode: 'class',
    theme: {
      extend: {
        fontFamily: {
          sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          mono: ['"Space Grotesk"', 'monospace'],
        },
        colors: {
          midnight: { 900: '#070F1C', 800: '#0B192C', 700: '#142740', 600: '#1E3A5F' },
          champagne: { 100: '#F9F5EE', 200: '#F1E9DA', 300: '#E2D3B8', 400: '#D4BD95', 500: '#C5A880', 600: '#AF8E62', 700: '#8A6E47' },
          emerald: { 500: '#10B981', 600: '#059669' },
          amber: { 500: '#F59E0B' },
          rose: { 500: '#F43F5E', 600: '#E11D48' }
        }
      }
    }
  }
</script>
<style data-purpose="scrollbar-and-general">
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #CBD5E1; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #94A3B8; }
    .custom-scroll-dark::-webkit-scrollbar-thumb { background: #1E3A5F; }
  </style>
<style data-purpose="view-transitions">
    .view-container { display: none; animation: fadeIn 0.18s ease-in-out forwards; }
    .view-container.active { display: block; }
    @@keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .drawer-backdrop { transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1); }
    .drawer-content { transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1); }
  </style>
<style data-purpose="sidebar-collapse-fix">
  #main-sidebar.sidebar-collapsed .nav-item { justify-content: center; }
  #main-sidebar.sidebar-collapsed #brand-container { justify-content: center; width: 100%; }
  #main-sidebar.sidebar-collapsed #sidebar-user-card { justify-content: center; }
  #main-sidebar.sidebar-collapsed #sidebar-toggle-btn { margin-left: auto; margin-right: auto; }
</style>
<link rel="stylesheet" href="~/css/site-mobile.css" />
@RenderSection("Styles", required: false)
</head>
<body class="h-full overflow-hidden font-sans text-slate-800 antialiased bg-[#F4F6F9] selection:bg-champagne-500 selection:text-white">
<div class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 pointer-events-none" id="toast-container"></div>
<div class="flex h-screen w-screen overflow-hidden">
@await Html.PartialAsync("_AdminSidebar")
<div class="flex-1 flex flex-col h-screen overflow-hidden">
  @RenderBody()
</div>
</div>
@RenderSection("Scripts", required: false)
</body>
</html>
