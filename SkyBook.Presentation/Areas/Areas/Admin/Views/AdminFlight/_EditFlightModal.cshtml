@* Edit flight modal *@
<div class="fixed inset-0 z-50 flex items-center justify-center hidden" data-purpose="modal-flight-form" id="modal-edit-flight">
  <div class="absolute inset-0 bg-midnight-900/60 backdrop-blur-xs" onclick="closeModal('modal-edit-flight')"></div>
  <div class="relative bg-white rounded-xl shadow-2xl max-w-lg w-full mx-4 overflow-hidden border border-slate-200 z-10 animate-scale">
    <div class="h-14 bg-midnight-800 px-6 flex items-center justify-between text-white">
      <h3 class="text-sm font-bold flex items-center gap-2">
        <svg class="w-4 h-4 text-champagne-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
        Schedule New Sovereign Flight
      </h3>
      <button class="text-slate-400 hover:text-white" onclick="closeModal('modal-edit-flight')">✕</button>
    </div>
    <form class="p-6 space-y-4 text-xs" onsubmit="handleCreateFlight(event)" method="post">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Flight Number</label>
          <input class="w-full text-xs font-mono rounded-lg border-slate-200 bg-slate-50 focus:ring-champagne-500" id="ef-flightno" placeholder="e.g. SB 992" required type="text">
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Assigned Aircraft</label>
          <select class="w-full text-xs rounded-lg border-slate-200 bg-slate-50" id="mf-aircraft">
            <option value="Boeing 787-9 (A6-SKB)">Boeing 787-9 (A6-SKB)</option>
            <option value="Airbus A350-1000 (A6-SKA)">Airbus A350-1000 (A6-SKA)</option>
            <option value="Boeing 777-300ER (A6-SKX)">Boeing 777-300ER (A6-SKX)</option>
            <option value="Gulfstream G700 (A6-G71)">Gulfstream G700 (A6-G71)</option>
          </select>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Departure Origin (IATA)</label>
          <select class="w-full text-xs rounded-lg border-slate-200 bg-slate-50" id="mf-origin">
            <option value="CAI">CAI - Cairo International</option>
            <option selected value="DXB">DXB - Dubai International</option>
            <option value="LHR">LHR - London Heathrow</option>
            <option value="JFK">JFK - New York JFK</option>
            <option value="HND">HND - Tokyo Haneda</option>
          </select>
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Destination Arrival (IATA)</label>
          <select class="w-full text-xs rounded-lg border-slate-200 bg-slate-50" id="mf-destination">
            <option selected value="LHR">LHR - London Heathrow</option>
            <option value="CAI">CAI - Cairo International</option>
            <option value="DXB">DXB - Dubai International</option>
            <option value="JFK">JFK - New York JFK</option>
            <option value="HND">HND - Tokyo Haneda</option>
          </select>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Departure Time (UTC)</label>
          <input class="w-full text-xs font-mono rounded-lg border-slate-200 bg-slate-50" id="mf-dept-time" required type="text" value="08:30">
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Arrival Time (UTC)</label>
          <input class="w-full text-xs font-mono rounded-lg border-slate-200 bg-slate-50" id="mf-arr-time" required type="text" value="13:15">
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Base Sovereign Fare ($ USD)</label>
          <input class="w-full text-xs font-mono rounded-lg border-slate-200 bg-slate-50" id="mf-fare" required type="text" value="$1,850.00">
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Initial Status</label>
          <select class="w-full text-xs rounded-lg border-slate-200 bg-slate-50" id="mf-status">
            <option selected value="Scheduled">Scheduled</option>
            <option value="In Flight">In Flight</option>
            <option value="Delayed">Delayed</option>
          </select>
        </div>
      </div>
      <div class="pt-4 border-t border-slate-100 flex items-center justify-end space-x-2">
        <button class="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-lg" onclick="closeModal('modal-edit-flight')" type="button">Cancel</button>
        <button class="px-4 py-2 bg-midnight-800 text-white font-semibold rounded-lg hover:bg-midnight-900 shadow-sm" type="submit">Save &amp; Broadcast Flight</button>
      </div>
    </form>
  </div>
</div>
