@* Shared Operations Modals and Drawers *@
@await Html.PartialAsync("~/Areas/Admin/Views/Airport/_AirportForm.cshtml", new SkyBook.Business.ViewModels.AirportVM())
@await Html.PartialAsync("~/Areas/Admin/Views/AdminFlight/_AddFlightModal.cshtml")
@await Html.PartialAsync("~/Areas/Admin/Views/AdminFlight/_EditFlightModal.cshtml")
@await Html.PartialAsync("~/Areas/Admin/Views/Aircraft/_AddAircraftModal.cshtml", new SkyBook.Business.ViewModels.AircraftVM())
@await Html.PartialAsync("~/Areas/Admin/Views/Aircraft/_EditAircraftModal.cshtml", new SkyBook.Business.ViewModels.AircraftVM())
@await Html.PartialAsync("~/Areas/Admin/Views/Seat/_ManageSeatsModal.cshtml")
@await Html.PartialAsync("~/Areas/Admin/Views/UserManagement/_AddCustomerModal.cshtml")
@await Html.PartialAsync("~/Areas/Admin/Views/UserManagement/_EditCustomerModal.cshtml")

<!-- Flight Details Drawer -->
<div class="fixed inset-0 z-40 overflow-hidden hidden" data-purpose="flight-details-drawer" id="drawer-flight-details">
  <div class="drawer-backdrop absolute inset-0 bg-midnight-900/60 backdrop-blur-xs opacity-0 transition-opacity duration-200" onclick="closeDrawer('drawer-flight-details')"></div>
  <div class="fixed inset-y-0 right-0 max-w-full flex pl-10">
    <div class="drawer-content w-screen max-w-md bg-white shadow-2xl flex flex-col translate-x-full transition-transform duration-300">
      <div class="h-16 px-6 bg-midnight-800 text-white flex items-center justify-between border-b border-midnight-700">
        <div class="flex items-center space-x-3">
          <span class="text-xs font-mono px-2 py-0.5 rounded bg-champagne-500/20 text-champagne-400 border border-champagne-500/40" id="df-code">SB 918</span>
          <span class="text-xs font-semibold" id="df-status-pill">In Flight</span>
        </div>
        <button class="text-slate-400 hover:text-white p-1" onclick="closeDrawer('drawer-flight-details')">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
        </button>
      </div>
      <div class="p-6 overflow-y-auto flex-1 space-y-6 text-xs text-slate-600">
        <!-- Route Visual -->
        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
          <div class="flex items-center justify-between">
            <div>
              <span class="text-2xl font-extrabold text-midnight-900 block font-mono" id="df-origin-iata">CAI</span>
              <span class="text-[11px] text-slate-500" id="df-origin-city">Cairo Intl</span>
              <span class="text-xs font-bold text-slate-700 mt-1 block font-mono" id="df-dept-time">20:05</span>
              <span class="text-[10px] text-slate-400" id="df-origin-gate">Terminal 2 • Gate 14</span>
            </div>
            <div class="flex flex-col items-center px-4 flex-1">
              <span class="text-[10px] font-mono text-champagne-600 font-semibold mb-1">3h 40m nonstop</span>
              <div class="w-full flex items-center">
                <div class="w-2 h-2 rounded-full bg-champagne-500"></div>
                <div class="flex-1 border-t-2 border-dashed border-champagne-400 mx-1"></div>
                <svg class="w-4 h-4 text-midnight-800 transform rotate-90" fill="currentColor" viewBox="0 0 20 20"><path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z"></path></svg>
                <div class="flex-1 border-t-2 border-dashed border-champagne-400 mx-1"></div>
                <div class="w-2 h-2 rounded-full bg-midnight-800"></div>
              </div>
              <span class="text-[10px] text-emerald-600 font-semibold mt-1">Airborne 38,000 ft</span>
            </div>
            <div class="text-right">
              <span class="text-2xl font-extrabold text-midnight-900 block font-mono" id="df-dest-iata">DXB</span>
              <span class="text-[11px] text-slate-500" id="df-dest-city">Dubai Intl</span>
              <span class="text-xs font-bold text-slate-700 mt-1 block font-mono" id="df-arr-time">01:45</span>
              <span class="text-[10px] text-slate-400" id="df-dest-gate">Terminal 3 • Gate B12</span>
            </div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="bg-white p-3 rounded-lg border border-slate-200">
            <span class="text-[10px] text-slate-400 block font-semibold uppercase">Assigned Aircraft</span>
            <span class="text-xs font-bold text-midnight-900 mt-0.5 block" id="df-aircraft-name">Boeing 787-9</span>
            <span class="text-[10px] font-mono text-champagne-600" id="df-tail-no">Tail: A6-SKB</span>
          </div>
          <div class="bg-white p-3 rounded-lg border border-slate-200">
            <span class="text-[10px] text-slate-400 block font-semibold uppercase">Base Fare</span>
            <span class="text-xs font-bold text-midnight-900 mt-0.5 block font-mono" id="df-fare">£1,290.00</span>
            <span class="text-[10px] text-slate-500">IATA Zone 2 Pricing</span>
          </div>
        </div>
      </div>
      <div class="p-4 bg-slate-50 border-t border-slate-200 flex items-center justify-end space-x-2">
        <button class="px-4 py-2 text-xs font-medium text-slate-700 hover:bg-slate-200 rounded-lg" onclick="closeDrawer('drawer-flight-details')">Close</button>
        <button class="px-4 py-2 text-xs font-semibold text-white bg-midnight-800 hover:bg-midnight-900 rounded-lg" onclick="openManageSeatsModal('A6-SKB', 'Boeing 787-9 Dreamliner')">Inspect Seat Map</button>
      </div>
    </div>
  </div>
</div>

<!-- Customer / Guest Details Drawer -->
<div class="fixed inset-0 z-40 overflow-hidden hidden" data-purpose="customer-drawer" id="drawer-customer-details">
  <div class="drawer-backdrop absolute inset-0 bg-midnight-900/60 backdrop-blur-xs transition-opacity duration-200 opacity-0" onclick="closeDrawer('drawer-customer-details')"></div>
  <div class="fixed inset-y-0 right-0 max-w-full flex pl-10">
    <div class="drawer-content w-screen max-w-md bg-white shadow-2xl flex flex-col transition-transform duration-300 translate-x-full">
      <div class="h-16 px-6 bg-midnight-800 text-white flex items-center justify-between border-b border-midnight-700">
        <span class="text-xs font-semibold uppercase tracking-wider text-champagne-400">Sovereign Guest Dossier</span>
        <button class="text-slate-400 hover:text-white p-1" onclick="closeDrawer('drawer-customer-details')">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
        </button>
      </div>
      <div class="p-6 overflow-y-auto flex-1 space-y-6 text-xs text-slate-600">
        <div class="flex items-center space-x-4 bg-slate-50 p-4 rounded-xl border border-slate-200">
          <div class="w-14 h-14 rounded-full bg-midnight-900 text-champagne-400 font-bold text-lg flex items-center justify-center border-2 border-champagne-500/50" id="cd-initials">JM</div>
          <div>
            <div class="flex items-center space-x-2">
              <h3 class="text-base font-bold text-midnight-900" id="cd-name">John Mohamed</h3>
              <span class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-1.5 py-0.5 rounded">Verified</span>
            </div>
            <p class="text-xs text-slate-500 mt-0.5" id="cd-email">john.mohamed@@sovereign-sky.com</p>
            <p class="text-[11px] font-medium text-champagne-700 mt-1" id="cd-tier">SkyClub Sovereign Tier • #SK-8829104</p>
          </div>
        </div>
        <div class="grid grid-cols-3 gap-2 text-center">
          <div class="p-3 bg-white border border-slate-200 rounded-lg">
            <span class="text-[10px] uppercase text-slate-400 font-semibold block">Total Trips</span>
            <span class="text-base font-extrabold text-midnight-900" id="cd-trips">18</span>
          </div>
          <div class="p-3 bg-white border border-slate-200 rounded-lg">
            <span class="text-[10px] uppercase text-slate-400 font-semibold block">SkyMiles</span>
            <span class="text-base font-extrabold text-champagne-600 font-mono" id="cd-miles">142,500</span>
          </div>
          <div class="p-3 bg-white border border-slate-200 rounded-lg">
            <span class="text-[10px] uppercase text-slate-400 font-semibold block">Disruptions</span>
            <span class="text-base font-extrabold text-emerald-600">0</span>
          </div>
        </div>
      </div>
      <div class="p-4 bg-slate-50 border-t border-slate-200 flex justify-end">
        <button class="px-4 py-2 text-xs font-semibold text-white bg-midnight-800 hover:bg-midnight-900 rounded-lg" onclick="closeDrawer('drawer-customer-details')">Close Dossier</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal Role Confirmation -->
<div class="fixed inset-0 z-[60] flex items-center justify-center hidden" id="modal-confirm-role">
  <div class="absolute inset-0 bg-midnight-900/60 backdrop-blur-sm" onclick="closeModal('modal-confirm-role')"></div>
  <div class="relative bg-white rounded-xl shadow-2xl max-w-md w-full mx-4 overflow-hidden border border-slate-200 z-10">
    <div class="bg-midnight-800 px-6 py-4 flex items-center gap-3">
      <div class="w-10 h-10 rounded-lg bg-champagne-500/20 border border-champagne-400/40 flex items-center justify-center text-champagne-300">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
      </div>
      <div>
        <p class="text-[10px] font-bold uppercase tracking-widest text-champagne-400">Access Control</p>
        <h3 class="text-sm font-bold text-white" id="role-modal-title">Promote to Admin?</h3>
      </div>
    </div>
    <div class="p-6 space-y-5">
      <p class="text-sm text-slate-600 leading-relaxed" id="role-modal-desc">This user will receive full access to the Operations Console.</p>
      <div class="flex items-start gap-2.5 rounded-lg border border-amber-200 bg-amber-50 px-3.5 py-3">
        <svg class="w-4 h-4 text-amber-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        <p class="text-xs text-amber-900 leading-relaxed">Please confirm this change carefully. Admin privileges cannot be limited per module in this console.</p>
      </div>
      <div class="flex items-center gap-2 pt-1">
        <button type="button" class="flex-1 py-2.5 text-xs font-medium text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition" onclick="window.pendingRoleChange=null; closeModal('modal-confirm-role')">Cancel</button>
        <button type="button" class="flex-1 py-2.5 text-xs font-bold text-white bg-midnight-800 hover:bg-midnight-900 rounded-lg shadow-sm transition" id="role-modal-confirm-btn" onclick="typeof confirmRoleChange === 'function' ? confirmRoleChange() : closeModal('modal-confirm-role')">Yes, Confirm</button>
      </div>
    </div>
  </div>
</div>
