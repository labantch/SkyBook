@using Microsoft.AspNetCore.Identity
@using SkyBook.Data.Models
@inject UserManager<ApplicationUser> UserManager
@{
    var appUser = await UserManager.GetUserAsync(User);
    var adminName = appUser?.FullName;
    if (string.IsNullOrWhiteSpace(adminName))
    {
        adminName = appUser?.UserName ?? User.Identity?.Name ?? "Administrator";
    }
    var adminImage = appUser?.ImageUrl ?? "";
    var adminInitials = "SB";
    if (!string.IsNullOrWhiteSpace(adminName))
    {
        var parts = adminName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length > 1)
        {
            adminInitials = $"{parts[0][0]}{parts[1][0]}".ToUpper();
        }
        else if (parts.Length == 1 && parts[0].Length > 0)
        {
            adminInitials = parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        }
    }
}
  <div class="p-3 border-t border-midnight-700/60 bg-midnight-900/40">
    <div id="sidebar-user-card" class="flex items-center gap-2 p-2 rounded-lg bg-midnight-800/80 border border-midnight-700/40 overflow-hidden">
      <button type="button" onclick="openAdminProfile()" class="flex items-center gap-2 min-w-0 flex-1 text-left hover:opacity-90 transition rounded-md">
        <div class="relative flex-shrink-0">
          <div class="w-9 h-9 rounded-full overflow-hidden bg-champagne-500/20 text-champagne-300 font-bold text-xs flex items-center justify-center border border-champagne-400/40">
            @if (!string.IsNullOrEmpty(adminImage))
            {
              <img src="@adminImage" alt="@adminName" class="w-full h-full object-cover" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
              <span style="display:none;" class="w-full h-full flex items-center justify-center">@adminInitials</span>
            }
            else
            {
              <span>@adminInitials</span>
            }
          </div>
          <span class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-emerald-500 border-2 border-midnight-800 rounded-full"></span>
        </div>
        <div class="sidebar-text truncate leading-tight min-w-0 flex-1">
          <p class="text-xs font-semibold text-white truncate">@adminName</p>
          <p class="text-[10px] text-champagne-400 font-medium truncate">Chief Flight Dispatcher</p>
        </div>
      </button>
      <button class="sidebar-logout-btn text-slate-400 hover:text-rose-400 p-1.5 rounded transition-colors flex-shrink-0" onclick="handleLogout()" title="Logout">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
      </button>
    </div>
  </div>
</aside>