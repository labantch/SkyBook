@* Manage seats modal *@
<div class="fixed inset-0 z-50 flex items-center justify-center hidden" data-purpose="seat-map-inspector" id="modal-manage-seats">
  <div class="absolute inset-0 bg-midnight-900/70 backdrop-blur-xs" onclick="closeModal('modal-manage-seats')"></div>
  <div class="relative bg-white rounded-2xl shadow-2xl max-w-2xl w-full mx-4 overflow-hidden border border-slate-200 z-10 flex flex-col max-h-[90vh]">
    <div class="h-16 bg-midnight-800 px-6 flex items-center justify-between text-white flex-shrink-0">
      <div>
        <h3 class="text-sm font-bold flex items-center gap-2">
          <svg class="w-4 h-4 text-champagne-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
          <span class="">Cabin Berth Management — <span class="text-champagne-300 font-mono" id="ms-plane-title">Boeing 787-9 Dreamliner (A6-SKB)</span></span>
        </h3>
      </div>
      <button class="text-slate-400 hover:text-white" onclick="closeModal('modal-manage-seats')">✕</button>
    </div>
    <div class="p-6 overflow-y-auto space-y-6 flex-1 text-xs">
      <div class="flex items-center justify-around p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-[11px]">
        <div class="flex items-center space-x-1.5"><span class="w-3.5 h-3.5 rounded bg-champagne-500 border border-champagne-600"></span><span class="font-medium text-slate-700">First Sovereign Suite</span></div>
        <div class="flex items-center space-x-1.5"><span class="w-3.5 h-3.5 rounded bg-midnight-700 border border-midnight-800"></span><span class="font-medium text-slate-700">Business Flat-Bed</span></div>
        <div class="flex items-center space-x-1.5"><span class="w-3.5 h-3.5 rounded bg-slate-200 border border-slate-300"></span><span class="font-medium text-slate-700">Economy Prestige</span></div>
      </div>
      <div class="border-2 border-dashed border-slate-300 rounded-3xl p-6 bg-slate-50/50 flex flex-col items-center space-y-6">
        <div class="w-24 h-8 bg-slate-200 rounded-t-full flex items-center justify-center text-[10px] font-semibold text-slate-500 uppercase tracking-widest border border-slate-300">Cockpit</div>
        <div class="w-full space-y-6" id="ms-seatmap-root"><!-- populated live by renderInspectorSeatMap() from the aircraft's cabin counts --></div>
      </div>
      <div class="p-4 rounded-xl bg-midnight-900 text-white flex items-center justify-between" id="seat-inspector-panel">
        <div>
          <span class="text-[10px] uppercase tracking-wider text-champagne-400 font-semibold block">Inspector Selection</span>
          <span class="text-sm font-bold font-mono" id="inspected-seat-id">Seat 14A (Horizon Flex)</span>
          <p class="text-xs text-slate-300 mt-0.5" id="inspected-seat-desc">Occupied: John Mohamed (Sovereign Member) • CAI → DXB</p>
        </div>
        <button class="px-3 py-1.5 bg-champagne-500 hover:bg-champagne-600 text-midnight-950 font-bold rounded-lg text-xs" onclick="showToast('Berth telemetry pushed to onboard Purser terminal', 'success')">Sync Berth</button>
      </div>
    </div>
    <div class="p-4 bg-slate-50 border-t border-slate-200 flex justify-end flex-shrink-0">
      <button class="px-4 py-2 text-xs font-semibold text-white bg-midnight-800 hover:bg-midnight-900 rounded-lg" onclick="closeModal('modal-manage-seats')">Done</button>
    </div>
  </div>
</div>
