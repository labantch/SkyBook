@* Edit Customer Modal *@
<div class="fixed inset-0 z-50 flex items-center justify-center hidden" data-purpose="modal-customer-edit-form" id="modal-edit-customer">
  <div class="absolute inset-0 bg-midnight-900/60 backdrop-blur-xs" onclick="closeModal('modal-edit-customer')"></div>
  <div class="relative bg-white rounded-xl shadow-2xl max-w-lg w-full mx-4 overflow-hidden border border-slate-200 z-10 animate-scale">
    <div class="h-14 bg-midnight-800 px-6 flex items-center justify-between text-white flex-shrink-0">
      <h3 class="text-sm font-bold flex items-center gap-2">
        <svg class="w-4 h-4 text-champagne-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
        Edit User Dossier
      </h3>
      <button class="text-slate-400 hover:text-white" onclick="closeModal('modal-edit-customer')">✕</button>
    </div>
    <form class="p-6 space-y-4 text-xs" id="edit-customer-form" onsubmit="handleEditCustomer(event)" method="post">
      <input type="hidden" id="ec-original-email">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Full Name *</label>
          <input class="w-full text-xs rounded-lg border-slate-200 bg-slate-50 focus:ring-champagne-500" id="ec-name" maxlength="100" required type="text">
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Email Address *</label>
          <input class="w-full text-xs rounded-lg border-slate-200 bg-slate-50 focus:ring-champagne-500" id="ec-email" maxlength="256" required type="email">
        </div>
      </div>
      <div>
        <label class="block font-semibold text-slate-700 mb-1">Avatar / Photo URL <span class="font-normal text-slate-400">(optional)</span></label>
        <input class="w-full text-xs rounded-lg border-slate-200 bg-slate-50 focus:ring-champagne-500" id="ec-image-url" maxlength="500" placeholder="https://images.example.com/avatar.jpg" type="url">
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Mobile Phone</label>
          <input class="w-full text-xs rounded-lg border-slate-200 bg-slate-50" id="ec-phone" maxlength="50" type="tel">
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Country</label>
          <input class="w-full text-xs rounded-lg border-slate-200 bg-slate-50" id="ec-country" maxlength="100" required type="text">
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Membership Tier</label>
          <select class="w-full text-xs rounded-lg border-slate-200 bg-slate-50" id="ec-tier">
            <option value="Sovereign VIP">Sovereign VIP</option>
            <option value="SkyClub Royal">SkyClub Royal</option>
            <option value="SkyClub Sovereign Tier">SkyClub Sovereign Tier</option>
            <option value="First Sovereign">First Sovereign</option>
          </select>
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Role</label>
          <select class="w-full text-xs rounded-lg border-slate-200 bg-slate-50" id="ec-role">
            <option value="user">USER</option>
            <option value="admin">ADMIN</option>
          </select>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Total Trips</label>
          <input class="w-full text-xs rounded-lg border-slate-200 bg-slate-50" id="ec-trips" min="0" type="number">
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">SkyMiles Balance</label>
          <input class="w-full text-xs rounded-lg border-slate-200 bg-slate-50" id="ec-miles" type="text">
        </div>
      </div>
      <div class="pt-4 border-t border-slate-100 flex items-center justify-end space-x-2">
        <button class="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-lg" onclick="closeModal('modal-edit-customer')" type="button">Cancel</button>
        <button class="px-4 py-2 bg-midnight-800 text-white font-semibold rounded-lg hover:bg-midnight-900 shadow-sm" type="submit">Update User Profile</button>
      </div>
    </form>
  </div>
</div>
