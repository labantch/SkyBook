@model IEnumerable<SkyBook.Business.ViewModels.UserVM>
@{
    ViewData["Title"] = "Users Management";
    Layout = "_AdminLayout";
}

<!-- Top header strip -->
<header class="h-16 bg-white border-b border-slate-200 px-6 flex items-center justify-between z-20 flex-shrink-0">
  <div class="flex items-center space-x-3">
    <div class="w-9 h-9 rounded-xl bg-midnight-900 flex items-center justify-center text-champagne-400 shadow-xs border border-champagne-500/30">
      <svg class="w-5 h-5 text-champagne-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
    </div>
    <div>
      <h1 class="text-sm font-bold text-midnight-900 tracking-tight">Users Management</h1>
      <p class="text-[11px] text-slate-500">SkyBook Operations Console &bull; Access &amp; Identity Directory</p>
    </div>
  </div>
  <div class="flex items-center space-x-3">
    <a href="@Url.Action("Index", "AdminDashboard", new { area = "Admin" })" class="inline-flex items-center gap-1.5 text-xs font-semibold text-champagne-600 hover:text-champagne-700 hover:underline">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
      <span>Operations Dashboard</span>
    </a>
  </div>
</header>

<main class="flex-1 overflow-y-auto p-6 bg-[#F8FAFC]" id="viewport-root">
  <section class="view-container space-y-6 active" data-purpose="user-management" id="view-users">
    
    <!-- Top Controls: Search & Filters (no Add User button) -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 bg-white p-4 rounded-xl border border-slate-200 shadow-2xs">
      <div class="flex flex-wrap items-center gap-3">
        <!-- Search Input -->
        <div class="relative w-72 sm:w-80">
          <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
          <input class="w-full text-xs bg-slate-50 rounded-lg pl-9 pr-3 py-2 border border-slate-200 focus:outline-none focus:ring-1 focus:ring-champagne-500 focus:border-champagne-500 transition-all" id="user-search-input" oninput="filterUserTable(this.value)" placeholder="Search user name, email, country, role..." type="text">
        </div>

        <!-- Role Filter Pills -->
        <div class="inline-flex items-center p-1 bg-slate-100 rounded-lg border border-slate-200 text-xs font-semibold">
          <button type="button" onclick="setUserRoleFilter('ALL')" id="filter-pill-all" class="user-filter-pill px-3 py-1 rounded-md bg-midnight-800 text-white shadow-xs transition-all">All Users</button>
          <button type="button" onclick="setUserRoleFilter('Admin')" id="filter-pill-admin" class="user-filter-pill px-3 py-1 rounded-md text-slate-600 hover:text-midnight-900 transition-all">Admins</button>
          <button type="button" onclick="setUserRoleFilter('User')" id="filter-pill-user" class="user-filter-pill px-3 py-1 rounded-md text-slate-600 hover:text-midnight-900 transition-all">Regular Users</button>
        </div>
      </div>

      <!-- Live Sync & Counts -->
      <div class="flex items-center space-x-3 text-xs text-slate-500">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 border border-slate-200 font-medium">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span id="user-count-label">Loading users...</span>
        </span>
      </div>
    </div>

    <!-- Users Table -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-2xs overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-slate-600">
          <thead class="bg-slate-50/80 text-[11px] uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-100">
            <tr>
              <th class="py-3.5 px-4">User</th>
              <th class="py-3.5 px-4">Contact Information</th>
              <th class="py-3.5 px-4">Country</th>
              <th class="py-3.5 px-4">Role</th>
              <th class="py-3.5 px-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 font-medium" id="users-table-body">
            <!-- Rendered by JavaScript from server model -->
          </tbody>
        </table>
      </div>

      <!-- Users Pagination Footer -->
      <div id="users-pagination" class="border-t border-slate-100 px-5 py-3 bg-slate-50/50 flex items-center justify-center">
        <nav id="users-pagination-nav" class="flex items-center gap-1.5" aria-label="Users pagination">
          <button type="button" id="users-prev-btn" onclick="prevUserPage()" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-semibold text-slate-600 hover:bg-white hover:text-slate-900 disabled:opacity-40 disabled:cursor-not-allowed transition shadow-2xs">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            <span>Previous</span>
          </button>
          <div id="users-page-numbers" class="flex items-center gap-1"></div>
          <button type="button" id="users-next-btn" onclick="nextUserPage()" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-semibold text-slate-600 hover:bg-white hover:text-slate-900 disabled:opacity-40 disabled:cursor-not-allowed transition shadow-2xs">
            <span>Next</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </button>
        </nav>
      </div>

    </div>
  </section>
</main>

<!-- ============================================================== -->
<!-- RIGHT-SIDE USER DETAILS DRAWER (Master-Detail Page Panel) -->
<!-- ============================================================== -->
<div class="fixed inset-0 z-50 overflow-hidden hidden" data-purpose="user-details-drawer" id="drawer-user-details">
  <div class="drawer-backdrop absolute inset-0 bg-midnight-950/60 backdrop-blur-xs transition-opacity duration-200 opacity-0" onclick="closeDrawer('drawer-user-details')"></div>
  <div class="fixed inset-y-0 right-0 max-w-full flex pl-10">
    <div class="drawer-content w-screen max-w-md bg-white shadow-2xl flex flex-col transition-transform duration-300 translate-x-full border-l-2 border-[#C5A880]">
      
      <!-- Drawer Header -->
      <div class="h-16 px-6 bg-midnight-800 text-white flex items-center justify-between border-b border-midnight-700 flex-shrink-0">
        <div class="flex items-center gap-2.5">
          <div class="w-7 h-7 rounded-lg bg-champagne-500/20 border border-champagne-500/30 flex items-center justify-center text-champagne-300">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          </div>
          <div>
            <span class="text-[10px] font-bold uppercase tracking-wider text-champagne-400 block">Identity Ledger</span>
            <h2 class="text-xs font-bold text-white tracking-wide">User Profile &amp; Access Dossier</h2>
          </div>
        </div>
        <button class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-slate-300 hover:text-white flex items-center justify-center transition-colors" onclick="closeDrawer('drawer-user-details')" title="Close details">
          ✕
        </button>
      </div>

      <!-- Drawer Body (Scrollable Details Content) -->
      <div class="p-6 overflow-y-auto flex-1 space-y-5 text-xs text-slate-600 bg-slate-50/50" id="drawer-details-body">
        
        <!-- User Identity Header Card with Picture -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-2xs space-y-4 text-center relative overflow-hidden">
          <div class="absolute -top-12 -right-12 w-28 h-28 rounded-full bg-champagne-500/10 blur-xl pointer-events-none"></div>
          
          <!-- Profile Picture & Status Badge -->
          <div class="relative w-20 h-20 mx-auto">
            <div id="ud-avatar-container" class="w-20 h-20 rounded-full border-2 border-[#C5A880] shadow-md overflow-hidden bg-midnight-900 flex items-center justify-center text-champagne-300 font-extrabold text-xl">
              <!-- Rendered dynamically -->
            </div>
            <span class="absolute bottom-0 right-1 w-4 h-4 bg-emerald-500 border-2 border-white rounded-full shadow-xs" title="Account Active"></span>
          </div>

          <div>
            <h3 class="text-base font-extrabold text-midnight-900" id="ud-name">User Name</h3>
            <p class="text-xs text-slate-500 font-mono mt-0.5" id="ud-email">user@skybook.com</p>
            <div class="mt-2.5 flex items-center justify-center gap-2" id="ud-role-pill-container">
              <!-- Role badge rendered here -->
            </div>
          </div>
        </div>

        <!-- Security & Access Level Card -->
        <div class="bg-white p-4 rounded-xl border border-slate-200 space-y-3">
          <p class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400">Security &amp; Role Privilege</p>
          <div class="flex items-start gap-3 p-3 rounded-lg bg-slate-50 border border-slate-200">
            <div class="w-8 h-8 rounded-lg bg-midnight-800 text-champagne-400 flex items-center justify-center flex-shrink-0 mt-0.5" id="ud-privilege-icon">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            </div>
            <div>
              <h4 class="font-bold text-midnight-900 text-xs" id="ud-privilege-title">Administrator Privileges</h4>
              <p class="text-[11px] text-slate-500 mt-0.5 leading-relaxed" id="ud-privilege-desc">Has comprehensive access to flights, fleet, airports, bookings, and user ledger.</p>
            </div>
          </div>
        </div>

        <!-- Profile Information Details -->
        <div class="bg-white p-4 rounded-xl border border-slate-200 space-y-3">
          <p class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400">Personal &amp; Contact Records</p>
          
          <div class="space-y-2.5 text-xs">
            <div class="flex items-center justify-between py-1.5 border-b border-slate-100">
              <span class="text-slate-500">Contact Email</span>
              <span class="font-semibold text-midnight-900 font-mono" id="ud-contact-email">user@skybook.com</span>
            </div>
            <div class="flex items-center justify-between py-1.5 border-b border-slate-100">
              <span class="text-slate-500">Telephone</span>
              <span class="font-semibold text-midnight-900 font-mono" id="ud-phone">N/A</span>
            </div>
            <div class="flex items-center justify-between py-1.5">
              <span class="text-slate-500">Country / Base</span>
              <span class="font-semibold text-midnight-900" id="ud-country">N/A</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Drawer Action Buttons Footer (Promote as Admin & Delete) - UI Only -->
      <div class="p-4 bg-white border-t border-slate-200 flex items-center justify-between gap-3 flex-shrink-0 shadow-lg">
        <!-- Delete User Button -->
        <button type="button" id="drawer-btn-delete" onclick="handleDrawerDelete()" class="px-4 py-2.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200 text-xs font-bold transition-all flex items-center gap-1.5 shadow-2xs">
          <svg class="w-4 h-4 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          <span>Delete User</span>
        </button>

        @* Only the SuperAdmin can promote / demote *@
        @if (ViewBag.IsSuperAdmin == true)
        {
          <!-- Promote as Admin / Demote Button -->
          <button type="button" id="drawer-btn-promote" onclick="handleDrawerPromoteToggle()" class="flex-1 px-4 py-2.5 rounded-lg bg-midnight-900 hover:bg-midnight-800 text-champagne-300 border border-champagne-500/40 text-xs font-bold transition-all flex items-center justify-center gap-2 shadow-md hover:shadow-lg">
            <svg class="w-4 h-4 text-champagne-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <span id="drawer-promote-text">Promote as Admin</span>
          </button>
        }
      </div>



    </div>
  </div>
</div>

@* Toast Notification Container *@
<div id="toast-container" class="fixed bottom-6 right-6 z-50 flex flex-col space-y-3 pointer-events-none"></div>

@* Hidden form just to hold the anti-forgery token for AJAX calls *@
<form id="csrf-form" style="display:none">@Html.AntiForgeryToken()</form>

@section Scripts {
<script data-purpose="user-management-logic">
  // Load users from server model (no sample data)
  const serverUsers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));

  const userState = {
    users: serverUsers || [],
    selectedUser: null,
    roleFilter: 'ALL',
    searchKeyword: '',
    currentPage: 1,
    pageSize: 10
  };

  function getInitials(name) {
    if (!name) return 'SB';
    const parts = name.trim().split(/\s+/);
    if (parts.length === 1) return parts[0].substring(0, 2).toUpperCase();
    return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
  }

  function getAvatarHtml(user, sizeClass = 'w-9 h-9', textSize = 'text-xs') {
    const initials = getInitials(user.fullName);
    const safeName = (user.fullName || '').replace(/"/g, '&quot;');
    if (user.imageUrl) {
      return `
        <img src="${user.imageUrl}" alt="${safeName}" class="${sizeClass} rounded-full object-cover border border-champagne-500/50 shadow-2xs" 
             onerror="this.outerHTML='<div class=\\'${sizeClass} rounded-full bg-midnight-900 text-champagne-400 font-bold ${textSize} flex items-center justify-center border border-champagne-500/40 shadow-2xs\\'>${initials}</div>'"/>
      `;
    }
    return `
      <div class="${sizeClass} rounded-full bg-midnight-900 text-champagne-400 font-bold ${textSize} flex items-center justify-center border border-champagne-500/40 shadow-2xs">
        ${initials}
      </div>
    `;
  }

  function getRoleBadge(role) {
    if (role === 'Admin') {
      return `
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[10px] font-bold bg-midnight-900 text-champagne-300 border border-champagne-500/40 shadow-2xs tracking-wider">
          <svg class="w-3 h-3 text-champagne-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          ADMIN
        </span>
      `;
    }
    return `
      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-[10px] font-bold bg-slate-100 text-slate-600 border border-slate-200 tracking-wider">
        <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        USER
      </span>
    `;
  }

  function renderUserRows(list) {
    if (!list || list.length === 0) {
      return `
        <tr>
          <td colspan="5" class="py-12 text-center text-slate-400">
            <svg class="w-10 h-10 mx-auto text-slate-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
            <p class="font-semibold text-slate-600 text-xs">No matching users found</p>
            <p class="text-[11px] text-slate-400 mt-0.5">Try searching with a different term or clear the role filter.</p>
          </td>
        </tr>
      `;
    }

    return list.map(user => {
      const safeName = (user.fullName || '').replace(/"/g, '&quot;');
      const safeId = (user.id || '').replace(/"/g, '&quot;');
      const role = user.role || 'User';
      return `
        <tr class="hover:bg-slate-50/80 transition-colors group">
          <!-- User Profile: Pic + Name -->
          <td class="py-3.5 px-4">
            <div class="flex items-center space-x-3">
              ${getAvatarHtml(user, 'w-10 h-10', 'text-xs')}
              <div>
                <span class="block font-bold text-midnight-900 group-hover:text-champagne-600 transition-colors">${user.fullName}</span>
              </div>
            </div>
          </td>

          <!-- Contact Information -->
          <td class="py-3.5 px-4">
            <span class="block text-slate-800 font-medium">${user.email}</span>
            <span class="text-[10px] text-slate-400 font-mono block">${user.phoneNumber || 'N/A'}</span>
          </td>

          <!-- Country -->
          <td class="py-3.5 px-4">
            <span class="inline-flex items-center gap-1.5 text-slate-700">
              <span class="w-1.5 h-1.5 rounded-full bg-champagne-500"></span>
              ${user.country || 'N/A'}
            </span>
          </td>

          <!-- Role Badge -->
          <td class="py-3.5 px-4">
            ${getRoleBadge(role)}
          </td>

          <!-- Actions: Details button only -->
          <td class="py-3.5 px-4 text-right">
            <div class="flex items-center justify-end gap-2">
              <button type="button" onclick="openUserDetailsDrawer('${safeId}')" class="btn-details inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-midnight-800 hover:bg-midnight-900 text-champagne-300 hover:text-white text-xs font-bold transition-all shadow-xs border border-midnight-700">
                <svg class="w-3.5 h-3.5 text-champagne-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                <span>Details</span>
              </button>
            </div>
          </td>
        </tr>
      `;
    }).join('');
  }

  function getFilteredUsers() {
    let list = userState.users;
    if (userState.roleFilter !== 'ALL') {
      list = list.filter(u => (u.role || 'User') === userState.roleFilter);
    }
    if (userState.searchKeyword) {
      const q = userState.searchKeyword.toLowerCase();
      list = list.filter(u => 
        (u.fullName || '').toLowerCase().includes(q) ||
        (u.email || '').toLowerCase().includes(q) ||
        (u.country || '').toLowerCase().includes(q) ||
        (u.role || '').toLowerCase().includes(q)
      );
    }
    return list;
  }

  function renderUsers() {
    const container = document.getElementById('users-table-body');
    if (!container) return;
    const filtered = getFilteredUsers();
    const total = filtered.length;
    const totalPages = Math.ceil(total / userState.pageSize) || 1;
    if (userState.currentPage > totalPages) userState.currentPage = totalPages;
    if (userState.currentPage < 1) userState.currentPage = 1;

    const startIndex = (userState.currentPage - 1) * userState.pageSize;
    const endIndex = startIndex + userState.pageSize;
    const pageSlice = filtered.slice(startIndex, endIndex);

    container.innerHTML = renderUserRows(pageSlice);

    const countLabel = document.getElementById('user-count-label');
    if (countLabel) {
      countLabel.innerText = `Total ${filtered.length} of ${userState.users.length} Users`;
    }

    const paginationBar = document.getElementById('users-pagination');
    if (paginationBar) {
      paginationBar.classList.toggle('hidden', total === 0);
    }

    const prevBtn = document.getElementById('users-prev-btn');
    const nextBtn = document.getElementById('users-next-btn');
    if (prevBtn) prevBtn.disabled = (userState.currentPage <= 1);
    if (nextBtn) nextBtn.disabled = (userState.currentPage >= totalPages);

    renderUserPageNumbers(totalPages, userState.currentPage);
  }

  function renderUserPageNumbers(totalPages, current) {
    const container = document.getElementById('users-page-numbers');
    if (!container) return;
    container.innerHTML = '';

    if (totalPages <= 1) return;

    const pages = [];
    if (totalPages <= 7) {
      for (let i = 1; i <= totalPages; i++) pages.push(i);
    } else {
      pages.push(1);
      if (current > 3) pages.push('...');
      const start = Math.max(2, current - 1);
      const end = Math.min(totalPages - 1, current + 1);
      for (let i = start; i <= end; i++) {
        if (!pages.includes(i)) pages.push(i);
      }
      if (current < totalPages - 2) pages.push('...');
      if (!pages.includes(totalPages)) pages.push(totalPages);
    }

    pages.forEach(p => {
      if (p === '...') {
        const span = document.createElement('span');
        span.className = 'px-2 py-1 text-slate-400 text-xs font-mono select-none';
        span.textContent = '...';
        container.appendChild(span);
      } else {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = p;
        if (p === current) {
          btn.className = 'w-8 h-8 rounded-lg bg-midnight-900 text-white font-bold text-xs shadow-xs border border-midnight-950 flex items-center justify-center';
        } else {
          btn.className = 'w-8 h-8 rounded-lg bg-white hover:bg-slate-100 text-slate-700 font-semibold text-xs border border-slate-200 hover:border-slate-300 transition flex items-center justify-center';
          btn.onclick = () => goToUserPage(p);
        }
        container.appendChild(btn);
      }
    });
  }

  function goToUserPage(page) {
    userState.currentPage = page;
    renderUsers();
    scrollToTopUsers();
  }

  function prevUserPage() {
    if (userState.currentPage > 1) {
      userState.currentPage--;
      renderUsers();
      scrollToTopUsers();
    }
  }

  function nextUserPage() {
    const totalPages = Math.ceil(getFilteredUsers().length / userState.pageSize) || 1;
    if (userState.currentPage < totalPages) {
      userState.currentPage++;
      renderUsers();
      scrollToTopUsers();
    }
  }

  function changeUserPageSize(size) {
    userState.pageSize = parseInt(size, 10) || 10;
    userState.currentPage = 1;
    renderUsers();
  }

  function scrollToTopUsers() {
    const el = document.getElementById('view-users');
    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function filterUserTable(keyword) {
    userState.searchKeyword = keyword.trim();
    userState.currentPage = 1;
    renderUsers();
  }

  function setUserRoleFilter(role) {
    userState.roleFilter = role;
    userState.currentPage = 1;
    document.querySelectorAll('.user-filter-pill').forEach(btn => {
      btn.className = 'user-filter-pill px-3 py-1 rounded-md text-slate-600 hover:text-midnight-900 transition-all';
    });
    const activeBtn = document.getElementById(`filter-pill-${role.toLowerCase()}`);
    if (activeBtn) {
      activeBtn.className = 'user-filter-pill px-3 py-1 rounded-md bg-midnight-800 text-white shadow-xs transition-all';
    }
    renderUsers();
  }

  // ==============================================================
  // RIGHT-SIDE DRAWER: Open User Details
  // ==============================================================
  function openUserDetailsDrawer(userId) {
    const user = userState.users.find(u => u.id === userId);
    if (!user) return;

    userState.selectedUser = user;

    // Set User Avatar
    const avatarBox = document.getElementById('ud-avatar-container');
    if (avatarBox) {
      avatarBox.innerHTML = getAvatarHtml(user, 'w-20 h-20', 'text-xl');
    }

    // Set Name & Email
    document.getElementById('ud-name').innerText = user.fullName;
    document.getElementById('ud-email').innerText = user.email;
    document.getElementById('ud-contact-email').innerText = user.email;
    document.getElementById('ud-phone').innerText = user.phoneNumber || 'N/A';
    document.getElementById('ud-country').innerText = user.country || 'N/A';

    // Role badge & privileges in drawer
    const rolePillBox = document.getElementById('ud-role-pill-container');
    const privTitle = document.getElementById('ud-privilege-title');
    const privDesc = document.getElementById('ud-privilege-desc');
    const promoteBtn = document.getElementById('drawer-btn-promote');
    const promoteText = document.getElementById('drawer-promote-text');

    const isAdmin = (user.role || 'User') === 'Admin';

    if (rolePillBox) {
      rolePillBox.innerHTML = getRoleBadge(user.role || 'User');
    }

    if (isAdmin) {
      privTitle.innerText = 'Administrator Access Granted';
      privDesc.innerText = 'Has comprehensive rights to manage flights, aircraft fleets, airport hubs, and the entire user directory.';
      if (promoteText) promoteText.innerText = 'Demote to Regular User';
      if (promoteBtn) {
        promoteBtn.className = 'flex-1 px-4 py-2.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 text-xs font-bold transition-all flex items-center justify-center gap-2 shadow-xs';
      }
    } else {
      privTitle.innerText = 'Standard User Account';
      privDesc.innerText = 'Restricted access: user can make reservations and view itineraries, but cannot access administrative consoles.';
      if (promoteText) promoteText.innerText = 'Promote as Admin';
      if (promoteBtn) {
        promoteBtn.className = 'flex-1 px-4 py-2.5 rounded-lg bg-midnight-900 hover:bg-midnight-800 text-champagne-300 border border-champagne-500/40 text-xs font-bold transition-all flex items-center justify-center gap-2 shadow-md hover:shadow-lg';
      }
    }

    openDrawer('drawer-user-details');
  }

  // Real Promote/Demote: calls server, then reloads page to reflect DB state
  async function handleDrawerPromoteToggle() {
    if (!userState.selectedUser) return;
    const user = userState.selectedUser;
    const isCurrentlyAdmin = (user.role || 'User') === 'Admin';
    const action = isCurrentlyAdmin ? 'DemoteUser' : 'PromoteUser';
    const label  = isCurrentlyAdmin ? 'demoted to Regular User' : 'promoted to Admin';

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value
               || document.cookie.match(/XSRF-TOKEN=([^;]+)/)?.[1] || '';

    const btn = document.getElementById('drawer-btn-promote');
    if (btn) { btn.disabled = true; btn.style.opacity = '0.6'; }

    try {
      const resp = await fetch(`/Admin/UserManagement/${action}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: `userId=${encodeURIComponent(user.id)}&__RequestVerificationToken=${encodeURIComponent(token)}`
      });
      const data = await resp.json();
      if (data.success) {
        showToast(`"${user.fullName}" has been ${label}.`, 'success');
        setTimeout(() => location.reload(), 800);
      } else {
        showToast(data.message || 'Action failed.', 'error');
        if (btn) { btn.disabled = false; btn.style.opacity = ''; }
      }
    } catch (e) {
      showToast('Server error. Please try again.', 'error');
      if (btn) { btn.disabled = false; btn.style.opacity = ''; }
    }
  }

  // UI-only: Delete user (visual only, no backend call)
  function handleDrawerDelete() {
    if (!userState.selectedUser) return;
    const user = userState.selectedUser;
    const name = user.fullName;

    userState.users = userState.users.filter(u => u.id !== user.id);
    userState.selectedUser = null;
    renderUsers();
    closeDrawer('drawer-user-details');
    showToast(`"${name}" removed from list (UI only).`, 'info');
  }

  // Drawer helper utilities
  function openDrawer(id) {
    const d = document.getElementById(id);
    if (!d) return;
    d.classList.remove('hidden');
    setTimeout(() => {
      const b = d.querySelector('.drawer-backdrop');
      const c = d.querySelector('.drawer-content');
      if(b) b.classList.remove('opacity-0');
      if(c) c.classList.remove('translate-x-full');
    }, 10);
  }

  function closeDrawer(id) {
    const d = document.getElementById(id);
    if (!d) return;
    const b = d.querySelector('.drawer-backdrop');
    const c = d.querySelector('.drawer-content');
    if(b) b.classList.add('opacity-0');
    if(c) c.classList.add('translate-x-full');
    setTimeout(() => d.classList.add('hidden'), 250);
  }

  function showToast(message, type = 'info') {
    const container = document.getElementById('toast-container');
    if (!container) return;
    const toast = document.createElement('div');
    const bgColors = { info: 'bg-midnight-900 text-white', success: 'bg-emerald-800 text-white', error: 'bg-rose-800 text-white' };
    toast.className = `${bgColors[type] || bgColors.info} px-4 py-3 rounded-xl shadow-xl text-xs font-semibold flex items-center space-x-2 transform transition-all duration-300 translate-y-2 opacity-0 pointer-events-auto`;
    toast.innerHTML = `<span class="w-2 h-2 rounded-full ${type === 'success' ? 'bg-emerald-400' : type === 'error' ? 'bg-rose-400' : 'bg-champagne-400'}"></span><span>${message}</span>`;
    container.appendChild(toast);
    setTimeout(() => toast.classList.remove('translate-y-2', 'opacity-0'), 10);
    setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-2');
      setTimeout(() => toast.remove(), 300);
    }, 3500);
  }

  window.addEventListener('DOMContentLoaded', () => {
    // Check TempData messages from C#
    @if (TempData["Success"] != null)
    {
        @:showToast('@TempData["Success"]', 'success');
    }
    @if (TempData["Error"] != null)
    {
        @:showToast('@TempData["Error"]', 'error');
    }

    renderUsers();
  });
</script>
}
