@section Scripts {
<script data-purpose="application-logic">
    // ============================================================
    // SEAT-MAP GENERATOR (shared logic with the customer-facing
    // seats.html). Given a { first, business, economy } seat count —
    // exactly what the "Add Aircraft" form collects — this lays out
    // real rows/letters so the "Manage Seats" inspector below always
    // matches what was actually configured for that aircraft, instead
    // of showing a fixed hardcoded demo map for every plane.
    // ============================================================
    const CABIN_LAYOUTS = {
      first:    { name: 'FIRST CLASS',    groups: [['A'], ['D', 'G'], ['K']] },
      business: { name: 'BUSINESS CLASS', groups: [['A'], ['D', 'G'], ['K']] },
      economy:  { name: 'ECONOMY CLASS',  groups: [['A', 'B', 'C'], ['D', 'E', 'F'], ['H', 'J', 'K']] }
    };
    const CABIN_ROW_GAP = 1;

    function buildCabin(typeKey, seatCount, startRow) {
      const layout = CABIN_LAYOUTS[typeKey];
      const seatsPerRow = layout.groups.reduce((sum, g) => sum + g.length, 0);
      const rowCount = Math.max(1, Math.ceil(seatCount / seatsPerRow));
      const rows = Array.from({ length: rowCount }, (_, i) => startRow + i);
      return { typeKey, name: layout.name, groups: layout.groups, rows, seatsPerRow };
    }

    function buildCabinsFromCounts(seats) {
      const cabinOrder = ['first', 'business', 'economy'];
      const cabins = [];
      let nextRow = 1;
      cabinOrder.forEach(typeKey => {
        const count = seats[typeKey] || 0;
        if (count <= 0) return;
        const cabin = buildCabin(typeKey, count, nextRow);
        cabins.push(cabin);
        nextRow = cabin.rows[cabin.rows.length - 1] + 1 + CABIN_ROW_GAP;
      });
      return cabins;
    }

    // Persist the fleet to localStorage so the customer-facing seats.html
    // page (opened in the same browser) can pick up any aircraft added
    // here. In the real MVC app this is replaced by both pages reading
    // the same Aircraft table instead of a shared browser key.
    const FLEET_STORAGE_KEY = 'skybook_fleet';
    function saveFleetToStorage() {
      try { localStorage.setItem(FLEET_STORAGE_KEY, JSON.stringify(state.fleet)); } catch (e) { /* storage unavailable */ }
    }
    function loadFleetFromStorage() {
      try {
        const raw = localStorage.getItem(FLEET_STORAGE_KEY);
        if (raw) state.fleet = JSON.parse(raw);
      } catch (e) { /* ignore malformed storage */ }
    }

    const FLIGHTS_STORAGE_KEY = 'skybook_flights';
    function saveFlightsToStorage() {
      try { localStorage.setItem(FLIGHTS_STORAGE_KEY, JSON.stringify(state.flights)); } catch (e) {}
    }
    function loadFlightsFromStorage() {
      try {
        const raw = localStorage.getItem(FLIGHTS_STORAGE_KEY);
        if (raw) state.flights = JSON.parse(raw);
      } catch (e) {}
    }

    const DEFAULT_AIRPORT_IMAGES = {
      'DXB': 'https://images.unsplash.com/photo-1512453979798-5ea266f8880c?auto=format&fit=crop&w=1200&q=80',
      'CAI': 'https://images.unsplash.com/photo-1572252009286-268acec5ca0a?auto=format&fit=crop&w=1200&q=80',
      'LHR': 'https://images.unsplash.com/photo-1520986606214-8b456906c813?auto=format&fit=crop&w=1200&q=80',
      'JFK': 'https://images.unsplash.com/photo-1496442226666-8d4d0e62e6e9?auto=format&fit=crop&w=1200&q=80',
      'HND': 'https://images.unsplash.com/photo-1503899036084-c55cdd92da26?auto=format&fit=crop&w=1200&q=80',
      'GVA': 'https://images.unsplash.com/photo-1527668752968-14dc70a27c95?auto=format&fit=crop&w=1200&q=80',
      'SIN': 'https://images.unsplash.com/photo-1525625293386-3f8f99389edd?auto=format&fit=crop&w=1200&q=80',
      'CDG': 'https://images.unsplash.com/photo-1502602898657-3e91760cbb34?auto=format&fit=crop&w=1200&q=80',
      'SYD': 'https://images.unsplash.com/photo-1506973035872-a4ec16b8e8d9?auto=format&fit=crop&w=1200&q=80'
    };
    const GENERIC_AIRPORT_IMAGE = 'https://images.unsplash.com/photo-1530521954074-e64f6810b32d?auto=format&fit=crop&w=1200&q=80';

    const CUSTOMERS_STORAGE_KEY = 'skybook-admin-customers';
    function saveCustomersToStorage() {
      try { localStorage.setItem(CUSTOMERS_STORAGE_KEY, JSON.stringify(state.customers)); } catch (e) {}
    }
    function loadCustomersFromStorage() {
      try {
        const raw = localStorage.getItem(CUSTOMERS_STORAGE_KEY);
        if (raw) state.customers = JSON.parse(raw);
      } catch (e) {}
    }

    const state = {
      currentView: 'dashboard',
      sidebarCollapsed: false,
      cancellationTarget: null,
      
      flights: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        (Model.RecentFlights ?? new List<SkyBook.Business.ViewModels.FlightVM>()).Select(f => new {
          code = f.FlightNumber,
          origin = f.DepartureAirportCode ?? "N/A",
          dest = f.ArrivalAirportCode ?? "N/A",
          routeDesc = $"{f.DepartureAirportCity} → {f.ArrivalAirportCity}",
          dept = f.DepartureTime.ToString("HH:mm"),
          deptGate = $"{f.DepartureAirportCode} • {f.DepartureTime:dd MMM}",
          arr = f.ArrivalTime.ToString("HH:mm"),
          arrGate = $"{f.ArrivalAirportCode} • {f.ArrivalTime:dd MMM}",
          aircraft = !string.IsNullOrEmpty(f.AircraftName) ? f.AircraftName : "Aircraft",
          tail = f.FlightNumber,
          fare = $"${f.Price:N2}",
          status = f.Status.ToString()
        })
      )),

      bookings: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        (Model.RecentBookings ?? new List<SkyBook.Business.ViewModels.BookingDetailsVm>()).Select(b => {
          var customerDisplayName = !string.IsNullOrWhiteSpace(b.UserFullName) ? b.UserFullName : (!string.IsNullOrWhiteSpace(b.UserName) ? b.UserName : (!string.IsNullOrWhiteSpace(b.PassengerName) ? b.PassengerName : "Customer"));
          var initials = !string.IsNullOrWhiteSpace(customerDisplayName)
            ? string.Concat(customerDisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(n => n[0])).ToUpper()
            : "CU";
          if (initials.Length > 2) initials = initials.Substring(0, 2);
          return new {
            pnr = b.BookingReference,
            customerName = customerDisplayName,
            userImageUrl = b.UserImageUrl ?? "",
            initials = initials,
            tier = "Customer",
            flightCode = b.FlightNumber,
            routeSummary = $"{b.DepartureAirPort} → {b.ArrivalAirPort}",
            travelDate = b.BookingDate.ToString("dd MMM yyyy"),
            seat = string.IsNullOrEmpty(b.SeatNumber) ? "Unassigned" : b.SeatNumber,
            price = $"${b.TotalPrice:N2}",
            status = b.Status.ToString()
          };
        })
      )),


      fleet: [],

      customers: [
        { name: 'John Mohamed', email: 'john.mohamed@@sovereign-sky.com', phone: '+971 50 123 4567', country: 'United Arab Emirates', tier: 'SkyClub Sovereign Tier', trips: 18, miles: '142,500', role: 'user' },
        { name: 'Ahmed Ali', email: 'ahmed.ali@@emirates-royal.com', phone: '+971 55 987 6543', country: 'United Arab Emirates', tier: 'SkyClub Royal', trips: 24, miles: '210,400', role: 'user' },
        { name: 'Eleanor Wright', email: 'e.wright@@mayfair-partners.co.uk', phone: '+44 20 7946 0912', country: 'United Kingdom', tier: 'First Sovereign', trips: 31, miles: '389,000', role: 'admin' },
        { name: 'Tariq Al-Hashimi', email: 'tariq@@hashimi-holdings.qa', phone: '+974 44 123456', country: 'Qatar', tier: 'Sovereign VIP', trips: 45, miles: '612,800', role: 'user' }
      ]
    };

    function switchView(viewKey) {
      if (viewKey === 'airports') {
        window.location.href = '/Admin/Airport';
        return;
      }
      if (viewKey === 'flights') {
        window.location.href = '/Admin/AdminFlight';
        return;
      }
      if (viewKey === 'aircraft') {
        window.location.href = '/Admin/Aircraft';
        return;
      }
      if (viewKey === 'bookings') {
        window.location.href = '/Admin/AdminBooking';
        return;
      }
      if (viewKey === 'customers') {
        window.location.href = '/Admin/UserManagement';
        return;
      }
      state.currentView = viewKey;

      document.querySelectorAll('.nav-item').forEach(btn => {
        const target = btn.getAttribute('data-nav-target');
        if (target === viewKey) {
          btn.className = 'nav-item w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-white bg-midnight-700/80 shadow-sm border border-midnight-600/50 group transition-colors';
          const icon = btn.querySelector('svg');
          if (icon) icon.className = 'w-4 h-4 text-champagne-400 flex-shrink-0';
        } else {
          btn.className = 'nav-item w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-medium text-slate-300 hover:text-white hover:bg-midnight-700/50 group transition-colors';
          const icon = btn.querySelector('svg');
          if (icon) icon.className = 'w-4 h-4 text-slate-400 group-hover:text-champagne-400 flex-shrink-0';
        }
      });

      document.querySelectorAll('.view-container').forEach(panel => panel.classList.remove('active'));
      const activePanel = document.getElementById(`view-${viewKey}`);
      if (activePanel) activePanel.classList.add('active');
    }

    function getStatusBadge(status) {
      if (status === 'In Flight' || status === 'Confirmed') return `<span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/60"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span>${status}</span>`;
      if (status === 'Scheduled' || status === 'Pending') return `<span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200/60"><span class="w-1.5 h-1.5 rounded-full bg-amber-500 mr-1.5"></span>${status}</span>`;
      return `<span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-rose-50 text-rose-700 border border-rose-200/60"><span class="w-1.5 h-1.5 rounded-full bg-rose-500 mr-1.5"></span>${status}</span>`;
    }

    function renderDashboardBookings() {
      const container = document.getElementById('dashboard-bookings-body');
      if (!container) return;
      if (!state.bookings || state.bookings.length === 0) {
        container.innerHTML = '<tr><td colspan="8" class="text-center py-6 text-slate-400 italic">No bookings recorded yet.</td></tr>';
        return;
      }
      container.innerHTML = state.bookings.slice(0, 6).map(b => `
        <tr class="hover:bg-slate-50/70 transition-colors">
          <td class="py-3 px-4 font-mono font-bold text-midnight-900">${b.pnr}</td>
          <td class="py-3 px-4">
            <div class="flex items-center space-x-2.5">
              ${b.userImageUrl ? `<img src="${b.userImageUrl}" alt="${b.customerName}" class="w-7 h-7 rounded-full object-cover border border-champagne-500/50 shrink-0 shadow-2xs" onerror="this.outerHTML='<div class=\\'w-7 h-7 rounded-full bg-champagne-100 text-champagne-800 text-[10px] font-bold flex items-center justify-center shrink-0\\'>${b.initials}</div>'"/>` : `<div class="w-7 h-7 rounded-full bg-champagne-100 text-champagne-800 text-[10px] font-bold flex items-center justify-center shrink-0">${b.initials}</div>`}
              <div><span class="block font-semibold text-slate-800">${b.customerName}</span><span class="text-[10px] text-slate-400 font-normal">${b.tier}</span></div>
            </div>
          </td>
          <td class="py-3 px-4 font-mono text-slate-700"><span class="font-semibold text-midnight-900">${b.flightCode}</span><span class="text-[10px] text-slate-400 ml-1">(${b.routeSummary})</span></td>
          <td class="py-3 px-4 text-slate-600">${b.travelDate}</td>
          <td class="py-3 px-4"><span class="bg-slate-100 px-2.5 py-0.5 rounded text-slate-700 font-mono text-[11px] font-semibold">${b.seat}</span></td>
          <td class="py-3 px-4 font-mono font-bold text-slate-900">${b.price}</td>
          <td class="py-3 px-4">${getStatusBadge(b.status)}</td>
          <td class="py-3 px-4 text-right"><a href="/Admin/AdminBooking" class="text-champagne-600 hover:text-champagne-700 font-semibold text-xs">View Details</a></td>
        </tr>
      `).join('');
