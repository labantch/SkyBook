    function getFlagshipBadge(country, code) {
      const c = (country || '').toLowerCase();
      const cd = (code || '').toUpperCase();
      if (cd === 'JFK' || c.includes('united states') || c.includes('usa') || c.includes('america')) return 'US FLAGSHIP';
      if (cd === 'HND' || cd === 'NRT' || cd === 'SIN' || cd === 'HKG' || cd === 'BKK' || c.includes('japan') || c.includes('china') || c.includes('singapore') || c.includes('korea') || c.includes('thailand')) return 'ASIAN FLAGSHIP';
      if (cd === 'DXB' || cd === 'DOH' || cd === 'AUH' || c.includes('emirates') || c.includes('uae') || c.includes('qatar') || c.includes('saudi')) return 'MIDDLE EAST FLAGSHIP';
      if (cd === 'CAI' || c.includes('egypt') || c.includes('africa') || c.includes('morocco') || c.includes('south africa')) return 'AFRICAN FLAGSHIP';
      if (cd === 'LHR' || cd === 'CDG' || cd === 'FRA' || cd === 'AMS' || cd === 'GVA' || cd === 'ZRH' || cd === 'MAD' || cd === 'FCO' || 
          c.includes('kingdom') || c.includes('uk') || c.includes('france') || c.includes('germany') || c.includes('switzerland') || c.includes('italy') || c.includes('spain') || c.includes('europe') || c.includes('netherlands')) return 'EUROPEAN FLAGSHIP';
      return 'GLOBAL FLAGSHIP';
    }



