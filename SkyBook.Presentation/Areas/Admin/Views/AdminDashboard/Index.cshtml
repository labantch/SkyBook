@model SkyBook.Business.ViewModels.DashboardVM
@{
    ViewData["Title"] = "Operations Dashboard";
    Layout = "_AdminLayout";
}

@removeTagHelper "Microsoft.AspNetCore.Mvc.TagHelpers.FormTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers"
@removeTagHelper "Microsoft.AspNetCore.Mvc.TagHelpers.InputTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers"
<!-- BEGIN: Main Work Area -->
<div class="flex-1 flex flex-col h-screen overflow-hidden">
  
  <!-- Top Header -->
  <header class="h-16 bg-white border-b border-slate-200 px-6 flex items-center justify-between z-20 flex-shrink-0" data-purpose="top-header">
    <div class="flex items-center space-x-4"></div>
    <div class="flex items-center space-x-4">
      <div class="hidden xl:flex items-center space-x-2 text-xs font-medium px-3 py-1.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="font-semibold text-slate-900">SYSTEM NOMINAL</span>
        <span class="text-slate-300">•</span>
        <span class="font-mono text-slate-600">UTC <span id="live-utc-clock" class="">17:14:03</span></span>
        <span class="text-slate-300">•</span>
        <span class="text-emerald-700 bg-emerald-50 text-[10px] uppercase font-bold px-1.5 py-0.5 rounded">Live Sync Active</span>
      <button class="flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-200 transition-all cursor-pointer shadow-2xs group" onclick="refreshDashboardData()" title="Force Refresh Operations Console">
        <svg class="w-3.5 h-3.5 text-slate-500 group-hover:text-slate-800 transition-transform duration-300" id="force-refresh-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
        <span class="hidden sm:inline">Refresh</span>
      </button>
    </div>
  </header>

  <!-- Dynamic Viewport Area -->
  <main class="flex-1 overflow-y-auto p-6 bg-[#F8FAFC]" id="viewport-root">
    
    <!-- ============================================== -->
    <!-- VIEW 1: OPERATIONS DASHBOARD (Default) -->
    <!-- ============================================== -->
    <section class="view-container space-y-6 active" data-purpose="dashboard-view" id="view-dashboard">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h2 class="text-sm font-bold text-midnight-900">Flight Operations Overview</h2>
          <p class="text-[11px] text-slate-500">Real-time telemetry and fleet dispatch status</p>
        </div>
        <div class="flex items-center space-x-3 text-xs text-slate-500 bg-white px-3.5 py-1.5 rounded-lg border border-slate-200 shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-champagne-500"></span>
          <span class="font-semibold text-slate-700">Operational Period:</span>
          <span class="">Today, 11 Sep 2026</span>
          <span class="text-slate-300">|</span>
          <span class="text-emerald-600 font-medium">Live Sync Active</span>
        </div>
      </div>

      <!-- 5 Primary Metric KPI Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        <!-- Card 1: Total Flights -->
        <div class="bg-white rounded-xl p-4 border border-slate-200/80 shadow-xs relative overflow-hidden group hover:border-slate-300 transition-all">
          <div class="flex items-center justify-between">
            <div class="w-8 h-8 rounded-lg bg-champagne-100 flex items-center justify-center text-champagne-700">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
            </div>
            <span class="text-[10px] font-semibold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded flex items-center gap-0.5">Live Ops</span>
          </div>
          <div class="mt-3">
            <h3 class="text-2xl font-extrabold text-midnight-900 tracking-tight">@Model.TotalFlights</h3>
            <p class="text-xs font-semibold text-slate-700 mt-0.5">Total Flights</p>
            <p class="text-[11px] text-slate-500 mt-1">@Model.InFlightCount In-Flight • @Model.ScheduledFlightsCount Sched • @Model.DelayedFlightsCount Delayed</p>
          </div>
          <div class="w-full bg-slate-100 h-1 rounded-full mt-3 overflow-hidden">
            <div class="bg-champagne-500 h-full rounded-full" style="width: @(Model.TotalFlights > 0 ? Math.Min(100, Math.Round((double)Model.InFlightCount / Model.TotalFlights * 100)) : 0)%"></div>
          </div>
        </div>
        
        <!-- Card 2: Total Airports -->
        <div class="bg-white rounded-xl p-4 border border-slate-200/80 shadow-xs relative overflow-hidden group hover:border-slate-300 transition-all">
          <div class="flex items-center justify-between">
            <div class="w-8 h-8 rounded-lg bg-amber-50 flex items-center justify-center text-amber-700">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
            </div>
            <span class="text-[10px] font-semibold text-slate-600 bg-slate-100 px-1.5 py-0.5 rounded">Active Network</span>
          </div>
          <div class="mt-3">
            <h3 class="text-2xl font-extrabold text-midnight-900 tracking-tight">@Model.TotalAirports</h3>
            <p class="text-xs font-semibold text-slate-700 mt-0.5">Total Airports</p>
            <p class="text-[11px] text-slate-500 mt-1">@Model.TotalCountriesCount Countries • @Model.TotalCitiesCount Destinations</p>
          </div>
          <div class="w-full bg-slate-100 h-1 rounded-full mt-3 overflow-hidden">
            <div class="bg-amber-600 h-full rounded-full" style="width: 100%"></div>
          </div>
        </div>

        <!-- Card 3: Total Aircraft -->
        <div class="bg-white rounded-xl p-4 border border-slate-200/80 shadow-xs relative overflow-hidden group hover:border-slate-300 transition-all">
          <div class="flex items-center justify-between">
            <div class="w-8 h-8 rounded-lg @(Model.TotalAircrafts > 0 ? "bg-emerald-50 text-emerald-700" : "bg-slate-100 text-slate-500") flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
            </div>
            <span class="text-[10px] font-semibold @(Model.TotalAircrafts > 0 ? "text-emerald-700 bg-emerald-50" : "text-slate-600 bg-slate-100") px-1.5 py-0.5 rounded">
              @(Model.TotalAircrafts > 0 ? "Fleet Ready" : "No Aircraft")
            </span>
          </div>
          <div class="mt-3">
            <h3 class="text-2xl font-extrabold text-midnight-900 tracking-tight" id="kpi-total-aircraft">@Model.TotalAircrafts</h3>
            <p class="text-xs font-semibold text-slate-700 mt-0.5">Total Aircraft</p>
            <p class="text-[11px] text-slate-500 mt-1 truncate" id="kpi-aircraft-breakdown" title="@(Model.AircraftModels != null && Model.AircraftModels.Any() ? string.Join(" • ", Model.AircraftModels) : "No aircraft in database")">
              @(Model.AircraftModels != null && Model.AircraftModels.Any() ? string.Join(" • ", Model.AircraftModels) : "No aircraft in database")
            </p>
          </div>
          <div class="w-full bg-slate-100 h-1 rounded-full mt-3 overflow-hidden">
            <div class="bg-midnight-800 h-full rounded-full" style="width: @(Model.TotalAircrafts > 0 ? "100%" : "0%")"></div>
          </div>
        </div>

        <!-- Card 4: Total Customers -->
        <div class="bg-white rounded-xl p-4 border border-slate-200/80 shadow-xs relative overflow-hidden group hover:border-slate-300 transition-all">
          <div class="flex items-center justify-between">
            <div class="w-8 h-8 rounded-lg bg-blue-50 flex items-center justify-center text-blue-700">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
            </div>
            <span class="text-[10px] font-semibold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded">Active Users</span>
          </div>
          <div class="mt-3">
            <h3 class="text-2xl font-extrabold text-midnight-900 tracking-tight">@Model.TotalUsers.ToString("N0")</h3>
            <p class="text-xs font-semibold text-slate-700 mt-0.5">Total Customers</p>
            <p class="text-[11px] text-slate-500 mt-1">@Model.AdminCount Admin • @Model.StandardUserCount Standard</p>
          </div>
          <div class="w-full bg-slate-100 h-1 rounded-full mt-3 overflow-hidden">
            <div class="bg-champagne-600 h-full rounded-full" style="width: 100%"></div>
          </div>
        </div>

        <!-- Card 5: Total Bookings -->
        <div class="bg-white rounded-xl p-4 border border-slate-200/80 shadow-xs relative overflow-hidden group hover:border-slate-300 transition-all">
          <div class="flex items-center justify-between">
            <div class="w-8 h-8 rounded-lg bg-purple-50 flex items-center justify-center text-purple-700">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
            </div>
            <span class="text-[10px] font-semibold text-purple-700 bg-purple-50 px-1.5 py-0.5 rounded">Bookings</span>
          </div>
          <div class="mt-3">
            <h3 class="text-2xl font-extrabold text-midnight-900 tracking-tight">@Model.TotalBookings.ToString("N0")</h3>
            <p class="text-xs font-semibold text-slate-700 mt-0.5">Total Bookings</p>
            <p class="text-[11px] text-slate-500 mt-1">$@Model.TotalRevenueGross.ToString("N2") Gross • @Model.SeatLoadPercentage.ToString("F1")% Load</p>
          </div>
          <div class="w-full bg-slate-100 h-1 rounded-full mt-3 overflow-hidden">
            <div class="bg-midnight-900 h-full rounded-full" style="width: @Math.Min(100, Math.Round(Model.SeatLoadPercentage))%"></div>
          </div>
        </div>
      </div>

      <!-- Recent Bookings Table -->
      <div class="bg-white rounded-xl border border-slate-200 shadow-2xs overflow-hidden mt-6">
        <div class="p-4 border-b border-slate-100 flex items-center justify-between">
          <div><h3 class="text-sm font-bold text-midnight-900">Recent Bookings</h3><p class="text-xs text-slate-500">Showing latest @(Model.RecentBookings?.Count ?? 0) of @Model.TotalBookings today</p></div>
          <a href="/Admin/AdminBooking" class="text-xs font-semibold text-champagne-600 hover:text-champagne-700 flex items-center gap-1"><span class="">View All Bookings</span><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg></a>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-slate-600">
            <thead class="bg-slate-50/80 text-[11px] uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-100">
              <tr><th class="py-3 px-4">Booking Ref</th><th class="py-3 px-4">Customer</th><th class="py-3 px-4">Flight</th><th class="py-3 px-4">Travel Date</th><th class="py-3 px-4">Seat / Cabin</th><th class="py-3 px-4">Total Price</th><th class="py-3 px-4">Status</th><th class="py-3 px-4 text-right">Actions</th></tr>
            </thead>
            <tbody class="divide-y divide-slate-100 font-medium" id="dashboard-bookings-body">
              @if (Model.RecentBookings != null && Model.RecentBookings.Any())
              {
                foreach (var b in Model.RecentBookings)
                {
                  var customerDisplayName = !string.IsNullOrWhiteSpace(b.UserFullName) ? b.UserFullName : (!string.IsNullOrWhiteSpace(b.UserName) ? b.UserName : (!string.IsNullOrWhiteSpace(b.PassengerName) ? b.PassengerName : "Customer"));
                  var initials = !string.IsNullOrWhiteSpace(customerDisplayName)
                    ? string.Concat(customerDisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(n => n[0])).ToUpper()
                    : "CU";
                  if (initials.Length > 2) initials = initials.Substring(0, 2);

                  <tr class="hover:bg-slate-50/70 transition-colors">
                    <td class="py-3 px-4 font-mono font-bold text-midnight-900">@b.BookingReference</td>
                    <td class="py-3 px-4">
                      <div class="flex items-center space-x-2.5">
                        @if (!string.IsNullOrEmpty(b.UserImageUrl))
                        {
                          <img src="@b.UserImageUrl" alt="@customerDisplayName" class="w-7 h-7 rounded-full object-cover border border-champagne-500/50 shrink-0 shadow-2xs" onerror="this.outerHTML='<div class=\'w-7 h-7 rounded-full bg-champagne-100 text-champagne-800 text-[10px] font-bold flex items-center justify-center shrink-0\'>@initials</div>'"/>
                        }
                        else
                        {
                          <div class="w-7 h-7 rounded-full bg-champagne-100 text-champagne-800 text-[10px] font-bold flex items-center justify-center shrink-0">@initials</div>
                        }
                        <div><span class="block font-semibold text-slate-800">@customerDisplayName</span><span class="text-[10px] text-slate-400 font-normal">Customer</span></div>
                      </div>
                    </td>
                    <td class="py-3 px-4 font-mono text-slate-700">
                      <span class="font-semibold text-midnight-900">@b.FlightNumber</span>
                      <span class="text-[10px] text-slate-400 ml-1">(@b.DepartureAirPort → @b.ArrivalAirPort)</span>
                    </td>
                    <td class="py-3 px-4 text-slate-600">@b.BookingDate.ToString("dd MMM yyyy")</td>
                    <td class="py-3 px-4"><span class="bg-slate-100 px-2.5 py-0.5 rounded text-slate-700 font-mono text-[11px] font-semibold">@(string.IsNullOrEmpty(b.SeatNumber) ? "Unassigned" : b.SeatNumber)</span></td>
                    <td class="py-3 px-4 font-mono font-bold text-slate-900">$@b.TotalPrice.ToString("N2")</td>
                    <td class="py-3 px-4">
                      @if (b.Status == SkyBook.Data.Models.BookingStatus.Confirmed)
                      {
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/60"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span>Confirmed</span>
                      }
                      else if (b.Status == SkyBook.Data.Models.BookingStatus.PendingPayment)
                      {
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200/60"><span class="w-1.5 h-1.5 rounded-full bg-amber-500 mr-1.5"></span>Pending</span>
                      }
                      else
                      {
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-rose-50 text-rose-700 border border-rose-200/60"><span class="w-1.5 h-1.5 rounded-full bg-rose-500 mr-1.5"></span>Cancelled</span>
                      }
                    </td>
                    <td class="py-3 px-4 text-right">
                      <a href="/Admin/AdminBooking" class="text-champagne-600 hover:text-champagne-700 font-semibold text-xs">View Details</a>
                    </td>
                  </tr>
                }
              }
              else
              {
                <tr>
                  <td colspan="8" class="text-center py-6 text-slate-400 italic">No bookings recorded yet.</td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      </div>

      <!-- Recent Flights Operations Table -->
      <div class="bg-white rounded-xl border border-slate-200 shadow-2xs overflow-hidden mt-6">
        <div class="p-4 border-b border-slate-100 flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <h3 class="text-sm font-bold text-midnight-900">Recent Flights</h3>
            <div class="flex items-center space-x-1 text-[11px] bg-slate-100 p-0.5 rounded-lg border border-slate-200">
              <button class="dash-flight-filter-pill px-2 py-0.5 rounded bg-white text-midnight-900 font-semibold shadow-2xs" onclick="setDashboardFlightFilter('ALL', this)">All Flights</button>
              <button class="dash-flight-filter-pill px-2 py-0.5 rounded text-slate-500 hover:text-slate-800" onclick="setDashboardFlightFilter('IN_FLIGHT', this)">In Flight</button>
              <button class="dash-flight-filter-pill px-2 py-0.5 rounded text-slate-500 hover:text-slate-800" onclick="setDashboardFlightFilter('SCHEDULED', this)">Scheduled</button>
              <button class="dash-flight-filter-pill px-2 py-0.5 rounded text-slate-500 hover:text-slate-800" onclick="setDashboardFlightFilter('DELAYED', this)">Delayed</button>
            </div>
          </div>
          <a href="/Admin/AdminFlight" class="text-xs font-semibold text-champagne-600 hover:text-champagne-700 flex items-center gap-1"><span>Full Flight Schedule</span><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg></a>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-slate-600">
            <thead class="bg-slate-50/80 text-[11px] uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-100">
              <tr><th class="py-3 px-4">Flight No.</th><th class="py-3 px-4">Route</th><th class="py-3 px-4">Departure</th><th class="py-3 px-4">Arrival</th><th class="py-3 px-4">Aircraft</th><th class="py-3 px-4">Base Fare</th><th class="py-3 px-4">Status</th><th class="py-3 px-4 text-right">Details</th></tr>
            </thead>
            <tbody class="divide-y divide-slate-100 font-medium" id="dashboard-flights-body">
              @if (Model.RecentFlights != null && Model.RecentFlights.Any())
              {
                foreach (var f in Model.RecentFlights)
                {
                  var isDeparted = f.Status == SkyBook.Data.Models.FlightStatus.Departed || f.Status == SkyBook.Data.Models.FlightStatus.Boarding;
                  var isDelayed = f.Status == SkyBook.Data.Models.FlightStatus.Delayed;
                  var isCancelled = f.Status == SkyBook.Data.Models.FlightStatus.Cancelled;

                  <tr class="hover:bg-slate-50/70 transition-colors">
                    <td class="py-3 px-4 font-mono font-bold text-midnight-900">
                      <span class="w-2 h-2 rounded-full inline-block mr-1.5 @(isDeparted ? "bg-emerald-500" : isDelayed ? "bg-amber-500" : isCancelled ? "bg-rose-500" : "bg-slate-400")"></span>@f.FlightNumber
                    </td>
                    <td class="py-3 px-4">
                      <span class="font-bold text-midnight-900">@f.DepartureAirportCode</span>
                      <span class="text-champagne-500 mx-1">→</span>
                      <span class="font-bold text-midnight-900">@f.ArrivalAirportCode</span>
                      <span class="text-[11px] text-slate-400 ml-1">(@f.DepartureAirportCity → @f.ArrivalAirportCity)</span>
                    </td>
                    <td class="py-3 px-4">
                      <span class="font-mono font-bold text-slate-800">@f.DepartureTime.ToString("HH:mm")</span>
                      <span class="text-[10px] text-slate-400 block">@f.DepartureTime.ToString("dd MMM yyyy")</span>
                    </td>
                    <td class="py-3 px-4">
                      <span class="font-mono font-bold text-slate-800">@f.ArrivalTime.ToString("HH:mm")</span>
                      <span class="text-[10px] text-slate-400 block">@f.ArrivalTime.ToString("dd MMM yyyy")</span>
                    </td>
                    <td class="py-3 px-4">
                      <span class="font-semibold text-slate-800">@(string.IsNullOrEmpty(f.AircraftName) ? "Unassigned" : f.AircraftName)</span>
                    </td>
                    <td class="py-3 px-4 font-mono font-bold text-slate-900">$@f.Price.ToString("N2")</td>
                    <td class="py-3 px-4">
                      @if (isDeparted)
                      {
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/60"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span>@f.Status</span>
                      }
                      else if (isDelayed)
                      {
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200/60"><span class="w-1.5 h-1.5 rounded-full bg-amber-500 mr-1.5"></span>Delayed</span>
                      }
                      else if (isCancelled)
                      {
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-rose-50 text-rose-700 border border-rose-200/60"><span class="w-1.5 h-1.5 rounded-full bg-rose-500 mr-1.5"></span>Cancelled</span>
                      }
                      else
                      {
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-slate-100 text-slate-700 border border-slate-200/60"><span class="w-1.5 h-1.5 rounded-full bg-slate-400 mr-1.5"></span>@f.Status</span>
                      }
                    </td>
                    <td class="py-3 px-4 text-right">
                      <a href="/Admin/AdminFlight" class="text-champagne-600 hover:text-champagne-700 font-semibold">Inspect</a>
                    </td>
                  </tr>
                }
              }
              else
              {
                <tr>
                  <td colspan="8" class="text-center py-6 text-slate-400 italic">No flights scheduled yet.</td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>


    <!-- ============================================== -->
    <!-- VIEW 2: FLIGHTS MANAGEMENT -->
    <!-- ============================================== -->
    <section class="view-container space-y-6" data-purpose="flights-management" id="view-flights">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-4 rounded-xl border border-slate-200">
        <div class="flex flex-wrap items-center gap-3 flex-1">
