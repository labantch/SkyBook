    function executeCancellation() {
      if (!state.cancellationTarget) return;
      const { type, identifier } = state.cancellationTarget;
      
      if (type === 'flight') {
        const item = state.flights.find(f => f.code === identifier);
        if (item) item.status = 'Cancelled';
        renderAllFlightsTable();
        renderDashboardFlights();
      } else {
        const item = state.bookings.find(b => b.pnr === identifier);
        if (item) item.status = 'Cancelled';
        renderBookingsTable();
        renderDashboardBookings();
      }

      closeModal('modal-confirm-cancel');
      showToast(`${type.toUpperCase()} ${identifier} has been cancelled`, 'error');
