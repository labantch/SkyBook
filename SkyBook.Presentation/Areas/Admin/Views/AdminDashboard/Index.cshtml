    function handleCreateAircraft(e) {
      e.preventDefault();
      const name = document.getElementById('na-model').value.trim();
      const tail = document.getElementById('na-tail').value.trim().toUpperCase();
      const first = parseInt(document.getElementById('na-seats-first').value, 10) || 0;
      const business = parseInt(document.getElementById('na-seats-business').value, 10) || 0;
      const economy = parseInt(document.getElementById('na-seats-economy').value, 10) || 0;
      const readiness = document.getElementById('na-readiness').value;
      const status = document.getElementById('na-status').value;

      if (!name || !tail) {
        showToast('Aircraft model and registration are required', 'error');
        return;
      }
      if (first + business + economy <= 0) {
        showToast('At least one cabin must have seats configured', 'error');
        return;
      }
      if (state.fleet.some(ac => ac.tail.toUpperCase() === tail)) {
        showToast(`Registration ${tail} is already in the fleet`, 'error');
        return;
      }

      const total = first + business + economy;
      const imageUrl = document.getElementById('na-image-url') ? document.getElementById('na-image-url').value.trim() : '';
      state.fleet.unshift({
        name, tail,
        cabins: { first, business, economy },
        capacity: `${total} Seats`,
        readiness: `${readiness}%`,
        status,
        imageUrl
      });

      // Keep the Add Flight modal's aircraft picker in sync with the new fleet member
      const flightAircraftSelect = document.getElementById('mf-aircraft');
      if (flightAircraftSelect) {
        const opt = document.createElement('option');
        opt.value = `${name} (${tail})`;
        opt.innerText = `${name} (${tail})`;
        flightAircraftSelect.prepend(opt);
      }

      renderFleet();
      saveFleetToStorage();
      closeModal('modal-add-aircraft');
      showToast(`${name} (${tail}) onboarded — ${first}F / ${business}J / ${economy}Y`, 'success');
      e.target.reset();
      updateAircraftSeatTotal();
    }

    function updateEditAircraftSeatTotal() {
      const first = parseInt(document.getElementById('ea-seats-first').value, 10) || 0;
      const business = parseInt(document.getElementById('ea-seats-business').value, 10) || 0;
      const economy = parseInt(document.getElementById('ea-seats-economy').value, 10) || 0;
      const el = document.getElementById('ea-seat-total');
      if (el) el.innerText = first + business + economy;
    }

    function openEditAircraftModal(tail) {
      const ac = state.fleet.find(a => a.tail === tail);
      if (!ac) return;
      document.getElementById('ea-original-tail').value = ac.tail;
      document.getElementById('ea-model').value = ac.name;
      document.getElementById('ea-tail').value = ac.tail;
      document.getElementById('ea-seats-first').value = ac.cabins ? (ac.cabins.first || 0) : 0;
      document.getElementById('ea-seats-business').value = ac.cabins ? (ac.cabins.business || 0) : 0;
      document.getElementById('ea-seats-economy').value = ac.cabins ? (ac.cabins.economy || 0) : 0;
      document.getElementById('ea-readiness').value = parseInt(ac.readiness, 10) || 100;
      document.getElementById('ea-status').value = ac.status;
      const imgInput = document.getElementById('ea-image-url');
      if (imgInput) imgInput.value = ac.imageUrl || '';
      updateEditAircraftSeatTotal();
      openModal('modal-edit-aircraft');
    }

    function handleEditAircraft(e) {
      e.preventDefault();
      const origTail = document.getElementById('ea-original-tail').value;
      const name = document.getElementById('ea-model').value.trim();
      const tail = document.getElementById('ea-tail').value.trim().toUpperCase();
      const first = parseInt(document.getElementById('ea-seats-first').value, 10) || 0;
      const business = parseInt(document.getElementById('ea-seats-business').value, 10) || 0;
      const economy = parseInt(document.getElementById('ea-seats-economy').value, 10) || 0;
      const readiness = document.getElementById('ea-readiness').value;
      const status = document.getElementById('ea-status').value;
      const imageUrl = document.getElementById('ea-image-url') ? document.getElementById('ea-image-url').value.trim() : '';

      const total = first + business + economy;
      const idx = state.fleet.findIndex(a => a.tail === origTail);
      if (idx !== -1) {
        state.fleet[idx] = {
          name, tail,
          cabins: { first, business, economy },
          capacity: `${total} Seats`,
          readiness: `${readiness}%`,
          status,
          imageUrl
        };
        renderFleet();
        saveFleetToStorage();
        closeModal('modal-edit-aircraft');
        showWebsitePopup({
          title: 'Aircraft Fleet Updated',
          message: `Aircraft ${tail} (${name}) specifications have been updated.`,
          type: 'success'
        });
      }
    }

    function handleDeleteAircraft(tail) {
      showWebsiteConfirm({
        title: `Decommission Aircraft ${tail}?`,
        category: 'Fleet Operations Decommissioning',
        message: `Are you sure you want to decommission aircraft <strong>${tail}</strong>? This will reassign pending flight dispatches to alternate airframes.`,
        confirmText: 'Yes, Decommission',
        cancelText: 'Keep Aircraft',
        type: 'danger',
        onConfirm: () => {
          state.fleet = state.fleet.filter(a => a.tail !== tail);
          renderFleet();
          saveFleetToStorage();
          showWebsitePopup({
            title: 'Aircraft Decommissioned',
            message: `Aircraft ${tail} has been removed from active dispatch fleet.`,
            type: 'info'
          });
        }
      });
    }

