@{
    ViewData["Title"] = "Operations Dashboard";
    Layout = "_AdminLayout";
}

@removeTagHelper "Microsoft.AspNetCore.Mvc.TagHelpers.FormTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers"
@removeTagHelper "Microsoft.AspNetCore.Mvc.TagHelpers.InputTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers"
<!-- BEGIN: Main Work Area -->
<div class="flex-1 flex flex-col h-screen overflow-hidden">
  
  <!-- Top Header -->
  <header class="h-16 bg-white border-b border-slate-200 px-6 flex items-center justify-between z-20 flex-shrink-0" data-purpose="top-header">
    <div class="flex items-center space-x-4"></div>
    <div class="flex items-center space-x-4">
      <div class="hidden xl:flex items-center space-x-2 text-xs font-medium px-3 py-1.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="font-semibold text-slate-900">SYSTEM NOMINAL</span>
        <span class="text-slate-300">•</span>
        <span class="font-mono text-slate-600">UTC <span id="live-utc-clock" class="">17:14:03</span></span>
        <span class="text-slate-300">•</span>
        <span class="text-emerald-700 bg-emerald-50 text-[10px] uppercase font-bold px-1.5 py-0.5 rounded">Live Sync Active</span>
      </div>
      <div class="relative w-64 md:w-80">
        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
        <input class="w-full bg-slate-50 hover:bg-slate-100/80 focus:bg-white text-xs text-slate-800 rounded-lg pl-9 pr-14 py-2 border border-slate-200 focus:outline-none focus:ring-1 focus:ring-champagne-500 focus:border-champagne-500 transition-all shadow-sm" id="globalSearchInput" oninput="handleGlobalSearch(this.value)" placeholder="Search flight code, tail, passenger..." type="text">
        <span class="absolute right-2.5 top-1/2 -translate-y-1/2 text-[10px] text-slate-400 font-mono bg-white border border-slate-200 px-1.5 py-0.5 rounded shadow-2xs">⌘K</span>
      </div>
      <button class="p-2 rounded-lg text-slate-500 hover:text-slate-700 hover:bg-slate-100 transition-colors" onclick="refreshDashboardData()" title="Force Refresh">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
      </button>
    </div>
  </header>

  <!-- Dynamic Viewport Area -->
  <main class="flex-1 overflow-y-auto p-6 bg-[#F8FAFC]" id="viewport-root">
    
    <!-- ============================================== -->
    <!-- VIEW 1: OPERATIONS DASHBOARD (Default) -->
    <!-- ============================================== -->
    <section class="view-container space-y-6 active" data-purpose="dashboard-view" id="view-dashboard">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center space-x-2">
          <button class="inline-flex items-center space-x-2 px-3.5 py-2 rounded-lg bg-midnight-800 hover:bg-midnight-900 text-white text-xs font-semibold shadow-sm hover:shadow transition-all" onclick="openModal('modal-add-flight')">
            <svg class="w-3.5 h-3.5 text-champagne-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path></svg>
            <span class="">Add Flight</span>
          </button>
          <button class="inline-flex items-center space-x-1.5 px-3 py-2 rounded-lg bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-medium shadow-xs transition-colors" onclick="openModal('modal-add-airport')">
            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
            <span class="">Add Airport</span>
          </button>
          <button class="inline-flex items-center space-x-1.5 px-3 py-2 rounded-lg bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-medium shadow-xs transition-colors" onclick="openModal('modal-add-aircraft')">
            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
            <span class="">Add Aircraft</span>
          </button>
        </div>
        <div class="flex items-center space-x-3 text-xs text-slate-500 bg-white px-3.5 py-1.5 rounded-lg border border-slate-200 shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-champagne-500"></span>
          <span class="font-semibold text-slate-700">Operational Period:</span>
          <span class="">Today, 11 Sep 2026</span>
          <span class="text-slate-300">|</span>
          <span class="text-emerald-600 font-medium">Live Sync Active</span>
        </div>
      </div>

      <!-- 5 Primary Metric KPI Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        <div class="bg-white rounded-xl p-4 border border-slate-200/80 shadow-xs relative overflow-hidden group hover:border-slate-300 transition-all">
          <div class="flex items-center justify-between">
            <div class="w-8 h-8 rounded-lg bg-champagne-100 flex items-center justify-center text-champagne-700"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg></div>
            <span class="text-[10px] font-semibold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded flex items-center gap-0.5">↑ +12% <span class="font-normal text-slate-400">vs lw</span></span>
          </div>
          <div class="mt-3">
            <h3 class="text-2xl font-extrabold text-midnight-900 tracking-tight">142</h3>
            <p class="text-xs font-semibold text-slate-700 mt-0.5">Total Flights</p>
            <p class="text-[11px] text-slate-500 mt-1">86 In-Flight • 48 Sched • 8 Ground</p>
          </div>
          <div class="w-full bg-slate-100 h-1 rounded-full mt-3 overflow-hidden"><div class="bg-champagne-500 h-full rounded-full" style="width: 68%"></div></div>
        </div>
        
        <div class="bg-white rounded-xl p-4 border border-slate-200/80 shadow-xs relative overflow-hidden group hover:border-slate-300 transition-all">
          <div class="flex items-center justify-between">
            <div class="w-8 h-8 rounded-lg bg-amber-50 flex items-center justify-center text-amber-700"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg></div>
            <span class="text-[10px] font-semibold text-slate-600 bg-slate-100 px-1.5 py-0.5 rounded">Active Network</span>
          </div>
          <div class="mt-3">
            <h3 class="text-2xl font-extrabold text-midnight-900 tracking-tight">48</h3>
            <p class="text-xs font-semibold text-slate-700 mt-0.5">Total Airports</p>
            <p class="text-[11px] text-slate-500 mt-1">28 Global Hubs • 20 Concierge FBOs</p>
          </div>
          <div class="w-full bg-slate-100 h-1 rounded-full mt-3 overflow-hidden"><div class="bg-amber-600 h-full rounded-full" style="width: 82%"></div></div>
        </div>

        <div class="bg-white rounded-xl p-4 border border-slate-200/80 shadow-xs relative overflow-hidden group hover:border-slate-300 transition-all">
          <div class="flex items-center justify-between">
            <div class="w-8 h-8 rounded-lg bg-emerald-50 flex items-center justify-center text-emerald-700"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg></div>
            <span class="text-[10px] font-semibold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded">97.2% Ready</span>
          </div>
          <div class="mt-3">
            <h3 class="text-2xl font-extrabold text-midnight-900 tracking-tight" id="kpi-total-aircraft">4</h3>
            <p class="text-xs font-semibold text-slate-700 mt-0.5">Total Aircraft</p>
            <p class="text-[11px] text-slate-500 mt-1" id="kpi-aircraft-breakdown">18 B787-9 • 12 A350 • 6 G700</p>
          </div>
          <div class="w-full bg-slate-100 h-1 rounded-full mt-3 overflow-hidden"><div class="bg-midnight-800 h-full rounded-full" style="width: 94%"></div></div>
        </div>

        <div class="bg-white rounded-xl p-4 border border-slate-200/80 shadow-xs relative overflow-hidden group hover:border-slate-300 transition-all">
          <div class="flex items-center justify-between">
            <div class="w-8 h-8 rounded-lg bg-blue-50 flex items-center justify-center text-blue-700"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg></div>
            <span class="text-[10px] font-semibold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded">↑ +8.4% MoM</span>
          </div>
          <div class="mt-3">
            <h3 class="text-2xl font-extrabold text-midnight-900 tracking-tight">28,450</h3>
            <p class="text-xs font-semibold text-slate-700 mt-0.5">Total Customers</p>
            <p class="text-[11px] text-slate-500 mt-1">3,840 Sovereign • 24,610 Elite</p>
          </div>
          <div class="w-full bg-slate-100 h-1 rounded-full mt-3 overflow-hidden"><div class="bg-champagne-600 h-full rounded-full" style="width: 76%"></div></div>
        </div>

        <div class="bg-white rounded-xl p-4 border border-slate-200/80 shadow-xs relative overflow-hidden group hover:border-slate-300 transition-all">
          <div class="flex items-center justify-between">
            <div class="w-8 h-8 rounded-lg bg-purple-50 flex items-center justify-center text-purple-700"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg></div>
            <span class="text-[10px] font-semibold text-purple-700 bg-purple-50 px-1.5 py-0.5 rounded">High Demand</span>
          </div>
          <div class="mt-3">
            <h3 class="text-2xl font-extrabold text-midnight-900 tracking-tight">12,890</h3>
            <p class="text-xs font-semibold text-slate-700 mt-0.5">Total Bookings</p>
            <p class="text-[11px] text-slate-500 mt-1">$34.8M Gross • 94.2% Load</p>
          </div>
          <div class="w-full bg-slate-100 h-1 rounded-full mt-3 overflow-hidden"><div class="bg-midnight-900 h-full rounded-full" style="width: 88%"></div></div>
        </div>
      </div>

      <!-- Recent Bookings Table -->
      <div class="bg-white rounded-xl border border-slate-200 shadow-2xs overflow-hidden mt-6">
        <div class="p-4 border-b border-slate-100 flex items-center justify-between">
          <div><h3 class="text-sm font-bold text-midnight-900">Recent Bookings</h3><p class="text-xs text-slate-500">Showing latest 6 of 1,248 today</p></div>
          <button class="text-xs font-semibold text-champagne-600 hover:text-champagne-700 flex items-center gap-1" onclick="switchView('bookings')"><span class="">View All Bookings</span><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg></button>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-slate-600">
            <thead class="bg-slate-50/80 text-[11px] uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-100">
              <tr><th class="py-3 px-4">Booking Ref</th><th class="py-3 px-4">Customer</th><th class="py-3 px-4">Flight</th><th class="py-3 px-4">Travel Date</th><th class="py-3 px-4">Seat</th><th class="py-3 px-4">Total Price</th><th class="py-3 px-4">Status</th><th class="py-3 px-4 text-right">Actions</th></tr>
            </thead>
            <tbody class="divide-y divide-slate-100 font-medium" id="dashboard-bookings-body"></tbody>
          </table>
        </div>
      </div>

      <!-- Recent Flights Operations Table -->
      <div class="bg-white rounded-xl border border-slate-200 shadow-2xs overflow-hidden mt-6">
        <div class="p-4 border-b border-slate-100 flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <h3 class="text-sm font-bold text-midnight-900">Recent Flights</h3>
            <div class="flex items-center space-x-1 text-[11px] bg-slate-100 p-0.5 rounded-lg border border-slate-200">
              <button class="dash-flight-filter-pill px-2 py-0.5 rounded bg-white text-midnight-900 font-semibold shadow-2xs" onclick="setDashboardFlightFilter('ALL', this)">All Flights</button>
              <button class="dash-flight-filter-pill px-2 py-0.5 rounded text-slate-500 hover:text-slate-800" onclick="setDashboardFlightFilter('IN_FLIGHT', this)">In Flight</button>
              <button class="dash-flight-filter-pill px-2 py-0.5 rounded text-slate-500 hover:text-slate-800" onclick="setDashboardFlightFilter('SCHEDULED', this)">Scheduled</button>
              <button class="dash-flight-filter-pill px-2 py-0.5 rounded text-slate-500 hover:text-slate-800" onclick="setDashboardFlightFilter('DELAYED', this)">Delayed</button>
            </div>
          </div>
          <button class="text-xs font-semibold text-champagne-600 hover:text-champagne-700 flex items-center gap-1" onclick="switchView('flights')"><span class="">Full Flight Schedule</span><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg></button>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-slate-600">
            <thead class="bg-slate-50/80 text-[11px] uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-100">
              <tr><th class="py-3 px-4">Flight No.</th><th class="py-3 px-4">Route</th><th class="py-3 px-4">Departure</th><th class="py-3 px-4">Arrival</th><th class="py-3 px-4">Aircraft</th><th class="py-3 px-4">Base Fare</th><th class="py-3 px-4">Status</th><th class="py-3 px-4 text-right">Details</th></tr>
            </thead>
            <tbody class="divide-y divide-slate-100 font-medium" id="dashboard-flights-body"></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ============================================== -->
    <!-- VIEW 2: FLIGHTS MANAGEMENT -->
    <!-- ============================================== -->
    <section class="view-container space-y-6" data-purpose="flights-management" id="view-flights">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-4 rounded-xl border border-slate-200">
        <div class="flex flex-wrap items-center gap-3 flex-1">
          <div class="relative w-72">
            <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
            <input class="w-full text-xs bg-slate-50 rounded-lg pl-9 pr-3 py-2 border border-slate-200 focus:outline-none focus:ring-1 focus:ring-champagne-500" id="flights-search" oninput="filterFlightsTable(this.value)" placeholder="Search flight code or destination..." type="text">
          </div>
          <div class="flex items-center space-x-1 text-xs">
            <button class="flight-filter-pill active px-3 py-1.5 rounded-lg bg-midnight-800 text-white font-medium" onclick="setFlightFilter('ALL')">All (6)</button>
            <button class="flight-filter-pill px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium" onclick="setFlightFilter('IN_FLIGHT')">In Flight</button>
            <button class="flight-filter-pill px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium" onclick="setFlightFilter('SCHEDULED')">Scheduled</button>
            <button class="flight-filter-pill px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium" onclick="setFlightFilter('DELAYED')">Delayed</button>
          </div>
        </div>
        <button class="inline-flex items-center space-x-2 px-3.5 py-2 rounded-lg bg-midnight-800 text-white text-xs font-semibold hover:bg-midnight-900 transition-all self-start sm:self-auto" onclick="openModal('modal-add-flight')">
          <svg class="w-3.5 h-3.5 text-champagne-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path></svg>
          <span class="">+ Create Flight</span>
        </button>
      </div>
      <div class="bg-white rounded-xl border border-slate-200 shadow-2xs overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-slate-600">
            <thead class="bg-slate-50/80 text-[11px] uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-100">
              <tr><th class="py-3 px-4">Flight</th><th class="py-3 px-4">Origin / Destination</th><th class="py-3 px-4">Departure Time</th><th class="py-3 px-4">Arrival Time</th><th class="py-3 px-4">Assigned Aircraft</th><th class="py-3 px-4">Base Fare</th><th class="py-3 px-4">Status</th><th class="py-3 px-4 text-right">Actions</th></tr>
            </thead>
            <tbody class="divide-y divide-slate-100 font-medium" id="all-flights-body"></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ============================================== -->
    <!-- VIEW 3: AIRPORTS MANAGEMENT -->
    <!-- ============================================== -->
    <section class="view-container space-y-6" data-purpose="airports-management" id="view-airports">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-4 rounded-xl border border-slate-200">
        <div class="flex items-center space-x-3">
          <div class="relative w-72">
            <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
            <input class="w-full text-xs bg-slate-50 rounded-lg pl-9 pr-3 py-2 border border-slate-200 focus:outline-none focus:ring-1 focus:ring-champagne-500" id="airport-search-input" oninput="filterAirports(this.value)" placeholder="Search IATA or airport name..." type="text">
          </div>
          <span class="text-xs text-slate-500">6 Major Hubs Listed</span>
        </div>
        <button class="inline-flex items-center space-x-2 px-3.5 py-2 rounded-lg bg-midnight-800 text-white text-xs font-semibold hover:bg-midnight-900 transition-all" onclick="openModal('modal-add-airport')">
          <svg class="w-3.5 h-3.5 text-champagne-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path></svg>
          <span class="">+ Add Airport Station</span>
        </button>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="airports-grid"></div>
    </section>

    <!-- ============================================== -->
    <!-- VIEW 4: AIRCRAFT & FLEET MANAGEMENT -->
    <!-- ============================================== -->
    <section class="view-container space-y-6" data-purpose="aircraft-fleet" id="view-aircraft">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-4 rounded-xl border border-slate-200">
        <div>
          <h2 class="text-sm font-bold text-midnight-900">Sovereign Flagship Fleet</h2>
          <p class="text-xs text-slate-500" id="fleet-roster-count">Total 4 aircraft active in dispatch roster</p>
        </div>
        <div class="flex items-center space-x-2">
          <button class="px-3 py-2 text-xs font-medium text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors" onclick="showToast('Fleet telematics synchronized with OEM avionics', 'success')">Run Avionics Diagnostics</button>
          <button class="px-3 py-2 text-xs font-medium text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 rounded-lg transition-colors flex items-center gap-1.5" onclick="openManageSeatsModal('A6-SKB', 'Boeing 787-9 Dreamliner')">
            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
            <span class="">Default Seat Configuration</span>
          </button>
          <button class="px-3.5 py-2 text-xs font-semibold text-white bg-midnight-800 hover:bg-midnight-900 rounded-lg transition-colors flex items-center gap-1.5" onclick="openModal('modal-add-aircraft')">
            <svg class="w-3.5 h-3.5 text-champagne-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path></svg>
            <span class="">Add Aircraft</span>
          </button>
        </div>
      </div>
