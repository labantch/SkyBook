    const ZONE_STYLES = {
      first:    { label: 'Zone A: First Sovereign Suites', seatClass: 'bg-champagne-500 text-white hover:brightness-110', cols: 4 },
      business: { label: 'Zone B: Business Class Suites',  seatClass: 'bg-midnight-700 text-white hover:bg-midnight-600', cols: 4 },
      economy:  { label: 'Zone C: Economy Prestige',       seatClass: 'bg-slate-200 text-slate-700 hover:bg-slate-300', cols: 9 }
    };

    function renderInspectorSeatMap(aircraft) {
      const root = document.getElementById('ms-seatmap-root');
      if (!root) return;

      if (!aircraft || !aircraft.cabins) {
        root.innerHTML = `<p class="text-xs text-slate-400 text-center py-6">No cabin configuration on file for this aircraft.</p>`;
        return;
      }

      const cabins = buildCabinsFromCounts(aircraft.cabins);
      if (cabins.length === 0) {
        root.innerHTML = `<p class="text-xs text-slate-400 text-center py-6">This aircraft has no seats configured yet — edit it from the fleet card to add cabin counts.</p>`;
        return;
      }

      root.innerHTML = cabins.map(cabin => {
        const style = ZONE_STYLES[cabin.typeKey];
        const seatButtons = cabin.rows.map(rowNum => cabin.groups.flat().map(letter => {
          const seatId = `${rowNum}${letter}`;
          // Deterministic demo occupancy so the map isn't 100% empty
          const isOccupied = (rowNum + letter.charCodeAt(0)) % 7 === 0;
          if (isOccupied) {
            return `<button class="p-3 rounded-lg bg-rose-600 text-white font-bold flex flex-col items-center shadow-xs" onclick="inspectSeat('${seatId}', '${cabin.name}', 'Occupied — reserved for this flight')">${seatId}<span class="text-[9px] font-normal opacity-90 font-sans">Taken</span></button>`;
          }
          return `<button class="p-3 rounded-lg ${style.seatClass} font-bold flex flex-col items-center shadow-xs" onclick="inspectSeat('${seatId}', '${cabin.name}', 'Available for assignment')">${seatId}<span class="text-[9px] uppercase font-normal opacity-80 font-sans">Open</span></button>`;
        }).join('')).join('');

        return `
          <div class="w-full space-y-2">
            <div class="flex items-center justify-between border-b border-slate-200 pb-1">
              <span class="text-[10px] uppercase font-bold text-slate-600 tracking-wider">${style.label}</span>
              <span class="text-[10px] text-slate-400 font-mono">${cabin.rows.length * cabin.seatsPerRow} seats • Rows ${cabin.rows[0]}–${cabin.rows[cabin.rows.length - 1]}</span>
            </div>
            <div class="grid gap-1.5 px-2 py-2 font-mono max-h-56 overflow-y-auto" style="grid-template-columns: repeat(${style.cols}, minmax(0, 1fr));">
              ${seatButtons}
            </div>
          </div>`;
      }).join('');
    }

