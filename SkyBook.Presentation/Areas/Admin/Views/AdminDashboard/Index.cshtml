      const isOccupied = window.currentInspectedSeat.status.includes('Occupied') || window.currentInspectedSeat.status.includes('Blocked');
      const newStatus = isOccupied ? 'Available for passenger assignment' : 'Blocked / Reserved by Dispatch';
