    window.pendingRoleChange = null;

    window.requestRoleChange = function(customerName, newRole) {
      window.pendingRoleChange = { name: customerName, role: newRole };
      const title = document.getElementById('role-modal-title');
      const desc = document.getElementById('role-modal-desc');
      const confirmBtn = document.getElementById('role-modal-confirm-btn');
      if (!title || !desc || !confirmBtn) {
        console.error('Role modal elements missing');
        return;
      }
      if (newRole === 'admin') {
        title.textContent = 'Promote to Admin?';
        desc.textContent = customerName + ' will receive full access to the Operations Console — flights, bookings, fleet, and customer data.';
        confirmBtn.textContent = 'Yes, Make Admin';
        confirmBtn.className = 'flex-1 py-2.5 text-xs font-bold text-white bg-midnight-800 hover:bg-midnight-900 rounded-lg shadow-sm transition';
      } else {
        title.textContent = 'Demote to User?';
        desc.textContent = customerName + ' will lose admin access to the Operations Console.';
        confirmBtn.textContent = 'Yes, Demote';
        confirmBtn.className = 'flex-1 py-2.5 text-xs font-bold text-white bg-rose-600 hover:bg-rose-700 rounded-lg shadow-sm transition';
      }
      openModal('modal-confirm-role');
    };

    window.confirmRoleChange = function() {
      if (!window.pendingRoleChange) return;
      const name = window.pendingRoleChange.name;
      const role = window.pendingRoleChange.role;
      const cust = state.customers.find(c => c.name.toLowerCase() === name.toLowerCase());
      if (cust) {
        cust.role = role;
        renderCustomers();
        saveCustomersToStorage();
        showToast(role === 'admin' ? (name + ' promoted to Admin') : (name + ' demoted to User'), role === 'admin' ? 'success' : 'info');
      }
      window.pendingRoleChange = null;
      closeModal('modal-confirm-role');
    };

    function handleCreateCustomer(e) {
      e.preventDefault();
      const name = document.getElementById('mc-name').value.trim();
      const email = document.getElementById('mc-email').value.trim();
      const phone = document.getElementById('mc-phone').value.trim() || '+971 50 000 0000';
      const country = document.getElementById('mc-country').value.trim();
      const tier = document.getElementById('mc-tier').value;
      const role = document.getElementById('mc-role').value;
      const trips = parseInt(document.getElementById('mc-trips').value, 10) || 0;
      const miles = document.getElementById('mc-miles').value.trim() || '0';

      if (!name || !email) {
        showToast('Name and email are required', 'error');
        return;
      }

      state.customers.unshift({
        name, email, phone, country, tier, trips, miles, role
      });

      renderCustomers();
      saveCustomersToStorage();
      closeModal('modal-add-customer');
      showToast(`Customer ${name} registered in sovereign directory`, 'success');
      e.target.reset();
    }

    function openEditCustomerModal(email) {
      const c = state.customers.find(x => x.email === email);
      if (!c) return;
      document.getElementById('ec-original-email').value = c.email;
      document.getElementById('ec-name').value = c.name;
      document.getElementById('ec-email').value = c.email;
      document.getElementById('ec-phone').value = c.phone || '';
      document.getElementById('ec-country').value = c.country || '';
      document.getElementById('ec-tier').value = c.tier || 'SkyClub Sovereign Tier';
      document.getElementById('ec-role').value = c.role || 'user';
      document.getElementById('ec-trips').value = c.trips || 0;
      document.getElementById('ec-miles').value = c.miles || '0';
      openModal('modal-edit-customer');
    }

    function handleEditCustomer(e) {
      e.preventDefault();
      const origEmail = document.getElementById('ec-original-email').value;
      const name = document.getElementById('ec-name').value.trim();
      const email = document.getElementById('ec-email').value.trim();
      const phone = document.getElementById('ec-phone').value.trim();
      const country = document.getElementById('ec-country').value.trim();
      const tier = document.getElementById('ec-tier').value;
      const role = document.getElementById('ec-role').value;
      const trips = parseInt(document.getElementById('ec-trips').value, 10) || 0;
      const miles = document.getElementById('ec-miles').value.trim();

      const idx = state.customers.findIndex(x => x.email === origEmail);
      if (idx !== -1) {
        state.customers[idx] = { ...state.customers[idx], name, email, phone, country, tier, role, trips, miles };
        renderCustomers();
        saveCustomersToStorage();
        closeModal('modal-edit-customer');
        showToast(`Customer ${name} updated successfully`, 'success');
      }
    }

    function handleDeleteCustomer(name) {
      if (confirm(`Are you sure you want to remove customer "${name}" from the sovereign ledger?`)) {
        state.customers = state.customers.filter(c => c.name !== name);
        renderCustomers();
        saveCustomersToStorage();
        showToast(`Customer ${name} deleted successfully`, 'info');
      }
    }


    // role-action-btn-delegation
    document.addEventListener('click', function(e) {
      const btn = e.target.closest('.role-action-btn');
      if (!btn) return;
      e.preventDefault();
      const name = btn.getAttribute('data-name');
      const role = btn.getAttribute('data-role');
      if (name && role && typeof window.requestRoleChange === 'function') {
        window.requestRoleChange(name, role);
      }
    });

    // Modal & Drawer Interactions
    function openModal(id) { document.getElementById(id).classList.remove('hidden'); }
    function closeModal(id) { document.getElementById(id).classList.add('hidden'); }
    
    function openDrawer(id) {
      const d = document.getElementById(id);
      if (!d) return;
      d.classList.remove('hidden');
      setTimeout(() => {
        const b = d.querySelector('.drawer-backdrop');
        const c = d.querySelector('.drawer-content');
        if(b) b.classList.remove('opacity-0');
        if(c) c.classList.remove('translate-x-full');
      }, 10);
    }
    
    function closeDrawer(id) {
      const d = document.getElementById(id);
      if (!d) return;
      const b = d.querySelector('.drawer-backdrop');
      const c = d.querySelector('.drawer-content');
      if(b) b.classList.add('opacity-0');
      if(c) c.classList.add('translate-x-full');
      setTimeout(() => d.classList.add('hidden'), 250);
    }

    function openFlightDrawer(code) {
      const flight = state.flights.find(f => f.code === code) || state.flights[0];
      document.getElementById('df-code').innerText = flight.code;
      document.getElementById('df-status-pill').innerText = flight.status;
      document.getElementById('df-origin-iata').innerText = flight.origin;
      document.getElementById('df-dest-iata').innerText = flight.dest;
      document.getElementById('df-dept-time').innerText = flight.dept;
      document.getElementById('df-arr-time').innerText = flight.arr;
      document.getElementById('df-origin-gate').innerText = flight.deptGate;
      document.getElementById('df-dest-gate').innerText = flight.arrGate;
      document.getElementById('df-aircraft-name').innerText = flight.aircraft;
      document.getElementById('df-tail-no').innerText = flight.tail;
      document.getElementById('df-fare').innerText = flight.fare;
      openDrawer('drawer-flight-details');
    }

