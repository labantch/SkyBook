@* Edit aircraft modal *@
<div class="fixed inset-0 z-50 flex items-center justify-center hidden" data-purpose="modal-aircraft-form" id="modal-edit-aircraft">
  <div class="absolute inset-0 bg-midnight-900/60 backdrop-blur-xs" onclick="closeModal('modal-edit-aircraft')"></div>
  <div class="relative bg-white rounded-xl shadow-2xl max-w-lg w-full mx-4 overflow-hidden border border-slate-200 z-10 animate-scale">
    <div class="h-14 bg-midnight-800 px-6 flex items-center justify-between text-white flex-shrink-0">
      <h3 class="text-sm font-bold flex items-center gap-2">
        <svg class="w-4 h-4 text-champagne-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
        Edit Aircraft Configuration
      </h3>
      <button class="text-slate-400 hover:text-white" onclick="closeModal('modal-edit-aircraft')">✕</button>
    </div>
    <form class="p-6 space-y-4 text-xs" id="edit-aircraft-form" onsubmit="handleEditAircraft(event)" method="post">
      <input type="hidden" id="ea-original-tail">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Aircraft Model</label>
          <input class="w-full text-xs rounded-lg border-slate-200 bg-slate-50 focus:ring-champagne-500" id="ea-model" placeholder="e.g. Airbus A380-800" required type="text">
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Registration / Tail No.</label>
          <input class="w-full text-xs font-mono uppercase rounded-lg border-slate-200 bg-slate-50 focus:ring-champagne-500" id="ea-tail" placeholder="e.g. A6-SKZ" required type="text">
        </div>
      </div>

      <div>
        <label class="block font-semibold text-slate-700 mb-2">Cabin Seat Configuration <span class="font-normal text-slate-400">(three cabins)</span></label>
        <div class="grid grid-cols-3 gap-3 p-3 rounded-xl bg-slate-50 border border-slate-200">
          <div>
            <label class="flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider text-champagne-700 mb-1"><span class="w-2 h-2 rounded-full bg-champagne-500 inline-block"></span>First Sovereign</label>
            <input class="w-full text-xs font-mono rounded-lg border-slate-200" id="ea-seats-first" min="0" oninput="updateEditAircraftSeatTotal()" required type="number" value="12">
          </div>
          <div>
            <label class="flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider text-midnight-800 mb-1"><span class="w-2 h-2 rounded-full bg-midnight-700 inline-block"></span>Business</label>
            <input class="w-full text-xs font-mono rounded-lg border-slate-200" id="ea-seats-business" min="0" oninput="updateEditAircraftSeatTotal()" required type="number" value="48">
          </div>
          <div>
            <label class="flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider text-slate-600 mb-1"><span class="w-2 h-2 rounded-full bg-slate-400 inline-block"></span>Economy</label>
            <input class="w-full text-xs font-mono rounded-lg border-slate-200" id="ea-seats-economy" min="0" oninput="updateEditAircraftSeatTotal()" required type="number" value="230">
          </div>
        </div>
        <p class="text-[11px] text-slate-500 mt-2">Total capacity: <span class="font-bold text-midnight-900" id="ea-seat-total">290</span> seats</p>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Avionics Readiness (%)</label>
          <input class="w-full text-xs font-mono rounded-lg border-slate-200 bg-slate-50" id="ea-readiness" max="100" min="0" required type="number" value="100">
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Status</label>
          <select class="w-full text-xs rounded-lg border-slate-200 bg-slate-50" id="ea-status">
            <option value="Operational (Ready at Gate)">Operational (Ready at Gate)</option>
            <option value="Operational (In-Flight)">Operational (In-Flight)</option>
            <option value="Turnaround Ops">Turnaround Ops</option>
            <option value="Scheduled Maintenance">Scheduled Maintenance</option>
          </select>
        </div>
      </div>

      <div class="pt-4 border-t border-slate-100 flex items-center justify-end space-x-2">
        <button class="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-lg" onclick="closeModal('modal-edit-aircraft')" type="button">Cancel</button>
        <button class="px-4 py-2 bg-midnight-800 text-white font-semibold rounded-lg hover:bg-midnight-900 shadow-sm" type="submit">Update Aircraft</button>
      </div>
    </form>
  </div>
</div>
