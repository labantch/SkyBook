@model List<SkyBook.Business.ViewModels.AircraftVM>
@{
    ViewData["Title"] = "Aircraft & Fleet";
    Layout = "_AdminLayout";
}

<!-- Top header strip (matches ops console) -->
<header class="h-16 bg-white border-b border-slate-200 px-6 flex items-center justify-between z-20 flex-shrink-0">
  <div>
    <h1 class="text-sm font-bold text-midnight-900">Aircraft &amp; Fleet Management</h1>
    <p class="text-[11px] text-slate-500">SkyBook Operations Console &bull; Sovereign Fleet Network</p>
  </div>
  <a href="@Url.Action("Index", "AdminDashboard", new { area = "Admin" })" class="text-xs font-semibold text-champagne-600 hover:text-champagne-700 hover:underline">&larr; Full Dashboard</a>
</header>

<main class="flex-1 overflow-y-auto p-6 bg-[#F8FAFC]" id="viewport-root">

  @if (TempData["Success"] != null)
  {
      <div class="mb-4 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs flex items-center justify-between shadow-xs">
          <div class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="font-semibold">@TempData["Success"]</span>
          </div>
          <button type="button" onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700 font-bold ml-4">✕</button>
      </div>
  }

  @if (TempData["Error"] != null)
  {
      <div class="mb-4 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs flex items-center justify-between shadow-xs">
          <div class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-rose-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
              </svg>
              <span class="font-semibold">@TempData["Error"]</span>
          </div>
          <button type="button" onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-700 font-bold ml-4">✕</button>
      </div>
  }
  @{
    var fallbackImg = "https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?auto=format&fit=crop&w=1200&q=80";

    string ResolveAircraftImage(string? rawUrl)
    {
        if (string.IsNullOrWhiteSpace(rawUrl)) return fallbackImg;
        if (rawUrl.Contains("google.com/imgres") && rawUrl.Contains("imgurl="))
        {
            try
            {
                var uri = new Uri(rawUrl);
                var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
                var extracted = query["imgurl"];
                if (!string.IsNullOrWhiteSpace(extracted)) return extracted;
            }
            catch {}
        }
        return rawUrl;
    }
  }

  <section class="view-container space-y-5 active" data-purpose="aircraft-fleet" id="view-aircraft">
    
    <!-- Header Section (Matching Airport Design) -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-1">
      <div>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Fleet Roster</h1>
        <p class="text-sm text-slate-500 mt-0.5 font-normal" id="aircraft-count-label">
            @(Model != null && Model.Any() ? $"{Model.Count} Aircraft in Active Fleet" : "Manage and monitor sovereign commercial fleet.")
        </p>
      </div>

      <div class="flex items-center gap-3">
        <div class="relative w-64 sm:w-72">
          <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
          </svg>
          <input class="w-full text-xs bg-white rounded-xl pl-9 pr-3 py-2.5 border border-slate-200 focus:outline-none focus:ring-1 focus:ring-slate-400 shadow-2xs transition" 
                 id="aircraft-search-input" 
                 oninput="filterAircrafts(this.value)" 
                 placeholder="Search model, capacity, or ID..." 
                 type="text">
        </div>

        <button type="button"
                class="inline-flex items-center space-x-2 px-4 py-2.5 rounded-xl bg-midnight-900 hover:bg-slate-800 text-white text-xs font-semibold transition-all shadow-sm shrink-0"
                onclick="openAddAircraftModal()">
            <svg class="w-3.5 h-3.5 text-champagne-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path d="M12 4v16m8-8H4" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path>
            </svg>
            <span>+ Add Aircraft</span>
        </button>
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- AIRCRAFT CARDS (HORIZONTAL ROW DESIGN MATCHING AIRPORT)     -->
    <!-- ============================================================ -->
    <div class="flex flex-col space-y-4" id="aircraft-grid">
      @if (Model != null && Model.Any())
      {
          @foreach (var aircraft in Model)
          {
              var displayImg = ResolveAircraftImage(aircraft.ImageUrl);

              <!-- SINGLE AIRCRAFT CARD (ROW) -->
              <div class="aircraft-card group bg-white hover:bg-slate-50/40 rounded-[22px] border border-slate-200/90 p-3 sm:p-4 shadow-2xs hover:shadow-md transition-all duration-200 flex flex-col md:flex-row items-stretch gap-4 lg:gap-5"
                   data-name="@aircraft.Name.ToLower()"
                   data-id="@aircraft.Id"
                   data-capacity="@aircraft.Capacity"
                   data-status="@aircraft.Status.ToString().ToLower()">

                  <!-- Left: Wide Thumbnail Image with Fleet ID Badge -->
                  <div class="relative w-full md:w-52 lg:w-60 h-32 md:h-28 lg:h-32 rounded-2xl overflow-hidden bg-slate-900 shrink-0 border border-slate-200/80 shadow-2xs">
                      <img src="@displayImg"
                           alt="@aircraft.Name"
                           class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                           onerror="this.onerror=null; this.src='@fallbackImg';" />
                      
                      <!-- Floating Fleet ID Badge at Bottom-Left of Image -->
                      <div class="absolute bottom-2.5 left-2.5 bg-black/65 backdrop-blur-md rounded-xl px-2.5 py-1 border border-white/15 text-center shadow-lg pointer-events-none min-w-[64px]">
                          <span class="block text-sm sm:text-base font-black font-mono text-white tracking-wider leading-none">#@aircraft.Id</span>
                          <span class="block text-[7px] font-bold text-champagne-400 uppercase tracking-[0.18em] leading-none mt-1">FLEET ID</span>
                      </div>
                  </div>

                  <!-- Right: Information & Action Controls -->
                  <div class="flex-1 flex flex-col justify-between py-0.5 min-w-0">
                      
                      <!-- Top Row: Name + Dynamic Status Badge -->
                      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                          <div class="min-w-0 flex-1">
                              <h3 class="text-base sm:text-lg font-bold text-slate-900 tracking-tight leading-snug truncate" title="@aircraft.Name">
                                  @aircraft.Name
                              </h3>
                              <p class="text-xs text-slate-500 mt-0.5 font-normal">SkyBook Sovereign Fleet &bull; Commercial Corridor Network</p>
                          </div>

                          <!-- Status Badge -->
                          <div class="shrink-0 flex items-center sm:justify-end">
                              @if (aircraft.Status == AircraftStatus.Active)
                              {
                                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 shadow-2xs">
                                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                      Active Fleet
                                  </span>
                              }
                              else if (aircraft.Status == AircraftStatus.Maintenance)
                              {
                                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200 shadow-2xs">
                                      <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                                      In Maintenance
                                  </span>
                              }
                              else
                              {
                                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200 shadow-2xs">
                                      <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                                      Inactive Fleet
                                  </span>
                              }
                          </div>
                      </div>

                      <!-- Bottom Row: Capacity + Specs + Action Buttons -->
                      <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-4 pt-3 border-t border-slate-100 mt-3">
                          <!-- Left: Capacity with passenger/seat icon & cabin distribution -->
                          <div class="flex items-center gap-3 text-xs text-slate-600 font-normal min-w-0">
                              <div class="w-9 h-9 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center text-midnight-800 shrink-0">
                                  <svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                                  </svg>
                              </div>
                              <div class="min-w-0">
                                  <div class="flex items-center gap-1.5 flex-wrap">
                                      <strong class="font-bold text-slate-900 font-mono text-xs">@aircraft.Capacity Seats</strong>
                                      <span class="text-slate-400 font-normal text-[11px]">(Capacity)</span>
                                  </div>
                                  @if (aircraft.FirstClassSeats > 0 || aircraft.BusinessSeats > 0 || aircraft.EconomySeats > 0)
                                  {
                                      <div class="flex flex-wrap items-center gap-1.5 text-[10px] mt-1">
                                          @if (aircraft.FirstClassSeats > 0)
                                          {
                                              <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-champagne-100 text-champagne-800 font-semibold font-mono">@aircraft.FirstClassSeats First</span>
                                          }
                                          @if (aircraft.BusinessSeats > 0)
                                          {
                                              <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-midnight-800 text-champagne-300 font-semibold font-mono">@aircraft.BusinessSeats Business</span>
                                          }
                                          @if (aircraft.EconomySeats > 0)
                                          {
                                              <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-slate-100 text-slate-700 font-semibold font-mono">@aircraft.EconomySeats Economy</span>
                                          }
                                      </div>
                                  }
                              </div>
                          </div>

                          <!-- Right: Certification + Action Buttons -->
                          <div class="flex items-center justify-between xl:justify-end gap-3 shrink-0">
                              <!-- Corridor Certification -->
                              <span class="hidden sm:inline-block text-xs font-medium text-slate-400 font-mono tracking-wide">
                                  FAA &bull; EASA &bull; GCAA
                              </span>

                              <!-- Action Buttons (Manage Seats + Edit + Delete) -->
                              <div class="flex items-center gap-2 shrink-0">
                                  <!-- Manage Seats Button -->
                                  <a href="/Admin/Seat"
                                     title="Manage Cabin Configuration"
                                     class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:text-slate-900 bg-white hover:bg-slate-50 rounded-lg border border-slate-200 hover:border-slate-300 transition shadow-2xs">
                                      <svg class="w-3.5 h-3.5 text-champagne-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                                      </svg>
                                      <span>Seats</span>
                                  </a>
                                  
                                  <!-- Edit Button -->
                                  <button type="button"
                                          data-id="@aircraft.Id"
                                          data-name="@aircraft.Name"
                                          data-capacity="@aircraft.Capacity"
                                          data-image="@(aircraft.ImageUrl ?? "")"
                                          data-status="@aircraft.Status"
                                          data-economy="@aircraft.EconomySeats"
                                          data-business="@aircraft.BusinessSeats"
                                          data-first="@aircraft.FirstClassSeats"
                                          onclick="handleEditButtonClick(this)"
                                          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:text-slate-900 bg-white hover:bg-slate-50 rounded-lg border border-slate-200 hover:border-slate-300 transition shadow-2xs">
                                      <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                      </svg>
                                      <span>Edit</span>
                                  </button>

                                  <!-- Delete Button -->
                                  <button type="button"
                                          data-id="@aircraft.Id"
                                          data-name="@aircraft.Name"
                                          onclick="handleDeleteButtonClick(this)"
                                          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-rose-600 hover:text-rose-700 bg-white hover:bg-rose-50 rounded-lg border border-rose-200/80 hover:border-rose-300 transition shadow-2xs">
                                      <svg class="w-3.5 h-3.5 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                      </svg>
                                      <span>Delete</span>
                                  </button>
                              </div>
                          </div>
                      </div>

                  </div>

              </div>
              <!-- /END SINGLE AIRCRAFT CARD -->
          }
      }
      else
      {
          <!-- Empty State -->
          <div class="py-14 text-center bg-white rounded-2xl border border-slate-200/80 p-8 shadow-xs">
              <div class="w-12 h-12 rounded-2xl bg-midnight-900 text-champagne-400 flex items-center justify-center mx-auto mb-3 border border-champagne-400/30 shadow-md">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                  </svg>
              </div>
              <h4 class="text-sm font-bold text-midnight-900">No Aircraft in Fleet Roster</h4>
              <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">Get started by onboarding your first aircraft into the SkyBook active fleet.</p>
              <button type="button"
                      onclick="openAddAircraftModal()"
                      class="mt-4 inline-flex items-center space-x-2 px-4 py-2 rounded-lg bg-midnight-800 text-white text-xs font-semibold hover:bg-midnight-900 transition shadow-sm">
                  <span>+ Onboard New Aircraft</span>
              </button>
          </div>
      }

      <!-- Search No-Matches State (hidden by default) -->
      <div id="no-search-results" class="py-12 text-center bg-white rounded-xl border border-slate-200 p-6 hidden">
          <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
          </div>
          <h4 class="text-xs font-bold text-midnight-900">No Aircraft Match Your Search</h4>
          <p class="text-[11px] text-slate-500 mt-0.5">Try searching by model name, capacity, or fleet ID.</p>
      </div>

    </div>

    <!-- Pagination Bar -->
    <div id="aircraft-pagination" class="bg-white rounded-2xl border border-slate-200/90 px-5 py-3 shadow-2xs flex items-center justify-center mt-2">
      <nav id="aircraft-pagination-nav" class="flex items-center gap-1.5" aria-label="Aircraft pagination">
        <button type="button" id="aircraft-prev-btn" onclick="prevAircraftPage()" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg border border-slate-200 text-[11px] font-semibold text-slate-600 hover:bg-slate-50 hover:text-slate-900 disabled:opacity-40 disabled:cursor-not-allowed transition shadow-2xs">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          <span>Previous</span>
        </button>
        <div id="aircraft-page-numbers" class="flex items-center gap-1">
          <!-- Page numbers rendered dynamically -->
        </div>
        <button type="button" id="aircraft-next-btn" onclick="nextAircraftPage()" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg border border-slate-200 text-[11px] font-semibold text-slate-600 hover:bg-slate-50 hover:text-slate-900 disabled:opacity-40 disabled:cursor-not-allowed transition shadow-2xs">
          <span>Next</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </button>
      </nav>
    </div>

  </section>
</main>

@* Delete Aircraft Confirmation Modal *@
<div class="fixed inset-0 z-50 flex items-center justify-center hidden"
     data-purpose="modal-aircraft-delete-confirm"
     id="modal-delete-aircraft">

    <div class="absolute inset-0 bg-midnight-900/60 backdrop-blur-xs"
         onclick="closeModal('modal-delete-aircraft')"></div>

    <div class="relative bg-white rounded-2xl shadow-2xl max-w-sm w-full mx-4 overflow-hidden border border-slate-200 z-10 animate-scale p-6 text-center">
        
        <div class="w-12 h-12 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
        </div>

        <h3 class="text-base font-bold text-midnight-900 mb-1">Decommission Aircraft?</h3>
        <p class="text-xs text-slate-500 mb-2">Are you sure you want to remove this aircraft from the active fleet?</p>
        
        <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-200 mb-5">
            <span id="da-aircraft-name" class="font-bold text-midnight-900 font-mono text-xs"></span>
        </div>

        <form id="delete-aircraft-form"
              action="/Admin/Aircraft/Delete"
              method="post"
              class="flex items-center gap-2">
            @Html.AntiForgeryToken()
            <input type="hidden" id="delete-aircraft-return-page" name="returnPage" value="1" />
            <input type="hidden" id="da-aircraft-id" name="id" />

            <button type="button"
                    class="flex-1 px-4 py-2.5 rounded-lg border border-slate-200 text-slate-700 text-xs font-semibold hover:bg-slate-100 transition"
                    onclick="closeModal('modal-delete-aircraft')">
                Cancel
            </button>

            <button type="submit"
                    class="flex-1 px-4 py-2.5 rounded-lg bg-rose-600 text-white text-xs font-semibold hover:bg-rose-700 transition shadow-sm">
                Yes, Delete
            </button>
        </form>

    </div>
</div>

@section Scripts {
<script>
    const aircraftPagination = {
        currentPage: 1,
        pageSize: 5,
        matchingCards: []
    };

    function updateAircraftPagination() {
        const total = aircraftPagination.matchingCards.length;
        const totalPages = Math.ceil(total / aircraftPagination.pageSize) || 1;
        if (aircraftPagination.currentPage > totalPages) {
            aircraftPagination.currentPage = totalPages;
        }
        if (aircraftPagination.currentPage < 1) {
            aircraftPagination.currentPage = 1;
        }

        const startIndex = (aircraftPagination.currentPage - 1) * aircraftPagination.pageSize;
        const endIndex = startIndex + aircraftPagination.pageSize;

        // Hide all cards first, then show only matching cards for current page
        const allCards = document.querySelectorAll('.aircraft-card');
        allCards.forEach(card => card.classList.add('hidden'));

        aircraftPagination.matchingCards.forEach((card, idx) => {
            if (idx >= startIndex && idx < endIndex) {
                card.classList.remove('hidden');
            }
        });

        // Update info bar
        const paginationBar = document.getElementById('aircraft-pagination');
        if (paginationBar) {
            paginationBar.classList.toggle('hidden', total === 0);
        }

        // Prev & Next buttons
        const prevBtn = document.getElementById('aircraft-prev-btn');
        const nextBtn = document.getElementById('aircraft-next-btn');
        if (prevBtn) prevBtn.disabled = (aircraftPagination.currentPage <= 1);
        if (nextBtn) nextBtn.disabled = (aircraftPagination.currentPage >= totalPages);

        // Render page numbers
        renderAircraftPageNumbers(totalPages, aircraftPagination.currentPage);
    }

    function renderAircraftPageNumbers(totalPages, current) {
        const container = document.getElementById('aircraft-page-numbers');
        if (!container) return;
        container.innerHTML = '';

        if (totalPages <= 1) return;

        const pages = [];
        if (totalPages <= 7) {
            for (let i = 1; i <= totalPages; i++) pages.push(i);
        } else {
            pages.push(1);
            if (current > 3) pages.push('...');
            const start = Math.max(2, current - 1);
            const end = Math.min(totalPages - 1, current + 1);
            for (let i = start; i <= end; i++) {
                if (!pages.includes(i)) pages.push(i);
            }
            if (current < totalPages - 2) pages.push('...');
            if (!pages.includes(totalPages)) pages.push(totalPages);
        }

        pages.forEach(p => {
            if (p === '...') {
                const span = document.createElement('span');
                span.className = 'px-2 py-1 text-slate-400 text-xs font-mono select-none';
                span.textContent = '...';
                container.appendChild(span);
            } else {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.textContent = p;
                if (p === current) {
                    btn.className = 'w-7 h-7 rounded-lg bg-midnight-900 text-white font-bold text-[11px] shadow-xs border border-midnight-950 flex items-center justify-center';
                } else {
                    btn.className = 'w-7 h-7 rounded-lg bg-white hover:bg-slate-100 text-slate-700 font-semibold text-[11px] border border-slate-200 hover:border-slate-300 transition flex items-center justify-center';
                    btn.onclick = () => goToAircraftPage(p);
                }
                container.appendChild(btn);
            }
        });
    }

    function goToAircraftPage(page) {
        aircraftPagination.currentPage = page;
        updateAircraftPagination();
        scrollToTopAircraft();
    }

    function prevAircraftPage() {
        if (aircraftPagination.currentPage > 1) {
            aircraftPagination.currentPage--;
            updateAircraftPagination();
            scrollToTopAircraft();
        }
    }

    function nextAircraftPage() {
        const totalPages = Math.ceil(aircraftPagination.matchingCards.length / aircraftPagination.pageSize) || 1;
        if (aircraftPagination.currentPage < totalPages) {
            aircraftPagination.currentPage++;
            updateAircraftPagination();
            scrollToTopAircraft();
        }
    }

    function scrollToTopAircraft() {
        const grid = document.getElementById('aircraft-grid');
        if (grid) {
            grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }

    // Live Search Filter across Name, Capacity, ID
    function filterAircrafts(query) {
        const q = (query || '').toLowerCase().trim();
        const cards = Array.from(document.querySelectorAll('.aircraft-card'));
        const noResults = document.getElementById('no-search-results');

        aircraftPagination.matchingCards = cards.filter(card => {
            const name = card.getAttribute('data-name') || '';
            const id = card.getAttribute('data-id') || '';
            const capacity = card.getAttribute('data-capacity') || '';
            const status = card.getAttribute('data-status') || '';
            return !q || name.includes(q) || id.includes(q) || capacity.includes(q) || status.includes(q);
        });

        if (noResults) {
            noResults.classList.toggle('hidden', aircraftPagination.matchingCards.length > 0 || cards.length === 0);
        }

        aircraftPagination.currentPage = 1;
        updateAircraftPagination();
    }

    function openAddAircraftModal() {
        const modal = document.getElementById('modal-add-aircraft');
        if (modal) {
            const form = modal.querySelector('form');
            if (form) {
                form.reset();
                const sumEl = document.getElementById('na-seat-sum');
                if (sumEl) sumEl.innerText = '0';
            }
            syncAircraftReturnPage('add-aircraft');
            openModal('modal-add-aircraft');
        }
    }

    function getAircraftPageFromUrl() {
        const page = Number(new URLSearchParams(window.location.search).get('page') || '1');
        return Number.isFinite(page) && page > 0 ? page : 1;
    }

    function syncAircraftReturnPage(formId) {
        const field = document.getElementById(formId + '-return-page');
        if (field) {
            field.value = aircraftPagination.currentPage;
        }
    }

    function handleEditButtonClick(btn) {
        const id = btn.getAttribute('data-id');
        const name = btn.getAttribute('data-name');
        const capacity = btn.getAttribute('data-capacity');
        const image = btn.getAttribute('data-image');
        const status = btn.getAttribute('data-status');
        const economy = btn.getAttribute('data-economy') || 0;
        const business = btn.getAttribute('data-business') || 0;
        const first = btn.getAttribute('data-first') || 0;

        syncAircraftReturnPage('edit-aircraft');

        if (typeof openEditAircraftModalById === 'function') {
            openEditAircraftModalById(id, name, capacity, image, economy, business, first, status);
        }
    }

    function handleDeleteButtonClick(btn) {
        const id = btn.getAttribute('data-id');
        const name = btn.getAttribute('data-name');
        syncAircraftReturnPage('delete-aircraft');
        openDeleteAircraftModal(id, name);
    }

    function openDeleteAircraftModal(id, name) {
        const idInput = document.getElementById('da-aircraft-id');
        const nameEl = document.getElementById('da-aircraft-name');
        if (idInput) idInput.value = id || '';
        if (nameEl) nameEl.textContent = `#${id} • ${name}`;
        openModal('modal-delete-aircraft');
    }

    window.addEventListener('DOMContentLoaded', () => {
        const isAuthed = localStorage.getItem('skybook-authenticated') === 'true';
        const role = localStorage.getItem('skybook-role');
        if (!isAuthed || role !== 'admin') {
            window.location.href = '/Account/Login?returnTo=/Admin/Aircraft';
            return;
        }

        aircraftPagination.currentPage = getAircraftPageFromUrl();

        const searchInput = document.getElementById('aircraft-search-input');
        filterAircrafts(searchInput ? searchInput.value : '');
    });
</script>
}
