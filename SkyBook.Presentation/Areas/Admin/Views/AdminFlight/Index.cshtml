      <div class="h-16 px-6 bg-midnight-800 text-white flex items-center justify-between border-b border-midnight-700">
        <div class="flex items-center space-x-3">
          <span class="text-xs font-mono px-2 py-0.5 rounded bg-champagne-500/20 text-champagne-400 border border-champagne-500/40" id="df-code">SB 918</span>
          <span class="text-xs font-semibold" id="df-status-pill">In Flight</span>
