    window.pendingRoleChange = null;

    window.requestRoleChange = function(customerName, newRole) {
      window.pendingRoleChange = { name: customerName, role: newRole };
      const title = document.getElementById('role-modal-title');
      const desc = document.getElementById('role-modal-desc');
      const confirmBtn = document.getElementById('role-modal-confirm-btn');
      if (!title || !desc || !confirmBtn) {
        console.error('Role modal elements missing');
        return;
      }
      if (newRole === 'admin') {
        title.textContent = 'Promote to Admin?';
        desc.textContent = customerName + ' will receive full access to the Operations Console — flights, bookings, fleet, and customer data.';
        confirmBtn.textContent = 'Yes, Make Admin';
        confirmBtn.className = 'flex-1 py-2.5 text-xs font-bold text-white bg-midnight-800 hover:bg-midnight-900 rounded-lg shadow-sm transition';
      } else {
        title.textContent = 'Demote to User?';
        desc.textContent = customerName + ' will lose admin access to the Operations Console.';
        confirmBtn.textContent = 'Yes, Demote';
        confirmBtn.className = 'flex-1 py-2.5 text-xs font-bold text-white bg-rose-600 hover:bg-rose-700 rounded-lg shadow-sm transition';
      }
      openModal('modal-confirm-role');
    };

    window.confirmRoleChange = function() {
      if (!window.pendingRoleChange) return;
      const name = window.pendingRoleChange.name;
      const role = window.pendingRoleChange.role;
      const cust = state.customers.find(c => c.name.toLowerCase() === name.toLowerCase());
      if (cust) {
        cust.role = role;
        renderCustomers();
        showToast(role === 'admin' ? (name + ' promoted to Admin') : (name + ' demoted to User'), role === 'admin' ? 'success' : 'info');
      }
      window.pendingRoleChange = null;
      closeModal('modal-confirm-role');
    };


    // role-action-btn-delegation
    document.addEventListener('click', function(e) {
      const btn = e.target.closest('.role-action-btn');
      if (!btn) return;
      e.preventDefault();
      const name = btn.getAttribute('data-name');
      const role = btn.getAttribute('data-role');
      if (name && role && typeof window.requestRoleChange === 'function') {
        window.requestRoleChange(name, role);
      }
    });

    // Modal & Drawer Interactions
    function openModal(id) { document.getElementById(id).classList.remove('hidden'); }
    function closeModal(id) { document.getElementById(id).classList.add('hidden'); }
    
    function openDrawer(id) {
      const d = document.getElementById(id);
      if (!d) return;
      d.classList.remove('hidden');
      setTimeout(() => {
        const b = d.querySelector('.drawer-backdrop');
        const c = d.querySelector('.drawer-content');
        if(b) b.classList.remove('opacity-0');
        if(c) c.classList.remove('translate-x-full');
      }, 10);
    }
    
    function closeDrawer(id) {
      const d = document.getElementById(id);
      if (!d) return;
      const b = d.querySelector('.drawer-backdrop');
      const c = d.querySelector('.drawer-content');
      if(b) b.classList.add('opacity-0');
      if(c) c.classList.add('translate-x-full');
      setTimeout(() => d.classList.add('hidden'), 250);
    }

    function openFlightDrawer(code) {
      const flight = state.flights.find(f => f.code === code) || state.flights[0];
      document.getElementById('df-code').innerText = flight.code;
      document.getElementById('df-status-pill').innerText = flight.status;
      document.getElementById('df-origin-iata').innerText = flight.origin;
      document.getElementById('df-dest-iata').innerText = flight.dest;
      document.getElementById('df-dept-time').innerText = flight.dept;
      document.getElementById('df-arr-time').innerText = flight.arr;
      document.getElementById('df-origin-gate').innerText = flight.deptGate;
      document.getElementById('df-dest-gate').innerText = flight.arrGate;
      document.getElementById('df-aircraft-name').innerText = flight.aircraft;
      document.getElementById('df-tail-no').innerText = flight.tail;
      document.getElementById('df-fare').innerText = flight.fare;
      openDrawer('drawer-flight-details');
    }

    function openManageSeatsModal(tail, planeName) {
      document.getElementById('ms-plane-title').innerText = `${planeName} (${tail})`;
      const aircraft = state.fleet.find(ac => ac.tail === tail);
      renderInspectorSeatMap(aircraft);
      openModal('modal-manage-seats');
    }

    const ZONE_STYLES = {
      first:    { label: 'Zone A: First Sovereign Suites', seatClass: 'bg-champagne-500 text-white hover:brightness-110', cols: 4 },
      business: { label: 'Zone B: Business Class Suites',  seatClass: 'bg-midnight-700 text-white hover:bg-midnight-600', cols: 4 },
      economy:  { label: 'Zone C: Economy Prestige',       seatClass: 'bg-slate-200 text-slate-700 hover:bg-slate-300', cols: 9 }
    };

    function renderInspectorSeatMap(aircraft) {
      const root = document.getElementById('ms-seatmap-root');
      if (!root) return;

      if (!aircraft || !aircraft.cabins) {
        root.innerHTML = `<p class="text-xs text-slate-400 text-center py-6">No cabin configuration on file for this aircraft.</p>`;
        return;
      }

      const cabins = buildCabinsFromCounts(aircraft.cabins);
      if (cabins.length === 0) {
        root.innerHTML = `<p class="text-xs text-slate-400 text-center py-6">This aircraft has no seats configured yet — edit it from the fleet card to add cabin counts.</p>`;
        return;
      }

      root.innerHTML = cabins.map(cabin => {
        const style = ZONE_STYLES[cabin.typeKey];
        const seatButtons = cabin.rows.map(rowNum => cabin.groups.flat().map(letter => {
          const seatId = `${rowNum}${letter}`;
          // Deterministic demo occupancy so the map isn't 100% empty
          const isOccupied = (rowNum + letter.charCodeAt(0)) % 7 === 0;
          if (isOccupied) {
            return `<button class="p-3 rounded-lg bg-rose-600 text-white font-bold flex flex-col items-center shadow-xs" onclick="inspectSeat('${seatId}', '${cabin.name}', 'Occupied — reserved for this flight')">${seatId}<span class="text-[9px] font-normal opacity-90 font-sans">Taken</span></button>`;
          }
          return `<button class="p-3 rounded-lg ${style.seatClass} font-bold flex flex-col items-center shadow-xs" onclick="inspectSeat('${seatId}', '${cabin.name}', 'Available for assignment')">${seatId}<span class="text-[9px] uppercase font-normal opacity-80 font-sans">Open</span></button>`;
        }).join('')).join('');

        return `
          <div class="w-full space-y-2">
            <div class="flex items-center justify-between border-b border-slate-200 pb-1">
              <span class="text-[10px] uppercase font-bold text-slate-600 tracking-wider">${style.label}</span>
              <span class="text-[10px] text-slate-400 font-mono">${cabin.rows.length * cabin.seatsPerRow} seats • Rows ${cabin.rows[0]}–${cabin.rows[cabin.rows.length - 1]}</span>
            </div>
            <div class="grid gap-1.5 px-2 py-2 font-mono max-h-56 overflow-y-auto" style="grid-template-columns: repeat(${style.cols}, minmax(0, 1fr));">
              ${seatButtons}
            </div>
          </div>`;
      }).join('');
    }

    function inspectSeat(seatId, cabin, statusInfo) {
      document.getElementById('inspected-seat-id').innerText = `Seat ${seatId} (${cabin})`;
      document.getElementById('inspected-seat-desc').innerText = statusInfo;
    }

    function openCustomerDrawerByName(customerName) {
      const cust = state.customers.find(c => c.name.toLowerCase() === customerName.toLowerCase()) || state.customers[0];
      document.getElementById('cd-name').innerText = cust.name;
      document.getElementById('cd-initials').innerText = cust.name.split(' ').map(n=>n[0]).join('');
      document.getElementById('cd-email').innerText = cust.email;
      document.getElementById('cd-tier').innerText = `${cust.tier} • #SK-8829104`;
      document.getElementById('cd-trips').innerText = cust.trips;
      document.getElementById('cd-miles').innerText = cust.miles;
      openDrawer('drawer-customer-details');
    }

    function openBookingCustomerDrawer(customerName) {
      openCustomerDrawerByName(customerName);
    }

    function promptCancel(type, identifier) {
      state.cancellationTarget = { type, identifier };
      document.getElementById('cancel-modal-title').innerText = `Cancel ${type === 'flight' ? 'Flight' : 'Booking'} ${identifier}?`;
      openModal('modal-confirm-cancel');
    }

    function executeCancellation() {
      if (!state.cancellationTarget) return;
      const { type, identifier } = state.cancellationTarget;
      
      if (type === 'flight') {
        const item = state.flights.find(f => f.code === identifier);
        if (item) item.status = 'Cancelled';
        renderAllFlightsTable();
        renderDashboardFlights();
      } else {
        const item = state.bookings.find(b => b.pnr === identifier);
        if (item) item.status = 'Cancelled';
        renderBookingsTable();
        renderDashboardBookings();
      }

      closeModal('modal-confirm-cancel');
      showToast(`${type.toUpperCase()} ${identifier} has been cancelled`, 'error');
    }

    // Forms
    function handleCreateFlight(e) {
      e.preventDefault();
      const code = document.getElementById('mf-flightno').value.trim();
      const aircraftStr = document.getElementById('mf-aircraft').value;
      const origin = document.getElementById('mf-origin').value;
      const dest = document.getElementById('mf-destination').value;
      const dept = document.getElementById('mf-dept-time').value;
      const arr = document.getElementById('mf-arr-time').value;
      const fare = document.getElementById('mf-fare').value;
      const status = document.getElementById('mf-status').value;

      state.flights.unshift({
        code, origin, dest, routeDesc: `${origin} → ${dest}`, dept, deptGate: `${origin} T1 • Gate G04`, arr, arrGate: `${dest} T2 • Gate B02`,
        aircraft: aircraftStr.split('(')[0].trim(), tail: aircraftStr.includes('(') ? aircraftStr.split('(')[1].replace(')', '') : 'A6-NEW', fare, status
      });

      renderAllFlightsTable();
      renderDashboardFlights();
      closeModal('modal-add-flight');
      showToast(`Flight ${code} scheduled and added to sovereign dispatch`, 'success');
      e.target.reset();
    }

    function handleCreateAirport(e) {
      e.preventDefault();
      const iata = document.getElementById('ma-iata').value.trim().toUpperCase();
      const name = document.getElementById('ma-name').value.trim();
      const city = document.getElementById('ma-city').value.trim();
      const country = document.getElementById('ma-country').value.trim();

      state.airports.unshift({ iata, name, city, country, type: 'Regional Flagship', gates: 36, runways: '2 Active' });
      renderAirports();
      closeModal('modal-add-airport');
      showToast(`Airport ${iata} - ${name} added to route network`, 'success');
      e.target.reset();
    }

    // Filtering
    function filterFlightsTable(keyword) {
      const q = keyword.toLowerCase();
      const filtered = state.flights.filter(f => f.code.toLowerCase().includes(q) || f.origin.toLowerCase().includes(q) || f.dest.toLowerCase().includes(q) || f.aircraft.toLowerCase().includes(q));
      renderAllFlightsTable(filtered);
    }

    function setFlightFilter(type) {
      document.querySelectorAll('.flight-filter-pill').forEach(btn => {
        btn.classList.remove('bg-midnight-800', 'text-white');
        btn.classList.add('bg-slate-100', 'text-slate-700');
      });
      event.target.classList.remove('bg-slate-100', 'text-slate-700');
      event.target.classList.add('bg-midnight-800', 'text-white');

      if (type === 'ALL') renderAllFlightsTable(state.flights);
      else if (type === 'IN_FLIGHT') renderAllFlightsTable(state.flights.filter(f => f.status === 'In Flight'));
      else if (type === 'SCHEDULED') renderAllFlightsTable(state.flights.filter(f => f.status === 'Scheduled'));
      else if (type === 'DELAYED') renderAllFlightsTable(state.flights.filter(f => f.status === 'Delayed'));
    }

    function setDashboardFlightFilter(type, btn) {
      document.querySelectorAll('.dash-flight-filter-pill').forEach(el => {
        el.classList.remove('bg-white', 'text-midnight-900', 'font-semibold', 'shadow-2xs');
        el.classList.add('text-slate-500');
      });
      if (btn) {
        btn.classList.remove('text-slate-500');
        btn.classList.add('bg-white', 'text-midnight-900', 'font-semibold', 'shadow-2xs');
      }

      if (type === 'IN_FLIGHT') renderDashboardFlights(state.flights.filter(f => f.status === 'In Flight'));
      else if (type === 'SCHEDULED') renderDashboardFlights(state.flights.filter(f => f.status === 'Scheduled'));
      else if (type === 'DELAYED') renderDashboardFlights(state.flights.filter(f => f.status === 'Delayed'));
      else renderDashboardFlights(state.flights);
    }

    function filterAirports(query) {
      const q = query.toLowerCase();
      const filtered = state.airports.filter(a => a.iata.toLowerCase().includes(q) || a.name.toLowerCase().includes(q) || a.city.toLowerCase().includes(q));
      document.getElementById('airports-grid').innerHTML = filtered.map(a => `
        <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-2xs hover:shadow-sm transition-shadow">
          <div class="flex items-start justify-between">
            <div class="flex items-center space-x-3">
              <span class="text-xl font-extrabold font-mono text-white bg-midnight-900 px-3 py-1.5 rounded-lg">${a.iata}</span>
              <div><h4 class="text-xs font-bold text-midnight-900">${a.name}</h4><p class="text-[11px] text-slate-500">${a.city}, ${a.country}</p></div>
            </div>
            <span class="text-[10px] font-semibold bg-champagne-100 text-champagne-800 px-2 py-0.5 rounded">${a.type}</span>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-600">
            <div><span class="text-[10px] text-slate-400 block uppercase font-semibold">Sovereign Gates</span><span class="font-bold text-midnight-900">${a.gates} Gates</span></div>
            <div class="text-right"><span class="text-[10px] text-slate-400 block uppercase font-semibold">Runway Ops</span><span class="text-emerald-600 font-semibold">${a.runways}</span></div>
          </div>
        </div>
      `).join('');
    }

    function filterBookingsTable(query) {
      const q = query.toLowerCase();
      const filtered = state.bookings.filter(b => b.pnr.toLowerCase().includes(q) || b.customerName.toLowerCase().includes(q) || b.flightCode.toLowerCase().includes(q));
      renderBookingsTable(filtered);
    }

    function filterBookingsByStatus(status) {
      if (status === 'ALL') renderBookingsTable(state.bookings);
      else renderBookingsTable(state.bookings.filter(b => b.status === status));
    }

    function filterCustomerTable(query) {
      const q = query.toLowerCase();
      const filtered = state.customers.filter(c =>
        c.name.toLowerCase().includes(q) ||
        c.email.toLowerCase().includes(q) ||
        c.tier.toLowerCase().includes(q) ||
        (c.role || '').toLowerCase().includes(q)
      );
      const container = document.getElementById('customers-table-body');
      if (container) container.innerHTML = renderCustomerRows(filtered);
    }

    function handleGlobalSearch(term) {
      if (!term) return;
      const q = term.toLowerCase();
      if (q.startsWith('sb') || q.includes('918') || q.includes('501')) {
        switchView('flights');
        filterFlightsTable(term);
      } else if (q.startsWith('sky-')) {
        switchView('bookings');
        filterBookingsTable(term);
      }
    }

    function showToast(message, type = 'info') {
      const container = document.getElementById('toast-container');
      if (!container) return;

      const toast = document.createElement('div');
      const bgColors = { info: 'bg-midnight-900 text-white border-midnight-700', success: 'bg-emerald-800 text-white border-emerald-700', error: 'bg-rose-800 text-white border-rose-700' };

      toast.className = `${bgColors[type] || bgColors.info} border px-4 py-3 rounded-xl shadow-xl text-xs font-semibold flex items-center space-x-2 pointer-events-auto transform transition-all duration-300 translate-y-2 opacity-0`;
      toast.innerHTML = `<span class="w-2 h-2 rounded-full ${type === 'success' ? 'bg-emerald-400' : type === 'error' ? 'bg-rose-400' : 'bg-champagne-400'}"></span><span>${message}</span>`;
      container.appendChild(toast);

      setTimeout(() => toast.classList.remove('translate-y-2', 'opacity-0'), 10);
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    function openAdminProfile() {
      openDrawer('drawer-admin-profile');
    }

    function handleLogout() {
      localStorage.removeItem('skybook-authenticated');
      localStorage.removeItem('skybook-role');
      localStorage.removeItem('skybook-user-name');
      localStorage.removeItem('skybook-user-email');
      localStorage.removeItem('skybook-user-initials');
      window.location.href = 'account.html?mode=login';
    }

    function refreshDashboardData() {
      showToast('Refreshing telemetric feed from live sovereign corridor...', 'info');
      setTimeout(() => showToast('All 142 airborne transponders in sync', 'success'), 800);
    }

    window.addEventListener('DOMContentLoaded', () => {
      // Demo-only gate: mirrors the [Authorize(Roles = "Admin")] check the real
      // MVC controller would enforce server-side on every request to this route.
      const isAuthed = localStorage.getItem('skybook-authenticated') === 'true';
      const role = localStorage.getItem('skybook-role');
      if (!isAuthed || role !== 'admin') {
        window.location.href = 'account.html?mode=login&returnTo=management.html';
        return;
      }

      loadFleetFromStorage();
      saveFleetToStorage(); // seed storage on first run so seats.html has data to read
      renderDashboardBookings();
      renderDashboardFlights();
      renderAllFlightsTable();
      renderAirports();
      renderFleet();
      renderBookingsTable();
      renderCustomers();
      
      const clockEl = document.getElementById('live-utc-clock');
      setInterval(() => { if (clockEl) clockEl.innerText = new Date().toUTCString().split(' ')[4]; }, 1000);

      const toggleBtn = document.getElementById('sidebar-toggle-btn');
      const sidebar = document.getElementById('main-sidebar');

      function applySidebarCollapsed(collapsed) {
        state.sidebarCollapsed = collapsed;
        sidebar.classList.toggle('w-64', !collapsed);
        sidebar.classList.toggle('w-20', collapsed);
        sidebar.classList.toggle('sidebar-collapsed', collapsed);

        document.querySelectorAll('.sidebar-text').forEach(el => {
          el.classList.toggle('hidden', collapsed);
        });

        document.querySelectorAll('#main-sidebar .nav-item').forEach(btn => {
          btn.classList.toggle('justify-center', collapsed);
          btn.classList.toggle('px-2', collapsed);
          btn.classList.toggle('px-3', !collapsed);
          btn.classList.toggle('space-x-3', !collapsed);
        });

        const brandContainer = document.getElementById('brand-container');
        if (brandContainer) {
          brandContainer.classList.toggle('justify-center', collapsed);
          brandContainer.classList.toggle('w-full', collapsed);
        }

        const userCard = document.getElementById('sidebar-user-card');
        if (userCard) {
          userCard.classList.toggle('justify-center', collapsed);
          const logoutBtn = userCard.querySelector('.sidebar-logout-btn');
          if (logoutBtn) logoutBtn.classList.toggle('hidden', collapsed);
        }

        const topRow = sidebar.querySelector('.h-16');
        if (topRow) {
          topRow.classList.toggle('px-2', collapsed);
        }
      }

      toggleBtn.addEventListener('click', () => {
        applySidebarCollapsed(!state.sidebarCollapsed);
      });

      window.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'b') { e.preventDefault(); toggleBtn.click(); }
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); document.getElementById('globalSearchInput').focus(); }
      });
    });
  </script>
}
