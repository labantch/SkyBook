    function switchView(viewKey) {
      state.currentView = viewKey;

      document.querySelectorAll('.nav-item').forEach(btn => {
        const target = btn.getAttribute('data-nav-target');
        if (target === viewKey) {
          btn.className = 'nav-item w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-white bg-midnight-700/80 shadow-sm border border-midnight-600/50 group transition-colors';
          const icon = btn.querySelector('svg');
          if (icon) icon.className = 'w-4 h-4 text-champagne-400 flex-shrink-0';
        } else {
          btn.className = 'nav-item w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-medium text-slate-300 hover:text-white hover:bg-midnight-700/50 group transition-colors';
          const icon = btn.querySelector('svg');
          if (icon) icon.className = 'w-4 h-4 text-slate-400 group-hover:text-champagne-400 flex-shrink-0';
        }
      });

      document.querySelectorAll('.view-container').forEach(panel => panel.classList.remove('active'));
      const activePanel = document.getElementById(`view-${viewKey}`);
      if (activePanel) activePanel.classList.add('active');
    }

    function getStatusBadge(status) {
      if (status === 'In Flight' || status === 'Confirmed') return `<span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/60"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span>${status}</span>`;
      if (status === 'Scheduled' || status === 'Pending') return `<span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200/60"><span class="w-1.5 h-1.5 rounded-full bg-amber-500 mr-1.5"></span>${status}</span>`;
      return `<span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-rose-50 text-rose-700 border border-rose-200/60"><span class="w-1.5 h-1.5 rounded-full bg-rose-500 mr-1.5"></span>${status}</span>`;
    }

    function renderDashboardBookings() {
      const container = document.getElementById('dashboard-bookings-body');
      if (!container) return;
      container.innerHTML = state.bookings.slice(0, 6).map(b => `
        <tr class="hover:bg-slate-50/70 transition-colors">
          <td class="py-3 px-4 font-mono font-bold text-midnight-900">${b.pnr}</td>
