            <div class="flex flex-col items-center px-4 flex-1">
              <span class="text-[10px] font-mono text-champagne-600 font-semibold mb-1">3h 40m nonstop</span>
              <div class="w-full flex items-center">
                <div class="w-2 h-2 rounded-full bg-champagne-500"></div>
                <div class="flex-1 border-t-2 border-dashed border-champagne-400 mx-1"></div>
                <svg class="w-4 h-4 text-midnight-800 transform rotate-90" fill="currentColor" viewBox="0 0 20 20"><path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z"></path></svg>
                <div class="flex-1 border-t-2 border-dashed border-champagne-400 mx-1"></div>
                <div class="w-2 h-2 rounded-full bg-midnight-800"></div>
              </div>
              <span class="text-[10px] text-emerald-600 font-semibold mt-1">Airborne 38,000 ft</span>
            </div>
            <div class="text-right">
              <span class="text-2xl font-extrabold text-midnight-900 block font-mono" id="df-dest-iata">DXB</span>
              <span class="text-[11px] text-slate-500" id="df-dest-city">Dubai Intl</span>
              <span class="text-xs font-bold text-slate-700 mt-1 block font-mono" id="df-arr-time">01:45</span>
              <span class="text-[10px] text-slate-400" id="df-dest-gate">Terminal 3 • Gate B12</span>
            </div>
