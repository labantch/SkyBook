          <td class="py-3 px-4"><span class="font-semibold text-slate-800">${f.aircraft}</span><span class="text-[10px] text-slate-400 block font-mono">${f.tail}</span></td>
          <td class="py-3 px-4 font-mono font-bold text-slate-900">${f.fare}</td>
          <td class="py-3 px-4">${getStatusBadge(f.status)}</td>
