@model List<SkyBook.Business.ViewModels.AirportVM>
@{
    ViewData["Title"] = "Airports";
    Layout = "_AdminLayout";
}

<!-- Top header strip (matches ops console) -->
<header class="h-16 bg-white border-b border-slate-200 px-6 flex items-center justify-between z-20 flex-shrink-0">
  <div>
    <h1 class="text-sm font-bold text-midnight-900">Airports Management</h1>
    <p class="text-[11px] text-slate-500">SkyBook Operations Console • Sovereign Station Network</p>
  </div>
  <a href="@Url.Action("Index", "AdminDashboard", new { area = "Admin" })" class="text-xs font-semibold text-champagne-600 hover:text-champagne-700 hover:underline">← Full Dashboard</a>
</header>

<main class="flex-1 overflow-y-auto p-6 bg-[#F8FAFC]" id="viewport-root">

  @if (TempData["Error"] != null)
  {
      <div class="mb-4 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs flex items-center justify-between shadow-xs">
          <div class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-rose-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
              </svg>
              <span class="font-semibold">@TempData["Error"]</span>
          </div>
          <button type="button" onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-700 font-bold ml-4">✕</button>
      </div>
  }
  @{
    var fallbackImg = "https://images.unsplash.com/photo-1530521954074-e64f6810b32d?auto=format&fit=crop&w=1200&q=80";

    string ResolveAirportImage(string? rawUrl)
    {
        if (string.IsNullOrWhiteSpace(rawUrl)) return fallbackImg;
        if (rawUrl.Contains("google.com/imgres") && rawUrl.Contains("imgurl="))
        {
            try
            {
                var uri = new Uri(rawUrl);
                var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
                var extracted = query["imgurl"];
                if (!string.IsNullOrWhiteSpace(extracted)) return extracted;
            }
            catch {}
        }
        return rawUrl;
    }
}

  <section class="view-container space-y-5 active" data-purpose="airports-management" id="view-airports">
    
    <!-- Header Section (Matching Provided Design) -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-1">
      <div>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Airports</h1>
        <p class="text-sm text-slate-500 mt-0.5 font-normal">Manage and monitor strategic network stations.</p>
      </div>

      <div class="flex items-center gap-3">
        <div class="relative w-64 sm:w-72">
          <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
          </svg>
          <input class="w-full text-xs bg-white rounded-xl pl-9 pr-3 py-2.5 border border-slate-200 focus:outline-none focus:ring-1 focus:ring-slate-400 shadow-2xs transition" 
                 id="airport-search-input" 
                 oninput="filterAirports(this.value)" 
                 placeholder="Search IATA, station name, or city..." 
                 type="text">
        </div>

        <button type="button"
                class="inline-flex items-center space-x-2 px-4 py-2.5 rounded-xl bg-midnight-900 hover:bg-slate-800 text-white text-xs font-semibold transition-all shadow-sm shrink-0"
                onclick="openAddAirportModal()">
            <svg class="w-3.5 h-3.5 text-champagne-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path d="M12 4v16m8-8H4" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path>
            </svg>
            <span>+ Add Airport</span>
        </button>
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- AIRPORT CARDS (HORIZONTAL ROW DESIGN AS REQUESTED)           -->
    <!-- ============================================================ -->
    <div class="flex flex-col space-y-4" id="airports-grid">
      @if (Model != null && Model.Any())
      {
          @foreach (var airport in Model)
          {
              var displayImg = ResolveAirportImage(airport.ImageUrl);

              <!-- SINGLE AIRPORT CARD -->
              <div class="airport-card group bg-white hover:bg-slate-50/40 rounded-[22px] border border-slate-200/90 p-3 sm:p-4 shadow-2xs hover:shadow-md transition-all duration-200 flex flex-col md:flex-row items-stretch gap-4 lg:gap-5"
                   data-code="@airport.Code.ToLower()"
                   data-name="@airport.Name.ToLower()"
                   data-city="@airport.City.ToLower()"
                   data-country="@airport.Country.ToLower()"
                   data-status="@airport.Status.ToString().ToLower()">

                  <!-- Left: Wide Thumbnail Image with IATA Badge -->
                  <div class="relative w-full md:w-52 lg:w-60 h-32 md:h-28 lg:h-32 rounded-2xl overflow-hidden bg-slate-900 shrink-0 border border-slate-200/80 shadow-2xs">
                      <img src="@displayImg"
                           alt="@airport.Name"
                           class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                           onerror="this.onerror=null; this.src='@fallbackImg';" />
                      
                      <!-- Floating IATA Badge at Bottom-Left of Image -->
                      <div class="absolute bottom-2.5 left-2.5 bg-black/65 backdrop-blur-md rounded-xl px-3 py-1.5 border border-white/15 text-center shadow-lg pointer-events-none">
                          <span class="block text-base sm:text-lg font-black font-mono text-white tracking-wider leading-none">@airport.Code</span>
                          <span class="block text-[8px] font-bold text-slate-300 uppercase tracking-widest leading-none mt-1">IATA</span>
                      </div>
                  </div>

                  <!-- Right: Information & Action Controls -->
                  <div class="flex-1 flex flex-col justify-between py-0.5 min-w-0">
                      
                      <!-- Top Row: Name + Dynamic Station Status -->
                      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                          <div class="min-w-0 flex-1">
                              <h3 class="text-base sm:text-lg font-bold text-slate-900 tracking-tight leading-snug truncate" title="@airport.Name">
                                      @airport.Name
                                  </h3>
                              <p class="text-xs text-slate-500 mt-0.5 font-normal">SkyBook Strategic Station Network</p>
                          </div>

                          <!-- Status Badge -->
                          <div class="shrink-0 flex items-center sm:justify-end">
                              @if (airport.Status == AirportStatus.Active)
                              {
                                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 shadow-2xs">
                                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                      Active Station
                                  </span>
                              }
                              else if (airport.Status == AirportStatus.Maintenance)
                              {
                                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200 shadow-2xs">
                                      <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                                      In Maintenance
                                  </span>
                              }
                              else
                              {
                                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200 shadow-2xs">
                                      <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                                      Inactive Station
                                  </span>
                              }
                          </div>
                      </div>

                      <!-- Bottom Row: Location + IATA + Edit/Delete Buttons -->
                      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-4 sm:pt-0 mt-3 sm:mt-0">
                          <!-- Left: Location with pin -->
                          <div class="flex items-center gap-1.5 text-xs text-slate-600 font-normal min-w-0 flex-1">
                              <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                              </svg>
                              <span class="truncate">@airport.City, @airport.Country</span>
                          </div>

                          <!-- Middle: IATA Code -->
                          <div class="shrink-0 flex items-center sm:justify-center sm:w-44">
                              <span class="text-xs font-medium text-slate-500 font-mono tracking-wide">
                                  IATA: @airport.Code
                              </span>
                          </div>

                          <!-- Right: Action Buttons -->
                          <div class="shrink-0 flex items-center gap-2 sm:justify-end sm:w-44">
                              <button type="button"
                                      data-id="@airport.Id"
                                      data-code="@airport.Code"
                                      data-name="@airport.Name"
                                      data-city="@airport.City"
                                      data-country="@airport.Country"
                                      data-image="@(airport.ImageUrl ?? "")"
                                      data-status="@airport.Status"
                                      onclick="handleEditButtonClick(this)"
                                      class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:text-slate-900 bg-white hover:bg-slate-50 rounded-lg border border-slate-200 hover:border-slate-300 transition shadow-2xs">
                                  <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                  </svg>
                                  <span>Edit</span>
                              </button>

                              <button type="button"
                                      data-id="@airport.Id"
                                      data-code="@airport.Code"
                                      data-name="@airport.Name"
                                      onclick="handleDeleteButtonClick(this)"
                                      class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-rose-600 hover:text-rose-700 bg-white hover:bg-rose-50 rounded-lg border border-rose-200/80 hover:border-rose-300 transition shadow-2xs">
                                  <svg class="w-3.5 h-3.5 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                  </svg>
                                  <span>Delete</span>
                              </button>
                          </div>
                      </div>

                  </div>

              </div>
              <!-- /END SINGLE AIRPORT CARD -->
          }
      }
      else
      {
          <!-- Empty State -->
          <div class="py-14 text-center bg-white rounded-2xl border border-slate-200/80 p-8 shadow-xs">
              <div class="w-12 h-12 rounded-2xl bg-midnight-900 text-champagne-400 flex items-center justify-center mx-auto mb-3 border border-champagne-400/30 shadow-md">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
              </div>
              <h4 class="text-sm font-bold text-midnight-900">No Airport Stations Registered</h4>
              <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">Get started by registering your first station to activate sovereign routes.</p>
              <button type="button"
                      onclick="openAddAirportModal()"
                      class="mt-4 inline-flex items-center space-x-2 px-4 py-2 rounded-lg bg-midnight-800 text-white text-xs font-semibold hover:bg-midnight-900 transition shadow-sm">
                  <span>+ Register Airport Station</span>
              </button>
          </div>
      }

      <!-- Search No-Matches State (hidden by default) -->
      <div id="no-search-results" class="py-12 text-center bg-white rounded-xl border border-slate-200 p-6 hidden">
          <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
          </div>
          <h4 class="text-xs font-bold text-midnight-900">No Stations Match Your Search</h4>
          <p class="text-[11px] text-slate-500 mt-0.5">Try searching by IATA code, city, country, or station name.</p>
      </div>

    </div>

    <!-- Pagination Bar -->
    <div id="airports-pagination" class="bg-white rounded-2xl border border-slate-200/90 px-5 py-3 shadow-2xs flex items-center justify-center mt-2">
      <nav id="airport-pagination-nav" class="flex items-center gap-1.5" aria-label="Airports pagination">
        <button type="button" id="airport-prev-btn" onclick="prevAirportPage()" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg border border-slate-200 text-[11px] font-semibold text-slate-600 hover:bg-slate-50 hover:text-slate-900 disabled:opacity-40 disabled:cursor-not-allowed transition shadow-2xs">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          <span>Previous</span>
        </button>
        <div id="airport-page-numbers" class="flex items-center gap-1">
          <!-- Page numbers rendered dynamically -->
        </div>
        <button type="button" id="airport-next-btn" onclick="nextAirportPage()" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg border border-slate-200 text-[11px] font-semibold text-slate-600 hover:bg-slate-50 hover:text-slate-900 disabled:opacity-40 disabled:cursor-not-allowed transition shadow-2xs">
          <span>Next</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </button>
      </nav>
    </div>

  </section>
</main>

@section Scripts {
<script>
    const airportPagination = {
        currentPage: 1,
        pageSize: 6,
        matchingCards: []
    };

    function updateAirportPagination() {
        const total = airportPagination.matchingCards.length;
        const totalPages = Math.ceil(total / airportPagination.pageSize) || 1;
        if (airportPagination.currentPage > totalPages) {
            airportPagination.currentPage = totalPages;
        }
        if (airportPagination.currentPage < 1) {
            airportPagination.currentPage = 1;
        }

        const startIndex = (airportPagination.currentPage - 1) * airportPagination.pageSize;
        const endIndex = startIndex + airportPagination.pageSize;

        // Hide all cards first, then show only matching cards for current page
        const allCards = document.querySelectorAll('.airport-card');
        allCards.forEach(card => card.classList.add('hidden'));

        airportPagination.matchingCards.forEach((card, idx) => {
            if (idx >= startIndex && idx < endIndex) {
                card.classList.remove('hidden');
            }
        });

        // Update info
        const paginationBar = document.getElementById('airports-pagination');
        if (paginationBar) {
            paginationBar.classList.toggle('hidden', total === 0);
        }

        // Prev & Next buttons
        const prevBtn = document.getElementById('airport-prev-btn');
        const nextBtn = document.getElementById('airport-next-btn');
        if (prevBtn) prevBtn.disabled = (airportPagination.currentPage <= 1);
        if (nextBtn) nextBtn.disabled = (airportPagination.currentPage >= totalPages);

        // Render page numbers
        renderAirportPageNumbers(totalPages, airportPagination.currentPage);
    }

    function renderAirportPageNumbers(totalPages, current) {
        const container = document.getElementById('airport-page-numbers');
        if (!container) return;
        container.innerHTML = '';

        if (totalPages <= 1) return;

        const pages = [];
        if (totalPages <= 7) {
            for (let i = 1; i <= totalPages; i++) pages.push(i);
        } else {
            pages.push(1);
            if (current > 3) pages.push('...');
            const start = Math.max(2, current - 1);
            const end = Math.min(totalPages - 1, current + 1);
            for (let i = start; i <= end; i++) {
                if (!pages.includes(i)) pages.push(i);
            }
            if (current < totalPages - 2) pages.push('...');
            if (!pages.includes(totalPages)) pages.push(totalPages);
        }

        pages.forEach(p => {
            if (p === '...') {
                const span = document.createElement('span');
                span.className = 'px-2 py-1 text-slate-400 text-xs font-mono select-none';
                span.textContent = '...';
                container.appendChild(span);
            } else {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.textContent = p;
                if (p === current) {
                    btn.className = 'w-7 h-7 rounded-lg bg-midnight-900 text-white font-bold text-[11px] shadow-xs border border-midnight-950 flex items-center justify-center';
                } else {
                    btn.className = 'w-7 h-7 rounded-lg bg-white hover:bg-slate-100 text-slate-700 font-semibold text-[11px] border border-slate-200 hover:border-slate-300 transition flex items-center justify-center';
                    btn.onclick = () => goToAirportPage(p);
                }
                container.appendChild(btn);
            }
        });
    }

    function goToAirportPage(page) {
        airportPagination.currentPage = page;
        updateAirportPagination();
        scrollToTopAirports();
    }

    function prevAirportPage() {
        if (airportPagination.currentPage > 1) {
            airportPagination.currentPage--;
            updateAirportPagination();
            scrollToTopAirports();
        }
    }

    function nextAirportPage() {
        const totalPages = Math.ceil(airportPagination.matchingCards.length / airportPagination.pageSize) || 1;
        if (airportPagination.currentPage < totalPages) {
            airportPagination.currentPage++;
            updateAirportPagination();
            scrollToTopAirports();
        }
    }

    function scrollToTopAirports() {
        const grid = document.getElementById('airports-grid');
        if (grid) {
            grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }

    function getAirportPageFromUrl() {
        const page = Number(new URLSearchParams(window.location.search).get('page') || '1');
        return Number.isFinite(page) && page > 0 ? page : 1;
    }

    function syncAirportReturnPage(formId) {
        const field = document.getElementById(formId + '-return-page');
        if (field) {
            field.value = airportPagination.currentPage;
        }
    }

    // Live Search Filter across Code, Name, City, Country
    function filterAirports(query) {
        const q = (query || '').toLowerCase().trim();
        const cards = Array.from(document.querySelectorAll('.airport-card'));
        const noResults = document.getElementById('no-search-results');

        airportPagination.matchingCards = cards.filter(card => {
            const code = card.getAttribute('data-code') || '';
            const name = card.getAttribute('data-name') || '';
            const city = card.getAttribute('data-city') || '';
            const country = card.getAttribute('data-country') || '';
            const status = card.getAttribute('data-status') || '';
            return !q || code.includes(q) || name.includes(q) || city.includes(q) || country.includes(q) || status.includes(q);
        });

        if (noResults) {
            noResults.classList.toggle('hidden', airportPagination.matchingCards.length > 0 || cards.length === 0);
        }

        if (q) {
            airportPagination.currentPage = 1;
        } else {
            airportPagination.currentPage = getAirportPageFromUrl();
        }

        updateAirportPagination();
    }

    function handleEditButtonClick(btn) {
        const id = btn.getAttribute('data-id');
        const code = btn.getAttribute('data-code');
        const name = btn.getAttribute('data-name');
        const city = btn.getAttribute('data-city');
        const country = btn.getAttribute('data-country');
        const image = btn.getAttribute('data-image');
        const status = btn.getAttribute('data-status');
        openEditAirportModal(id, code, name, city, country, image, status);
    }

    function handleDeleteButtonClick(btn) {
        const id = btn.getAttribute('data-id');
        const code = btn.getAttribute('data-code');
        const name = btn.getAttribute('data-name');
        openDeleteAirportModal(id, code, name);
    }

    window.addEventListener('DOMContentLoaded', () => {
        const isAuthed = localStorage.getItem('skybook-authenticated') === 'true';
        const role = localStorage.getItem('skybook-role');
        if (!isAuthed || role !== 'admin') {
            window.location.href = '/Account/Login?returnTo=/Admin/Airport';
            return;
        }

        airportPagination.currentPage = getAirportPageFromUrl();

        const searchInput = document.getElementById('airport-search-input');
        filterAirports(searchInput ? searchInput.value : '');
    });
</script>
}
