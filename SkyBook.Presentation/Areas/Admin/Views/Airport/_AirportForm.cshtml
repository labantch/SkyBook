@* Add / edit airport modal *@
<div class="fixed inset-0 z-50 flex items-center justify-center hidden" data-purpose="modal-airport-form" id="modal-add-airport">
  <div class="absolute inset-0 bg-midnight-900/60 backdrop-blur-xs" onclick="closeModal('modal-add-airport')"></div>
  <div class="relative bg-white rounded-xl shadow-2xl max-w-md w-full mx-4 overflow-hidden border border-slate-200 z-10 animate-scale">
    <div class="h-14 bg-midnight-800 px-6 flex items-center justify-between text-white">
      <h3 class="text-sm font-bold flex items-center gap-2">
        <svg class="w-4 h-4 text-champagne-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
        Register New Airport Station
      </h3>
      <button class="text-slate-400 hover:text-white" onclick="closeModal('modal-add-airport')">✕</button>
    </div>
    <form class="p-6 space-y-4 text-xs" onsubmit="handleCreateAirport(event)" method="post">
      <div>
        <label class="block font-semibold text-slate-700 mb-1">Airport Code (up to 10 chars, e.g. IATA/ICAO)</label>
        <input class="w-full text-xs font-mono uppercase rounded-lg border-slate-200 bg-slate-50" id="ma-iata" maxlength="10" placeholder="e.g. SIN" required type="text">
      </div>
      <div>
        <label class="block font-semibold text-slate-700 mb-1">Airport Name</label>
        <input class="w-full text-xs rounded-lg border-slate-200 bg-slate-50" id="ma-name" maxlength="100" placeholder="e.g. Singapore Changi Airport" required type="text">
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">City</label>
          <input class="w-full text-xs rounded-lg border-slate-200 bg-slate-50" id="ma-city" maxlength="100" placeholder="Singapore" required type="text">
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Country</label>
          <input class="w-full text-xs rounded-lg border-slate-200 bg-slate-50" id="ma-country" maxlength="100" placeholder="Singapore" required type="text">
        </div>
      </div>
      <div>
        <label class="block font-semibold text-slate-700 mb-1">Airport Image URL <span class="font-normal text-slate-400">(optional)</span></label>
        <input class="w-full text-xs rounded-lg border-slate-200 bg-slate-50" id="ma-image-url" maxlength="500" placeholder="https://images.example.com/airport.jpg" type="url">
      </div>
      <div class="pt-4 border-t border-slate-100 flex items-center justify-end space-x-2">
        <button class="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-lg" onclick="closeModal('modal-add-airport')" type="button">Cancel</button>
        <button class="px-4 py-2 bg-midnight-800 text-white font-semibold rounded-lg hover:bg-midnight-900 shadow-sm" type="submit">Save Station</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit Airport Modal -->
<div class="fixed inset-0 z-50 flex items-center justify-center hidden" data-purpose="modal-airport-edit-form" id="modal-edit-airport">
  <div class="absolute inset-0 bg-midnight-900/60 backdrop-blur-xs" onclick="closeModal('modal-edit-airport')"></div>
  <div class="relative bg-white rounded-xl shadow-2xl max-w-md w-full mx-4 overflow-hidden border border-slate-200 z-10 animate-scale">
    <div class="h-14 bg-midnight-800 px-6 flex items-center justify-between text-white">
      <h3 class="text-sm font-bold flex items-center gap-2">
        <svg class="w-4 h-4 text-champagne-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
        Edit Airport Station
      </h3>
      <button class="text-slate-400 hover:text-white" onclick="closeModal('modal-edit-airport')">✕</button>
    </div>
    <form class="p-6 space-y-4 text-xs" onsubmit="handleEditAirport(event)" method="post">
      <input type="hidden" id="ea-original-iata">
      <div>
        <label class="block font-semibold text-slate-700 mb-1">Airport Code (up to 10 chars, e.g. IATA/ICAO)</label>
        <input class="w-full text-xs font-mono uppercase rounded-lg border-slate-200 bg-slate-50" id="ea-iata" maxlength="10" required type="text">
      </div>
      <div>
        <label class="block font-semibold text-slate-700 mb-1">Airport Name</label>
        <input class="w-full text-xs rounded-lg border-slate-200 bg-slate-50" id="ea-name" maxlength="100" required type="text">
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">City</label>
          <input class="w-full text-xs rounded-lg border-slate-200 bg-slate-50" id="ea-city" maxlength="100" required type="text">
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Country</label>
          <input class="w-full text-xs rounded-lg border-slate-200 bg-slate-50" id="ea-country" maxlength="100" required type="text">
        </div>
      </div>
      <div>
        <label class="block font-semibold text-slate-700 mb-1">Airport Image URL <span class="font-normal text-slate-400">(optional)</span></label>
        <input class="w-full text-xs rounded-lg border-slate-200 bg-slate-50" id="ea-image-url" maxlength="500" placeholder="https://images.example.com/airport.jpg" type="url">
      </div>
      <div class="pt-4 border-t border-slate-100 flex items-center justify-end space-x-2">
        <button class="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-lg" onclick="closeModal('modal-edit-airport')" type="button">Cancel</button>
        <button class="px-4 py-2 bg-midnight-800 text-white font-semibold rounded-lg hover:bg-midnight-900 shadow-sm" type="submit">Update Station</button>
      </div>
    </form>
  </div>
</div>
