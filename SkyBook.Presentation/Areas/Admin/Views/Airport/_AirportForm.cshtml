@* Delete Airport Confirmation Modal *@
<div class="fixed inset-0 z-50 flex items-center justify-center hidden"
     data-purpose="modal-airport-delete-confirm"
     id="modal-delete-airport">

    <div class="absolute inset-0 bg-midnight-900/60 backdrop-blur-xs"
         onclick="closeModal('modal-delete-airport')"></div>

    <div class="relative bg-white rounded-2xl shadow-2xl max-w-sm w-full mx-4 overflow-hidden border border-slate-200 z-10 animate-scale p-6 text-center">
        
        <div class="w-12 h-12 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
        </div>

        <h3 class="text-base font-bold text-midnight-900 mb-1">Decommission Airport Station?</h3>
        <p class="text-xs text-slate-500 mb-2">Are you sure you want to delete this station from the route network?</p>
        
        <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-200 mb-5">
            <span id="da-airport-name" class="font-bold text-midnight-900 font-mono text-xs"></span>
        </div>

        <form id="delete-airport-form"
              action="/Admin/Airport/Delete"
              method="post"
              class="flex items-center gap-2">
            @Html.AntiForgeryToken()
            <input type="hidden" id="delete-return-page" name="returnPage" value="1" />
            <input type="hidden" id="da-id" name="id" />

            <button type="button"
                    class="flex-1 px-4 py-2.5 rounded-lg border border-slate-200 text-slate-700 text-xs font-semibold hover:bg-slate-100 transition"
                    onclick="closeModal('modal-delete-airport')">
                Cancel
            </button>

            <button type="submit"
                    class="flex-1 px-4 py-2.5 rounded-lg bg-rose-600 text-white text-xs font-semibold hover:bg-rose-700 transition shadow-sm">
                Yes, Delete
            </button>
        </form>

    </div>
</div>


<script>
    function updateAirportModalPreview(type) {
        const input = document.getElementById(type === 'add' ? 'ma-image-url' : 'ea-image-url');
        const img = document.getElementById(type === 'add' ? 'add-preview-img' : 'edit-preview-img');
        const placeholder = document.getElementById(type === 'add' ? 'add-preview-placeholder' : 'edit-preview-placeholder');
        if (!input || !img || !placeholder) return;

        const val = input.value.trim();
        if (val) {
            img.src = val;
            img.classList.remove('hidden');
            placeholder.classList.add('hidden');
        } else {
            img.src = '';
            img.classList.add('hidden');
            placeholder.classList.remove('hidden');
        }
    }

    function handlePreviewError(type) {
        const img = document.getElementById(type === 'add' ? 'add-preview-img' : 'edit-preview-img');
        const placeholder = document.getElementById(type === 'add' ? 'add-preview-placeholder' : 'edit-preview-placeholder');
        if (img && placeholder) {
            img.classList.add('hidden');
            placeholder.classList.remove('hidden');
            placeholder.innerHTML = `
                <svg class="w-7 h-7 mx-auto mb-1 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                <span class="text-[11px] text-rose-500 font-semibold">Image failed to load. Check URL.</span>
            `;
        }
    }

    function openAddAirportModal() {
        const form = document.getElementById('add-airport-form');
        if (form) form.reset();
        syncAirportReturnPage('add');
        updateAirportModalPreview('add');
        openModal('modal-add-airport');
    }

    function openEditAirportModal(id, code, name, city, country, imageUrl, status) {
        syncAirportReturnPage('edit');
        const idInput = document.getElementById('ea-id');
        const iataInput = document.getElementById('ea-iata');
        const nameInput = document.getElementById('ea-name');
        const cityInput = document.getElementById('ea-city');
        const countryInput = document.getElementById('ea-country');
        const imgInput = document.getElementById('ea-image-url');
        const statusInput = document.getElementById('ea-status');

        if (idInput) idInput.value = id || '';
        if (iataInput) iataInput.value = code || '';
        if (nameInput) nameInput.value = name || '';
        if (cityInput) cityInput.value = city || '';
        if (countryInput) countryInput.value = country || '';
        if (imgInput) imgInput.value = imageUrl || '';
        if (statusInput && status !== null && status !== undefined && status !== '') {
            statusInput.value = status;
        }

        updateAirportModalPreview('edit');
        openModal('modal-edit-airport');
    }

    function openDeleteAirportModal(id, code, name) {
        syncAirportReturnPage('delete');
        const idInput = document.getElementById('da-id');
        const nameEl = document.getElementById('da-airport-name');
        if (idInput) idInput.value = id || '';
        if (nameEl) nameEl.textContent = `${code} • ${name}`;
        openModal('modal-delete-airport');
    }

    function openModal(id) {
        const el = document.getElementById(id);
        if (el) el.classList.remove('hidden');
    }

    function closeModal(id) {
        const el = document.getElementById(id);
        if (el) el.classList.add('hidden');
    }
</script>
