@model SkyBook.Business.ViewModels.AirportVM
<div class="fixed inset-0 z-50 flex items-center justify-center hidden"
     data-purpose="modal-airport-form"
     id="modal-add-airport">

    <div class="absolute inset-0 bg-midnight-900/60 backdrop-blur-xs"
         onclick="closeModal('modal-add-airport')"></div>

    <div class="relative bg-white rounded-2xl shadow-2xl max-w-lg w-full mx-4 overflow-hidden border border-slate-200 z-10 animate-scale">

        <div class="h-14 bg-midnight-800 px-6 flex items-center justify-between text-white flex-shrink-0">
            <h3 class="text-sm font-bold flex items-center gap-2">
                <svg class="w-4 h-4 text-champagne-400"
                     fill="none"
                     stroke="currentColor"
                     viewBox="0 0 24 24">
                    <path d="M12 4v16m8-8H4"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2">
                    </path>
                </svg>
                Register New Airport Station
            </h3>

            <button type="button"
                    class="text-slate-400 hover:text-white transition-colors"
                    onclick="closeModal('modal-add-airport')">
                ✕
            </button>
        </div>

        <form id="add-airport-form"
              action="/Admin/Airport/Add"
              method="post"
              class="p-6 space-y-4 text-xs max-h-[82vh] overflow-y-auto">
            @Html.AntiForgeryToken()
            <input type="hidden" id="add-return-page" name="returnPage" value="1" />

            <div class="grid grid-cols-3 gap-3">
                <div class="col-span-1">
                    <label class="block font-semibold text-slate-700 mb-1">
                        IATA / Code <span class="text-rose-500">*</span>
                    </label>
                    <input id="ma-iata"
                           name="Code"
                           class="w-full text-xs font-mono uppercase rounded-lg border-slate-200 bg-slate-50 focus:border-champagne-500 focus:ring-1 focus:ring-champagne-500"
                           maxlength="10"
                           placeholder="e.g. SIN"
                           required />
                </div>

                <div class="col-span-2">
                    <label class="block font-semibold text-slate-700 mb-1">
                        Airport Name <span class="text-rose-500">*</span>
                    </label>
                    <input id="ma-name"
                           name="Name"
                           class="w-full text-xs rounded-lg border-slate-200 bg-slate-50 focus:border-champagne-500 focus:ring-1 focus:ring-champagne-500"
                           maxlength="100"
                           placeholder="e.g. Singapore Changi Airport"
                           required />
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block font-semibold text-slate-700 mb-1">
                        City <span class="text-rose-500">*</span>
                    </label>
                    <input id="ma-city"
                           name="City"
                           class="w-full text-xs rounded-lg border-slate-200 bg-slate-50 focus:border-champagne-500 focus:ring-1 focus:ring-champagne-500"
                           maxlength="100"
                           placeholder="Singapore"
                           required />
                </div>

                <div>
                    <label class="block font-semibold text-slate-700 mb-1">
                        Country <span class="text-rose-500">*</span>
                    </label>
                    <input id="ma-country"
                           name="Country"
                           class="w-full text-xs rounded-lg border-slate-200 bg-slate-50 focus:border-champagne-500 focus:ring-1 focus:ring-champagne-500"
                           maxlength="100"
                           placeholder="Singapore"
                           required />
                </div>
            </div>

            <!-- Station Operational Status -->
            <div>
                <label class="block font-semibold text-slate-700 mb-1">
                    Station Operational Status <span class="text-rose-500">*</span>
                </label>
                <select id="ma-status"
                        name="Status"
                        class="w-full text-xs rounded-lg border-slate-200 bg-slate-50 focus:border-champagne-500 focus:ring-1 focus:ring-champagne-500"
                        required>
                    <option value="@AirportStatus.Active" selected>Active Station (Operational)</option>
                    <option value="@AirportStatus.Maintenance">In Maintenance (Restricted)</option>
                    <option value="@AirportStatus.Inactive">Inactive Station (Closed)</option>
                </select>
            </div>

            <div>
                <div class="flex items-center justify-between mb-1">
                    <label class="block font-semibold text-slate-700">
                        Airport Hero Image URL
                    </label>
                    <span class="text-[10px] text-slate-400">Card showcase photo URL</span>
                </div>
                <input id="ma-image-url"
                       name="ImageUrl"
                       class="w-full text-xs rounded-lg border-slate-200 bg-slate-50 focus:border-champagne-500 focus:ring-1 focus:ring-champagne-500"
                       maxlength="500"
                       placeholder="https://images.unsplash.com/..."
                       type="url"
                       oninput="updateAirportModalPreview('add')" />
            </div>

            <!-- Live Image Preview Card -->
            <div>
                <label class="block font-semibold text-slate-700 mb-1">Live Card Preview</label>
                <div id="add-preview-container" class="relative h-32 w-full rounded-xl overflow-hidden border border-slate-200 bg-slate-100 flex items-center justify-center">
                    <img id="add-preview-img" src="" alt="Preview" class="w-full h-full object-cover hidden" onerror="handlePreviewError('add')">
                    <div id="add-preview-placeholder" class="text-center p-4 text-slate-400">
                        <svg class="w-7 h-7 mx-auto mb-1 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                        <span class="text-[11px]">Enter an image URL above to preview</span>
                    </div>
                </div>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-end space-x-2">
                <button type="button"
                        class="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-lg transition"
                        onclick="closeModal('modal-add-airport')">
                    Cancel
                </button>

                <button type="submit"
                        class="px-4 py-2 bg-midnight-800 text-white font-semibold rounded-lg hover:bg-midnight-900 shadow-sm transition">
                    Save Station
                </button>
            </div>

        </form>

    </div>
</div>


