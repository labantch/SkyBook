@{
    ViewData["Title"] = "Error";
    Layout = "_Layout";
}
<div class="max-w-xl mx-auto px-6 py-24 text-center">
    <div class="w-16 h-16 mx-auto rounded-full bg-rose-50 text-rose-600 flex items-center justify-center mb-6 border border-rose-100">
        <span class="material-symbols-outlined text-3xl">error</span>
    </div>
    <h1 class="text-2xl font-extrabold text-[#0B192C] tracking-tight">Something went wrong</h1>
    <p class="mt-3 text-slate-500 text-sm leading-relaxed">
        An unexpected error occurred while processing your request. Please try again or contact the SkyBook concierge desk.
    </p>
    @if (ViewData["RequestId"] != null)
    {
        <p class="mt-4 text-xs text-slate-400 font-mono">Request ID: @ViewData["RequestId"]</p>
    }
    <a href="@@Url.Action("Index", "Home")" class="inline-flex items-center gap-2 mt-8 px-6 py-3 rounded-lg bg-[#0B192C] text-white text-sm font-semibold hover:bg-[#162840] transition">
        Return to Home
        <span class="material-symbols-outlined text-base">arrow_forward</span>
    </a>
</div>
