@using Microsoft.AspNetCore.Identity
@using SkyBook.Data.Models
@inject UserManager<ApplicationUser> UserManager

@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    bool isUserAdmin = false;
    string displayName = "";
    string userEmail = "";
    string userInitials = "SB";
    string userRole = "user";
    string userImage = "";

    if (isAuthenticated)
    {
        var appUser = await UserManager.GetUserAsync(User);
        displayName = appUser?.FullName;
        if (string.IsNullOrWhiteSpace(displayName))
        {
            displayName = appUser?.UserName ?? User.Identity?.Name ?? "User";
        }
        userEmail = appUser?.Email ?? User.Identity?.Name ?? "";
        isUserAdmin = User.IsInRole("Admin") || (appUser != null && await UserManager.IsInRoleAsync(appUser, "Admin"));
        userRole = isUserAdmin ? "admin" : "user";
        userImage = appUser?.ImageUrl ?? "";

        var parts = displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length > 1)
        {
            userInitials = $"{parts[0][0]}{parts[1][0]}".ToUpper();
        }
        else if (parts.Length == 1 && parts[0].Length > 0)
        {
            userInitials = parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SkyBook Luxury Airways</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@300;400;500;600;700;800&family=Space+Grotesk:wght@@500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link rel="stylesheet" href="~/css/skybook-global.css" />
    <link rel="stylesheet" href="~/css/site-mobile.css" />
    @await RenderSectionAsync("Styles", required: false)
    @RenderSection("HeadScripts", required: false)
</head>
<body class="bg-surface font-body-md text-on-surface antialiased min-h-screen flex flex-col"
      data-authenticated="@(isAuthenticated ? "true" : "false")"
      data-user-name="@displayName"
      data-user-email="@userEmail"
      data-user-role="@userRole"
      data-user-initials="@userInitials"
      data-user-image="@userImage">
    <!-- Global header is injected by skybook-global.js; keep a noscript fallback -->
    <noscript>
        <header class="border-b border-slate-200 bg-white">
            <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
                <a href="@@Url.Action("Index", "Home")" class="font-bold text-[#0B192C]">SkyBook</a>
                <nav class="flex gap-4 text-sm">
                    <a href="@Url.Action("Index", "Home")">Flights</a>
                    <a href="@Url.Action("MyBookings", "Booking")">My Bookings</a>
                    <a href="@Url.Action("About", "Home")">About</a>
                </nav>
            </div>
        </header>
    </noscript>

    @if (ViewData["ShowBookingProgress"] as bool? == true)
    {
        @await Html.PartialAsync("_BookingProgressBar")
    }

    <main class="flex-grow w-full">
        @RenderBody()
    </main>

    <footer class="w-full bg-[#0B192C] text-white mt-auto">
        <div class="max-w-7xl mx-auto px-6 lg:px-12 py-10">
            <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-slate-400">
                <p>© @DateTime.UtcNow.Year SkyBook Luxury Airways. All rights reserved.</p>
                <div class="flex gap-6">
                    <a class="hover:text-white transition" href="#">Conditions of Carriage</a>
                    <a class="hover:text-white transition" href="#">Privacy Policy</a>
                    <a class="hover:text-white transition" href="#">Security</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/js/skybook-global.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
