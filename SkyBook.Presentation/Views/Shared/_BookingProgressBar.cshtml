@{
    var step = (ViewData["BookingStep"] as int?) ?? 0;
    var steps = new[]
    {
        ("Flights", Url.Action("Results", "Flight") ?? "#"),
        ("Seats", Url.Action("SelectSeats", "Booking") ?? "#"),
        ("Passenger Details", Url.Action("Details", "Passenger") ?? "#"),
        ("Confirm & Pay", Url.Action("ConfirmPayment", "Booking") ?? "#")
    };
}
@* <nav id="skybook-booking-progress" class="bg-[#F8F9FA] border-b border-slate-200" aria-label="Booking progress">
    <div class="skybook-progress-inner max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-center gap-2 sm:gap-3 min-h-[54px] overflow-x-auto">
        @for (var i = 0; i < steps.Length; i++)
        {
            if (i > 0)
            {
                <span class="text-slate-300 font-light text-sm select-none" aria-hidden="true">›</span>
            }
            var isCurrent = i + 1 == step;
            var cls = isCurrent
                ? "flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#FFF8E7] border border-[#C5A880]/50 text-[#0B192C] font-bold text-xs tracking-wider"
                : "flex items-center gap-1.5 text-slate-400 font-semibold text-xs tracking-wider";
            var numCls = isCurrent
                ? "w-5 h-5 rounded-full bg-[#0B192C] text-white text-[11px] font-extrabold flex items-center justify-center"
                : "w-5 h-5 rounded-full bg-slate-100 text-slate-500 text-[11px] font-bold flex items-center justify-center";
            <a class="@cls" href="@@steps[i].Item2">
                <span class="@numCls">@(i + 1)</span>
                <span class="hidden sm:inline">@steps[i].Item1.ToUpperInvariant()</span>
            </a>
        }
    </div>
</nav> *@
