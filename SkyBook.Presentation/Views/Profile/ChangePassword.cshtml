@model SkyBook.Business.ViewModels.ChangePasswordVM
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Change Password";
    Layout = "_Layout";
}

<div class="min-h-[calc(100vh-5rem)] bg-[#F8F9FA] py-10 px-4 sm:px-6 lg:px-8">
  <div class="max-w-xl mx-auto space-y-6">

    <!-- BREADCRUMB / BACK LINK -->
    <div class="flex items-center justify-between">
      <a href="@Url.Action("Index", "Profile")" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-[#0B192C] transition">
        <span class="material-symbols-outlined text-sm">arrow_back</span>
        <span>Back to Profile</span>
      </a>
      <span class="text-xs text-slate-400">Security Center</span>
    </div>

    <!-- MAIN CARD -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-6 sm:p-10 space-y-8">
      
      <!-- HEADER -->
      <div class="border-b border-slate-100 pb-6">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-[#0B192C] text-[#C5A880] flex items-center justify-center flex-shrink-0 shadow-sm">
            <span class="material-symbols-outlined text-2xl">lock_reset</span>
          </div>
          <div>
            <h1 class="text-xl sm:text-2xl font-bold text-[#0B192C]">Update Password</h1>
            <p class="text-xs text-slate-500 mt-0.5">Secure your SkyBook account with a new password.</p>
          </div>
        </div>
      </div>

      <!-- VALIDATION ERRORS -->
      @if (!ViewData.ModelState.IsValid)
      {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs space-y-1" role="alert">
          <p class="font-bold flex items-center gap-1.5">
            <span class="material-symbols-outlined text-base text-rose-600">error</span>
            <span>Password Update Failed:</span>
          </p>
          <ul class="list-disc list-inside pl-5 space-y-0.5 text-rose-700">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
              <li>@error.ErrorMessage</li>
            }
          </ul>
        </div>
      }

      <form action="@Url.Action("ChangePassword", "Profile")" method="post" id="change-pwd-form" class="space-y-6">
        @Html.AntiForgeryToken()

        <!-- Current Password -->
        <div class="space-y-1.5">
          <label for="input-curr" class="text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-1">
            <span>Current Password</span>
            <span class="text-rose-500">*</span>
          </label>
          <div class="relative flex items-center">
            <span class="material-symbols-outlined absolute left-3.5 text-slate-400 text-lg pointer-events-none">vpn_key</span>
            <input name="CurrentPassword" type="password" id="input-curr" required
                   placeholder="••••••••••••"
                   class="w-full pl-10 pr-12 py-3 rounded-xl border border-slate-300 focus:border-[#0B192C] focus:ring-2 focus:ring-[#0B192C]/10 text-sm font-medium text-[#0B192C] bg-white transition" />
            <button type="button" onclick="togglePasswordVisibility('input-curr', this)" class="absolute right-3.5 text-slate-400 hover:text-slate-600">
              <span class="material-symbols-outlined text-lg">visibility</span>
            </button>
          </div>
        </div>

        <!-- New Password -->
        <div class="space-y-1.5">
          <label for="input-new" class="text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-1">
            <span>New Password (min. 8 characters)</span>
            <span class="text-rose-500">*</span>
          </label>
          <div class="relative flex items-center">
            <span class="material-symbols-outlined absolute left-3.5 text-slate-400 text-lg pointer-events-none">lock</span>
            <input name="NewPassword" type="password" id="input-new" required minlength="8"
                   placeholder="••••••••••••"
                   class="w-full pl-10 pr-12 py-3 rounded-xl border border-slate-300 focus:border-[#0B192C] focus:ring-2 focus:ring-[#0B192C]/10 text-sm font-medium text-[#0B192C] bg-white transition" />
            <button type="button" onclick="togglePasswordVisibility('input-new', this)" class="absolute right-3.5 text-slate-400 hover:text-slate-600">
              <span class="material-symbols-outlined text-lg">visibility</span>
            </button>
          </div>
        </div>

        <!-- Confirm Password -->
        <div class="space-y-1.5">
          <label for="input-confirm" class="text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-1">
            <span>Confirm New Password</span>
            <span class="text-rose-500">*</span>
          </label>
          <div class="relative flex items-center">
            <span class="material-symbols-outlined absolute left-3.5 text-slate-400 text-lg pointer-events-none">lock_reset</span>
            <input name="ConfirmPassword" type="password" id="input-confirm" required
                   placeholder="••••••••••••"
                   class="w-full pl-10 pr-12 py-3 rounded-xl border border-slate-300 focus:border-[#0B192C] focus:ring-2 focus:ring-[#0B192C]/10 text-sm font-medium text-[#0B192C] bg-white transition" />
            <button type="button" onclick="togglePasswordVisibility('input-confirm', this)" class="absolute right-3.5 text-slate-400 hover:text-slate-600">
              <span class="material-symbols-outlined text-lg">visibility</span>
            </button>
          </div>
        </div>

        <!-- BUTTONS -->
        <div class="pt-4 flex flex-col-reverse sm:flex-row items-center justify-end gap-3 border-t border-slate-100">
          <a href="@Url.Action("Index", "Profile")"
             class="w-full sm:w-auto px-6 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-semibold text-center transition">
            Cancel
          </a>
          <button type="submit" id="submit-pwd-btn"
                  class="w-full sm:w-auto px-7 py-3 rounded-xl bg-[#0B192C] hover:bg-[#162840] text-white text-sm font-bold shadow-md hover:shadow-lg transition-all duration-200 flex items-center justify-center gap-2">
            <span class="material-symbols-outlined text-[18px]">verified_user</span>
            <span>Update Password</span>
          </button>
        </div>
      </form>

    </div>
  </div>
</div>

@section Scripts {
<script>
  function togglePasswordVisibility(inputId, btn) {
    const input = document.getElementById(inputId);
    const icon = btn.querySelector('.material-symbols-outlined');
    if (input.type === 'password') {
      input.type = 'text';
      icon.textContent = 'visibility_off';
    } else {
      input.type = 'password';
      icon.textContent = 'visibility';
    }
  }

  document.getElementById('change-pwd-form')?.addEventListener('submit', function () {
    const btn = document.getElementById('submit-pwd-btn');
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[18px]">progress_activity</span><span>Updating Password…</span>';
    }
  });
</script>
}
