@{
    ViewData["Title"] = "Profile";
    Layout = "_Layout";
}

@removeTagHelper "Microsoft.AspNetCore.Mvc.TagHelpers.FormTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers"
@removeTagHelper "Microsoft.AspNetCore.Mvc.TagHelpers.InputTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers"
@section Styles {
<style>@@layer base { html, body { margin: 0; padding: 0; } body { overscroll-behavior: none; } main > :first-child { margin-top: 0 !important; } main > :last-child { margin-bottom: 0 !important; } } ::-webkit-scrollbar { display: none; }</style>
}

<div class="flex flex-col w-full">
<div class="max-w-6xl mx-auto w-full py-10 px-gutter flex flex-col gap-space-lg">
<!-- TOP PROFILE HERO BANNER -->
<div class="w-full bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-space-lg relative overflow-hidden">
<div class="absolute top-0 right-0 w-80 h-full bg-gradient-to-l from-secondary-container/10 via-transparent to-transparent pointer-events-none"></div>
<div class="flex items-center gap-space-lg z-10">
<!-- Avatar Ring with initials -->
<div class="relative flex-shrink-0">
<div class="w-20 h-20 rounded-full bg-primary-container text-on-primary flex items-center justify-center font-headline-md text-headline-md shadow-md">
            JM
          </div>
<span class="absolute bottom-1 right-1 w-4 h-4 bg-emerald-600 rounded-full ring-2 ring-surface-container-lowest" title="Active &amp; Verified"></span>
</div>
<!-- Identity Credentials -->
<div class="flex flex-col gap-space-xs">
<div class="flex flex-wrap items-center gap-space-sm">
<h1 class="font-headline-md text-headline-md text-on-surface tracking-tight">John Mohamed</h1>
<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-surface-container text-secondary font-label-caps text-label-caps">
<span class="material-symbols-outlined text-[14px]">verified</span>
              Verified
            </span>
</div>
<div class="flex flex-wrap items-center gap-space-sm text-body-sm font-body-sm text-on-surface-variant">
<span>john.mohamed@@sovereign-sky.com</span>
<span class="inline-block w-1 h-1 rounded-full bg-outline-variant"></span>
<span class="font-label-caps text-label-caps tracking-wider text-on-surface-variant">#SK-8829104</span>
</div>
</div>
</div>
<!-- Quick Action CTA -->
<div class="z-10 self-stretch md:self-center flex items-center justify-end">
<div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 w-full md:w-auto">
<button class="w-full md:w-auto px-space-lg py-2.5 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-body-md text-body-md font-semibold transition-all duration-200 flex items-center justify-center gap-space-xs" id="hero-edit-btn" onclick="togglePersonalEdit(true)">
<span class="material-symbols-outlined text-[18px]">edit</span>
          Edit Profile
        </button>
<button type="button" onclick="handleProfileSignOut()" class="w-full md:w-auto px-space-lg py-2.5 rounded-lg border border-rose-200 bg-rose-50 hover:bg-rose-100 text-rose-700 font-body-md text-body-md font-semibold transition-all duration-200 flex items-center justify-center gap-space-xs" id="hero-signout-btn">
<span class="material-symbols-outlined text-[18px]">logout</span>
          Sign Out
        </button>
</div>
</div>
</div>
<!-- QUICK TRAVEL & LOYALTY STATS STRIP -->
<div class="w-full bg-surface-container-lowest rounded-xl p-space-md shadow-sm grid grid-cols-2 lg:grid-cols-5 gap-space-md items-center">
<!-- Stat 1 -->
<div class="flex flex-col p-space-sm bg-surface-container-low rounded-lg">
<span class="font-label-caps text-label-caps uppercase text-on-surface-variant tracking-wider">Total Trips</span>
<div class="flex items-baseline gap-space-xs mt-1">
<span class="font-price-lg text-price-lg text-on-surface font-bold">18</span>
<span class="font-body-sm text-body-sm text-on-surface-variant">Completed</span>
</div>
</div>
<!-- Stat 2 -->
<div class="flex flex-col p-space-sm bg-surface-container-low rounded-lg">
<span class="font-label-caps text-label-caps uppercase text-on-surface-variant tracking-wider">Upcoming Trips</span>
<div class="flex items-baseline gap-space-xs mt-1">
<span class="font-price-lg text-price-lg text-secondary font-bold">2</span>
<span class="font-body-sm text-body-sm font-semibold text-secondary">Journeys</span>
</div>
</div>
<!-- Stat 3 -->
<div class="flex flex-col p-space-sm bg-surface-container-low rounded-lg">
<span class="font-label-caps text-label-caps uppercase text-on-surface-variant tracking-wider">Disruptions</span>
<div class="flex items-baseline gap-space-xs mt-1">
<span class="font-price-lg text-price-lg text-on-surface font-bold">0</span>
<span class="font-body-sm text-body-sm text-on-surface-variant">Active</span>
</div>
</div>
<!-- Stat 4 -->
<div class="col-span-2 lg:col-span-1 flex flex-col p-space-sm bg-surface-container-low rounded-lg">
<div class="flex items-center justify-between">
<span class="font-label-caps text-label-caps uppercase text-on-surface-variant tracking-wider">SkyMiles</span>
<span class="font-label-caps text-label-caps text-secondary font-semibold">Tier Sovereign</span>
</div>
<div class="flex items-baseline gap-space-xs mt-1">
<span class="font-price-lg text-price-lg text-on-surface font-bold">142,500</span>
<span class="font-body-sm text-body-sm text-on-surface-variant">Miles</span>
</div>
</div>
<!-- Link to Bookings -->
<div class="col-span-2 lg:col-span-1 flex items-center justify-center lg:justify-end pr-space-xs">
<a class="w-full lg:w-auto px-space-lg py-2.5 rounded-lg bg-primary-container text-on-primary font-body-md text-body-md font-semibold text-center hover:bg-secondary transition-colors duration-200 flex items-center justify-center gap-space-xs" data-path="my-bookings" href="#">
<span>View My Bookings</span>
<span class="material-symbols-outlined text-[16px]">arrow_forward</span>
</a>
</div>
</div>
<!-- TWO-COLUMN MAIN CONTENT GRID -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg">
<!-- LEFT COLUMN: Personal & Travel Identity Details -->
<div class="lg:col-span-7 flex flex-col gap-space-lg">
<!-- PERSONAL INFORMATION CARD -->
<div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col gap-space-md relative transition-all">
<div class="flex items-center justify-between pb-space-sm border-b border-surface-container">
<div class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-secondary text-[22px]">badge</span>
<h2 class="font-headline-sm text-headline-sm text-on-surface">Personal Information</h2>
</div>
<button class="font-body-sm text-body-sm text-secondary hover:text-on-surface flex items-center gap-1 font-semibold transition-colors" id="personal-edit-btn" onclick="togglePersonalEdit(true)">
<span class="material-symbols-outlined text-[16px]">edit_note</span>
              Edit Information
            </button>
</div>
<!-- STATIC READ-ONLY VIEW -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-space-md" id="personal-view-mode">
<div class="flex flex-col gap-space-xs">
<span class="font-label-caps text-label-caps uppercase text-on-surface-variant">Full Legal Name</span>
<span class="font-body-md text-body-md font-medium text-on-surface" id="display-name">John Mohamed</span>
</div>
<div class="flex flex-col gap-space-xs">
<span class="font-label-caps text-label-caps uppercase text-on-surface-variant">Email Address</span>
<span class="font-body-md text-body-md font-medium text-on-surface" id="display-email">john.mohamed@@sovereign-sky.com</span>
</div>
<div class="flex flex-col gap-space-xs">
<span class="font-label-caps text-label-caps uppercase text-on-surface-variant">Phone Number</span>
<div class="flex items-center gap-2">
<span class="font-body-md text-body-md">🇦🇪</span>
<span class="font-body-md text-body-md font-medium text-on-surface" id="display-phone">+971 50 123 4567</span>
</div>
</div>
<div class="flex flex-col gap-space-xs">
<span class="font-label-caps text-label-caps uppercase text-on-surface-variant">Country of Residence</span>
<span class="font-body-md text-body-md font-medium text-on-surface" id="display-country">United Arab Emirates</span>
</div>
<div class="flex flex-col gap-space-xs">
<span class="font-label-caps text-label-caps uppercase text-on-surface-variant">Date of Birth</span>
<span class="font-body-md text-body-md font-medium text-on-surface" id="display-dob">15 May 1988</span>
</div>
<div class="flex flex-col gap-space-xs">
<span class="font-label-caps text-label-caps uppercase text-on-surface-variant">Emergency Contact</span>
<span class="font-body-md text-body-md font-medium text-on-surface">Amina Mohamed (+971 50 987 6543)</span>
</div>
</div>
<!-- INTERACTIVE EDIT VIEW -->
<form class="hidden flex-col gap-space-md" id="personal-edit-mode" onsubmit="savePersonalChanges(event)" method="post">
<div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
<div class="flex flex-col gap-1">
<label class="font-label-caps text-label-caps uppercase text-on-surface-variant">Full Legal Name</label>
<input class="w-full bg-surface-container-low text-on-surface px-3 py-2 rounded-lg font-body-md text-body-md focus:outline-none focus:bg-surface-container-lowest focus:ring-1 focus:ring-secondary transition-all" id="input-name" required="" type="text" value="John Mohamed"/>
</div>
<div class="flex flex-col gap-1">
<label class="font-label-caps text-label-caps uppercase text-on-surface-variant">Email Address</label>
<input class="w-full bg-surface-container-low text-on-surface px-3 py-2 rounded-lg font-body-md text-body-md focus:outline-none focus:bg-surface-container-lowest focus:ring-1 focus:ring-secondary transition-all" id="input-email" required="" type="email" value="john.mohamed@@sovereign-sky.com"/>
</div>
<div class="flex flex-col gap-1">
<label class="font-label-caps text-label-caps uppercase text-on-surface-variant">Phone Number</label>
<div class="flex gap-2">
<span class="inline-flex items-center px-3 bg-surface-container-low rounded-lg text-body-md">🇦🇪 +971</span>
<input class="w-full bg-surface-container-low text-on-surface px-3 py-2 rounded-lg font-body-md text-body-md focus:outline-none focus:bg-surface-container-lowest focus:ring-1 focus:ring-secondary transition-all" id="input-phone" required="" type="tel" value="50 123 4567"/>
</div>
</div>
<div class="flex flex-col gap-1">
<label class="font-label-caps text-label-caps uppercase text-on-surface-variant">Country of Residence</label>
<select class="w-full bg-surface-container-low text-on-surface px-3 py-2 rounded-lg font-body-md text-body-md focus:outline-none focus:bg-surface-container-lowest focus:ring-1 focus:ring-secondary transition-all" id="input-country">
<option selected="" value="United Arab Emirates">United Arab Emirates</option>
<option value="Saudi Arabia">Saudi Arabia</option>
<option value="United Kingdom">United Kingdom</option>
<option value="United States">United States</option>
<option value="Egypt">Egypt</option>
<option value="Switzerland">Switzerland</option>
</select>
</div>
<div class="flex flex-col gap-1">
<label class="font-label-caps text-label-caps uppercase text-on-surface-variant">Date of Birth</label>
<input class="w-full bg-surface-container-low text-on-surface px-3 py-2 rounded-lg font-body-md text-body-md focus:outline-none focus:bg-surface-container-lowest focus:ring-1 focus:ring-secondary transition-all" id="input-dob" type="date" value="1988-05-15"/>
</div>
</div>
<div class="flex items-center justify-end gap-space-sm pt-space-sm">
<button class="px-space-md py-2 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-body-md text-body-md transition-colors" onclick="togglePersonalEdit(false)" type="button">
                Cancel
              </button>
<button class="px-space-lg py-2 rounded-lg bg-primary-container text-on-primary font-body-md text-body-md font-semibold hover:bg-secondary transition-colors" type="submit">
                Save Changes
              </button>
</div>
</form>
</div>
<!-- TRAVEL & IDENTITY INFORMATION CARD -->
<div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col gap-space-md">
<div class="flex items-center justify-between pb-space-sm border-b border-surface-container">
<div class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-secondary text-[22px]">flight_takeoff</span>
<h2 class="font-headline-sm text-headline-sm text-on-surface">Travel &amp; Identity Credentials</h2>
</div>
<span class="font-label-caps text-label-caps uppercase px-2.5 py-0.5 rounded bg-surface-container text-on-surface-variant">
              IATA Compliant
            </span>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
<div class="flex flex-col gap-space-xs">
<span class="font-label-caps text-label-caps uppercase text-on-surface-variant">Primary Nationality</span>
<div class="flex items-center gap-2">
<span class="font-body-md text-body-md">🇪🇬</span>
<span class="font-body-md text-body-md font-medium text-on-surface">Egyptian (EGY)</span>
</div>
</div>
<div class="flex flex-col gap-space-xs">
<div class="flex items-center justify-between">
<span class="font-label-caps text-label-caps uppercase text-on-surface-variant">Passport Number</span>
<button class="text-secondary font-label-caps text-label-caps flex items-center gap-1 hover:underline" onclick="togglePassportMask()" type="button">
<span class="material-symbols-outlined text-[14px]" id="eye-icon">visibility</span>
<span id="eye-label">Reveal</span>
</button>
</div>
<span class="font-title-flight-code text-[18px] text-on-surface font-semibold tracking-wider" id="passport-text">A28••••89</span>
</div>
<div class="flex flex-col gap-space-xs">
<span class="font-label-caps text-label-caps uppercase text-on-surface-variant">Passport Expiry Date</span>
<span class="font-body-md text-body-md font-medium text-on-surface">24 Nov 2031 <span class="text-secondary font-body-sm">(Valid for 5+ years)</span></span>
</div>
<div class="flex flex-col gap-space-xs">
<span class="font-label-caps text-label-caps uppercase text-on-surface-variant">Issuing Authority</span>
<span class="font-body-md text-body-md font-medium text-on-surface">Ministry of Interior, Egypt</span>
</div>
<div class="flex flex-col gap-space-xs">
<span class="font-label-caps text-label-caps uppercase text-on-surface-variant">Frequent Flyer Affiliation</span>
<span class="font-body-md text-body-md font-medium text-on-surface">SkyAlliance Global OnePass</span>
</div>
<div class="flex flex-col gap-space-xs">
<span class="font-label-caps text-label-caps uppercase text-on-surface-variant">Known Traveler Number (KTN)</span>
<span class="font-body-md text-body-md font-medium text-on-surface">KTN-994182471</span>
</div>
</div>
<div class="mt-space-xs p-space-sm bg-surface-container-low rounded-lg flex items-center gap-space-sm text-body-sm font-body-sm text-on-surface-variant">
<span class="material-symbols-outlined text-secondary text-[20px] flex-shrink-0">shield_lock</span>
<span>Biometric credentials are encrypted at rest with hardware HSM compliant with IATA Sovereign Travel Standards.</span>
</div>
</div>
</div>
<!-- RIGHT COLUMN: Preferences & Security Settings -->
<div class="lg:col-span-5 flex flex-col gap-space-lg">
<!-- TRAVEL PREFERENCES CARD -->
<div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col gap-space-md">
<div class="flex items-center justify-between pb-space-sm border-b border-surface-container">
<div class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-secondary text-[22px]">tune</span>
<h2 class="font-headline-sm text-headline-sm text-on-surface">Travel Preferences</h2>
</div>
<span class="w-2 h-2 rounded-full bg-secondary"></span>
</div>
<div class="flex flex-col gap-space-md">
<div class="flex flex-col gap-1">
<label class="font-label-caps text-label-caps uppercase text-on-surface-variant">Preferred Cabin Class</label>
<select class="w-full bg-surface-container-low text-on-surface px-3 py-2.5 rounded-lg font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-secondary transition-all" id="pref-cabin">
<option value="economy">Economy Comfort</option>
<option selected="" value="business">Business Class (Flat-Bed Suite)</option>
<option value="first">First Sovereign Private Suite</option>
</select>
</div>
<div class="flex flex-col gap-1">
<label class="font-label-caps text-label-caps uppercase text-on-surface-variant">In-Flight Dining Choice</label>
<select class="w-full bg-surface-container-low text-on-surface px-3 py-2.5 rounded-lg font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-secondary transition-all" id="pref-meal">
<option selected="" value="halal">Chef's Halal Gourmet &amp; Contemporary</option>
<option value="international">Standard International Haute Cuisine</option>
<option value="lacto">Vegetarian Lacto-Ovo Curated</option>
<option value="low-sodium">Heart-Healthy / Low Sodium</option>
<option value="vegan">Plant-Based Vegan Masterpiece</option>
</select>
</div>
<div class="flex flex-col gap-1">
<label class="font-label-caps text-label-caps uppercase text-on-surface-variant">Seat Preference</label>
<select class="w-full bg-surface-container-low text-on-surface px-3 py-2.5 rounded-lg font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-secondary transition-all" id="pref-seat">
<option selected="" value="window">Window Seat (Port Side / Left)</option>
<option value="window-starboard">Window Seat (Starboard / Right)</option>
<option value="aisle">Aisle Direct Access</option>
<option value="center">Center Couple Suite</option>
</select>
</div>
<div class="grid grid-cols-2 gap-space-sm">
<div class="flex flex-col gap-1">
<label class="font-label-caps text-label-caps uppercase text-on-surface-variant">Language</label>
<select class="w-full bg-surface-container-low text-on-surface px-3 py-2 rounded-lg font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-secondary">
<option selected="">English (US)</option>
<option>Arabic (العربية)</option>
<option>French (Français)</option>
</select>
</div>
<div class="flex flex-col gap-1">
<label class="font-label-caps text-label-caps uppercase text-on-surface-variant">Settlement</label>
<select class="w-full bg-surface-container-low text-on-surface px-3 py-2 rounded-lg font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-secondary">
<option selected="">USD ($)</option>
<option>AED (د.إ)</option>
<option>EUR (€)</option>
<option>GBP (£)</option>
</select>
</div>
</div>
<button class="w-full mt-space-xs py-2.5 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-body-md text-body-md font-semibold transition-colors flex items-center justify-center gap-space-xs" onclick="showToast('Travel preferences saved successfully')">
<span class="material-symbols-outlined text-[18px]">check</span>
              Update Preferences
            </button>
</div>
</div>
<!-- ACCOUNT & SECURITY CARD -->
<div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col gap-space-md">
<div class="flex items-center justify-between pb-space-sm border-b border-surface-container">
<div class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-secondary text-[22px]">lock</span>
<h2 class="font-headline-sm text-headline-sm text-on-surface">Account &amp; Security</h2>
</div>
<span class="inline-flex items-center gap-1 font-label-caps text-label-caps text-emerald-700 font-semibold">
<span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
              Secure
            </span>
</div>
<!-- Password Row -->
<div class="flex items-center justify-between py-1">
<div class="flex flex-col">
<span class="font-body-md text-body-md font-medium text-on-surface">Master Password</span>
<span class="font-body-sm text-body-sm text-on-surface-variant">Updated 3 months ago</span>
</div>
<button class="px-space-md py-1.5 rounded bg-surface-container hover:bg-surface-container-high text-on-surface font-body-sm text-body-sm font-semibold transition-colors" onclick="togglePasswordModal(true)">
              Change
            </button>
</div>
<!-- 2FA Toggle -->
<div class="flex items-center justify-between py-1">
<div class="flex flex-col">
<span class="font-body-md text-body-md font-medium text-on-surface">Two-Factor Authentication</span>
<span class="font-body-sm text-body-sm text-on-surface-variant">SMS &amp; Authenticator App</span>
</div>
<label class="relative inline-flex items-center cursor-pointer">
<input checked="" class="sr-only peer" id="2fa-toggle" onchange="toggleTwoFactor(this)" type="checkbox"/>
<div class="w-11 h-6 bg-surface-container-highest peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary-container"></div>
</label>
</div>
<!-- Active Sessions -->
<div class="flex flex-col gap-space-xs pt-space-xs border-t border-surface-container">
<span class="font-label-caps text-label-caps uppercase text-on-surface-variant">Active Sessions</span>
<div class="flex items-center justify-between p-space-sm bg-surface-container-low rounded-lg">
<div class="flex items-center gap-space-sm">
<span class="material-symbols-outlined text-on-surface-variant text-[20px]">laptop_mac</span>
<div class="flex flex-col">
<span class="font-body-sm text-body-sm font-medium text-on-surface">Chrome on macOS</span>
<span class="font-label-caps text-[10px] text-on-surface-variant">Dubai, UAE • Active now</span>
</div>
</div>
<span class="w-2 h-2 rounded-full bg-emerald-600"></span>
</div>
<div class="flex items-center justify-between p-space-sm bg-surface-container-low rounded-lg">
<div class="flex items-center gap-space-sm">
<span class="material-symbols-outlined text-on-surface-variant text-[20px]">smartphone</span>
<div class="flex flex-col">
<span class="font-body-sm text-body-sm font-medium text-on-surface">Safari on iPhone 15 Pro</span>
<span class="font-label-caps text-[10px] text-on-surface-variant">Geneva, Switzerland • 3 days ago</span>
</div>
</div>
<button class="text-on-surface-variant hover:text-error text-body-sm" onclick="terminateSession(this)" title="Revoke access">
<span class="material-symbols-outlined text-[18px]">close</span>
</button>
</div>
</div>
<!-- Danger Zone -->
<div class="mt-space-xs pt-space-md border-t border-surface-container flex items-center justify-between">
<div class="flex flex-col">
<span class="font-body-sm text-body-sm font-medium text-error">Account Deletion</span>
<span class="font-label-caps text-[10px] text-on-surface-variant">Permanently deactivate profile</span>
</div>
<button class="px-space-md py-1.5 rounded text-error bg-error-container/30 hover:bg-error-container text-body-sm font-body-sm font-semibold transition-colors" onclick="toggleDeleteModal(true)">
              Delete Account
            </button>
</div>
</div>
</div>
</div>
</div>
<!-- FLOATING TOAST NOTIFICATION -->
<div class="fixed top-24 right-6 z-50 transform translate-y-[-20px] opacity-0 pointer-events-none transition-all duration-300 ease-out" id="toast">
<div class="bg-primary-container text-on-primary px-space-lg py-space-sm rounded-xl shadow-xl flex items-center gap-space-sm">
<span class="material-symbols-outlined text-secondary text-[22px]">check_circle</span>
<div class="flex flex-col">
<span class="font-body-md text-body-md font-semibold text-on-primary" id="toast-message">Update successful</span>
<span class="font-label-caps text-[10px] text-on-primary-container">SkyBook Sovereign Cloud</span>
</div>
</div>
</div>
<!-- CHANGE PASSWORD MODAL -->
<div class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-sm p-4" id="password-modal">
<div class="bg-surface-container-lowest max-w-md w-full rounded-xl shadow-2xl p-space-lg flex flex-col gap-space-md animate-in fade-in zoom-in-95 duration-200">
<div class="flex items-center justify-between pb-space-xs border-b border-surface-container">
<h3 class="font-headline-sm text-headline-sm text-on-surface">Update Password</h3>
<button class="text-on-surface-variant hover:text-on-surface" onclick="togglePasswordModal(false)">
<span class="material-symbols-outlined">close</span>
</button>
</div>
<form class="flex flex-col gap-space-md" onsubmit="saveNewPassword(event)" method="post">
<div class="flex flex-col gap-1">
<label class="font-label-caps text-label-caps uppercase text-on-surface-variant">Current Password</label>
<input class="w-full bg-surface-container-low text-on-surface px-3 py-2 rounded-lg font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-secondary" placeholder="••••••••••••" required="" type="password"/>
</div>
<div class="flex flex-col gap-1">
<label class="font-label-caps text-label-caps uppercase text-on-surface-variant">New Password</label>
<input class="w-full bg-surface-container-low text-on-surface px-3 py-2 rounded-lg font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-secondary" placeholder="Minimum 12 characters" required="" type="password"/>
</div>
<div class="flex flex-col gap-1">
<label class="font-label-caps text-label-caps uppercase text-on-surface-variant">Confirm New Password</label>
<input class="w-full bg-surface-container-low text-on-surface px-3 py-2 rounded-lg font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-secondary" placeholder="Re-enter new password" required="" type="password"/>
</div>
<div class="flex items-center justify-end gap-space-sm pt-space-xs">
<button class="px-space-md py-2 rounded-lg bg-surface-container text-on-surface font-body-md text-body-md" onclick="togglePasswordModal(false)" type="button">
            Cancel
          </button>
<button class="px-space-lg py-2 rounded-lg bg-primary-container text-on-primary font-body-md text-body-md font-semibold hover:bg-secondary transition-colors" type="submit">
            Update Password
          </button>
</div>
</form>
</div>
</div>
<!-- DELETE ACCOUNT CONFIRMATION MODAL -->
<div class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm p-4" id="delete-modal">
<div class="bg-surface-container-lowest max-w-lg w-full rounded-xl shadow-2xl p-space-lg flex flex-col gap-space-md">
<div class="w-12 h-12 rounded-full bg-error-container/40 flex items-center justify-center text-error">
<span class="material-symbols-outlined text-[28px]">warning</span>
</div>
<div class="flex flex-col gap-space-xs">
<h3 class="font-headline-sm text-headline-sm text-on-surface">Permanently Delete Account?</h3>
<p class="font-body-md text-body-md text-on-surface-variant">
          Are you sure you want to delete your SkyBook account? All active booking reservations, concierge entitlements, and your balance of <strong class="text-on-surface">142,500 SkyMiles</strong> will be irrevocably forfeited.
        </p>
</div>
<div class="flex items-center justify-end gap-space-sm pt-space-sm">
<button class="px-space-md py-2 rounded-lg bg-surface-container text-on-surface font-body-md text-body-md" onclick="toggleDeleteModal(false)">
          Cancel &amp; Retain Account
        </button>
<button class="px-space-lg py-2 rounded-lg bg-error text-on-error font-body-md text-body-md font-semibold hover:opacity-90 transition-opacity" onclick="confirmAccountDeletion()">
          Confirm Deletion
        </button>
</div>
</div>
</div>
</div>
<script>
  // Mask/Unmask Passport
  let isPassportRevealed = false;
  function togglePassportMask() {
    const passportField = document.getElementById('passport-text');
    const eyeIcon = document.getElementById('eye-icon');
    const eyeLabel = document.getElementById('eye-label');

    if (isPassportRevealed) {
      passportField.textContent = 'A28••••89';
      eyeIcon.textContent = 'visibility';
      eyeLabel.textContent = 'Reveal';
      isPassportRevealed = false;
    } else {
      passportField.textContent = 'A28491889';
      eyeIcon.textContent = 'visibility_off';
      eyeLabel.textContent = 'Hide';
      isPassportRevealed = true;
    }
  }

  // Toggle Edit View for Personal Details
  function togglePersonalEdit(isEditing) {
    const viewMode = document.getElementById('personal-view-mode');
    const editMode = document.getElementById('personal-edit-mode');
    const heroBtn = document.getElementById('hero-edit-btn');
    const cardBtn = document.getElementById('personal-edit-btn');

    if (isEditing) {
      viewMode.classList.add('hidden');
      editMode.classList.remove('hidden');
      editMode.classList.add('flex');
      if (heroBtn) heroBtn.classList.add('opacity-50', 'pointer-events-none');
      if (cardBtn) cardBtn.classList.add('hidden');
    } else {
      editMode.classList.add('hidden');
      editMode.classList.remove('flex');
      viewMode.classList.remove('hidden');
      if (heroBtn) heroBtn.classList.remove('opacity-50', 'pointer-events-none');
      if (cardBtn) cardBtn.classList.remove('hidden');
    }
  }

  // Save Personal Details
  function savePersonalChanges(event) {
    event.preventDefault();
    const newName = document.getElementById('input-name').value;
    const newEmail = document.getElementById('input-email').value;
    const newPhone = document.getElementById('input-phone').value;
    const newCountry = document.getElementById('input-country').value;
    const newDob = document.getElementById('input-dob').value;

    if (newName) document.getElementById('display-name').textContent = newName;
    if (newEmail) document.getElementById('display-email').textContent = newEmail;
    if (newPhone) document.getElementById('display-phone').textContent = '+971 ' + newPhone;
    if (newCountry) document.getElementById('display-country').textContent = newCountry;
    if (newDob) {
      const parsedDate = new Date(newDob);
      const options = { day: 'numeric', month: 'short', year: 'numeric' };
      document.getElementById('display-dob').textContent = parsedDate.toLocaleDateString('en-GB', options);
    }

    togglePersonalEdit(false);
    showToast('Personal information updated successfully');
  }

  // Toast System
  let toastTimer;
  function showToast(message) {
    const toast = document.getElementById('toast');
    const msg = document.getElementById('toast-message');
    msg.textContent = message;

    clearTimeout(toastTimer);
    toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-[-20px]');
    toast.classList.add('opacity-100', 'translate-y-0');

    toastTimer = setTimeout(() => {
      toast.classList.remove('opacity-100', 'translate-y-0');
      toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-[-20px]');
    }, 3500);
  }

  // Password Modal
  function togglePasswordModal(show) {
    const modal = document.getElementById('password-modal');
    if (show) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    } else {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  }

  function saveNewPassword(event) {
    event.preventDefault();
    togglePasswordModal(false);
    showToast('Master password updated securely');
  }

  // Delete Modal
  function toggleDeleteModal(show) {
    const modal = document.getElementById('delete-modal');
    if (show) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    } else {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  }

  function confirmAccountDeletion() {
    toggleDeleteModal(false);
    showToast('Account closure request logged with concierge');
  }

  // 2FA Toggle
  function toggleTwoFactor(checkbox) {
    if (checkbox.checked) {
      showToast('Two-Factor Authentication enabled');
    } else {
      showToast('Security warning: 2FA disabled');
    }
  }

  // Terminate session
  function terminateSession(button) {
    const row = button.closest('.flex.items-center.justify-between');
    if (row) {
      row.style.opacity = '0';
      setTimeout(() => {
        row.remove();
        showToast('Remote device session terminated');
      }, 200);
    }
  }
</script>

