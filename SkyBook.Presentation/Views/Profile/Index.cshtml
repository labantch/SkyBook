<script>
document.addEventListener('DOMContentLoaded', function() {
  var btn = document.getElementById('hero-signout-btn');
  if (btn) btn.addEventListener('click', function(e){ e.preventDefault(); window.handleProfileSignOut(); });
  const name = localStorage.getItem('skybook-user-name');
  const initials = localStorage.getItem('skybook-user-initials');
  const email = localStorage.getItem('skybook-user-email');
  if (name) {
    document.querySelectorAll('h1.font-headline-md, #display-name').forEach(el => { el.textContent = name; });
    const input = document.getElementById('input-name');
    if (input) input.value = name;
  }
  if (initials) {
    const av = document.querySelector('.w-10.h-10.rounded-full, .rounded-full.bg-primary');
    // update common avatar text nodes that are just initials
    document.querySelectorAll('div').forEach(el => {
      if (el.children.length === 0 && (el.textContent || '').trim() === 'JM') el.textContent = initials;
    });
  }
  if (email) {
    const em = document.getElementById('display-email') || document.getElementById('input-email');
    if (em) {
      if (em.tagName === 'INPUT') em.value = email;
      else em.textContent = email;
    }
  }
});
</script>
<script>
window.handleProfileSignOut = function () {
  try {
    localStorage.removeItem('skybook-authenticated');
    localStorage.removeItem('skybook-role');
    localStorage.removeItem('skybook-user-name');
    localStorage.removeItem('skybook-user-email');
    localStorage.removeItem('skybook-user-initials');
    localStorage.removeItem('skybook-auth-user');
  } catch (e) {}
  window.location.href = '/Account/Login';
};
</script>
