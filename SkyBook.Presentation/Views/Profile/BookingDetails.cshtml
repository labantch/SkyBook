@model SkyBook.Business.ViewModels.BookingDetailsVm
@using SkyBook.Data.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Booking Details - " + (Model?.BookingReference ?? "");
    Layout = "_Layout";
    var isCancelled = Model?.Status == BookingStatus.Cancelled;
}

<div class="min-h-[calc(100vh-5rem)] bg-[#F8F9FA] py-10 px-4 sm:px-6 lg:px-8">
  <div class="max-w-3xl mx-auto space-y-6">

    <!-- BREADCRUMB / BACK LINK -->
    <div class="flex items-center justify-between">
      <a href="@Url.Action("MyBookings", "Profile")" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-[#0B192C] transition">
        <span class="material-symbols-outlined text-sm">arrow_back</span>
        <span>Back to My Bookings</span>
      </a>
      <span class="text-xs text-slate-400 font-medium font-mono">Ref: @(Model?.BookingReference ?? "")</span>
    </div>

    <!-- MAIN BOARDING PASS / DETAILS CARD -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 overflow-hidden space-y-0">
      
      <!-- TOP LUXURY HEADER -->
      <div class="bg-[#0B192C] text-white p-6 sm:p-8 relative overflow-hidden flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="absolute -right-12 -top-12 w-48 h-48 bg-gradient-to-br from-[#D4A017]/25 to-transparent rounded-full blur-xl pointer-events-none"></div>

        <div class="flex items-center gap-4 text-center sm:text-left z-10">
          <div class="w-14 h-14 rounded-2xl bg-white/10 text-[#C5A880] flex items-center justify-center flex-shrink-0 shadow-sm">
            <span class="material-symbols-outlined text-3xl">flight</span>
          </div>
          <div>
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-white/10 text-[#C5A880] text-[11px] font-bold uppercase tracking-wider mb-1">
              Flight @(Model?.FlightNumber ?? "")
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Booking Details</h1>
            <p class="text-xs text-slate-300 mt-0.5">Booking Date: @(Model?.BookingDate.ToString("MMM dd, yyyy") ?? "")</p>
          </div>
        </div>

        <div class="z-10">
          @if (Model?.Status == BookingStatus.Confirmed)
          {
            <span class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>Confirmed</span>
            </span>
          }
          else if (Model?.Status == BookingStatus.PendingPayment)
          {
            <span class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
              <span class="w-2 h-2 rounded-full bg-amber-500"></span>
              <span>Pending</span>
            </span>
          }
          else
          {
            <span class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">
              <span class="w-2 h-2 rounded-full bg-rose-500"></span>
              <span>Cancelled</span>
            </span>
          }
        </div>
      </div>

      <!-- ROUTE OVERVIEW -->
      <div class="p-6 sm:p-8 space-y-6">
        <div class="rounded-2xl bg-gradient-to-br from-[#FDFBF7] to-[#F5EFE6] border border-[#E8DFC8] p-6 space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 items-center text-center sm:text-left">
            <div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Departure</span>
              <p class="text-lg font-black text-[#0B192C]">@(Model?.DepartureAirPort ?? "")</p>
            </div>
            <div class="flex flex-col items-center justify-center">
              <span class="material-symbols-outlined text-[#D4A017] text-2xl">flight_takeoff</span>
              <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mt-1">Direct Flight</span>
            </div>
            <div class="sm:text-right">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Arrival Destination</span>
              <p class="text-lg font-black text-[#0B192C]">@(Model?.ArrivalAirPort ?? "")</p>
            </div>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 border-t border-dashed border-[#D4C3A3] text-xs">
            <div class="p-3 rounded-xl bg-white/70 border border-[#E8DFC8]/60">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Passenger</span>
              <span class="font-bold text-[#0B192C]">@(Model?.PassengerName ?? "Passenger")</span>
            </div>
            <div class="p-3 rounded-xl bg-white/70 border border-[#E8DFC8]/60">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Seat</span>
              <span class="font-extrabold text-[#0B192C]">@(Model?.SeatNumber ?? "Unassigned")</span>
            </div>
            <div class="p-3 rounded-xl bg-white/70 border border-[#E8DFC8]/60">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Reference</span>
              <span class="font-mono font-bold text-[#0B192C]">@(Model?.BookingReference ?? "")</span>
            </div>
            <div class="p-3 rounded-xl bg-white/70 border border-[#E8DFC8]/60">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Total Price</span>
              <span class="font-extrabold text-emerald-700">$@(Model?.TotalPrice.ToString("N2") ?? "0.00")</span>
            </div>
          </div>
        </div>

        @if (Model?.Passengers != null && Model.Passengers.Count > 0)
        {
          <div class="space-y-3 pt-2">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[16px] text-[#0B192C]">group</span>
              <span>All Registered Passengers (@Model.Passengers.Count)</span>
            </h3>
            <div class="space-y-2.5">
              @for (int i = 0; i < Model.Passengers.Count; i++)
              {
                var p = Model.Passengers[i];
                <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 flex items-center justify-between gap-3 text-xs">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-[#0B192C] text-[#C5A880] flex items-center justify-center font-bold text-xs shrink-0">
                      @(i + 1)
                    </div>
                    <div>
                      <p class="font-extrabold text-[#0B192C] text-sm">@p.FullName</p>
                      <p class="text-[11px] text-slate-500">
                        @(i == 0 ? "Primary Passenger" : "Traveler") &bull; @(string.IsNullOrEmpty(p.Nationality) ? "Adult" : p.Nationality)
                        @if (!string.IsNullOrEmpty(p.PassportNumber) && p.PassportNumber != "-")
                        {
                          <span> &bull; Passport: <strong class="font-mono text-slate-700">@p.PassportNumber</strong></span>
                        }
                      </p>
                    </div>
                  </div>
                  <div class="text-right shrink-0">
                    <span class="text-[10px] uppercase font-bold text-slate-400 block">Seat</span>
                    <span class="font-black text-sm text-[#855D29] px-2.5 py-0.5 rounded-lg bg-[#FBF7F0] border border-[#C5A880]/40">@(string.IsNullOrEmpty(p.SeatNumber) ? "Unassigned" : p.SeatNumber)</span>
                  </div>
                </div>
              }
            </div>
          </div>
        }

        <!-- ACTION FOOTER -->
        <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-slate-100">
          <button type="button" onclick="window.print()" class="px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px]">print</span>
            <span>Print E-Ticket</span>
          </button>

          @if (!isCancelled)
          {
            <form action="@Url.Action("CancelBooking", "Profile", new { id = Model?.BookingId })" method="post" onsubmit="return confirm('Are you sure you want to cancel this reservation?');">
              @Html.AntiForgeryToken()
              <button type="submit" class="px-4 py-2.5 rounded-xl text-xs font-bold text-rose-600 hover:text-white hover:bg-rose-600 border border-rose-200 hover:border-rose-600 transition flex items-center gap-1 shadow-2xs">
                <span class="material-symbols-outlined text-[16px]">cancel</span>
                <span>Cancel Reservation</span>
              </button>
            </form>
          }
        </div>
      </div>

    </div>

  </div>
</div>
