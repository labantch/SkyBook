<script>
    (function() {
      const routeOriginCode = document.getElementById('route-origin-code');
      const routeOriginName = document.getElementById('route-origin-name');
      const routeDestCode = document.getElementById('route-dest-code');
      const routeDestName = document.getElementById('route-dest-name');
      const routeDuration = document.getElementById('route-duration');

      const btnLondonTokyo = document.getElementById('btn-london-tokyo');
      const btnNyDubai = document.getElementById('btn-ny-dubai');
      const btnGenevaSing = document.getElementById('btn-geneva-singapore');

      const resetButtons = () => {
        [btnLondonTokyo, btnNyDubai, btnGenevaSing].forEach(btn => {
          if (btn) {
            btn.classList.remove('bg-secondary', 'text-white');
            btn.classList.add('text-on-surface-variant');
          }
        });
      };

      if (btnLondonTokyo) {
        btnLondonTokyo.addEventListener('click', () => {
          resetButtons();
          btnLondonTokyo.classList.add('bg-secondary', 'text-white');
          btnLondonTokyo.classList.remove('text-on-surface-variant');
          routeOriginCode.textContent = 'LHR';
          routeOriginName.textContent = 'London Heathrow • FBO Signature';
          routeDestCode.textContent = 'HND';
          routeDestName.textContent = 'Tokyo Haneda • Premier VIP';
          routeDuration.textContent = '11h 45m • Non-Stop';
        });
      }

      if (btnNyDubai) {
        btnNyDubai.addEventListener('click', () => {
          resetButtons();
          btnNyDubai.classList.add('bg-secondary', 'text-white');
          btnNyDubai.classList.remove('text-on-surface-variant');
          routeOriginCode.textContent = 'JFK';
          routeOriginName.textContent = 'New York JFK • Sheltair VIP';
          routeDestCode.textContent = 'DXB';
          routeDestName.textContent = 'Dubai Al Maktoum • Jet Aviation';
          routeDuration.textContent = '12h 20m • Non-Stop';
        });
      }

      if (btnGenevaSing) {
        btnGenevaSing.addEventListener('click', () => {
          resetButtons();
          btnGenevaSing.classList.add('bg-secondary', 'text-white');
          btnGenevaSing.classList.remove('text-on-surface-variant');
          routeOriginCode.textContent = 'GVA';
          routeOriginName.textContent = 'Geneva Cointrin • TAG Aviation';
          routeDestCode.textContent = 'SIN';
          routeDestName.textContent = 'Singapore Seletar • Universal Aviation';
          routeDuration.textContent = '12h 50m • Non-Stop';
        });
      }

      const inquirySubmit = document.getElementById('inquiry-submit');
      const inquiryInput = document.getElementById('inquiry-input');
      const inquiryMsg = document.getElementById('inquiry-msg');
      const inquiryModal = document.getElementById('inquiry-success-modal');
      const inquirySuccessEmail = document.getElementById('inquiry-success-email');
      const inquirySuccessClose = document.getElementById('inquiry-success-close');

      if (inquirySubmit && inquiryInput && inquiryMsg && inquiryModal) {
        inquirySubmit.addEventListener('click', () => {
          if (inquiryInput.checkValidity()) {
            inquirySuccessEmail.textContent = inquiryInput.value;
            inquiryMsg.classList.remove('hidden');
            inquiryModal.classList.remove('hidden');
            inquiryModal.classList.add('flex');
            inquiryInput.value = '';
          } else {
            inquiryInput.reportValidity();
          }
        });

        inquirySuccessClose.addEventListener('click', () => {
          inquiryModal.classList.add('hidden');
          inquiryModal.classList.remove('flex');
        });

        inquiryModal.addEventListener('click', (event) => {
          if (event.target === inquiryModal) inquirySuccessClose.click();
        });
      }
    })();
  </script>
}