</div>
<div class="grid grid-cols-3 gap-space-sm pt-space-sm text-center">
<div class="p-space-sm rounded-lg bg-surface-container-low flex flex-col items-center justify-center">
<span class="font-label-caps text-label-caps uppercase text-on-surface-variant">Top Speed</span>
<span class="font-price-lg text-price-lg text-on-surface tabular-nums mt-1 font-bold">Mach 0.925</span>
<span class="font-body-sm text-[11px] text-on-surface-variant">High Speed Cruise</span>
</div>
<div class="p-space-sm rounded-lg bg-surface-container-low flex flex-col items-center justify-center">
<span class="font-label-caps text-label-caps uppercase text-on-surface-variant">Max Range</span>
<span class="font-price-lg text-price-lg text-on-surface tabular-nums mt-1 font-bold">7,750 nm</span>
<span class="font-body-sm text-[11px] text-on-surface-variant">Non-stop Transoceanic</span>
</div>
<div class="p-space-sm rounded-lg bg-surface-container-low flex flex-col items-center justify-center">
<span class="font-label-caps text-label-caps uppercase text-on-surface-variant">Cabin Altitude</span>
<span class="font-price-lg text-price-lg text-secondary tabular-nums mt-1 font-bold">2,900 ft</span>
<span class="font-body-sm text-[11px] text-on-surface-variant">Lowest in Aviation</span>
</div>
</div>
</div>
<!-- Aircraft 2: Bombardier Global 7500 -->
<div class="flex flex-col rounded-2xl bg-surface-container-lowest border border-surface-container-high/60 p-space-lg shadow-sm">
<div class="flex items-center justify-between pb-space-sm">
<div>
<span class="font-label-caps text-label-caps uppercase text-secondary tracking-wider">Four True Living Spaces</span>
<h3 class="font-title-flight-code text-title-flight-code text-on-surface">Bombardier Global 7500</h3>
</div>
<span class="px-3 py-1 rounded-full bg-secondary/10 text-secondary font-label-caps text-label-caps uppercase tracking-wider">In Service</span>
</div>
<div class="relative h-56 w-full rounded-xl overflow-hidden my-space-md bg-surface-container-low">
<img class="w-full h-full object-cover" data-alt="A luxurious Bombardier Global 7500 aircraft climbing into high altitude with dramatic sunset highlights." src="/images/img-1d370a6005.jpg">
</div>
<div class="grid grid-cols-3 gap-space-sm pt-space-sm text-center">
<div class="p-space-sm rounded-lg bg-surface-container-low flex flex-col items-center justify-center">
<span class="font-label-caps text-label-caps uppercase text-on-surface-variant">Top Speed</span>
<span class="font-price-lg text-price-lg text-on-surface tabular-nums mt-1 font-bold">Mach 0.925</span>
<span class="font-body-sm text-[11px] text-on-surface-variant">Smooth-Flēx Wing</span>
</div>
<div class="p-space-sm rounded-lg bg-surface-container-low flex flex-col items-center justify-center">
<span class="font-label-caps text-label-caps uppercase text-on-surface-variant">Max Range</span>
<span class="font-price-lg text-price-lg text-on-surface tabular-nums mt-1 font-bold">7,700 nm</span>
<span class="font-body-sm text-[11px] text-on-surface-variant">London to Singapore</span>
</div>
<div class="p-space-sm rounded-lg bg-surface-container-low flex flex-col items-center justify-center">
<span class="font-label-caps text-label-caps uppercase text-on-surface-variant">Cabin Altitude</span>
<span class="font-price-lg text-price-lg text-secondary tabular-nums mt-1 font-bold">2,900 ft</span>
<span class="font-body-sm text-[11px] text-on-surface-variant">PŪR Air HEPA System</span>
</div>
</div>
</div>
</div>
</section>
<!-- Interactive Flight Calculator / Route Preview Module -->

<!-- Exclusive Inquiry Call-to-Action (By Invitation Only) -->
<section class="w-full my-space-lg p-space-xl rounded-2xl bg-primary-container text-on-primary relative overflow-hidden shadow-2xl flex flex-col items-center text-center" id="inquiry"><div class="absolute inset-0 z-0 pointer-events-none overflow-hidden"><img src="/images/img-b146bd9b84.jpg" alt="Private business jet cruising above sunset clouds" class="w-full h-full object-cover"><div class="absolute inset-0 bg-gradient-to-r from-[#0b192c]/95 via-[#0b192c]/85 to-[#0b192c]/60"></div><div class="absolute inset-0 bg-gradient-to-t from-[#0b192c] via-transparent to-[#0b192c]/40"></div></div>
<!-- Subtle luxury glow backdrop -->
<div class="absolute inset-0 bg-gradient-to-b from-white/5 to-transparent pointer-events-none"></div>
<div class="absolute top-0 w-1/2 h-1 bg-secondary"></div>
<div class="relative z-10 max-w-2xl flex flex-col items-center gap-space-md">
<div class="w-12 h-12 rounded-full bg-secondary/20 flex items-center justify-center text-secondary mb-space-xs">
<span class="material-symbols-outlined text-[24px]">key</span>
</div>
<span class="font-label-caps text-label-caps uppercase text-secondary-fixed-dim tracking-widest">Confidential Protocol</span>
<h2 class="font-headline-lg text-headline-lg text-white font-semibold tracking-tight">
            A Sovereign Circle, By Invitation Only
          </h2>
<p class="font-body-lg text-body-lg text-primary-fixed-dim leading-relaxed">
            Membership to SkyClub and our Private Concierge is currently accessible by invitation or private inquiry only.
          </p>
<p class="font-body-sm text-body-sm text-on-primary-container italic max-w-lg">
            Each application is personally reviewed by our Private Aviation Advisory Directorate.
          </p>
<div class="w-full max-w-md mt-space-md flex flex-col gap-space-sm">
<div class="flex gap-2">
<input aria-describedby="inquiry-msg" autocomplete="email" class="flex-1 px-4 py-3 rounded-lg bg-tertiary-container text-white placeholder:text-on-primary-container font-body-sm focus:outline-none focus:ring-1 focus:ring-secondary transition-all" id="inquiry-input" placeholder="Enter executive or family office email..." required type="email">
<button class="px-space-md py-3 rounded-lg bg-secondary text-white font-body-sm font-semibold hover:bg-secondary/90 transition-all flex items-center gap-1 shadow-md whitespace-nowrap" id="inquiry-submit" type="button">
