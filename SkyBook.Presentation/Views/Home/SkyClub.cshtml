@{
    ViewData["Title"] = "SkyClub";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/cards-mobile.css" />
<style>
    @@layer base {
      html, body { margin: 0; padding: 0; scroll-behavior: smooth; }
      body { overscroll-behavior: none; }
    }
    ::-webkit-scrollbar { display: none; }
  </style>
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-space-lg flex flex-col gap-space-lg">
<!-- Top Subtle Notification & Breadcrumb Anchor -->
<div class="w-full flex items-center justify-between pb-2 border-b border-surface-container-high/60">
<div class="flex items-center gap-space-xs">
<a class="font-label-caps text-label-caps uppercase text-secondary tracking-widest hover:underline" href="#">Aura Division</a>
<span class="text-outline-variant font-body-sm">/</span>
<span class="font-label-caps text-label-caps uppercase text-on-surface-variant">Private Concierge &amp; SkyClub</span>
</div>
<div class="flex items-center gap-2 text-on-surface-variant font-label-caps text-label-caps uppercase">
<span class="inline-block w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
<span class="">Concierge Line: Confidential Standby</span>
</div>
</div>
<!-- Cinematic Hero Section -->
<section class="relative w-full rounded-2xl overflow-hidden bg-primary-container text-on-primary shadow-2xl p-space-lg lg:p-space-xl"><div class="absolute inset-0 z-0 pointer-events-none overflow-hidden"><img src="/images/img-b146bd9b84.jpg" alt="Private business jet cruising above sunset clouds" class="w-full h-full object-cover"><div class="absolute inset-0 bg-gradient-to-r from-[#0b192c]/95 via-[#0b192c]/85 to-[#0b192c]/60"></div><div class="absolute inset-0 bg-gradient-to-t from-[#0b192c] via-transparent to-[#0b192c]/40"></div></div>
<!-- Ambient atmospheric gold & ocean glows -->
<div class="absolute -top-32 -right-32 w-96 h-96 rounded-full bg-secondary/20 blur-3xl pointer-events-none"></div>
<div class="absolute -bottom-32 -left-32 w-96 h-96 rounded-full bg-[#001c38]/90 blur-3xl pointer-events-none"></div>
<div class="relative z-10 max-w-4xl flex flex-col gap-space-md">
<!-- Pre-headline badge -->
<div class="inline-flex items-center gap-2 self-start px-3.5 py-1.5 rounded-full bg-white/5 backdrop-blur-md border border-white/10 text-secondary-fixed">
<span class="material-symbols-outlined text-[16px] text-secondary-fixed">verified</span>
<span class="font-label-caps text-label-caps tracking-widest uppercase text-secondary-fixed">AURA PRIVATE AVIATION • SKYCLUB CONCIERGE</span>
</div>
<!-- Main Headline -->
<h1 class="font-display-hero text-display-hero tracking-tight text-white">
            An Elevation of Privilege
          </h1>
<!-- Editorial Subtitle -->
<p class="font-body-lg text-body-lg text-primary-fixed-dim max-w-2xl leading-relaxed">
            SkyClub is an uncompromised travel experience reserved for the world's most discerning flyers. Where intercontinental transit meets private aviation sovereignty.
          </p>
<!-- Action Group -->
<div class="flex flex-wrap items-center gap-space-md pt-space-sm">
<a class="inline-flex items-center justify-center gap-2 px-space-lg py-3.5 rounded-lg bg-secondary text-white font-body-md font-semibold shadow-lg hover:bg-secondary/90 transition-all" href="#inquiry">
<span class="">Request an Invitation</span>
<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
</a>
<a class="inline-flex items-center justify-center gap-2 px-space-lg py-3.5 rounded-lg bg-white/10 text-white font-body-md font-medium hover:bg-white/15 border border-white/10 transition-all backdrop-blur-sm" href="#fleet">
<span class="material-symbols-outlined text-[18px]">flight</span>
<span class="">Explore Sovereign Fleet</span>
</a>
</div>
</div>
<!-- Credibility / Prestige Stats Strip -->
<div class="relative z-10 mt-space-xl pt-space-md grid grid-cols-1 md:grid-cols-3 gap-space-md">
<div class="flex items-center gap-space-sm bg-white/5 p-space-md rounded-xl backdrop-blur-md border border-white/10">
<div class="w-11 h-11 rounded-lg bg-secondary/20 flex items-center justify-center text-secondary-fixed">
<span class="material-symbols-outlined text-[22px]">flight_takeoff</span>
</div>
<div class="flex flex-col">
<span class="font-headline-sm text-headline-sm text-white tabular-nums font-semibold">G700 &amp; Global 7500</span>
<span class="font-label-caps text-label-caps uppercase text-secondary-fixed-dim tracking-wider">Fleet Access Worldwide</span>
</div>
</div>
<div class="flex items-center gap-space-sm bg-white/5 p-space-md rounded-xl backdrop-blur-md border border-white/10">
<div class="w-11 h-11 rounded-lg bg-secondary/20 flex items-center justify-center text-secondary-fixed">
<span class="material-symbols-outlined text-[22px]">shield</span>
</div>
<div class="flex flex-col">
<span class="font-headline-sm text-headline-sm text-white tabular-nums font-semibold">100% Private</span>
<span class="font-label-caps text-label-caps uppercase text-secondary-fixed-dim tracking-wider">Dedicated Terminals &amp; FBOs</span>
</div>
</div>
<div class="flex items-center gap-space-sm bg-white/5 p-space-md rounded-xl backdrop-blur-md border border-white/10">
<div class="w-11 h-11 rounded-lg bg-secondary/20 flex items-center justify-center text-secondary-fixed">
<span class="material-symbols-outlined text-[22px]">timer</span>
</div>
<div class="flex flex-col">
<span class="font-headline-sm text-headline-sm text-white tabular-nums font-semibold">&lt; 15 Minutes</span>
<span class="font-label-caps text-label-caps uppercase text-secondary-fixed-dim tracking-wider">Sub-15 Minute Tarmac Transfers</span>
</div>
</div>
</div>
</section>
<!-- Editorial Imagery Highlight Strip -->
<section class="w-full grid grid-cols-1 md:grid-cols-2 gap-6 my-space-md">
<div class="relative h-[420px] rounded-2xl overflow-hidden shadow-md bg-surface-container-low group">
<img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" data-alt="An ultra-luxury private Gulfstream jet banking gracefully above a warm golden sunset cloud layer." src="/images/img-cea3ece29d.jpg">
<div class="absolute inset-0 bg-gradient-to-t from-[#0b192c]/90 via-[#0b192c]/30 to-transparent flex flex-col justify-end p-space-lg text-white">
<span class="font-label-caps text-label-caps uppercase text-secondary-fixed-dim tracking-widest mb-1 font-semibold">Stratospheric Sovereignty</span>
<h3 class="font-headline-md text-headline-md font-semibold text-white tracking-tight">Transcontinental Range. Zero Compromise.</h3>
</div>
</div>
<div class="relative h-[420px] rounded-2xl overflow-hidden shadow-md bg-surface-container-low group">
<img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" data-alt="A meticulously curated first class private jet cabin interior during dusk." src="/images/img-2828a54b66.jpg">
<div class="absolute inset-0 bg-gradient-to-t from-[#0b192c]/90 via-[#0b192c]/30 to-transparent flex flex-col justify-end p-space-lg text-white">
<span class="font-label-caps text-label-caps uppercase text-secondary-fixed-dim tracking-widest mb-1 font-semibold">Tailored Suites</span>
<h3 class="font-headline-md text-headline-md font-semibold text-white tracking-tight">A Sanctuary at 45,000 Feet</h3>
</div>
</div>
</section>
<!-- The Sovereign Experience: 3-Column Feature Grid -->
<section class="w-full py-space-lg flex flex-col gap-space-lg">
<div class="flex flex-col gap-space-xs max-w-2xl">
<div class="flex items-center gap-2">
<span class="w-6 h-[2px] bg-secondary inline-block"></span>
<span class="font-label-caps text-label-caps uppercase tracking-widest text-secondary font-semibold">Distinction by Design</span>
</div>
<h2 class="font-headline-lg text-headline-lg tracking-tight text-on-surface">The Sovereign Experience</h2>
<p class="font-body-md text-body-md text-on-surface-variant">
            Every itinerary is orchestrated around your singular timeline. We deliver bespoke chartering, diplomatic discretion, and culinary artistry at cruising altitude.
          </p>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-space-lg">
<!-- Card 1 -->
<div class="group flex flex-col justify-between rounded-xl overflow-hidden bg-surface-container-lowest border border-surface-container-high/60 shadow-[0_4px_20px_-4px_rgba(11,25,44,0.05)] hover:shadow-[0_12px_32px_-6px_rgba(11,25,44,0.09)] transition-all"><div class="relative h-48 w-full overflow-hidden bg-surface-container-low"><img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" src="/images/img-8ae64e39ff.jpg" alt="Bespoke Charters Private Jet"><div class="absolute inset-0 bg-gradient-to-t from-[#0b192c]/60 via-transparent to-transparent"></div></div><div class="flex flex-col justify-between flex-grow p-space-lg"><div class="flex flex-col gap-space-md"><div class="w-12 h-12 rounded-xl bg-secondary-container/40 flex items-center justify-center text-secondary group-hover:scale-105 transition-transform"><span class="material-symbols-outlined text-[26px]">flight_takeoff</span></div><div><span class="font-label-caps text-label-caps uppercase tracking-wider text-secondary font-semibold">Global Fleet Access</span><h3 class="font-headline-md text-headline-md text-on-surface mt-1 font-semibold">Bespoke Charters</h3></div><p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">On-demand access to ultra-long-range Gulfstream G700 and Bombardier Global 7500 aircraft, ready for global departure within four hours.</p></div><div class="flex flex-wrap gap-2 pt-space-lg"><span class="px-2.5 py-1 rounded-full bg-surface-container-low text-on-surface font-label-caps text-label-caps tracking-wider tabular-nums">Range: 7,750 nm</span><span class="px-2.5 py-1 rounded-full bg-surface-container-low text-on-surface font-label-caps text-label-caps tracking-wider tabular-nums">Up to 19 Passengers</span><span class="px-2.5 py-1 rounded-full bg-surface-container-low text-on-surface font-label-caps text-label-caps tracking-wider">Ka-Band Satellite</span></div></div></div>
<!-- Card 2 -->
<div class="group flex flex-col justify-between rounded-xl overflow-hidden bg-surface-container-lowest border border-surface-container-high/60 shadow-[0_4px_20px_-4px_rgba(11,25,44,0.05)] hover:shadow-[0_12px_32px_-6px_rgba(11,25,44,0.09)] transition-all"><div class="relative h-48 w-full overflow-hidden bg-surface-container-low"><img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" src="/images/img-f1a54d80fc.jpg" alt="Tarmac to Suite Chauffeur Transfer"><div class="absolute inset-0 bg-gradient-to-t from-[#0b192c]/60 via-transparent to-transparent"></div></div><div class="flex flex-col justify-between flex-grow p-space-lg"><div class="flex flex-col gap-space-md"><div class="w-12 h-12 rounded-xl bg-secondary-container/40 flex items-center justify-center text-secondary group-hover:scale-105 transition-transform"><span class="material-symbols-outlined text-[26px]">airport_shuttle</span></div><div><span class="font-label-caps text-label-caps uppercase tracking-wider text-secondary font-semibold">Unmatched Discretion</span><h3 class="font-headline-md text-headline-md text-on-surface mt-1 font-semibold">Tarmac to Suite</h3></div><p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">Private chauffeur boarding that bypasses all commercial terminals entirely. Direct transfer from your private residence or executive suite to aircraft stairs.</p></div><div class="flex flex-wrap gap-2 pt-space-lg"><span class="px-2.5 py-1 rounded-full bg-surface-container-low text-on-surface font-label-caps text-label-caps tracking-wider">Zero Terminal Wait</span><span class="px-2.5 py-1 rounded-full bg-surface-container-low text-on-surface font-label-caps text-label-caps tracking-wider">Discreet Customs</span><span class="px-2.5 py-1 rounded-full bg-surface-container-low text-on-surface font-label-caps text-label-caps tracking-wider">Luggage Valet</span></div></div></div>
<!-- Card 3 -->
<div class="group flex flex-col justify-between rounded-xl overflow-hidden bg-surface-container-lowest border border-surface-container-high/60 shadow-[0_4px_20px_-4px_rgba(11,25,44,0.05)] hover:shadow-[0_12px_32px_-6px_rgba(11,25,44,0.09)] transition-all"><div class="relative h-48 w-full overflow-hidden bg-surface-container-low"><img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" src="/images/img-f0109d427e.jpg" alt="Culinary Mastery In-flight Dining"><div class="absolute inset-0 bg-gradient-to-t from-[#0b192c]/60 via-transparent to-transparent"></div></div><div class="flex flex-col justify-between flex-grow p-space-lg"><div class="flex flex-col gap-space-md"><div class="w-12 h-12 rounded-xl bg-secondary-container/40 flex items-center justify-center text-secondary group-hover:scale-105 transition-transform"><span class="material-symbols-outlined text-[26px]">restaurant</span></div><div><span class="font-label-caps text-label-caps uppercase tracking-wider text-secondary font-semibold">Haute Cuisine at 45,000 FT</span><h3 class="font-headline-md text-headline-md text-on-surface mt-1 font-semibold">Culinary Mastery</h3></div><p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">Michelin-starred menus customized to the member's exact dietary profile prior to takeoff, accompanied by artisanal infusions and bespoke caviar service.</p></div><div class="flex flex-wrap gap-2 pt-space-lg"><span class="px-2.5 py-1 rounded-full bg-surface-container-low text-on-surface font-label-caps text-label-caps tracking-wider">Customized Menus</span><span class="px-2.5 py-1 rounded-full bg-surface-container-low text-on-surface font-label-caps text-label-caps tracking-wider">Artisan Mixology</span><span class="px-2.5 py-1 rounded-full bg-surface-container-low text-on-surface font-label-caps text-label-caps tracking-wider">Fine China</span></div></div></div>
</div>
</section>
<!-- Private Fleet Showcase / Aircraft Architectural Detail -->
<section class="w-full py-space-md flex flex-col gap-space-lg" id="fleet">
<div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md">
<div>
<span class="font-label-caps text-label-caps uppercase text-secondary tracking-widest font-semibold">Architectural Precision</span>
<h2 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">The Sovereign Flagships</h2>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant max-w-md">
            Engineered for quiet long-range performance, exceptional cabin pressurization, and refined ergonomics for seamless global productivity.
          </p>
</div>
<!-- Fleet Specs Bento Grid -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-space-lg">
<!-- Aircraft 1: Gulfstream G700 -->
<div class="flex flex-col rounded-2xl bg-surface-container-lowest border border-surface-container-high/60 p-space-lg shadow-sm">
<div class="flex items-center justify-between pb-space-sm">
<div>
<span class="font-label-caps text-label-caps uppercase text-secondary tracking-wider">Ultra-Long-Range Masterpiece</span>
<h3 class="font-title-flight-code text-title-flight-code text-on-surface">Gulfstream G700</h3>
</div>
<span class="px-3 py-1 rounded-full bg-secondary/10 text-secondary font-label-caps text-label-caps uppercase tracking-wider">In Service</span>
</div>
