<script>
  document.addEventListener('DOMContentLoaded', () => {
    // LUXURY AIRPORT DATA REPOSITORY
    const AIRPORTS_DATA = [
      { code: 'DXB', city: 'Dubai Intl', country: 'United Arab Emirates' },
      { code: 'LHR', city: 'London Heathrow', country: 'United Kingdom' },
      { code: 'JFK', city: 'New York JFK', country: 'United States' },
      { code: 'HND', city: 'Tokyo Haneda', country: 'Japan' },
      { code: 'SIN', city: 'Singapore Changi', country: 'Singapore' },
      { code: 'CAI', city: 'Cairo Intl', country: 'Egypt' },
      { code: 'YJC', city: 'A Coruña', country: 'Spain' },
      { code: 'CDG', city: 'Paris Charles de Gaulle', country: 'France' },
      { code: 'SYD', city: 'Sydney Kingsford Smith', country: 'Australia' },
      { code: 'FRA', city: 'Frankfurt am Main', country: 'Germany' },
      { code: 'ZRH', city: 'Zurich Airport', country: 'Switzerland' }
    ];

    // 1. TRIP TABS & SWITCHING MODES
    const tripTabButtons = document.querySelectorAll('#trip-tabs button');
    const returnDateContainer = document.getElementById('return-date-container');
    const standardContainer = document.getElementById('standard-search-container');
    const multicityContainer = document.getElementById('multicity-search-container');
    let currentTripMode = 'round-trip';

    tripTabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        tripTabButtons.forEach(b => {
          b.className = 'px-5 py-2 rounded-md font-label-caps text-label-caps uppercase tracking-wider transition-all text-on-surface-variant hover:text-on-surface';
        });
        btn.className = 'px-5 py-2 rounded-md font-label-caps text-label-caps uppercase tracking-wider transition-all bg-[#0B192C] text-white shadow-sm';

        currentTripMode = btn.getAttribute('data-trip');
        sessionStorage.setItem('skybook-trip-mode', currentTripMode);

        if (currentTripMode === 'multi-city') {
          standardContainer.classList.add('hidden');
          multicityContainer.classList.remove('hidden');
        } else {
          multicityContainer.classList.add('hidden');
          standardContainer.classList.remove('hidden');

          if (currentTripMode === 'one-way') {
            returnDateContainer.classList.add('opacity-40', 'pointer-events-none', 'grayscale');
          } else {
            returnDateContainer.classList.remove('opacity-40', 'pointer-events-none', 'grayscale');
          }
        }
        closeAirportDropdown();
        closeCalendar();
        closePassengersPopover();
      });
    });

    // 2. UNIVERSAL AIRPORT PICKER DROPDOWN SYSTEM
    const airportDropdown = document.getElementById('luxury-airport-dropdown');
    const airportSearchInput = document.getElementById('airport-search-input');
    const airportSearchClear = document.getElementById('airport-search-clear');
    const airportItemsContainer = document.getElementById('airport-items-container');
    const airportResultsCount = document.getElementById('airport-results-count');

    let activeAirportAnchor = null;

    function renderAirportList(query = '') {
      airportItemsContainer.innerHTML = '';
      const filter = query.trim().toLowerCase();
      const filtered = AIRPORTS_DATA.filter(a => {
        return a.code.toLowerCase().includes(filter) ||
               a.city.toLowerCase().includes(filter) ||
               a.country.toLowerCase().includes(filter);
      });

      airportResultsCount.textContent = `${filtered.length} Airfield${filtered.length === 1 ? '' : 's'}`;

      if (filtered.length === 0) {
        const noResult = document.createElement('div');
        noResult.className = 'py-6 text-center text-xs text-on-surface-variant';
        noResult.textContent = 'No matching sovereign gateways found';
        airportItemsContainer.appendChild(noResult);
        return;
      }

      filtered.forEach(item => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'airport-option w-full text-left px-3 py-2.5 rounded-lg hover:bg-surface-container transition-colors flex items-center justify-between group';
        btn.innerHTML = `
          <div>
            <div class="font-headline-sm text-sm text-primary font-bold">
              <span class="tabular-nums font-title-flight-code text-base mr-2 text-secondary">${item.code}</span>
              ${item.city}
            </div>
            <span class="text-xs text-on-surface-variant">${item.country}</span>
          </div>
          <span class="material-symbols-outlined text-[16px] text-on-surface-variant group-hover:text-primary transition-colors">flight</span>
        `;

        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          selectAirport(item);
        });

        airportItemsContainer.appendChild(btn);
      });
    }

    function selectAirport(item) {
      if (!activeAirportAnchor) return;

      const role = activeAirportAnchor.getAttribute('data-field-role');

      if (role === 'origin') {
        const codeEl = document.getElementById('origin-code');
        const cityEl = document.getElementById('origin-city');
        const countryEl = document.getElementById('origin-country');
        if (codeEl) codeEl.textContent = item.code;
        if (cityEl) cityEl.textContent = item.city;
        if (countryEl) countryEl.textContent = item.country;
      } else if (role === 'destination') {
        const codeEl = document.getElementById('destination-code');
        const cityEl = document.getElementById('destination-city');
        const countryEl = document.getElementById('destination-country');
        if (codeEl) codeEl.textContent = item.code;
        if (cityEl) cityEl.textContent = item.city;
        if (countryEl) countryEl.textContent = item.country;
      } else if (role === 'multicity-from') {
        const input = activeAirportAnchor.querySelector('.segment-from-input');
        if (input) input.value = `${item.city} ${item.code}`;
      } else if (role === 'multicity-to') {
        const input = activeAirportAnchor.querySelector('.segment-to-input');
        if (input) input.value = `${item.city} ${item.code}`;
      }

      closeAirportDropdown();
    }

    function openAirportDropdown(anchorElement) {
      if (!airportDropdown.classList.contains('hidden') && activeAirportAnchor === anchorElement) {
        closeAirportDropdown();
        return;
      }

      activeAirportAnchor = anchorElement;
      airportSearchInput.value = '';
      airportSearchClear.classList.add('hidden');
      renderAirportList('');

      anchorElement.appendChild(airportDropdown);
      airportDropdown.classList.remove('hidden');

      const rect = anchorElement.getBoundingClientRect();
      const dropWidth = 380;
      if (rect.left + dropWidth > window.innerWidth - 16) {
        airportDropdown.style.left = 'auto';
        airportDropdown.style.right = '0';
      } else {
        airportDropdown.style.left = '0';
        airportDropdown.style.right = 'auto';
      }
      airportDropdown.style.top = '100%';

      setTimeout(() => airportSearchInput.focus(), 50);

      closeCalendar();
      closePassengersPopover();
    }

    function closeAirportDropdown() {
      airportDropdown.classList.add('hidden');
      activeAirportAnchor = null;
    }

    airportSearchInput.addEventListener('input', (e) => {
      const val = e.target.value;
      if (val.length > 0) {
        airportSearchClear.classList.remove('hidden');
      } else {
        airportSearchClear.classList.add('hidden');
      }
      renderAirportList(val);
    });

    airportSearchClear.addEventListener('click', (e) => {
      e.stopPropagation();
      airportSearchInput.value = '';
      airportSearchClear.classList.add('hidden');
      renderAirportList('');
      airportSearchInput.focus();
    });

    // Standard swap button
    const swapBtn = document.getElementById('btn-swap-airports');
    if (swapBtn) {
      swapBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        swapBtn.classList.toggle('rotate-180');

        const originCode = document.getElementById('origin-code').textContent;
        const originCity = document.getElementById('origin-city').textContent;
        const originCountry = document.getElementById('origin-country').textContent;

        const destCode = document.getElementById('destination-code').textContent;
        const destCity = document.getElementById('destination-city').textContent;
        const destCountry = document.getElementById('destination-country').textContent;

        document.getElementById('origin-code').textContent = destCode;
        document.getElementById('origin-city').textContent = destCity;
        document.getElementById('origin-country').textContent = destCountry;

        document.getElementById('destination-code').textContent = originCode;
        document.getElementById('destination-city').textContent = originCity;
        document.getElementById('destination-country').textContent = originCountry;
      });
    }

    // Bind standard mode origin and destination boxes
    const originBox = document.getElementById('origin-box');
    const destinationBox = document.getElementById('destination-box');

    if (originBox) {
      originBox.addEventListener('click', (e) => {
        e.stopPropagation();
        openAirportDropdown(originBox);
      });
    }

    if (destinationBox) {
      destinationBox.addEventListener('click', (e) => {
        e.stopPropagation();
        openAirportDropdown(destinationBox);
      });
    }

    // 3. INTERACTIVE LUXURY CALENDAR POPUP SYSTEM
    const calendarModal = document.getElementById('luxury-calendar-modal');
    const calTitle = document.getElementById('cal-title');
    const calDaysGrid = document.getElementById('cal-days-grid');
    const btnPrevMonth = document.getElementById('btn-prev-month');
    const btnNextMonth = document.getElementById('btn-next-month');
    const btnCloseCalendar = document.getElementById('btn-close-calendar');

    const depDateContainer = document.getElementById('departure-date-container');
    const retDateContainer = document.getElementById('return-date-container');
    const depDateDisplay = document.getElementById('departure-date-display');
    const depSubDisplay = document.getElementById('departure-sub-display');
    const retDateDisplay = document.getElementById('return-date-display');
    const retSubDisplay = document.getElementById('return-sub-display');

    let activeCalendarTarget = 'departure';
    let activeMulticityDateBox = null;
    let activeAnchorElement = null;

    let selectedDepartureDate = new Date(2026, 9, 24);
    let selectedReturnDate = new Date(2026, 10, 2);
    let currentCalViewMonth = 9;
    let currentCalViewYear = 2026;

    const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
    const monthShortNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    const dayNames = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];

    function renderCalendar() {
      calTitle.textContent = `${monthNames[currentCalViewMonth]} ${currentCalViewYear}`;
      calDaysGrid.innerHTML = '';

      const firstDayIndex = new Date(currentCalViewYear, currentCalViewMonth, 1).getDay();
      const totalDays = new Date(currentCalViewYear, currentCalViewMonth + 1, 0).getDate();

      for (let i = 0; i < firstDayIndex; i++) {
        const emptyCell = document.createElement('div');
        emptyCell.className = 'h-9 w-9';
        calDaysGrid.appendChild(emptyCell);
      }

      const minSelectableDate = new Date(2026, 0, 1);

      for (let day = 1; day <= totalDays; day++) {
        const thisDate = new Date(currentCalViewYear, currentCalViewMonth, day);
        const dayBtn = document.createElement('button');
        dayBtn.type = 'button';
        dayBtn.textContent = day;
        dayBtn.className = 'h-9 w-9 mx-auto flex items-center justify-center rounded-lg text-xs font-semibold tabular-nums transition-all';

        const isPast2026 = thisDate < minSelectableDate;

        if (isPast2026) {
          dayBtn.className += ' text-on-surface-variant/30 cursor-not-allowed';
          dayBtn.disabled = true;
        } else {
          let isCurrentSelection = false;
          if (activeCalendarTarget === 'departure' && thisDate.toDateString() === selectedDepartureDate.toDateString()) {
            isCurrentSelection = true;
          } else if (activeCalendarTarget === 'return' && thisDate.toDateString() === selectedReturnDate.toDateString()) {
            isCurrentSelection = true;
          }

          if (isCurrentSelection) {
            dayBtn.className += ' bg-[#0B192C] text-white shadow-md font-bold scale-105 ring-2 ring-secondary/50';
          } else {
            dayBtn.className += ' text-primary hover:bg-secondary/15 hover:text-secondary';
          }

          dayBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            onDateSelected(new Date(thisDate));
          });
        }
        calDaysGrid.appendChild(dayBtn);
      }
    }

    function onDateSelected(dateObj) {
      if (activeCalendarTarget === 'departure') {
        selectedDepartureDate = dateObj;
        depDateDisplay.textContent = `${monthShortNames[dateObj.getMonth()]} ${String(dateObj.getDate()).padStart(2, '0')}`;
        depSubDisplay.textContent = `${dayNames[dateObj.getDay()]}, ${dateObj.getFullYear()}`;

        if (selectedReturnDate < selectedDepartureDate) {
          selectedReturnDate = new Date(selectedDepartureDate.getTime() + (7 * 24 * 60 * 60 * 1000));
          retDateDisplay.textContent = `${monthShortNames[selectedReturnDate.getMonth()]} ${String(selectedReturnDate.getDate()).padStart(2, '0')}`;
          retSubDisplay.textContent = `${dayNames[selectedReturnDate.getDay()]}, ${selectedReturnDate.getFullYear()}`;
        }
      } else if (activeCalendarTarget === 'return') {
        selectedReturnDate = dateObj;
        retDateDisplay.textContent = `${monthShortNames[dateObj.getMonth()]} ${String(dateObj.getDate()).padStart(2, '0')}`;
        retSubDisplay.textContent = `${dayNames[dateObj.getDay()]}, ${dateObj.getFullYear()}`;
      } else if (activeCalendarTarget === 'multicity' && activeMulticityDateBox) {
        const valElem = activeMulticityDateBox.querySelector('.segment-date-val');
        if (valElem) {
          valElem.textContent = `${String(dateObj.getDate()).padStart(2, '0')} ${monthShortNames[dateObj.getMonth()]} ${dateObj.getFullYear()}`;
        }
      }

      closeCalendar();
    }

    btnPrevMonth.addEventListener('click', (e) => {
      e.stopPropagation();
      if (currentCalViewYear === 2026 && currentCalViewMonth === 0) return;
      if (currentCalViewMonth === 0) {
        currentCalViewMonth = 11;
        currentCalViewYear--;
      } else {
        currentCalViewMonth--;
      }
      renderCalendar();
    });

    btnNextMonth.addEventListener('click', (e) => {
      e.stopPropagation();
      if (currentCalViewMonth === 11) {
        currentCalViewMonth = 0;
        currentCalViewYear++;
      } else {
        currentCalViewMonth++;
      }
      renderCalendar();
    });

    function closeCalendar() {
      calendarModal.classList.add('hidden');
      activeAnchorElement = null;
    }

    btnCloseCalendar.addEventListener('click', (e) => {
      e.stopPropagation();
      closeCalendar();
    });

    function openCalendar(targetType, initialDate, anchorElem) {
      if (!calendarModal.classList.contains('hidden') && activeAnchorElement === anchorElem) {
        closeCalendar();
        return;
      }
      activeCalendarTarget = targetType;
      activeAnchorElement = anchorElem;
      currentCalViewMonth = initialDate.getMonth();
      currentCalViewYear = initialDate.getFullYear();
      renderCalendar();

      anchorElem.appendChild(calendarModal);
      calendarModal.classList.remove('hidden');

      const rect = anchorElem.getBoundingClientRect();
      const calWidth = 340;
      if (rect.left + calWidth > window.innerWidth - 16) {
        calendarModal.style.left = 'auto';
        calendarModal.style.right = '0';
      } else {
        calendarModal.style.left = '0';
        calendarModal.style.right = 'auto';
      }
      calendarModal.style.top = '100%';

      closeAirportDropdown();
      closePassengersPopover();
    }

    depDateContainer.addEventListener('click', (e) => {
      e.stopPropagation();
      openCalendar('departure', selectedDepartureDate, depDateContainer);
    });

    retDateContainer.addEventListener('click', (e) => {
      e.stopPropagation();
      if (currentTripMode === 'one-way') return;
      openCalendar('return', selectedReturnDate, retDateContainer);
    });

    // 4. MULTI-CITY ROWS INTERACTION & DYNAMIC ADDITION
    const multicityRowsContainer = document.getElementById('multicity-rows-container');
    const btnAddFlight = document.getElementById('btn-add-flight');
    let multicityFlightCount = 2;

    function attachSegmentEvents(row) {
      // From Airport Picker
      const fromField = row.querySelector('.segment-origin-trigger');
      if (fromField) {
        fromField.addEventListener('click', (e) => {
          e.stopPropagation();
          openAirportDropdown(fromField);
        });
      }

      // To Airport Picker
      const toField = row.querySelector('.segment-dest-trigger');
      if (toField) {
        toField.addEventListener('click', (e) => {
          e.stopPropagation();
          openAirportDropdown(toField);
        });
      }

      // Date Picker Trigger
      const dateBox = row.querySelector('.segment-date-box');
      if (dateBox) {
        dateBox.addEventListener('click', (e) => {
          e.stopPropagation();
          activeMulticityDateBox = dateBox;
          openCalendar('multicity', new Date(2026, 8, 11), dateBox);
        });
      }

      // Swap button
      const swap = row.querySelector('.segment-swap-btn');
      if (swap) {
        swap.addEventListener('click', (e) => {
          e.stopPropagation();
          const fromInput = row.querySelector('.segment-from-input');
          const toInput = row.querySelector('.segment-to-input');
          if (fromInput && toInput) {
            const temp = fromInput.value;
            fromInput.value = toInput.value;
            toInput.value = temp;
          }
        });
      }

      // Passengers / Class trigger in multi-city
      const passTrigger = row.querySelector('.multicity-passenger-trigger');
      if (passTrigger) {
        passTrigger.addEventListener('click', (e) => {
          e.stopPropagation();
          openPassengersPopover(passTrigger);
        });
      }

      // Remove button
      const removeBtn = row.querySelector('.btn-remove-segment');
      if (removeBtn) {
        removeBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const allRows = multicityRowsContainer.querySelectorAll('.multicity-row');
          if (allRows.length > 2) {
            if (row.contains(airportDropdown)) {
              closeAirportDropdown();
              document.body.appendChild(airportDropdown);
            }
            if (row.contains(calendarModal)) {
              closeCalendar();
              document.body.appendChild(calendarModal);
            }
            if (row.contains(passengersPopover)) {
              closePassengersPopover();
              document.body.appendChild(passengersPopover);
            }
            row.remove();
            btnAddFlight.disabled = false;
            btnAddFlight.classList.remove('opacity-50', 'cursor-not-allowed');
          }
        });
      }
    }

    document.querySelectorAll('.multicity-row').forEach(r => attachSegmentEvents(r));

    btnAddFlight.addEventListener('click', () => {
      const currentRows = multicityRowsContainer.querySelectorAll('.multicity-row');
      if (currentRows.length >= 3) {
        return;
      }

      multicityFlightCount++;
      const lastRow = currentRows[currentRows.length - 1];
      const lastToVal = lastRow.querySelector('.segment-to-input')?.value || 'Dubai DXB';

      const newRow = document.createElement('div');
      newRow.className = 'multicity-row bg-surface-container-lowest border border-outline-variant/60 rounded-xl shadow-sm hover:border-secondary/70 transition-all p-2 sm:p-2.5 flex flex-col md:flex-row items-stretch md:items-center gap-2 relative group';
      newRow.setAttribute('data-row-id', multicityFlightCount);

      newRow.innerHTML = `
        <div class="airport-field flex-1 min-w-[140px] px-3 py-1.5 rounded-lg hover:bg-surface-container-low transition-colors cursor-pointer segment-origin-trigger relative" data-field-role="multicity-from">
          <span class="block text-[11px] font-label-caps uppercase tracking-wider text-on-surface-variant">From</span>
          <div class="flex items-baseline gap-1.5">
            <input class="w-full bg-transparent border-none p-0 text-sm md:text-base font-semibold text-primary focus:ring-0 segment-from-input pointer-events-none" placeholder="Origin" readonly type="text" value="${lastToVal}"/>
          </div>
        </div>
        <div class="flex items-center justify-center px-1">
          <button class="w-8 h-8 rounded-full hover:bg-surface-container text-on-surface-variant hover:text-primary transition-colors flex items-center justify-center segment-swap-btn" title="Swap cities" type="button">
            <span class="material-symbols-outlined text-[18px]">sync_alt</span>
          </button>
        </div>
        <div class="airport-field flex-1 min-w-[140px] px-3 py-1.5 rounded-lg hover:bg-surface-container-low transition-colors cursor-pointer segment-dest-trigger relative" data-field-role="multicity-to">
          <span class="block text-[11px] font-label-caps uppercase tracking-wider text-on-surface-variant">To</span>
          <div class="flex items-baseline gap-1.5">
            <input class="w-full bg-transparent border-none p-0 text-sm md:text-base font-semibold text-primary focus:ring-0 segment-to-input pointer-events-none" placeholder="Destination" readonly type="text" value="Tokyo HND"/>
          </div>
        </div>
        <div class="hidden md:block w-px h-9 bg-outline-variant/40 my-auto"></div>
        <div class="relative w-full md:w-44 px-3 py-1.5 rounded-lg hover:bg-surface-container-low transition-colors cursor-pointer segment-date-box" data-target="multicity-${multicityFlightCount}">
          <span class="block text-[11px] font-label-caps uppercase tracking-wider text-on-surface-variant">Departure</span>
          <span class="text-sm md:text-base font-semibold text-primary block tabular-nums segment-date-val">15 Sep 2026</span>
        </div>
        <div class="flex items-center justify-end px-2">
          <button class="w-8 h-8 rounded-full text-on-surface-variant hover:text-error hover:bg-error-container/40 flex items-center justify-center transition-colors btn-remove-segment" title="Remove Flight" type="button">
            <span class="material-symbols-outlined text-[18px]">close</span>
          </button>
        </div>
      `;

      multicityRowsContainer.appendChild(newRow);
      attachSegmentEvents(newRow);
      if (multicityRowsContainer.querySelectorAll('.multicity-row').length >= 3) {
        btnAddFlight.disabled = true;
        btnAddFlight.classList.add('opacity-50', 'cursor-not-allowed');
      }
    });

    // 5. UNIFIED PASSENGERS & CLASS SELECTOR SYSTEM
    const passengersPopover = document.getElementById('universal-passengers-popover');
    const standardPassengerTrigger = document.querySelector('.passenger-trigger-standard');
    const btnClosePassengers = document.getElementById('btn-close-passengers');
    const btnApplyPassengers = document.getElementById('btn-apply-passengers');

    let activePassengerAnchor = null;

    let countAdults = 1;
    let countChildren = 0;
    let countInfants = 0;
    let currentCabinChoice = 'Business Class';

    const valAdults = document.getElementById('val-adults');
    const valChildren = document.getElementById('val-children');
    const valInfants = document.getElementById('val-infants');
    const btnDecAdults = document.getElementById('btn-dec-adults');
    const btnDecChildren = document.getElementById('btn-dec-children');
    const btnDecInfants = document.getElementById('btn-dec-infants');

    function updateCountersDisplay() {
      valAdults.textContent = countAdults;
      valChildren.textContent = countChildren;
      valInfants.textContent = countInfants;
      btnDecAdults.disabled = countAdults <= 1;
      btnDecChildren.disabled = countChildren <= 0;
      btnDecInfants.disabled = countInfants <= 0;
    }

    document.getElementById('btn-inc-adults').addEventListener('click', (e) => {
      e.stopPropagation();
      if (countAdults < 9) countAdults++;
      updateCountersDisplay();
    });
    btnDecAdults.addEventListener('click', (e) => {
      e.stopPropagation();
      if (countAdults > 1) countAdults--;
      updateCountersDisplay();
    });

    document.getElementById('btn-inc-children').addEventListener('click', (e) => {
      e.stopPropagation();
      if (countChildren < 9) countChildren++;
      updateCountersDisplay();
    });
    btnDecChildren.addEventListener('click', (e) => {
      e.stopPropagation();
      if (countChildren > 0) countChildren--;
      updateCountersDisplay();
    });

    document.getElementById('btn-inc-infants').addEventListener('click', (e) => {
      e.stopPropagation();
      if (countInfants < 4) countInfants++;
      updateCountersDisplay();
    });
    btnDecInfants.addEventListener('click', (e) => {
      e.stopPropagation();
      if (countInfants > 0) countInfants--;
      updateCountersDisplay();
    });

    document.querySelectorAll('input[name="cabin-class-choice"]').forEach(radio => {
      radio.addEventListener('change', (e) => {
        currentCabinChoice = e.target.value;
      });
    });

    function getPassengerSummaryText() {
      const total = countAdults + countChildren + countInfants;
      const passWord = total === 1 ? '1 Passenger' : `${total} Passengers`;
      return `${passWord}, ${currentCabinChoice}`;
    }

    function applyPassengerSelection() {
      const summary = getPassengerSummaryText();

      // Standard mode trigger update
      const guestsDisplay = document.getElementById('guests-display');
      const cabinDisplay = document.getElementById('cabin-display');
      if (guestsDisplay) guestsDisplay.textContent = summary;
      if (cabinDisplay) cabinDisplay.textContent = currentCabinChoice.toUpperCase();

      // Multi-city triggers update
      document.querySelectorAll('.mc-passenger-label').forEach(label => {
        label.textContent = summary;
      });

      closePassengersPopover();
    }

    function openPassengersPopover(anchor) {
      if (!passengersPopover.classList.contains('hidden') && activePassengerAnchor === anchor) {
        closePassengersPopover();
        return;
      }

      activePassengerAnchor = anchor;
      updateCountersDisplay();

      anchor.appendChild(passengersPopover);
      passengersPopover.classList.remove('hidden');

      const rect = anchor.getBoundingClientRect();
      const popWidth = 380;
      if (rect.left + popWidth > window.innerWidth - 16) {
        passengersPopover.style.left = 'auto';
        passengersPopover.style.right = '0';
      } else {
        passengersPopover.style.left = '0';
        passengersPopover.style.right = 'auto';
      }
      passengersPopover.style.top = '100%';

      closeAirportDropdown();
      closeCalendar();
    }

    function closePassengersPopover() {
      passengersPopover.classList.add('hidden');
      activePassengerAnchor = null;
    }

    if (standardPassengerTrigger) {
      standardPassengerTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        openPassengersPopover(standardPassengerTrigger);
      });
    }

    btnClosePassengers.addEventListener('click', (e) => {
      e.stopPropagation();
      closePassengersPopover();
    });

    btnApplyPassengers.addEventListener('click', (e) => {
      e.stopPropagation();
      applyPassengerSelection();
    });

    // Close popovers on click outside
    document.addEventListener('click', (e) => {
      if (airportDropdown && !airportDropdown.contains(e.target) && !e.target.closest('.airport-field')) {
        closeAirportDropdown();
      }
      if (passengersPopover && !passengersPopover.contains(e.target) && !e.target.closest('.passenger-trigger-standard') && !e.target.closest('.multicity-passenger-trigger')) {
        closePassengersPopover();
      }
      if (calendarModal && !calendarModal.contains(e.target) && !depDateContainer?.contains(e.target) && !retDateContainer?.contains(e.target) && !e.target.closest('.segment-date-box')) {
        closeCalendar();
      }
    });

    // ESC key closes any open dropdown
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeAirportDropdown();
        closeCalendar();
        closePassengersPopover();
      }
    });

    // Search Flights Button Feedback
    const searchBtn = document.getElementById('btn-search-flights');
    if (searchBtn) {
      searchBtn.addEventListener('click', () => {
        sessionStorage.setItem('skybook-search-context', JSON.stringify({
          mode: currentTripMode,
          originCode: document.getElementById('origin-code')?.textContent.trim(),
          originCity: document.getElementById('origin-city')?.textContent.trim(),
          destinationCode: document.getElementById('destination-code')?.textContent.trim(),
          destinationCity: document.getElementById('destination-city')?.textContent.trim(),
          departure: document.getElementById('departure-date-display')?.textContent.trim(),
          returnDate: document.getElementById('return-date-display')?.textContent.trim(),
          passengers: document.getElementById('guests-display')?.textContent.trim(),
          cabin: currentCabinChoice
        }));
        sessionStorage.setItem('skybook-trip-mode', currentTripMode);
        searchBtn.classList.add('scale-95');
        setTimeout(() => {
          searchBtn.classList.remove('scale-95');
          window.location.href = '/Flight/Results';
        }, 150);
      });
    }

    const skyClubButton = [...document.querySelectorAll('button')].find(button => button.textContent.includes('Explore SkyClub Tiers'));
    if (skyClubButton) {
      skyClubButton.addEventListener('click', () => {
        window.location.href = '/Home/SkyClub';
      });
    }

    const featuredFlightButton = document.getElementById('featured-flight-btn');
    if (featuredFlightButton) {
      featuredFlightButton.addEventListener('click', () => {
        window.location.href = '/Flight/Results';
      });
    }

    // Initialize displays
    updateCountersDisplay();
  });
</script>
}