@{
    ViewData["Title"] = "Home";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/cards-mobile.css" />
<style>@@layer base{html,body{margin:0;padding:0;height:auto;min-height:100%;}html{overflow-y:scroll;}body{overflow-x:hidden;overflow-y:auto;overscroll-behavior-y:auto;}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}</style>
}

<div class="flex flex-col w-full">
<!-- Cinematic Aircraft Hero -->
<section class="relative w-full -mt-20 overflow-hidden">
<!-- Image Backdrop with refined cinematic gradient scrims -->
<div class="absolute inset-0 w-full h-full bg-cover bg-center" style="background-image: url(&quot;/images/Hero.jpeg&quot;);">
<div class="absolute inset-0 bg-gradient-to-t from-background via-primary/40 to-primary/80 mix-blend-multiply"></div>
<div class="absolute inset-0 bg-gradient-to-r from-primary/70 via-transparent to-primary/50"></div>
<div class="absolute bottom-0 inset-x-0 h-48 bg-gradient-to-b from-transparent to-background"></div>
</div>
<!-- Hero Content Container -->
<div class="relative max-w-7xl mx-auto px-6 lg:px-12 pt-36 pb-32 lg:pt-44 lg:pb-40 flex flex-col items-start text-left">
<!-- Sovereign Badge -->
<div class="inline-flex items-center gap-space-xs px-3.5 py-1.5 rounded-full bg-surface-container-lowest/15 backdrop-blur-md mb-6 shadow-sm">
<span class="w-1.5 h-1.5 rounded-full bg-secondary-fixed animate-pulse"></span>
<span class="font-label-caps text-label-caps text-secondary-fixed tracking-widest uppercase">The Sovereign Skyways • Flagship 2025</span>
</div>
<!-- Headline -->
<h1 class="font-display-hero text-display-hero text-on-primary max-w-4xl tracking-tight leading-tight">
        Experience Flight in its Purest Elegance
      </h1>
<p class="font-body-lg text-body-lg text-surface-variant max-w-2xl mt-4 text-balance">
        Curated long-haul journeys connecting Dubai, London, New York, Tokyo and beyond in unmatched comfort.
      </p>
<!-- Key Metrics Strip -->
<div class="hidden sm:flex items-center gap-8 mt-8 text-on-primary/90">
<div class="flex flex-col">
<span class="font-title-flight-code text-title-flight-code tracking-wide text-secondary-fixed">100%</span>
<span class="font-label-caps text-label-caps uppercase tracking-wider text-surface-variant">Private Lie-Flat Suites</span>
</div>
<div class="w-px h-8 bg-surface-variant/30"></div>
<div class="flex flex-col">
<span class="font-title-flight-code text-title-flight-code tracking-wide text-secondary-fixed">38</span>
<span class="font-label-caps text-label-caps uppercase tracking-wider text-surface-variant">Global Flagship Lounges</span>
</div>
<div class="w-px h-8 bg-surface-variant/30"></div>
<div class="flex flex-col">
<span class="font-title-flight-code text-title-flight-code tracking-wide text-secondary-fixed">5★</span>
<span class="font-label-caps text-label-caps uppercase tracking-wider text-surface-variant">Skytrax Certified Sovereign</span>
</div>
</div>
</div>
</section>
<!-- Overlapping Booking Card Module -->
<section class="relative z-20 max-w-7xl mx-auto px-6 lg:px-12 w-full -mt-24 lg:-mt-28">
<div class="w-full bg-surface-container-lowest rounded-xl shadow-[0_16px_48px_-12px_rgba(14,28,47,0.18)] p-6 lg:p-8 overflow-visible relative">
<!-- Search Engine Top Bar: Tabs Only (Fare Type Removed) -->
<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6">
<!-- Trip Type Selector Tabs -->
<div class="inline-flex items-center p-1 rounded-lg bg-surface-container" id="trip-tabs">
<button class="px-5 py-2 rounded-md font-label-caps text-label-caps uppercase tracking-wider transition-all bg-[#0B192C] text-white shadow-sm" data-trip="round-trip" id="tab-round-trip" type="button">
            Round Trip
          </button>
<button class="px-5 py-2 rounded-md font-label-caps text-label-caps uppercase tracking-wider transition-all text-on-surface-variant hover:text-on-surface" data-trip="one-way" id="tab-one-way" type="button">
            One Way
          </button>
<button class="px-5 py-2 rounded-md font-label-caps text-label-caps uppercase tracking-wider transition-all text-on-surface-variant hover:text-on-surface" data-trip="multi-city" id="tab-multi-city" type="button">
            Multi-City
          </button>
</div>
<div class="hidden sm:flex items-center gap-2 text-xs font-medium text-on-surface-variant">
<span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
<span class="">Live Sovereign Seat Inventory 2026</span>
</div>
</div>
<!-- Standard Mode: Round Trip & One Way Inputs Grid -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-3 items-stretch relative" id="standard-search-container">
<!-- Combined Departure & Destination with Seam-Centered Swap Button -->
<div class="lg:col-span-6 relative grid grid-cols-1 sm:grid-cols-2 rounded-lg bg-surface-container-low p-1 gap-1">
<!-- Departure (From) -->
<div class="airport-field relative flex flex-col justify-between p-3.5 rounded-md hover:bg-surface-container transition-colors cursor-pointer group" data-field-role="origin" id="origin-box">
<div class="flex items-center justify-between mb-1">
<span class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider">Departure From</span>
<span class="material-symbols-outlined text-[16px] text-secondary">flight_takeoff</span>
</div>
<div class="flex items-baseline gap-2">
<span class="font-title-flight-code text-title-flight-code text-primary tabular-nums transition-transform duration-300" id="origin-code">LHR</span>
<span class="font-body-md text-body-md text-on-surface font-medium truncate" id="origin-city">London Heathrow</span>
</div>
<span class="font-body-sm text-body-sm text-on-surface-variant" id="origin-country">United Kingdom</span>
</div>
<!-- Overlapping Centered Route Swap Button -->
<div class="hidden sm:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-20 pointer-events-auto">
<button class="w-8 h-8 rounded-full bg-surface-container-lowest border border-outline-variant/50 hover:bg-surface-container flex items-center justify-center text-primary transition-transform duration-300 shadow-md" id="btn-swap-airports" title="Swap departure and destination" type="button">
<span class="material-symbols-outlined text-[16px]">swap_horiz</span>
</button>
</div>
<!-- Destination (To) -->
<div class="airport-field relative flex flex-col justify-between p-3.5 rounded-md hover:bg-surface-container transition-colors cursor-pointer group" data-field-role="destination" id="destination-box">
<div class="flex items-center justify-between mb-1">
<span class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider">Destination</span>
<span class="material-symbols-outlined text-[16px] text-secondary">flight_land</span>
</div>
<div class="flex items-baseline gap-2">
<span class="font-title-flight-code text-title-flight-code text-primary tabular-nums transition-transform duration-300" id="destination-code">DXB</span>
<span class="font-body-md text-body-md text-on-surface font-medium truncate" id="destination-city">Dubai Intl</span>
</div>
<span class="font-body-sm text-body-sm text-on-surface-variant" id="destination-country">United Arab Emirates</span>
</div>
</div>
<!-- Dates (Departure & Return) with Interactive Popup Calendar -->
<div class="lg:col-span-3 grid grid-cols-2 gap-2 relative">
<!-- Departure Date Container -->
<div class="relative flex flex-col justify-between p-3.5 rounded-lg bg-surface-container-low hover:bg-surface-container transition-colors cursor-pointer group border border-transparent hover:border-outline-variant/40" id="departure-date-container">
<div class="flex items-center justify-between">
<span class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider mb-1">Departure</span>
<span class="material-symbols-outlined text-[16px] text-secondary group-hover:scale-110 transition-transform">calendar_month</span>
</div>
<span class="font-headline-sm text-headline-sm text-primary font-semibold tabular-nums" id="departure-date-display">Oct 24</span>
<span class="font-body-sm text-body-sm text-on-surface-variant tabular-nums" id="departure-sub-display">Saturday, 2026</span>
</div>
<!-- Return Date Container -->
<div class="relative flex flex-col justify-between p-3.5 rounded-lg bg-surface-container-low hover:bg-surface-container transition-all cursor-pointer group border border-transparent hover:border-outline-variant/40" id="return-date-container">
<div class="flex items-center justify-between">
<span class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider mb-1">Return</span>
<span class="material-symbols-outlined text-[16px] text-secondary group-hover:scale-110 transition-transform">calendar_month</span>
</div>
<span class="font-headline-sm text-headline-sm text-primary font-semibold tabular-nums" id="return-date-display">Nov 02</span>
<span class="font-body-sm text-body-sm text-on-surface-variant tabular-nums" id="return-sub-display">Monday, 2026</span>
</div>
</div>
<!-- Passengers / Class Trigger (Standard Mode) -->
<div class="lg:col-span-3 relative">
<div class="h-full flex flex-col justify-between p-3.5 rounded-lg bg-surface-container-low hover:bg-surface-container transition-colors cursor-pointer group passenger-trigger-standard" id="guests-trigger">
<div class="flex items-center justify-between">
<span class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider mb-1">Passengers / Class</span>
<span class="material-symbols-outlined text-[18px] text-on-surface-variant group-hover:text-primary transition-colors">expand_more</span>
</div>
<span class="text-sm md:text-base font-semibold text-primary truncate" id="guests-display">1 Passenger, Business Class</span>
<span class="font-label-caps text-label-caps uppercase tracking-wider text-secondary font-semibold" id="cabin-display">Business Class</span>
</div>
</div>
</div>
<!-- Multi-City Mode Container (Matches Image Reference) -->
<div class="space-y-3 hidden" id="multicity-search-container">
<!-- Segment Rows Container -->
<div class="space-y-3" id="multicity-rows-container">
<!-- Flight 1 Row (Card style from reference image) -->
<div class="multicity-row bg-surface-container-lowest border border-outline-variant/60 rounded-xl shadow-sm hover:border-secondary/70 transition-all p-2 sm:p-2.5 flex flex-col md:flex-row items-stretch md:items-center gap-2 relative group" data-row-id="1">
<!-- From field -->
<div class="airport-field flex-1 min-w-[140px] px-3 py-1.5 rounded-lg hover:bg-surface-container-low transition-colors cursor-pointer segment-origin-trigger relative" data-field-role="multicity-from">
<span class="block text-[11px] font-label-caps uppercase tracking-wider text-on-surface-variant">From</span>
<div class="flex items-baseline gap-1.5">
<input class="w-full bg-transparent border-none p-0 text-sm md:text-base font-semibold text-primary focus:ring-0 segment-from-input pointer-events-none" readonly="" type="text" value="Cairo CAI">
</div>
</div>
<!-- Swap Arrow -->
<div class="flex items-center justify-center px-1">
<button class="w-8 h-8 rounded-full hover:bg-surface-container text-on-surface-variant hover:text-primary transition-colors flex items-center justify-center segment-swap-btn" title="Swap cities" type="button">
<span class="material-symbols-outlined text-[18px]">sync_alt</span>
</button>
</div>
<!-- To field -->
<div class="airport-field flex-1 min-w-[140px] px-3 py-1.5 rounded-lg hover:bg-surface-container-low transition-colors cursor-pointer segment-dest-trigger relative" data-field-role="multicity-to">
<span class="block text-[11px] font-label-caps uppercase tracking-wider text-on-surface-variant">To</span>
<div class="flex items-baseline gap-1.5">
<input class="w-full bg-transparent border-none p-0 text-sm md:text-base font-semibold text-primary focus:ring-0 segment-to-input pointer-events-none" readonly="" type="text" value="A Coruña YJC">
</div>
</div>
<!-- Vertical Divider -->
<div class="hidden md:block w-px h-9 bg-outline-variant/40 my-auto"></div>
<!-- Departure Date Field -->
<div class="relative w-full md:w-44 px-3 py-1.5 rounded-lg hover:bg-surface-container-low transition-colors cursor-pointer segment-date-box" data-target="multicity-1">
<span class="block text-[11px] font-label-caps uppercase tracking-wider text-on-surface-variant">Departure</span>
<span class="text-sm md:text-base font-semibold text-primary block tabular-nums segment-date-val">11 Sep 2026</span>
</div>
<!-- Vertical Divider -->
<div class="hidden md:block w-px h-9 bg-outline-variant/40 my-auto"></div>
<!-- Passengers / Class Field -->
<div class="relative w-full md:w-60 px-3 py-1.5 rounded-lg hover:bg-surface-container-low transition-colors cursor-pointer flex items-center justify-between multicity-passenger-trigger">
<div>
<span class="block text-[11px] font-label-caps uppercase tracking-wider text-on-surface-variant">Passengers / Class</span>
<span class="text-sm md:text-base font-semibold text-primary block truncate mc-passenger-label">1 Passenger, Economy</span>
</div>
<span class="material-symbols-outlined text-[18px] text-on-surface-variant ml-1">expand_more</span>
</div>
</div>
<!-- Flight 2 Row -->
<div class="multicity-row bg-surface-container-lowest border border-outline-variant/60 rounded-xl shadow-sm hover:border-secondary/70 transition-all p-2 sm:p-2.5 flex flex-col md:flex-row items-stretch md:items-center gap-2 relative group" data-row-id="2">
<!-- From field -->
<div class="airport-field flex-1 min-w-[140px] px-3 py-1.5 rounded-lg hover:bg-surface-container-low transition-colors cursor-pointer segment-origin-trigger relative" data-field-role="multicity-from">
<span class="block text-[11px] font-label-caps uppercase tracking-wider text-on-surface-variant">From</span>
<div class="flex items-baseline gap-1.5">
<input class="w-full bg-transparent border-none p-0 text-sm md:text-base font-semibold text-primary focus:ring-0 segment-from-input pointer-events-none" placeholder="Origin airport or city" readonly="" type="text" value="A Coruña YJC">
</div>
</div>
<!-- Swap Arrow -->
<div class="flex items-center justify-center px-1">
<button class="w-8 h-8 rounded-full hover:bg-surface-container text-on-surface-variant hover:text-primary transition-colors flex items-center justify-center segment-swap-btn" title="Swap cities" type="button">
<span class="material-symbols-outlined text-[18px]">sync_alt</span>
</button>
</div>
<!-- To field -->
<div class="airport-field flex-1 min-w-[140px] px-3 py-1.5 rounded-lg hover:bg-surface-container-low transition-colors cursor-pointer segment-dest-trigger relative" data-field-role="multicity-to">
<span class="block text-[11px] font-label-caps uppercase tracking-wider text-on-surface-variant">To</span>
<div class="flex items-baseline gap-1.5">
<input class="w-full bg-transparent border-none p-0 text-sm md:text-base font-semibold text-primary focus:ring-0 segment-to-input pointer-events-none" placeholder="Destination airport or city" readonly="" type="text" value="Dubai DXB">
</div>
</div>
<!-- Vertical Divider -->
<div class="hidden md:block w-px h-9 bg-outline-variant/40 my-auto"></div>
<!-- Departure Date Field -->
<div class="relative w-full md:w-44 px-3 py-1.5 rounded-lg hover:bg-surface-container-low transition-colors cursor-pointer segment-date-box" data-target="multicity-2">
<span class="block text-[11px] font-label-caps uppercase tracking-wider text-on-surface-variant">Departure</span>
<span class="text-sm md:text-base font-semibold text-primary block tabular-nums segment-date-val">12 Sep 2026</span>
</div>
<!-- Optional Delete Button for Segment 2+ -->
<div class="flex items-center justify-end px-2">
<button class="w-8 h-8 rounded-full text-on-surface-variant hover:text-error hover:bg-error-container/40 flex items-center justify-center transition-colors btn-remove-segment" title="Remove Flight" type="button">
<span class="material-symbols-outlined text-[18px]">close</span>
</button>
</div>
</div>
</div>
<!-- Add Flight Button Row -->
<div class="pt-2 flex items-center justify-between">
<button class="inline-flex items-center gap-1.5 text-secondary hover:text-on-secondary-fixed font-semibold text-sm transition-colors py-1 px-2 rounded-md hover:bg-secondary-container/20" id="btn-add-flight" type="button">
<span class="material-symbols-outlined text-[20px]">add</span>
<span class="">Add a flight</span>
</button>
<span class="text-xs text-on-surface-variant hidden sm:inline">Add up to 3 multi-city sovereign segments</span>
</div>
</div>
<!-- Universal Elevated Passengers & Cabin Class Popover (Dynamically repositioned on click) -->
<div class="hidden absolute w-80 sm:w-96 bg-surface-container-lowest rounded-2xl shadow-[0_20px_48px_rgba(11,25,44,0.22)] border border-outline-variant/50 p-5 z-50 backdrop-blur-xl animate-in fade-in zoom-in-95 duration-150 pointer-events-auto" id="universal-passengers-popover">
<div class="flex items-center justify-between pb-3 border-b border-surface-container">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-secondary text-[20px]">group</span>
<span class="font-headline-sm text-sm font-bold text-primary tracking-tight">Passengers &amp; Cabin Class</span>
</div>
<button class="w-7 h-7 rounded-full hover:bg-surface-container flex items-center justify-center text-on-surface-variant hover:text-primary transition-colors" id="btn-close-passengers" type="button">
<span class="material-symbols-outlined text-[18px]">close</span>
</button>
</div>
<!-- Steppers Container -->
<div class="py-3.5 space-y-3.5 divide-y divide-surface-container/60">
<!-- Adults -->
<div class="flex items-center justify-between pt-1">
<div>
<div class="text-sm font-semibold text-primary">Adults</div>
<div class="text-xs text-on-surface-variant">Age 12+ years</div>
</div>
<div class="flex items-center gap-3">
<button class="w-8 h-8 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary hover:bg-surface-container hover:border-secondary transition-colors font-bold disabled:opacity-30 disabled:cursor-not-allowed" id="btn-dec-adults" type="button" disabled="">-</button>
<span class="font-headline-sm text-sm tabular-nums font-semibold min-w-[20px] text-center text-primary" id="val-adults">1</span>
<button class="w-8 h-8 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary hover:bg-surface-container hover:border-secondary transition-colors font-bold" id="btn-inc-adults" type="button">+</button>
</div>
</div>
<!-- Children -->
<div class="flex items-center justify-between pt-3">
<div>
<div class="text-sm font-semibold text-primary">Children</div>
<div class="text-xs text-on-surface-variant">Age 2-11 years</div>
</div>
<div class="flex items-center gap-3">
<button class="w-8 h-8 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary hover:bg-surface-container hover:border-secondary transition-colors font-bold disabled:opacity-30 disabled:cursor-not-allowed" id="btn-dec-children" type="button" disabled="">-</button>
<span class="font-headline-sm text-sm tabular-nums font-semibold min-w-[20px] text-center text-primary" id="val-children">0</span>
<button class="w-8 h-8 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary hover:bg-surface-container hover:border-secondary transition-colors font-bold" id="btn-inc-children" type="button">+</button>
</div>
</div>
<!-- Infants -->
<div class="flex items-center justify-between pt-3">
<div>
<div class="text-sm font-semibold text-primary">Infants</div>
<div class="text-xs text-on-surface-variant">Under 2 years (on lap)</div>
</div>
<div class="flex items-center gap-3">
<button class="w-8 h-8 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary hover:bg-surface-container hover:border-secondary transition-colors font-bold disabled:opacity-30 disabled:cursor-not-allowed" id="btn-dec-infants" type="button" disabled="">-</button>
<span class="font-headline-sm text-sm tabular-nums font-semibold min-w-[20px] text-center text-primary" id="val-infants">0</span>
<button class="w-8 h-8 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary hover:bg-surface-container hover:border-secondary transition-colors font-bold" id="btn-inc-infants" type="button">+</button>
</div>
</div>
</div>
<!-- Cabin Class Selector -->
<div class="pt-3 border-t border-surface-container">
<span class="font-label-caps text-[11px] uppercase tracking-wider text-on-surface-variant block mb-2 font-semibold">Cabin Class</span>
<div class="grid grid-cols-2 gap-2">
<label class="cabin-radio-pill flex items-center gap-2 p-2 rounded-lg border border-outline-variant/50 hover:bg-surface-container cursor-pointer transition-colors bg-surface-container-low">
<input class="text-secondary focus:ring-secondary" name="cabin-class-choice" type="radio" value="Economy">
<span class="text-xs font-medium text-primary">Economy</span>
</label>
<label class="cabin-radio-pill flex items-center gap-2 p-2 rounded-lg border border-outline-variant/50 hover:bg-surface-container cursor-pointer transition-colors bg-surface-container-low">
<input checked="" class="text-secondary focus:ring-secondary" name="cabin-class-choice" type="radio" value="Business Class">
<span class="text-xs font-medium text-primary">Business Class</span>
</label>
<label class="cabin-radio-pill flex items-center gap-2 p-2 rounded-lg border border-outline-variant/50 hover:bg-surface-container cursor-pointer transition-colors bg-surface-container-low">
<input class="text-secondary focus:ring-secondary" name="cabin-class-choice" type="radio" value="First Sovereign Suite">
<span class="text-xs font-medium text-primary">First Sovereign Suite</span>
</label>
</div>
</div>
<!-- Apply Button -->
<div class="mt-4 pt-3 border-t border-surface-container">
<button class="w-full py-2.5 rounded-lg bg-[#0B192C] text-white font-label-caps text-label-caps uppercase tracking-wider hover:bg-secondary transition-colors font-semibold shadow-sm" id="btn-apply-passengers" type="button">
          Apply Passengers &amp; Class
        </button>
</div>
</div>
<!-- Elevated Shared Airport Picker Dropdown (Anchored to whichever field is clicked) -->
<div class="hidden absolute w-80 sm:w-96 bg-surface-container-lowest rounded-2xl shadow-[0_20px_48px_rgba(11,25,44,0.22)] border border-outline-variant/50 p-3 z-50 animate-in fade-in zoom-in-95 duration-150 backdrop-blur-xl" id="luxury-airport-dropdown">
<div class="pb-2.5 px-1">
<div class="relative flex items-center">
<span class="material-symbols-outlined text-[18px] text-secondary absolute left-3 pointer-events-none">search</span>
<input class="w-full pl-9 pr-8 py-2 bg-surface-container-low rounded-lg text-xs md:text-sm text-primary placeholder:text-on-surface-variant/70 border border-outline-variant/40 focus:border-secondary focus:ring-1 focus:ring-secondary focus:outline-none transition-all" id="airport-search-input" placeholder="Search city, code or airport..." type="text">
<button class="absolute right-2.5 text-on-surface-variant hover:text-primary transition-colors hidden" id="airport-search-clear" type="button">
<span class="material-symbols-outlined text-[16px]">close</span>
</button>
</div>
</div>
<div class="px-2 py-1 flex items-center justify-between text-[11px] font-label-caps uppercase tracking-wider text-on-surface-variant border-b border-surface-container">
<span class="">Sovereign Gateways</span>
<span class="text-[10px] text-secondary font-semibold" id="airport-results-count">11 Airfields</span>
</div>
<div class="max-h-64 overflow-y-auto divide-y divide-surface-container/60 mt-1 pr-0.5" id="airport-items-container">
<!-- Populated Dynamically via JS with full 11 Curated Luxury Gateways -->
</div>
</div>
<!-- Interactive Luxury Popup Calendar Element (Dynamically positioned beneath active date input) -->
<div class="absolute mt-2 w-80 sm:w-[340px] bg-surface-container-lowest rounded-2xl shadow-[0_20px_40px_rgba(0,0,0,0.18)] border border-[#e5e7eb] p-5 z-50 backdrop-blur-xl animate-in fade-in zoom-in-95 duration-150 hidden pointer-events-auto" id="luxury-calendar-modal">
<div class="flex items-center justify-between pb-3 border-b border-surface-container">
