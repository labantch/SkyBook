["Plus Jakarta Sans"],"title-flight-code":["Space Grotesk"],"display-hero-mobile":["Plus Jakarta Sans"]},"fontSize":{"price-lg":["24px",{"lineHeight":"28px","letterSpacing":"-0.02em","fontWeight":"700"}],"headline-md":["24px",{"lineHeight":"32px","letterSpacing":"-0.015em","fontWeight":"600"}],"body-md":["15px",{"lineHeight":"22px","fontWeight":"400"}],"headline-lg":["32px",{"lineHeight":"40px","letterSpacing":"-0.02em","fontWeight":"600"}],"body-sm":["13px",{"lineHeight":"18px","fontWeight":"400"}],"display-hero":["56px",{"lineHeight":"64px","letterSpacing":"-0.03em","fontWeight":"700"}],"label-caps":["11px",{"lineHeight":"14px","letterSpacing":"0.08em","fontWeight":"600"}],"headline-sm":["20px",{"lineHeight":"28px","fontWeight":"600"}],"body-lg":["18px",{"lineHeight":"28px","fontWeight":"400"}],"title-flight-code":["28px",{"lineHeight":"32px","letterSpacing":"0.04em","fontWeight":"700"}],"display-hero-mobile":["36px",{"lineHeight":"44px","letterSpacing":"-0.02em","fontWeight":"700"}]}}}};</script>
<script>
    let activePaymentType = null;

    function openFlightDrawer(seg) {
      const flightDrawerData = {
        1: {
          title: 'Cairo → Dubai · SB 918',
          route: 'CAI → DXB',
          aircraft: 'Boeing 787-9 Dreamliner',
          cabin: 'Economy (Horizon Flex)',
          duration: '3h 40m',
          amenities: [
            { icon: 'luggage', title: '2× 23kg Checked', sub: 'Included per guest' },
            { icon: 'restaurant', title: 'Artisan Dining', sub: 'Complimentary multi-course' },
            { icon: 'wifi', title: 'High-Speed Wi-Fi', sub: 'Messaging & streaming aloft' }
          ]
        },
        2: {
          title: 'Dubai → Cairo · SB 928',
          route: 'DXB → CAI',
          aircraft: 'Airbus A350-1000',
          cabin: 'Economy (Horizon Flex)',
          duration: '3h 35m',
          amenities: [
            { icon: 'luggage', title: '2× 23kg Checked', sub: 'Included per guest' },
            { icon: 'restaurant', title: 'Artisan Dining', sub: 'Complimentary multi-course' },
            { icon: 'wifi', title: 'High-Speed Wi-Fi', sub: 'Messaging & streaming aloft' }
          ]
        }
      };
      const data = flightDrawerData[seg];
      if (!data) return;
      document.getElementById('flight-drawer-title').textContent = data.title;
      document.getElementById('flight-drawer-body').innerHTML = `
        <div class="rounded-xl border-2 border-[#C5A880]/50 bg-white p-4 space-y-1">
          <p class="text-sm font-bold text-[#0B192C]">${data.route}</p>
          <p class="text-xs text-slate-500">${data.aircraft}</p>
          <p class="text-xs text-[#855D29] font-semibold">${data.cabin} · ${data.duration}</p>
        </div>
        <h3 class="text-[11px] font-extrabold uppercase tracking-wider text-slate-500 pt-1">Included amenities</h3>
        <div class="space-y-2.5">
          ${data.amenities.map(a => `
            <div class="flex items-start gap-3 rounded-xl border border-[#C5A880]/40 bg-white p-3.5">
              <span class="material-symbols-outlined text-[#855D29] text-xl">${a.icon}</span>
              <div>
                <p class="text-sm font-bold text-[#0B192C]">${a.title}</p>
                <p class="text-xs text-slate-500">${a.sub}</p>
              </div>
            </div>
          `).join('')}
        </div>
      `;
      const overlay = document.getElementById('flight-drawer-overlay');
      const drawer = document.getElementById('flight-drawer');
      overlay.classList.remove('hidden');
      requestAnimationFrame(() => {
        overlay.classList.remove('opacity-0');
        drawer.classList.remove('translate-x-full');
      });
      document.body.style.overflow = 'hidden';
    }

    function closeFlightDrawer() {
      const overlay = document.getElementById('flight-drawer-overlay');
      const drawer = document.getElementById('flight-drawer');
      overlay.classList.add('opacity-0');
      drawer.classList.add('translate-x-full');
      setTimeout(() => {
        overlay.classList.add('hidden');
        document.body.style.overflow = '';
      }, 300);
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeFlightDrawer();
    });

    function switchPayment(type) {
      activePaymentType = type;
      dismissPaymentAlert();

      const tabs = document.querySelectorAll('.payment-tab');
      tabs.forEach(tab => {
        const radio = tab.querySelector('input[type="radio"]');
        if (tab.getAttribute('data-tab') === type) {
          tab.classList.add('bg-surface-container-low', 'border-secondary');
          tab.classList.remove('border-transparent');
          radio.checked = true;
        } else {
          tab.classList.remove('bg-surface-container-low', 'border-secondary');
          tab.classList.add('border-transparent');
          radio.checked = false;
        }
      });

      document.getElementById('panel-card').classList.toggle('hidden', type !== 'card');
      document.getElementById('panel-fawry').classList.toggle('hidden', type !== 'fawry');
      document.getElementById('panel-meeza').classList.toggle('hidden', type !== 'meeza');
    }

    function dismissPaymentAlert() {
      const alert = document.getElementById('payment-error-alert');
      if (alert) alert.classList.add('hidden');
      const optGroup = document.getElementById('payment-options-group');
      if (optGroup) {
        optGroup.classList.remove('ring-2', 'ring-secondary', 'animate-shake');
      }
    }

    function showPaymentAlert(title, message) {
      const alert = document.getElementById('payment-error-alert');
      const titleEl = document.getElementById('payment-error-title');
      const descEl = document.getElementById('payment-error-desc');
      const optGroup = document.getElementById('payment-options-group');

      if (titleEl && title) titleEl.textContent = title;
      if (descEl && message) descEl.textContent = message;

      if (alert) {
        alert.classList.remove('hidden');
      }

      if (optGroup) {
        optGroup.classList.remove('animate-shake');
        void optGroup.offsetWidth;
        optGroup.classList.add('ring-2', 'ring-secondary', 'animate-shake');
      }
    }

    function handleTermsToggle(checkbox) {
      const termsAlert = document.getElementById('terms-alert');
      if (checkbox.checked) {
        if (termsAlert) termsAlert.classList.add('hidden');
        document.getElementById('terms-section').classList.remove('ring-1', 'ring-secondary');
      }
    }

    function formatExpiryInput(input) {
      const digits = input.value.replace(/\D/g, '').slice(0, 4);
      input.value = digits.length > 2 ? digits.slice(0, 2) + '/' + digits.slice(2) : digits;
    }

    function isValidExpiry(value) {
      const match = /^(0[1-9]|1[0-2])\/([0-9]{2})$/.exec(value);
      if (!match) return false;
      const now = new Date();
      const expiryYear = 2000 + Number(match[2]);
      const expiryMonth = Number(match[1]);
      return expiryYear > now.getFullYear() || (expiryYear === now.getFullYear() && expiryMonth >= now.getMonth() + 1);
    }

    function executePayment() {
      const termsBox = document.getElementById('terms-checkbox');
      const termsSection = document.getElementById('terms-section');
      const termsAlert = document.getElementById('terms-alert');
      const paymentSection = document.getElementById('payment-method-section');

      // 1. Validate payment selection
      if (!activePaymentType) {
        paymentSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
        showPaymentAlert('Please select a payment method', 'Choose Credit / Debit, Fawry Pay, or Meeza Card to continue with your secure checkout.');
        
        const firstRadio = document.getElementById('payment-radio-card');
        if (firstRadio) firstRadio.focus();
        return;
      }

      // 2. Validate payment-specific fields
      if (activePaymentType === 'card') {
        const cardNum = document.getElementById('card-number-input');
        const cardExp = document.getElementById('card-expiry-input');
        const cardCvv = document.getElementById('card-cvv-input');

        if (!cardNum.value.trim() || !cardExp.value.trim() || !cardCvv.value.trim()) {
          paymentSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
          showPaymentAlert('Incomplete Card Details', 'Please complete the card number, expiry date, and CVV security code before submitting.');
          if (!cardNum.value.trim()) cardNum.focus();
          else if (!cardExp.value.trim()) cardExp.focus();
          else cardCvv.focus();
          return;
        }
        if (!/^\d{3}$/.test(cardCvv.value)) {
          paymentSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
          showPaymentAlert('Invalid Security Code', 'The CVC / CVV must contain exactly 3 numbers.');
          cardCvv.focus();
          return;
        }
        if (!isValidExpiry(cardExp.value)) {
          paymentSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
          showPaymentAlert('Invalid Expiry Date', 'Enter a valid future expiry date in MM/YY format, for example 09/27.');
          cardExp.focus();
          return;
        }
      } else if (activePaymentType === 'meeza') {
        const meezaNum = document.getElementById('meeza-card-input');
        const meezaExp = document.getElementById('meeza-exp-input');
        const meezaCvv = document.getElementById('meeza-cvv-input');

        if (!meezaNum.value.trim() || !meezaExp.value.trim() || !meezaCvv.value.trim()) {
          paymentSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
          showPaymentAlert('Incomplete Meeza Card Details', 'Please enter your 16-digit Meeza card number, expiry date, and CVV.');
          if (!meezaNum.value.trim()) meezaNum.focus();
          else if (!meezaExp.value.trim()) meezaExp.focus();
          else meezaCvv.focus();
          return;
        }
        if (!/^\d{3}$/.test(meezaCvv.value)) {
          paymentSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
          showPaymentAlert('Invalid Security Code', 'The CVC / CVV must contain exactly 3 numbers.');
          meezaCvv.focus();
          return;
        }
        if (!isValidExpiry(meezaExp.value)) {
          paymentSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
          showPaymentAlert('Invalid Expiry Date', 'Enter a valid future expiry date in MM/YY format, for example 09/27.');
          meezaExp.focus();
          return;
        }
      }

      // 3. Validate terms acceptance
      if (termsBox && !termsBox.checked) {
        termsSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
        termsSection.classList.add('ring-1', 'ring-secondary');
        if (termsAlert) termsAlert.classList.remove('hidden');
        termsBox.focus();
        return;
      }

      // 4. If all validations pass, proceed with payment flow
      const btn = document.getElementById('submit-button');
      const label = document.getElementById('button-label');
      const arrow = document.getElementById('button-arrow');
      const spinner = document.getElementById('spinner');

      btn.disabled = true;
      arrow.classList.add('hidden');
      spinner.classList.remove('hidden');
      label.textContent = 'Processing Payment...';

      setTimeout(() => {
        spinner.classList.add('hidden');
        arrow.classList.remove('hidden');
        label.textContent = 'Confirm & Pay $2,560.00';
        btn.disabled = false;
        document.getElementById('confirmation-modal').classList.remove('hidden');
      }, 1400);
    }

    function dismissModal() {
      document.getElementById('confirmation-modal').classList.add('hidden');
    }
  </script>
}