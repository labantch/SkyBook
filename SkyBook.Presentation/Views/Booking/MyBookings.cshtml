            toAirport: "Cairo International Airport",
            date: "28 Jun 2026",
            departureTime: "14:15",
            arrivalTime: "20:30",
            arrivalDayOffset: "",
            duration: "5h 15m",
            isNonStop: true,
            flightNumber: "SB 302",
            aircraft: "Airbus A350-1000",
            cabin: "Economy"
          }
        ],
        priceBreakdown: {
          baseFare: 1510.00,
          taxesFees: 140.00,
          seatSelection: "Included"
        }
      }
    ];

    // UI State
    let currentTab = 'upcoming'; // 'upcoming' | 'past' | 'cancelled'
    let searchQuery = '';
    let pendingCancelBookingId = null;

    // Initialize View
    document.addEventListener('DOMContentLoaded', () => {
      
    // Sync header user from login state
    (function syncMyBookingsUser() {
      const name = (localStorage.getItem('skybook-user-name') || '').trim();
      const hasRealName = name.length > 0 && name.toLowerCase() !== 'guest';
      const authed = localStorage.getItem('skybook-authenticated') === 'true' && hasRealName;
      const initials = localStorage.getItem('skybook-user-initials') || 'SB';
      const av = document.getElementById('mb-user-avatar');
      const nm = document.getElementById('mb-user-name');
      const sub = document.getElementById('mb-user-sub');
      const link = document.getElementById('mb-user-link');
      if (authed) {
        if (av) av.textContent = initials;
        if (nm) nm.textContent = name;
        if (sub) sub.innerHTML = '<span class="material-symbols-outlined text-[12px]">verified</span> Member';
        if (link) link.href = 'profile.html';
      } else {
        // Not logged in → always go to login (never profile)
        if (av) av.textContent = 'SB';
        if (nm) nm.textContent = 'Log in';
        if (sub) sub.textContent = 'Sign in to continue';
        if (link) {
          link.href = 'account.html?mode=login';
          link.onclick = function (e) {
            e.preventDefault();
            window.location.href = 'account.html?mode=login';
          };
        }
      }
    })();

      render();
    });

    function setTab(tab) {
      currentTab = tab;
      
      // Update Tab button styles
      ['upcoming', 'past', 'cancelled'].forEach(t => {
        const btn = document.getElementById(`tab-${t}`);
        if (t === tab) {
          btn.className = "px-5 py-2 rounded-lg text-sm font-semibold transition-all bg-[#0B192C] text-white shadow-sm flex items-center gap-2";
          const badge = btn.querySelector('span:last-child');
          if (badge) {
            badge.className = "px-2 py-0.5 text-xs rounded-full bg-white/20 text-white font-bold";
          }
        } else {
          btn.className = "px-5 py-2 rounded-lg text-sm font-semibold transition-all text-slate-600 hover:text-[#0B192C] flex items-center gap-2";
          const badge = btn.querySelector('span:last-child');
          if (badge) {
            badge.className = "px-2 py-0.5 text-xs rounded-full bg-slate-100 text-slate-600 font-bold";
          }
        }
      });

      render();
    }

    function handleSearch() {
      const input = document.getElementById('search-input');
      searchQuery = input.value.trim().toLowerCase();
      const clearBtn = document.getElementById('clear-search-btn');
      if (searchQuery.length > 0) {
        clearBtn.classList.remove('hidden');
      } else {
        clearBtn.classList.add('hidden');
      }
      render();
    }

    function clearSearch() {
      const input = document.getElementById('search-input');
      input.value = '';
      searchQuery = '';
      document.getElementById('clear-search-btn').classList.add('hidden');
      render();
    }

        function openCancelModal(bookingId) {
      pendingCancelBookingId = bookingId;
      document.getElementById('modal-booking-ref').textContent = bookingId;
      const modal = document.getElementById('cancel-modal');
      const card = document.getElementById('cancel-modal-card');
      
      modal.classList.remove('hidden');
      setTimeout(() => {
        card.classList.remove('scale-95');
        card.classList.add('scale-100');
      }, 10);
    }

    function closeCancelModal() {
      const modal = document.getElementById('cancel-modal');
      const card = document.getElementById('cancel-modal-card');
      card.classList.remove('scale-100');
      card.classList.add('scale-95');
      setTimeout(() => {
        modal.classList.add('hidden');
        pendingCancelBookingId = null;
      }, 200);
    }

    function confirmCancellation() {
      if (!pendingCancelBookingId) return;

      const booking = bookings.find(b => b.id === pendingCancelBookingId);
      if (booking) {
        booking.status = 'CANCELLED';
        
        // Show Toast
        showToast(`Booking ${booking.id} cancelled. Moved to Cancelled tab.`);
        
        // Close modal
        closeCancelModal();
        
        // Switch view to Cancelled tab to show the user the updated state
        currentTab = 'cancelled';
        setTab('cancelled');
      }
    }

    function showToast(message) {
      const toast = document.getElementById('toast');
      const text = document.getElementById('toast-text');
      text.textContent = message;
      toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
      setTimeout(() => {
        toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
      }, 4000);
    }

    function downloadDocument(type, bookingRef) {
      showToast(`Generating ${type} for ${bookingRef}...`);
    }

    // Main Render Function
    function render() {
      // Update Tab Badges
      const upcomingCount = bookings.filter(b => b.status === 'CONFIRMED').length;
      const pastCount = bookings.filter(b => b.status === 'PAST').length;
      const cancelledCount = bookings.filter(b => b.status === 'CANCELLED').length;

      document.getElementById('badge-count-upcoming').textContent = upcomingCount;
      document.getElementById('badge-count-past').textContent = pastCount;
      document.getElementById('badge-count-cancelled').textContent = cancelledCount;

      // Filter by current Tab
      let filtered = bookings.filter(b => {
        if (currentTab === 'upcoming') return b.status === 'CONFIRMED';
        if (currentTab === 'past') return b.status === 'PAST';
        if (currentTab === 'cancelled') return b.status === 'CANCELLED';
        return true;
      });

      // Filter by Search Query
      if (searchQuery) {
        filtered = filtered.filter(b => {
          const matchId = b.id.toLowerCase().includes(searchQuery);
          const matchFlight = b.segments.some(s => s.flightNumber.toLowerCase().includes(searchQuery));
          const matchCity = b.segments.some(s => s.fromCity.toLowerCase().includes(searchQuery) || s.toCity.toLowerCase().includes(searchQuery));
          const matchPassenger = b.passengers.some(p => p.name.toLowerCase().includes(searchQuery));
          return matchId || matchFlight || matchCity || matchPassenger;
        });
      }

      const container = document.getElementById('bookings-container');
      const emptyState = document.getElementById('empty-state');

      if (filtered.length === 0) {
        container.innerHTML = '';
        emptyState.classList.remove('hidden');

        const title = document.getElementById('empty-state-title');
        const subtitle = document.getElementById('empty-state-subtitle');
        const btn = document.getElementById('empty-state-btn');

        if (searchQuery) {
          title.textContent = "No matching bookings found";
          subtitle.textContent = `No bookings found matching "${searchQuery}". Please verify your reference number or flight code.`;
          btn.parentElement.classList.add('hidden');
        } else if (currentTab === 'upcoming') {
          title.textContent = "No upcoming journeys";
          subtitle.textContent = "Your next adventure starts here. Discover our scheduled flights and luxury cabins across continents.";
          btn.parentElement.classList.remove('hidden');
        } else if (currentTab === 'past') {
          title.textContent = "No past bookings";
          subtitle.textContent = "You have no completed journeys recorded in your sovereign flight manifest history.";
          btn.parentElement.classList.add('hidden');
        } else if (currentTab === 'cancelled') {
          title.textContent = "No cancelled bookings";
          subtitle.textContent = "You have no active cancellations on file.";
          btn.parentElement.classList.add('hidden');
        }
        return;
      }

      emptyState.classList.add('hidden');

      // Generate Cards HTML
      container.innerHTML = filtered.map(b => createBookingCardHTML(b)).join('');
    }

    function createBookingCardHTML(b) {
      const isCancelled = b.status === 'CANCELLED';
      const isPast = b.status === 'PAST';

      // Status Badge HTML
      let badgeHtml = '';
      if (b.status === 'CONFIRMED') {
        badgeHtml = `
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold badge-confirmed">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>CONFIRMED ✓</span>
          </span>
        `;
      } else if (b.status === 'PAST') {
        badgeHtml = `
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold badge-past">
            <span class="material-symbols-outlined text-sm">history</span>
            <span>COMPLETED</span>
          </span>
        `;
      } else {
        badgeHtml = `
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold badge-cancelled">
            <span class="material-symbols-outlined text-sm">cancel</span>
            <span>CANCELLED</span>
          </span>
        `;
      }

      // Segments Summary HTML
      const segmentsHtml = b.segments.map((seg, idx) => `
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 py-4 ${idx > 0 ? 'border-t border-slate-100' : ''}">
          <!-- Route & Segment Type -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-slate-50 border border-slate-200 flex items-center justify-center text-[#0B192C] flex-shrink-0">
              <span class="material-symbols-outlined text-xl ${seg.type === 'Return' ? 'rotate-180' : ''}">flight_takeoff</span>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="text-xs font-bold uppercase tracking-wider text-[#855D29] bg-[#FBF7F0] px-2 py-0.5 rounded border border-[#C5A880]/30">${seg.type}</span>
                <span class="text-xs text-slate-400 font-medium">${seg.date}</span>
              </div>
              <div class="text-lg font-extrabold text-[#0B192C] tracking-tight mt-0.5">
                ${seg.fromCity.toUpperCase()} (${seg.fromCode}) → ${seg.toCity.toUpperCase()} (${seg.toCode})
              </div>
              <div class="text-xs text-slate-500 mt-0.5 flex flex-wrap items-center gap-2">
                <span class="font-semibold text-slate-700">Flight ${seg.flightNumber}</span>
                <span>•</span>
                <span>${seg.aircraft}</span>
              </div>
            </div>
          </div>

          <!-- Time & Duration Timeline -->
          <div class="flex items-center gap-6 self-start md:self-center pl-14 md:pl-0">
            <div class="text-left">
              <div class="text-base font-bold text-[#0B192C] tabular-nums">${seg.departureTime}</div>
              <div class="text-xs text-slate-400">${seg.fromCode}</div>
            </div>

            <div class="flex flex-col items-center">
              <span class="text-[11px] font-semibold text-slate-500">${seg.duration}</span>
              <div class="relative w-24 sm:w-28 flex items-center my-1">
                <div class="w-1.5 h-1.5 rounded-full bg-[#0B192C]"></div>
                <div class="flex-1 h-[2px] bg-slate-200"></div>
                <span class="material-symbols-outlined text-xs text-[#855D29] -mx-1">flight</span>
                <div class="flex-1 h-[2px] bg-slate-200"></div>
                <div class="w-1.5 h-1.5 rounded-full bg-[#0B192C]"></div>
              </div>
              <span class="text-[10px] text-emerald-600 font-medium">Non-stop direct</span>
            </div>

            <div class="text-left">
              <div class="text-base font-bold text-[#0B192C] tabular-nums">
                ${seg.arrivalTime} <span class="text-xs font-semibold text-[#855D29]">${seg.arrivalDayOffset || ''}</span>
              </div>
              <div class="text-xs text-slate-400">${seg.toCode}</div>
            </div>
          </div>
        </div>
      `).join('');

      // Passenger summary count
      const paxCountText = `${b.passengers.length} Passenger${b.passengers.length > 1 ? 's' : ''}`;

      return `
        <div class="bg-white rounded-2xl border ${isCancelled ? 'border-red-200/80 bg-red-50/20' : 'border-slate-200'} shadow-sm overflow-hidden transition-all duration-200">
          
          <!-- CARD HEADER BAR -->
          <div class="bg-slate-50/80 px-6 py-4 border-b border-slate-100 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              ${badgeHtml}
              <div class="h-4 w-px bg-slate-200 hidden sm:block"></div>
              <div class="text-xs text-slate-500">
                Booking Reference: <span class="font-extrabold text-[#0B192C] tracking-wider text-sm ml-1">${b.id}</span>
              </div>
            </div>

            <div class="flex items-center gap-3 text-xs text-slate-500">
              <span class="font-semibold uppercase tracking-wider text-slate-700 bg-white px-2.5 py-1 rounded-md border border-slate-200">${b.tripType}</span>
              <span class="hidden sm:inline">•</span>
              <span class="hidden sm:inline">Booked on ${b.bookingDate}</span>
            </div>
          </div>

          <!-- CARD BODY -->
          <div class="p-6">
            ${segmentsHtml}

            <!-- Card Bottom Strip: Passenger Count, Cabin, Total & Action Buttons -->
            <div class="mt-4 pt-4 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-slate-600">
                <div class="flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-lg text-slate-400">group</span>
                  <span class="font-medium text-[#0B192C]">${paxCountText}</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-lg text-slate-400">airline_seat_recline_extra</span>
                  <span class="font-medium text-[#0B192C]">${b.fareClass}</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="text-xs text-slate-400">Total Paid:</span>
                  <span class="text-base font-extrabold text-[#0B192C] tabular-nums">$${b.totalPaid.toLocaleString('en-US', { minimumFractionDigits: 2 })} ${b.currency}</span>
                </div>
              </div>

              <!-- Action Controls -->
              <div class="flex items-center gap-3 self-end sm:self-auto">
                ${!isCancelled && !isPast ? `
                  <button 
                    onclick="openCancelModal('${b.id}')"
                    class="px-4 py-2 rounded-lg text-sm font-semibold text-red-600 hover:text-red-700 hover:bg-red-50 border border-transparent hover:border-red-200 transition"
                  >
                    Cancel Booking
                  </button>
                ` : ''}

                <button 
                  type="button"
                  onclick="openBookingDrawer('${b.id}')"
                  class="px-5 py-2 rounded-lg text-sm font-bold transition-all flex items-center gap-2 bg-[#0B192C] text-white hover:bg-[#11223A] shadow-sm"
                >
                  <span>View Details</span>
                  <span class="material-symbols-outlined text-base">arrow_forward</span>
                </button>
              </div>
            </div>
          </div>

        </div>
      `;
    }

    function openBookingDrawer(bookingId) {
      const booking = bookings.find(b => b.id === bookingId);
      if (!booking) return;

      const body = document.getElementById('booking-drawer-body');
      const title = document.getElementById('drawer-booking-id');
      title.textContent = booking.id;
      body.innerHTML = buildDrawerContent(booking);

      const overlay = document.getElementById('booking-drawer-overlay');
      const drawer = document.getElementById('booking-drawer');
      overlay.classList.remove('hidden');
      requestAnimationFrame(() => {
        overlay.classList.remove('opacity-0');
        drawer.classList.remove('translate-x-full');
      });
      document.body.style.overflow = 'hidden';
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeBookingDrawer();
    });

    function closeBookingDrawer() {
      const overlay = document.getElementById('booking-drawer-overlay');
      const drawer = document.getElementById('booking-drawer');
      overlay.classList.add('opacity-0');
      drawer.classList.add('translate-x-full');
      setTimeout(() => {
        overlay.classList.add('hidden');
        document.body.style.overflow = '';
      }, 300);
    }

    function buildDrawerContent(b) {
      const isCancelled = b.status === 'CANCELLED';
      const statusColor = isCancelled ? 'text-rose-600' : (b.status === 'PAST' ? 'text-slate-500' : 'text-emerald-700');

      const segmentsHtml = b.segments.map(seg => `
        <div class="rounded-xl border border-slate-200 bg-white p-4">
          <div class="flex items-center justify-between gap-2 mb-3">
            <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider ${seg.type === 'Outbound' ? 'bg-[#0B192C] text-white' : 'bg-[#C5A880]/25 text-[#855D29]'}">${seg.type}</span>
            <span class="text-[11px] font-semibold text-slate-500">${seg.flightNumber}</span>
          </div>
          <div class="flex items-center justify-between gap-3">
            <div>
              <div class="text-xl font-black text-[#0B192C] tabular-nums">${seg.departureTime}</div>
              <div class="text-sm font-bold text-slate-800">${seg.fromCode}</div>
              <div class="text-[11px] text-slate-400">${seg.date}</div>
            </div>
            <div class="flex-1 text-center px-2">
              <div class="text-[10px] text-slate-500 font-medium">${seg.duration}</div>
              <div class="flex items-center my-1">
                <span class="w-1.5 h-1.5 rounded-full bg-[#C5A880]"></span>
                <span class="flex-1 h-px bg-slate-200"></span>
                <span class="material-symbols-outlined text-sm text-[#0B192C] mx-0.5">flight</span>
                <span class="flex-1 h-px bg-slate-200"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-[#C5A880]"></span>
              </div>
              <div class="text-[10px] font-bold text-emerald-700">${seg.isNonStop ? 'Non-stop' : 'Connecting'}</div>
            </div>
            <div class="text-right">
              <div class="text-xl font-black text-[#0B192C] tabular-nums">${seg.arrivalTime}${seg.arrivalDayOffset ? `<span class="text-[10px] text-[#855D29] ml-0.5">${seg.arrivalDayOffset}</span>` : ''}</div>
              <div class="text-sm font-bold text-slate-800">${seg.toCode}</div>
              <div class="text-[11px] text-slate-400">${seg.cabin}</div>
            </div>
          </div>
        </div>
      `).join('');

      const passengersHtml = b.passengers.map((pax, i) => `
        <div class="rounded-xl border border-slate-200 bg-white p-3.5">
          <div class="flex items-center justify-between mb-1">
            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Passenger ${i + 1}</span>
            <span class="text-[11px] text-slate-400">${pax.type}</span>
          </div>
          <div class="text-sm font-bold text-[#0B192C]">${pax.name}</div>
          <div class="text-[11px] text-slate-500 mt-0.5">${pax.nationality}</div>
          <div class="mt-2.5 space-y-1">
            ${Object.entries(pax.seats).map(([fn, seat]) => `
              <div class="flex justify-between items-center text-[11px] bg-slate-50 rounded-lg px-2.5 py-1.5">
                <span class="text-slate-600">${fn}</span>
                <span class="font-extrabold text-[#0B192C]">Seat ${seat}</span>
              </div>
            `).join('')}
          </div>
        </div>
      `).join('');

      return `
        <div class="space-y-1">
          <p class="text-xs text-slate-500">Booked ${b.bookingDate} · <span class="${statusColor} font-semibold">${b.status}</span> · ${b.tripType}</p>
          <p class="text-xs text-slate-500">${b.fareClass}</p>
        </div>

        <section>
          <h3 class="text-[11px] font-extrabold uppercase tracking-wider text-slate-500 mb-2.5">Flights</h3>
          <div class="space-y-2.5">${segmentsHtml}</div>
        </section>

        <section>
          <h3 class="text-[11px] font-extrabold uppercase tracking-wider text-slate-500 mb-2.5">Passengers &amp; seats</h3>
          <div class="space-y-2.5">${passengersHtml}</div>
        </section>

        <section>
          <h3 class="text-[11px] font-extrabold uppercase tracking-wider text-slate-500 mb-2.5">Payment</h3>
          <div class="rounded-xl border border-slate-200 bg-white p-4 space-y-2 text-sm">
            <div class="flex justify-between text-slate-600"><span>Base fare</span><span class="font-semibold text-slate-800">$${b.priceBreakdown.baseFare.toLocaleString('en-US', { minimumFractionDigits: 2 })}</span></div>
            <div class="flex justify-between text-slate-600"><span>Taxes &amp; fees</span><span class="font-semibold text-slate-800">$${b.priceBreakdown.taxesFees.toLocaleString('en-US', { minimumFractionDigits: 2 })}</span></div>
            <div class="flex justify-between text-slate-600"><span>Seat selection</span><span class="font-bold text-emerald-700">${b.priceBreakdown.seatSelection}</span></div>
            <div class="pt-2.5 border-t border-slate-200 flex justify-between items-baseline">
              <span class="font-extrabold text-[#0B192C]">Total paid</span>
              <span class="text-lg font-black text-[#0B192C] tabular-nums">$${b.totalPaid.toLocaleString('en-US', { minimumFractionDigits: 2 })}</span>
            </div>
          </div>
        </section>
      `;
    }


  </script>
}