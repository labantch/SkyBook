@section Scripts {
<script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            mono: ['"Space Grotesk"', 'monospace'],
          },
          colors: {
            brand: {
              navy: '#0B192C',
              navyLight: '#162840',
              gold: '#C5A880',
              goldLight: '#E8DCB8',
              goldDark: '#9C7A4A',
              surface: '#F8F9FA',
              border: '#E2E8F0',
            }
          }
        }
      }
    }
  </script>
<script>
    // ============================================================
    // AUTO SEAT-MAP GENERATOR
    // Mirrors the "Add Aircraft" form in the ops console: you hand it
    // three numbers — seats in First, Business, and Economy — and it
    // lays out rows, aisles, and seat letters on its own. Nobody has
    // to hand-author a seat button ever again.
    //
    // How it works:
    //  1. CABIN_LAYOUTS defines the *shape* of one row per cabin type
    //     (e.g. Economy is 3-3-3: three seats, aisle, three seats,
    //     aisle, three seats). This is the only place layout patterns
    //     live — change it once and every aircraft using that cabin
    //     type updates.
    //  2. buildCabin() takes a seat COUNT and divides it by the row's
    //     seat capacity to work out how many rows are needed, then
    //     numbers those rows starting at `startRow`. Seat counts are
    //     rounded up to the nearest full row, same as a real aircraft.
    //  3. buildAircraft() chains First → Business → Economy, leaving
    //     a 1-row gap between cabins for the galley/divider, and
    //     returns the exact same `{ cabins: [...] }` shape the
    //     existing renderSeatMap()/updateAllViews() code already
    //     knows how to draw — so nothing else in this file changes.
    //
    // To add a new aircraft: call buildAircraft() with a model name
    // and a { first, business, economy } seat count. That's it.
    // ============================================================
    const CABIN_LAYOUTS = {
      first:    { name: 'FIRST CLASS',    badge: '1-2-1 SOVEREIGN SUITES',     groups: [['A'], ['D', 'G'], ['K']] },
      business: { name: 'BUSINESS CLASS', badge: '1-2-1 DIRECT AISLE ACCESS', groups: [['A'], ['D', 'G'], ['K']] },
      economy:  { name: 'ECONOMY CLASS',  badge: '3-3-3 MODERN LAYOUT',       groups: [['A', 'B', 'C'], ['D', 'E', 'F'], ['H', 'J', 'K']] }
    };
    const CABIN_ROW_GAP = 1; // blank rows left between cabins for a galley/divider

    function buildCabin(typeKey, seatCount, startRow, reservedSeats = []) {
      const layout = CABIN_LAYOUTS[typeKey];
      const seatsPerRow = layout.groups.reduce((sum, g) => sum + g.length, 0);
      const rowCount = Math.max(1, Math.ceil(seatCount / seatsPerRow));
      const rows = Array.from({ length: rowCount }, (_, i) => startRow + i);

      // Sprinkle in some already-occupied seats so the map doesn't look
      // empty on first load — but never touch a seat a demo passenger
      // already holds (passed in via reservedSeats).
      const occupied = [];
      let seatIndex = 0;
      rows.forEach(rowNum => {
        layout.groups.flat().forEach(letter => {
          const seatId = `${rowNum}${letter}`;
          seatIndex++;
          if (seatIndex % 6 === 0 && !reservedSeats.includes(seatId)) occupied.push(seatId);
        });
      });

      return {
        typeKey,
        name: layout.name,
        badge: layout.badge,
        groups: layout.groups,
        rows,
        occupied,
        extraLegroomRows: typeKey === 'economy' ? [rows[0]] : undefined,
        seatsPerRow
      };
    }

    function buildAircraft({ model, category, flightNum, seats, reservedSeats = [] }) {
      // `seats` is exactly what the ops-console "Add Aircraft" modal
      // collects: { first, business, economy }. Nothing else needed.
      const cabinOrder = ['first', 'business', 'economy'];
      const cabins = [];
      let nextRow = 1;

      cabinOrder.forEach(typeKey => {
        const count = seats[typeKey] || 0;
        if (count <= 0) return;
        const cabin = buildCabin(typeKey, count, nextRow, reservedSeats);
        cabins.push(cabin);
        nextRow = cabin.rows[cabin.rows.length - 1] + 1 + CABIN_ROW_GAP;
      });

      // Total reflects what actually got drawn (rounded to full rows),
      // so the number shown to the customer always matches the map.
      const totalSeats = cabins.reduce((sum, c) => sum + c.rows.length * c.seatsPerRow, 0);
      const layoutTags = cabins.map(c => c.groups.map(g => g.length).join('-'));

      return {
        model,
        category,
        flightNum,
        totalSeats,
        configLabel: `3 CABIN ARCHITECTURE • ${layoutTags.join(' / ')}`,
        shortSpecs: `${totalSeats} seats • ${layoutTags[layoutTags.length - 1]} layout`,
        cabins
      };
    }

    const aircraftConfigs = {
      // Just the three seat counts drive the entire map below.
      'B777-300ER': buildAircraft({
        model: 'Boeing 777-300ER',
        category: 'Flagship Wide-body',
        flightNum: 'SB 918',
        seats: { first: 8, business: 12, economy: 54 },
        reservedSeats: ['10A', '10B']
      }),
      'B787-9': buildAircraft({
        model: 'Boeing 787-9 Dreamliner',
        category: 'Mid-sized Wide-body Carbon Composite',
        flightNum: 'SB 929',
        seats: { first: 8, business: 12, economy: 63 },
        reservedSeats: ['9F', '8H']
      }),
      'A350-1000': buildAircraft({
        model: 'Airbus A350-1000',
        category: 'Next-Gen Ultra Long-Haul Wide-Body',
        flightNum: 'SB 101',
        seats: { first: 8, business: 12, economy: 90 }
      })
    };

    const bookingState = {
      activeSegment: 2,
      activePassenger: 2,
      segments: {
        1: {
          aircraftId: 'B777-300ER',
          flightNum: 'SB 918',
          route: 'Cairo (CAI) → Dubai (DXB)',
          depCity: 'Cairo (CAI)',
          arrCity: 'Dubai (DXB)',
          depTime: '14:20',
          arrTime: '19:55',
          duration: '3h 35m',
          date: 'Friday, 11 Sep 2026',
          passengers: {
            1: { name: 'Passenger 1 (Adult)', seat: '10A', type: 'Standard Seat', pos: 'Window • Row 10' },
            2: { name: 'Passenger 2 (Adult)', seat: '10B', type: 'Standard Seat', pos: 'Middle • Row 10' }
          }
        },
        2: {
          aircraftId: 'B787-9',
          flightNum: 'SB 929',
          route: 'Dubai (DXB) → London (LHR)',
          depCity: 'Dubai (DXB)',
          arrCity: 'London (LHR)',
          depTime: '09:15',
          arrTime: '14:00',
          duration: '7h 45m',
          date: 'Friday, 18 Sep 2026',
          passengers: {
            1: { name: 'Passenger 1 (Adult)', seat: '9F', type: 'Standard Seat', pos: 'Aisle • Row 9' },
            2: { name: 'Passenger 2 (Adult)', seat: '8H', type: 'Extra Legroom', pos: 'Window • Row 8' }
          }
        },
        3: {
          aircraftId: 'A350-1000',
          flightNum: 'SB 101',
          route: 'London (LHR) → New York (JFK)',
          depCity: 'London (LHR)',
          arrCity: 'New York (JFK)',
          depTime: '16:30',
          arrTime: '19:40',
          duration: '8h 10m',
          date: 'Monday, 21 Sep 2026',
          passengers: {
            1: { name: 'Passenger 1 (Adult)', seat: null, type: null, pos: null },
            2: { name: 'Passenger 2 (Adult)', seat: null, type: null, pos: null }
          }
        }
      }
    };

    function renderSeatMap() {
      const seg = bookingState.segments[bookingState.activeSegment];
      const aircraft = aircraftConfigs[seg.aircraftId];
      const root = document.getElementById('dynamic-seatmap-root');
      if (!root) return;
      root.innerHTML = '';

      aircraft.cabins.forEach((cabin, cIndex) => {
        const cabinWrapper = document.createElement('div');
        cabinWrapper.className = 'space-y-3';

        const headerDiv = document.createElement('div');
        const isFirst = cabin.typeKey === 'first';
        const isBusiness = cabin.typeKey === 'business';

        if (isFirst) {
          headerDiv.className = 'flex items-center justify-between py-2.5 px-3.5 rounded-xl border border-[#C5A880]/50 bg-gradient-to-r from-amber-500/15 via-[#C5A880]/20 to-amber-500/10 shadow-sm';
          headerDiv.innerHTML = `
            <div class="flex items-center gap-2.5">
              <span class="w-2.5 h-2.5 rounded-full bg-[#C5A880] shadow-[0_0_8px_rgba(197,168,128,0.7)]"></span>
              <span class="tracking-wider uppercase text-xs font-extrabold text-[#785929]">${cabin.name}</span>
            </div>
            <span class="text-[10px] uppercase font-bold px-2.5 py-0.5 rounded-md border border-[#C5A880]/50 bg-white/90 text-[#8A6834] shadow-xs tracking-wide">${cabin.badge}</span>
          `;
        } else if (isBusiness) {
          headerDiv.className = 'flex items-center justify-between py-2.5 px-3.5 rounded-xl border border-slate-700 bg-[#0B192C] text-white shadow-sm';
          headerDiv.innerHTML = `
            <div class="flex items-center gap-2.5">
              <span class="w-2.5 h-2.5 rounded-full bg-[#C5A880] shadow-[0_0_8px_rgba(197,168,128,0.5)]"></span>
              <span class="tracking-wider uppercase text-xs font-extrabold text-white">${cabin.name}</span>
            </div>
            <span class="text-[10px] uppercase font-bold px-2.5 py-0.5 rounded-md border border-slate-700 bg-white/10 text-[#C5A880] tracking-wide shadow-xs">${cabin.badge}</span>
          `;
        } else {
          headerDiv.className = 'flex items-center justify-between py-2.5 px-3.5 rounded-xl border border-emerald-200 bg-emerald-50/80 text-emerald-900 shadow-sm';
          headerDiv.innerHTML = `
            <div class="flex items-center gap-2.5">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 shadow-[0_0_6px_rgba(16,185,129,0.5)]"></span>
              <span class="tracking-wider uppercase text-xs font-extrabold text-emerald-800">${cabin.name}</span>
            </div>
            <span class="text-[10px] uppercase font-bold px-2.5 py-0.5 rounded-md border border-emerald-200 bg-white text-emerald-700 font-mono tracking-wide shadow-xs">${cabin.badge}</span>
          `;
        }
        cabinWrapper.appendChild(headerDiv);

        const letterRow = document.createElement('div');
        letterRow.className = 'flex items-center justify-between px-2 text-xs font-mono font-bold text-slate-400 select-none';

        let letterHtml = '';
        cabin.groups.forEach((group, gIdx) => {
          const colWidth = group.length === 1 ? 'w-[42px]' : group.length === 2 ? 'w-[84px]' : group.length === 3 ? 'w-[124px]' : 'w-[164px]';
          const gridCols = `grid-cols-${group.length}`;
          letterHtml += `<div class="grid ${gridCols} gap-1.5 ${colWidth} text-center">`;
          group.forEach(letter => {
            letterHtml += `<span>${letter}</span>`;
          });
          letterHtml += `</div>`;

          if (gIdx < cabin.groups.length - 1) {
            letterHtml += `<div class="w-5 text-center text-[10px] text-slate-300 font-normal">|</div>`;
          }
        });
        letterRow.innerHTML = letterHtml;
        cabinWrapper.appendChild(letterRow);

        cabin.rows.forEach(rowNum => {
          const rowDiv = document.createElement('div');
          rowDiv.className = 'flex items-center justify-between px-2 group';

          let rowHtml = '';
          const isExtraLegroom = cabin.extraLegroomRows && cabin.extraLegroomRows.includes(rowNum);

          cabin.groups.forEach((group, gIdx) => {
            const colWidth = group.length === 1 ? 'w-[42px]' : group.length === 2 ? 'w-[84px]' : group.length === 3 ? 'w-[124px]' : 'w-[164px]';
            const gridCols = `grid-cols-${group.length}`;
            rowHtml += `<div class="grid ${gridCols} gap-1.5 ${colWidth}">`;

            group.forEach(letter => {
              const seatId = `${rowNum}${letter}`;
              const isOccupied = cabin.occupied && cabin.occupied.includes(seatId);

              let pos = 'Aisle';
              if (letter === group[0] && gIdx === 0) pos = 'Window';
              else if (letter === group[group.length - 1] && gIdx === cabin.groups.length - 1) pos = 'Window';
              else if (group.length > 2 && letter !== group[0] && letter !== group[group.length - 1]) pos = 'Middle';

              let seatType = isFirst ? 'First Class Suite' : isBusiness ? 'Business Suite' : isExtraLegroom ? 'Extra Legroom' : 'Standard Seat';

              const p1Seat = seg.passengers[1].seat;
              const p2Seat = seg.passengers[2].seat;
              const isP1 = p1Seat === seatId;
              const isP2 = p2Seat === seatId;

              if (isOccupied) {
                rowHtml += `<button disabled class="seat-btn seat-occupied h-9 rounded-md border text-[11px] flex items-center justify-center font-mono" title="Seat ${seatId} (Occupied)">✕</button>`;
              } else if (isP1) {
                rowHtml += `<button onclick="handleSeatClick('${seatId}', '${seatType}', '${pos}')" class="seat-btn seat-selected-p1 h-9 rounded-md border text-[11px] flex items-center justify-center font-mono" title="Seat ${seatId} (Assigned to Passenger 1 - Click to unassign or switch)">
                  <span>${seatId}</span>
                  <span class="seat-pax-tag bg-slate-300 text-slate-900">P1</span>
                </button>`;
              } else if (isP2) {
                rowHtml += `<button onclick="handleSeatClick('${seatId}', '${seatType}', '${pos}')" class="seat-btn seat-selected-p2 h-9 rounded-md border text-[11px] flex items-center justify-center font-mono" title="Seat ${seatId} (Assigned to Passenger 2 - Click to unassign or switch)">
                  <span>${seatId}</span>
                  <span class="seat-pax-tag bg-[#C5A880] text-[#0B192C]">P2</span>
                </button>`;
              } else if (isFirst) {
                rowHtml += `<button onclick="handleSeatClick('${seatId}', '${seatType}', '${pos}')" class="seat-btn seat-available seat-first h-9 rounded-md border text-[11px] font-semibold flex items-center justify-center font-mono" title="Seat ${seatId} (${seatType})">${seatId}</button>`;
              } else if (isBusiness) {
                rowHtml += `<button onclick="handleSeatClick('${seatId}', '${seatType}', '${pos}')" class="seat-btn seat-available seat-business h-9 rounded-md border text-[11px] font-semibold flex items-center justify-center font-mono" title="Seat ${seatId} (${seatType})">${seatId}</button>`;
              } else if (isExtraLegroom) {
                rowHtml += `<button onclick="handleSeatClick('${seatId}', '${seatType}', '${pos}')" class="seat-btn seat-available seat-legroom h-9 rounded-md border text-[11px] font-semibold flex items-center justify-center font-mono" title="Seat ${seatId} (${seatType})">${seatId}</button>`;
              } else {
                rowHtml += `<button onclick="handleSeatClick('${seatId}', '${seatType}', '${pos}')" class="seat-btn seat-available bg-white border-slate-300 text-slate-800 h-9 rounded-md border text-[11px] font-semibold flex items-center justify-center font-mono" title="Seat ${seatId}">${seatId}</button>`;
              }
            });

            rowHtml += `</div>`;

            if (gIdx < cabin.groups.length - 1) {
              rowHtml += `<div class="w-5 text-center text-[10px] font-mono font-bold text-slate-400 select-none">${rowNum}</div>`;
            }
          });

          rowDiv.innerHTML = rowHtml;
          cabinWrapper.appendChild(rowDiv);
        });

        if (cIndex < aircraft.cabins.length - 1) {
          const divider = document.createElement('div');
          divider.className = 'py-1 flex items-center justify-center';
          divider.innerHTML = `<div class="w-full border-t border-dashed border-slate-200 my-1"></div>`;
          cabinWrapper.appendChild(divider);
        }

        root.appendChild(cabinWrapper);
      });
    }

    function handleSeatClick(seatId, type, pos) {
      const seg = bookingState.segments[bookingState.activeSegment];
      const currPax = bookingState.activePassenger;
      const otherPax = currPax === 1 ? 2 : 1;

      // If clicked the current passenger's own seat, unassign it
      if (seg.passengers[currPax].seat === seatId) {
        seg.passengers[currPax].seat = null;
        seg.passengers[currPax].type = null;
        seg.passengers[currPax].pos = null;
        updateAllViews();
        return;
      }

      // If clicked the other passenger's seat, unassign other passenger so current takes it
      if (seg.passengers[otherPax].seat === seatId) {
        seg.passengers[otherPax].seat = null;
        seg.passengers[otherPax].type = null;
        seg.passengers[otherPax].pos = null;
      }

      // Assign to current passenger
      seg.passengers[currPax].seat = seatId;
      seg.passengers[currPax].type = type;
      seg.passengers[currPax].pos = `${pos} • Row ${seatId.replace(/\D/g, '')}`;

      // Automatically flip focus to other passenger if they don't have a seat yet
      if (!seg.passengers[otherPax].seat) {
        bookingState.activePassenger = otherPax;
      }

      updateAllViews();
    }

    function setActivePassenger(paxId) {
      bookingState.activePassenger = paxId;
      updateAllViews();
    }

    function switchSegment(segId) {
      bookingState.activeSegment = segId;
      const seg = bookingState.segments[segId];
      if (!seg.passengers[1].seat) {
        bookingState.activePassenger = 1;
      } else if (!seg.passengers[2].seat) {
        bookingState.activePassenger = 2;
      } else {
        bookingState.activePassenger = 1;
      }
      updateAllViews();
    }

    function updateAllViews() {
      const segId = bookingState.activeSegment;
      const seg = bookingState.segments[segId];
      const aircraft = aircraftConfigs[seg.aircraftId];
      const currPax = bookingState.activePassenger;

      [1, 2, 3].forEach(id => {
        const tab = document.getElementById(`segment-tab-${id}`);
        const num = document.getElementById(`tab-${id}-num`);
        const card = document.getElementById(`aircraft-spec-card-${id}`);
        const status = document.getElementById(`tab-${id}-status`);

        const p1 = bookingState.segments[id].passengers[1].seat;
        const p2 = bookingState.segments[id].passengers[2].seat;
        const count = (p1 ? 1 : 0) + (p2 ? 1 : 0);
        if (status) status.textContent = `(${count}/2 Selected)`;

        if (segId === id) {
          if (tab) tab.className = "w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all bg-[#0B192C] text-white shadow-sm border border-[#0B192C]";
          if (num) num.className = "w-4 h-4 rounded-full bg-[#C5A880] text-[#0B192C] flex items-center justify-center text-[10px] font-bold";
          if (status) status.className = "text-[11px] text-[#C5A880] font-semibold";

          if (card) {
            card.className = "bg-white p-3 rounded-xl border-2 border-[#C5A880] shadow-sm select-none transition-all ring-2 ring-[#C5A880]/20 cursor-default";
            card.onclick = null;
          }
        } else {
          if (tab) tab.className = "w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all bg-white text-slate-600 hover:text-slate-900 hover:bg-slate-50 border border-slate-200 shadow-sm cursor-pointer";
          if (num) num.className = "w-4 h-4 rounded-full bg-slate-200 text-slate-700 flex items-center justify-center text-[10px] font-bold";
          if (status) status.className = "text-[11px] text-slate-400 font-semibold";

          if (card) {
            card.className = "bg-slate-50/75 p-3 rounded-xl border border-slate-200 shadow-sm select-none transition-all opacity-60 hover:opacity-100 cursor-pointer";
            card.onclick = () => switchSegment(id);
          }
        }
      });

      const headerRoute = document.getElementById('header-route-label');
      if (headerRoute) headerRoute.textContent = seg.route;
      const headerDate = document.getElementById('header-date-label');
      if (headerDate) headerDate.textContent = seg.date;
      const headerSpec = document.getElementById('header-flight-spec');
      if (headerSpec) headerSpec.textContent = `${aircraft.flightNum} • ${aircraft.model}`;
      const badgeModel = document.getElementById('badge-aircraft-model');
      if (badgeModel) badgeModel.textContent = aircraft.model;
      const badgeSeats = document.getElementById('badge-total-seats');
      if (badgeSeats) badgeSeats.textContent = aircraft.totalSeats;

      const fuselageName = document.getElementById('fuselage-aircraft-name');
      if (fuselageName) fuselageName.textContent = aircraft.model.toUpperCase();
      const fuselageConfig = document.getElementById('fuselage-config-label');
      if (fuselageConfig) fuselageConfig.textContent = aircraft.configLabel;

      const assigneeLabel = document.getElementById('current-assignee-label');
      if (assigneeLabel) assigneeLabel.textContent = `Passenger ${currPax} (Adult)`;
      const assigneeBadge = document.getElementById('current-assignee-badge');
      if (assigneeBadge) {
        assigneeBadge.textContent = `P${currPax}`;
        if (currPax === 1) {
          assigneeBadge.className = "w-5 h-5 rounded-full bg-[#0B192C] text-white flex items-center justify-center font-bold text-[10px] ring-1 ring-slate-400";
        } else {
          assigneeBadge.className = "w-5 h-5 rounded-full bg-[#0B192C] text-[#C5A880] flex items-center justify-center font-bold text-[10px] ring-1 ring-[#C5A880]";
        }
      }

      const summaryTag = document.getElementById('summary-segment-tag');
      if (summaryTag) summaryTag.textContent = `SEGMENT ${segId} OF 3`;
      const summaryCode = document.getElementById('summary-flight-code');
      if (summaryCode) summaryCode.textContent = aircraft.flightNum;
      const depTime = document.getElementById('summary-dep-time');
      if (depTime) depTime.textContent = seg.depTime;
      const depCity = document.getElementById('summary-dep-city');
      if (depCity) depCity.textContent = seg.depCity;
      const arrTime = document.getElementById('summary-arr-time');
      if (arrTime) arrTime.textContent = seg.arrTime;
      const arrCity = document.getElementById('summary-arr-city');
      if (arrCity) arrCity.textContent = seg.arrCity;
      const duration = document.getElementById('summary-duration');
      if (duration) duration.textContent = seg.duration;
      const summaryDate = document.getElementById('summary-date');
      if (summaryDate) summaryDate.textContent = seg.date;
      const summaryAircraft = document.getElementById('summary-aircraft-disp');
      if (summaryAircraft) summaryAircraft.textContent = aircraft.model;

      const p1Seat = seg.passengers[1].seat;
      const p2Seat = seg.passengers[2].seat;
      const currentSegSeatsCount = (p1Seat ? 1 : 0) + (p2Seat ? 1 : 0);
      const seatsCounterBadge = document.getElementById('summary-seats-counter-badge');
      if (seatsCounterBadge) seatsCounterBadge.textContent = `${currentSegSeatsCount} of 2 Seats Selected`;

      const pax1Box = document.getElementById('summary-pax1-box');
      const pax2Box = document.getElementById('summary-pax2-box');
      const pax1Avatar = document.getElementById('pax1-avatar');
      const pax2Avatar = document.getElementById('pax2-avatar');
      const pax1Tag = document.getElementById('pax1-active-tag');
      const pax2Tag = document.getElementById('pax2-active-tag');
      const pax1Disp = document.getElementById('pax1-seat-disp');
      const pax2Disp = document.getElementById('pax2-seat-disp');

      if (p1Seat) {
        if (pax1Disp) {
          pax1Disp.textContent = p1Seat;
          pax1Disp.className = "text-lg font-extrabold font-mono px-2.5 py-0.5 rounded-md inline-block shadow-xs " + (currPax === 1 ? "bg-[#0B192C] text-white border-2 border-[#0B192C]" : "bg-slate-100 text-[#0B192C] border border-slate-200");
        }
        const pax1Details = document.getElementById('pax1-details-label');
        if (pax1Details) pax1Details.textContent = `${seg.passengers[1].type || 'Standard Seat'} • ${seg.passengers[1].pos || 'Seat'}`;
        const pax1Status = document.getElementById('pax1-status-badge');
        if (pax1Status) {
          pax1Status.textContent = 'Included';
          pax1Status.className = 'text-[10px] text-emerald-600 font-bold block mt-0.5';
        }
      } else {
        if (pax1Disp) {
          pax1Disp.textContent = '--';
          pax1Disp.className = "text-lg font-extrabold text-slate-300 font-mono px-2 py-0.5 rounded-md bg-slate-50 border border-slate-200 inline-block";
        }
        const pax1Details = document.getElementById('pax1-details-label');
        if (pax1Details) pax1Details.textContent = 'Click to select seat on map';
        const pax1Status = document.getElementById('pax1-status-badge');
        if (pax1Status) {
          pax1Status.textContent = 'Seat not assigned';
          pax1Status.className = 'text-[10px] text-amber-600 font-semibold block mt-0.5';
        }
      }

      if (p2Seat) {
        if (pax2Disp) {
          pax2Disp.textContent = p2Seat;
          pax2Disp.className = "text-lg font-extrabold font-mono px-2.5 py-0.5 rounded-md inline-block shadow-xs " + (currPax === 2 ? "bg-[#0B192C] text-[#C5A880] border border-[#C5A880]" : "bg-slate-100 text-[#0B192C] border border-slate-200");
        }
        const pax2Details = document.getElementById('pax2-details-label');
        if (pax2Details) pax2Details.textContent = `${seg.passengers[2].type || 'Standard Seat'} • ${seg.passengers[2].pos || 'Seat'}`;
        const pax2Status = document.getElementById('pax2-status-badge');
        if (pax2Status) {
          pax2Status.textContent = 'Included';
          pax2Status.className = 'text-[10px] text-emerald-600 font-bold block mt-0.5';
        }
      } else {
        if (pax2Disp) {
          pax2Disp.textContent = '--';
          pax2Disp.className = "text-lg font-extrabold text-slate-300 font-mono px-2 py-0.5 rounded-md bg-slate-50 border border-slate-200 inline-block";
        }
        const pax2Details = document.getElementById('pax2-details-label');
        if (pax2Details) pax2Details.textContent = 'Click to select seat on map';
        const pax2Status = document.getElementById('pax2-status-badge');
        if (pax2Status) {
          pax2Status.textContent = 'Seat not assigned';
          pax2Status.className = 'text-[10px] text-amber-600 font-semibold block mt-0.5';
        }
      }

      if (currPax === 1) {
        if (pax1Box) pax1Box.className = "cursor-pointer p-3.5 rounded-xl border-2 transition-all bg-amber-50/60 border-[#C5A880] ring-2 ring-[#C5A880]/30 shadow-md relative group";
        if (pax1Avatar) pax1Avatar.className = "w-7 h-7 rounded-full bg-[#0B192C] text-white flex items-center justify-center font-bold text-xs border border-slate-700 transition-transform scale-105 shadow-sm";
        if (pax1Tag) pax1Tag.classList.remove('hidden');

        if (pax2Box) pax2Box.className = "cursor-pointer p-3.5 rounded-xl border-2 transition-all bg-white border-slate-200 hover:border-slate-300 relative group";
        if (pax2Avatar) pax2Avatar.className = "w-7 h-7 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center font-bold text-xs border border-slate-300 transition-transform group-hover:scale-105";
        if (pax2Tag) pax2Tag.classList.add('hidden');
      } else {
        if (pax2Box) pax2Box.className = "cursor-pointer p-3.5 rounded-xl border-2 transition-all bg-amber-50/60 border-[#C5A880] ring-2 ring-[#C5A880]/30 shadow-md relative group";
        if (pax2Avatar) pax2Avatar.className = "w-7 h-7 rounded-full bg-[#0B192C] text-[#C5A880] flex items-center justify-center font-bold text-xs border border-[#C5A880] transition-transform scale-105 shadow-sm";
        if (pax2Tag) pax2Tag.classList.remove('hidden');

        if (pax1Box) pax1Box.className = "cursor-pointer p-3.5 rounded-xl border-2 transition-all bg-white border-slate-200 hover:border-slate-300 relative group";
        if (pax1Avatar) pax1Avatar.className = "w-7 h-7 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center font-bold text-xs border border-slate-300 transition-transform group-hover:scale-105";
        if (pax1Tag) pax1Tag.classList.add('hidden');
      }

      const btn = document.getElementById('primary-action-btn');
      const btnLabel = document.getElementById('primary-btn-label');
      const allSelectedForCurrentSeg = p1Seat && p2Seat;

      if (!allSelectedForCurrentSeg) {
        if (btn) btn.classList.add('opacity-80');
        const missingPax = !p1Seat ? 1 : 2;
        if (btnLabel) btnLabel.textContent = `Select Seat for Passenger ${missingPax} to Continue`;
      } else {
        if (btn) btn.classList.remove('opacity-80');
        if (btnLabel) {
          if (segId === 1) {
            btnLabel.textContent = "Next: Select Seat for DXB → LHR";
          } else if (segId === 2) {
            btnLabel.textContent = "Next: Select Seat for LHR → JFK";
          } else {
            btnLabel.textContent = "Continue to Confirmation";
          }
        }
      }

      renderSeatMap();
    }

    function handlePrimaryAction() {
      const seg = bookingState.segments[bookingState.activeSegment];
      if (!seg.passengers[1].seat) {
        setActivePassenger(1);
        return;
      }
      if (!seg.passengers[2].seat) {
        setActivePassenger(2);
        return;
      }

      if (bookingState.activeSegment === 1) {
        switchSegment(2);
        window.scrollTo({ top: 120, behavior: 'smooth' });
      } else if (bookingState.activeSegment === 2) {
        switchSegment(3);
        window.scrollTo({ top: 120, behavior: 'smooth' });
      } else {
        const seg1 = bookingState.segments[1];
        const seg2 = bookingState.segments[2];
        const seg3 = bookingState.segments[3];
        const summary = document.getElementById('seat-confirmation-summary');
        summary.innerHTML = [
          `Flight 1 <span class="text-slate-400">CAI → DXB</span><div class="mt-1 text-xs text-slate-500">${aircraftConfigs[seg1.aircraftId].model} · P1 <strong class="text-[#0B192C]">${seg1.passengers[1].seat}</strong> · P2 <strong class="text-[#0B192C]">${seg1.passengers[2].seat}</strong></div>`,
          `Flight 2 <span class="text-slate-400">DXB → LHR</span><div class="mt-1 text-xs text-slate-500">${aircraftConfigs[seg2.aircraftId].model} · P1 <strong class="text-[#0B192C]">${seg2.passengers[1].seat}</strong> · P2 <strong class="text-[#0B192C]">${seg2.passengers[2].seat}</strong></div>`,
          `Flight 3 <span class="text-slate-400">LHR → JFK</span><div class="mt-1 text-xs text-slate-500">${aircraftConfigs[seg3.aircraftId].model} · P1 <strong class="text-[#0B192C]">${seg3.passengers[1].seat || 'Unassigned'}</strong> · P2 <strong class="text-[#0B192C]">${seg3.passengers[2].seat || 'Unassigned'}</strong></div>`
        ].map((item) => `<div class="border-b border-slate-200 pb-2 last:border-0 last:pb-0">${item}</div>`).join('');
        document.getElementById('seat-confirmation-modal').classList.remove('hidden');
        document.getElementById('seat-confirmation-modal').classList.add('flex');
      }
    }

    function closeSeatConfirmation() {
      const modal = document.getElementById('seat-confirmation-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    document.addEventListener('DOMContentLoaded', () => {
      updateAllViews();
    });
  </script>
}