["Plus Jakarta Sans"],"title-flight-code":["Space Grotesk"],"display-hero-mobile":["Plus Jakarta Sans"]},"fontSize":{"price-lg":["24px",{"lineHeight":"28px","letterSpacing":"-0.02em","fontWeight":"700"}],"headline-md":["24px",{"lineHeight":"32px","letterSpacing":"-0.015em","fontWeight":"600"}],"body-md":["15px",{"lineHeight":"22px","fontWeight":"400"}],"headline-lg":["32px",{"lineHeight":"40px","letterSpacing":"-0.02em","fontWeight":"600"}],"body-sm":["13px",{"lineHeight":"18px","fontWeight":"400"}],"display-hero":["56px",{"lineHeight":"64px","letterSpacing":"-0.03em","fontWeight":"700"}],"label-caps":["11px",{"lineHeight":"14px","letterSpacing":"0.08em","fontWeight":"600"}],"headline-sm":["20px",{"lineHeight":"28px","fontWeight":"600"}],"body-lg":["18px",{"lineHeight":"28px","fontWeight":"400"}],"title-flight-code":["28px",{"lineHeight":"32px","letterSpacing":"0.04em","fontWeight":"700"}],"display-hero-mobile":["36px",{"lineHeight":"44px","letterSpacing":"-0.02em","fontWeight":"700"}]}}}};</script>
<script>
  function togglePassengerAccordion(id) {
    const body = document.getElementById(id + '-body');
    const chevron = document.getElementById(id + '-chevron');
    if (!body || !chevron) return;

    const isHidden = body.classList.contains('hidden');
    if (isHidden) {
      body.classList.remove('hidden');
      chevron.style.transform = 'rotate(180deg)';
    } else {
      body.classList.add('hidden');
      chevron.style.transform = 'rotate(0deg)';
    }
  }

  function hideValidationBanner() {
    const banner = document.getElementById('form-validation-banner');
    if (banner) banner.classList.add('hidden');
  }

  function showValidationBanner(title, desc) {
    const banner = document.getElementById('form-validation-banner');
    const t = document.getElementById('form-validation-title');
    const d = document.getElementById('form-validation-desc');
    if (t) t.textContent = title;
    if (d) d.textContent = desc;
    if (banner) {
      banner.classList.remove('hidden');
      banner.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }

  function setFieldError(el, hasError) {
    if (!el) return;
    if (hasError) {
      el.classList.add('border-rose-400', 'ring-2', 'ring-rose-200');
      el.classList.remove('border-[#C5A880]/70');
    } else {
      el.classList.remove('border-rose-400', 'ring-2', 'ring-rose-200');
      if (!el.classList.contains('border-[#C5A880]/70')) {
        el.classList.add('border-[#C5A880]/70');
      }
    }
  }

  function getGenderValue(id) {
    const checked = document.querySelector('input[name="' + id + '-gender"]:checked');
    return checked ? checked.value : '';
  }

  function validatePassengerCard(id, highlight) {
    const title = document.getElementById(id + '-title');
    const first = document.getElementById(id + '-firstname');
    const last = document.getElementById(id + '-lastname');
    const dobDate = document.getElementById(id + '-dob-date');
    const nat = document.getElementById(id + '-nationality');
    const passport = document.getElementById(id + '-passport');
    const expDate = document.getElementById(id + '-exp-date');
    const badge = document.getElementById(id + '-status-badge');
    const summaryName = document.getElementById(id + '-summary-name');

    // Keep hidden date parts in sync when validating
    if (dobDate && dobDate.value) syncPassengerDate(id, 'dob', dobDate.value);
    if (expDate && expDate.value) syncPassengerDate(id, 'exp', expDate.value);

    const checks = [
      { el: title, ok: title && title.value },
      { el: first, ok: first && first.value.trim().length > 0 },
      { el: last, ok: last && last.value.trim().length > 0 },
      { el: dobDate, ok: dobDate && dobDate.value },
      { el: nat, ok: nat && nat.value },
      { el: passport, ok: passport && passport.value.trim().length > 0 },
      { el: expDate, ok: expDate && expDate.value },
      { el: null, ok: !!getGenderValue(id) }
    ];

    const isComplete = checks.every(c => c.ok);

    if (highlight) {
      checks.forEach(c => setFieldError(c.el, !c.ok));
      // gender group outline
      document.querySelectorAll('input[name="' + id + '-gender"]').forEach(radio => {
        const label = radio.closest('label');
        if (label) {
          if (!getGenderValue(id)) {
            label.classList.add('border-rose-400', 'ring-2', 'ring-rose-200');
          } else {
            label.classList.remove('border-rose-400', 'ring-2', 'ring-rose-200');
          }
        }
      });
    } else if (isComplete) {
      checks.forEach(c => setFieldError(c.el, false));
      document.querySelectorAll('input[name="' + id + '-gender"]').forEach(radio => {
        const label = radio.closest('label');
        if (label) label.classList.remove('border-rose-400', 'ring-2', 'ring-rose-200');
      });
    }

    if (summaryName) {
      if (isComplete && title && first && last) {
        summaryName.textContent = title.value + '. ' + first.value.trim() + ' ' + last.value.trim();
      } else if (first && first.value.trim()) {
        summaryName.textContent = first.value.trim() + (last && last.value.trim() ? ' ' + last.value.trim() : '');
      } else {
        summaryName.textContent = 'Click to enter passenger information';
      }
    }

    if (badge) {
      if (isComplete) {
        badge.className = 'inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-[#F8E7CD]/80 text-[#543b17] text-xs font-medium';
        badge.innerHTML = '<span class="material-symbols-outlined text-[15px]">check_circle</span>Details Added';
      } else {
        badge.className = 'inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-slate-100 text-slate-600 text-xs font-medium';
        badge.innerHTML = '<span class="material-symbols-outlined text-[15px]">edit</span>Incomplete';
      }
    }

    return isComplete;
  }

  function openPassengerCard(id) {
    const body = document.getElementById(id + '-body');
    const chevron = document.getElementById(id + '-chevron');
    if (body && body.classList.contains('hidden')) {
      body.classList.remove('hidden');
      if (chevron) chevron.style.transform = 'rotate(180deg)';
    }
  }

  function handleFormSubmit() {
    hideValidationBanner();
    const p1Ok = validatePassengerCard('p1', true);
    const p2Ok = validatePassengerCard('p2', true);

    if (!p1Ok) {
      openPassengerCard('p1');
      showValidationBanner(
        'Passenger 1 is incomplete',
        'Please fill in all highlighted fields for Passenger 1, then try again.'
      );
      const first = document.getElementById('p1-firstname');
      if (first) first.focus();
      return;
    }

    if (!p2Ok) {
      openPassengerCard('p2');
      showValidationBanner(
        'Passenger 2 is incomplete',
        'Please fill in all highlighted fields for Passenger 2, then try again.'
      );
      // focus first empty field
      const order = ['title', 'firstname', 'lastname', 'dob-date', 'nationality', 'passport', 'exp-date'];
      for (const key of order) {
        const el = document.getElementById('p2-' + key);
        if (el && !el.value) { el.focus(); break; }
      }
      return;
    }

    const btn = document.getElementById('submit-review-btn');
    if (btn) {
      btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[18px]">sync</span><span>Securing Booking Manifest...</span>';
      btn.classList.add('opacity-90');
      setTimeout(() => {
        const user = localStorage.getItem('skybook-auth-user') || sessionStorage.getItem('skybook-auth-user');
        sessionStorage.setItem('skybook-return-to', '/Booking/ConfirmPayment');
        if (user) {
          window.location.href = '/Booking/ConfirmPayment';
        } else {
          window.location.href = '/Account/Login?returnTo=' + encodeURIComponent('/Booking/ConfirmPayment');
        }
      }, 600);
    }
  }

  function syncPassengerDate(passengerId, dateType, value) {
    const parts = value ? value.split('-') : ['', '', ''];
    const prefix = passengerId + '-' + dateType;
    const y = document.getElementById(prefix + '-year');
    const m = document.getElementById(prefix + '-month');
    const d = document.getElementById(prefix + '-day');
    if (y) y.value = parts[0] || '';
    if (m) m.value = parts[1] || '';
    if (d) d.value = parts[2] || '';
  }

  document.addEventListener('DOMContentLoaded', () => {
    validatePassengerCard('p1');
    validatePassengerCard('p2');
  });
</script>
}