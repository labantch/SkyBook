@{
    ViewData["Title"] = "Passenger Details";
    Layout = "_Layout";
    ViewData["ShowBookingProgress"] = true;
    ViewData["BookingStep"] = 3;
}

@section Styles {
    <link rel="stylesheet" href="~/css/passenger-mobile.css" />
<style>@@layer base{html,body{margin:0;padding:0;}body{overscroll-behavior-y:auto;overflow-y:auto;}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}</style>
}

<div class="max-w-7xl mx-auto px-6 lg:px-12 py-10">
<!-- MAIN TWO-COLUMN SPLIT: FORM ENGINE (68%) & TRIP DETAILS (32%) -->
<div class="gap-10 items-start flex justify-center">
<!-- LEFT SECTION (Form Engine - 8 cols) -->
<div class="flex flex-col gap-8 w-full">
<!-- Header & Identity Requirements Note -->
<div class="flex flex-col gap-2">
<div class="flex items-center gap-2">
<span class="font-label-caps text-[11px] uppercase text-secondary font-bold tracking-widest">STEP 3 OF 4</span>
<span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
<span class="font-label-caps text-[11px] uppercase text-on-surface-variant font-medium tracking-widest">International Booking Manifest</span>
</div>
<h1 class="font-headline-lg text-3xl sm:text-4xl text-primary font-bold tracking-tight">Who's travelling?</h1>
<p class="font-body-md text-on-surface-variant text-[15px]">
            Enter passenger details exactly as they appear on the government-issued passport or national travel ID.
          </p>
</div>
<!-- Info Callout Box (Name Matching Requirement) -->
<div class="p-5 rounded-2xl bg-surface-container-low/70 border border-surface-container-low flex items-start gap-4">
<div class="w-10 h-10 rounded-xl bg-surface-container-lowest border border-surface-container-low flex items-center justify-center shrink-0 shadow-xs">
<span class="material-symbols-outlined text-on-surface-variant text-[22px]">badge</span>
</div>
<div class="flex flex-col gap-1">
<span class="font-headline-sm font-semibold text-primary text-[15px]">Name matching requirement</span>
<p class="font-body-sm text-[13px] text-on-surface-variant leading-relaxed">
              Ensure first, middle, and surnames correspond verbatim to your passport bio page. Middle names must be placed alongside first name in the indicated field. Discrepancies may result in denied boarding at security gates.
            </p>
</div>
</div>
<!-- PASSENGER CARDS CONTAINER -->
<div id="form-validation-banner" class="hidden mb-2 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 flex items-start gap-3">
  <span class="material-symbols-outlined text-rose-600 text-[20px] mt-0.5">error</span>
  <div class="flex-1 min-w-0">
    <p class="text-sm font-bold text-rose-900" id="form-validation-title">Please complete the missing details</p>
    <p class="text-xs text-rose-700 mt-0.5" id="form-validation-desc">Fill in the highlighted fields below to continue.</p>
  </div>
  <button type="button" class="text-rose-400 hover:text-rose-600" onclick="hideValidationBanner()" aria-label="Dismiss">
    <span class="material-symbols-outlined text-[18px]">close</span>
  </button>
</div>
<form class="flex flex-col gap-6" id="passenger-form" onsubmit="event.preventDefault(); handleFormSubmit();" method="post">

  <!-- PASSENGER 1 -->
  <div class="rounded-2xl border border-[#C5A880] bg-white shadow-sm overflow-hidden" id="card-p1">
    <button type="button" class="w-full text-left p-5 flex flex-wrap sm:flex-nowrap items-center justify-between gap-3 hover:bg-[#FBF7F0]/60 transition-colors" onclick="togglePassengerAccordion('p1')">
      <div class="flex items-center gap-3 min-w-0">
        <div class="w-8 h-8 rounded-full bg-[#0B192C] text-white text-xs font-bold flex items-center justify-center shrink-0">01</div>
        <div class="min-w-0">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="font-bold text-[#0B192C]">Passenger 1</span>
            <span class="text-slate-500 text-sm">• Adult</span>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-[#F8E7CD]/70 text-[#543b17] text-xs font-medium border border-[#C5A880]/40">
              <span class="material-symbols-outlined text-[14px]">airline_seat_recline_extra</span>
              Seat 14A
            </span>
          </div>
          <span class="text-sm text-slate-500" id="p1-summary-name">Mr. Alexander Wright</span>
        </div>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-[#F8E7CD]/80 text-[#543b17] text-xs font-medium" id="p1-status-badge">
          <span class="material-symbols-outlined text-[15px]">check_circle</span>
          Details Added
        </span>
        <div class="w-7 h-7 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 transition-transform duration-300" id="p1-chevron" style="transform: rotate(0deg);">
          <span class="material-symbols-outlined text-[18px]">expand_more</span>
        </div>
      </div>
    </button>

    <div id="p1-body" class="hidden border-t border-[#C5A880]/40 px-5 pb-5 pt-4 space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-4">
        <div class="sm:col-span-4 space-y-1.5">
          <label class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold" for="p1-title">Title *</label>
          <select id="p1-title" required onchange="validatePassengerCard('p1')" class="w-full px-3.5 py-2.5 rounded-xl border border-[#C5A880]/70 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C5A880]/40">
            <option value="Mr" selected>Mr.</option>
            <option value="Mrs">Mrs.</option>
            <option value="Ms">Ms.</option>
            <option value="Dr">Dr.</option>
          </select>
        </div>
        <div class="sm:col-span-8 space-y-1.5">
          <label class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold">Gender *</label>
          <div class="grid grid-cols-2 gap-3">
            <label class="flex items-center gap-2 p-2.5 rounded-xl border border-[#C5A880]/70 cursor-pointer">
              <input type="radio" name="p1-gender" value="male" checked class="accent-[#0B192C]" onchange="validatePassengerCard('p1')">
              <span class="text-sm font-medium">Male</span>
            </label>
            <label class="flex items-center gap-2 p-2.5 rounded-xl border border-[#C5A880]/70 cursor-pointer">
              <input type="radio" name="p1-gender" value="female" class="accent-[#0B192C]" onchange="validatePassengerCard('p1')">
              <span class="text-sm font-medium">Female</span>
            </label>
          </div>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="space-y-1.5">
          <label class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold" for="p1-firstname">First &amp; Middle Name *</label>
          <input id="p1-firstname" type="text" required value="Alexander" placeholder="e.g. Alexander" oninput="validatePassengerCard('p1')" class="w-full px-3.5 py-2.5 rounded-xl border border-[#C5A880]/70 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C5A880]/40">
        </div>
        <div class="space-y-1.5">
          <label class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold" for="p1-lastname">Last Name *</label>
          <input id="p1-lastname" type="text" required value="Wright" placeholder="e.g. Wright" oninput="validatePassengerCard('p1')" class="w-full px-3.5 py-2.5 rounded-xl border border-[#C5A880]/70 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C5A880]/40">
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="space-y-1.5">
          <label class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold" for="p1-dob-date">Date of Birth *</label>
          <input id="p1-dob-date" type="date" required max="2024-12-31" value="1990-05-12" onchange="syncPassengerDate('p1', 'dob', this.value); validatePassengerCard('p1')" class="w-full px-3.5 py-2.5 rounded-xl border border-[#C5A880]/70 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C5A880]/40">
          <div class="hidden" aria-hidden="true">
            <input id="p1-dob-day" type="hidden" value="12">
            <input id="p1-dob-month" type="hidden" value="05">
            <input id="p1-dob-year" type="hidden" value="1990">
          </div>
        </div>
        <div class="space-y-1.5">
          <label class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold" for="p1-nationality">Nationality *</label>
          <select id="p1-nationality" required onchange="validatePassengerCard('p1')" class="w-full px-3.5 py-2.5 rounded-xl border border-[#C5A880]/70 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C5A880]/40">
            <option value="United Kingdom" selected>United Kingdom</option>
            <option value="Egypt">Egypt</option>
            <option value="United Arab Emirates">United Arab Emirates</option>
            <option value="United States">United States</option>
            <option value="Saudi Arabia">Saudi Arabia</option>
          </select>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="space-y-1.5">
          <label class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold" for="p1-passport">Passport / Travel Document *</label>
          <input id="p1-passport" type="text" required value="GB92817401" placeholder="e.g. GB92817401" oninput="validatePassengerCard('p1')" class="uppercase tracking-wider w-full px-3.5 py-2.5 rounded-xl border border-[#C5A880]/70 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C5A880]/40">
        </div>
        <div class="space-y-1.5">
          <label class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold" for="p1-exp-date">Passport Expiry Date *</label>
          <input id="p1-exp-date" type="date" required min="2026-01-01" max="2040-12-31" value="2031-11-28" onchange="syncPassengerDate('p1', 'exp', this.value); validatePassengerCard('p1')" class="w-full px-3.5 py-2.5 rounded-xl border border-[#C5A880]/70 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C5A880]/40">
          <div class="hidden" aria-hidden="true">
            <input id="p1-exp-day" type="hidden" value="28">
            <input id="p1-exp-month" type="hidden" value="11">
            <input id="p1-exp-year" type="hidden" value="2031">
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- PASSENGER 2 -->
  <div class="rounded-2xl border border-[#C5A880] bg-white shadow-sm overflow-hidden" id="card-p2">
    <button type="button" class="w-full text-left p-5 flex flex-wrap sm:flex-nowrap items-center justify-between gap-3 hover:bg-[#FBF7F0]/60 transition-colors" onclick="togglePassengerAccordion('p2')">
      <div class="flex items-center gap-3 min-w-0">
        <div class="w-8 h-8 rounded-full border-2 border-[#C5A880] text-[#855D29] text-xs font-bold flex items-center justify-center shrink-0 bg-[#FBF7F0]">02</div>
        <div class="min-w-0">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="font-bold text-[#0B192C]">Passenger 2</span>
            <span class="text-slate-500 text-sm">• Adult</span>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 text-xs font-medium border border-slate-200">
              <span class="material-symbols-outlined text-[14px]">airline_seat_recline_extra</span>
              Seat 14B
            </span>
          </div>
          <span class="text-sm text-slate-500" id="p2-summary-name">Click to enter passenger information</span>
        </div>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-slate-100 text-slate-600 text-xs font-medium" id="p2-status-badge">
          <span class="material-symbols-outlined text-[15px]">edit</span>
          Incomplete
        </span>
        <div class="w-7 h-7 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 transition-transform duration-300" id="p2-chevron" style="transform: rotate(180deg);">
          <span class="material-symbols-outlined text-[18px]">expand_more</span>
        </div>
      </div>
    </button>

    <div id="p2-body" class="border-t border-[#C5A880]/40 px-5 pb-5 pt-4 space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-4">
        <div class="sm:col-span-4 space-y-1.5">
          <label class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold" for="p2-title">Title *</label>
          <select id="p2-title" required onchange="validatePassengerCard('p2')" class="w-full px-3.5 py-2.5 rounded-xl border border-[#C5A880]/70 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C5A880]/40">
            <option value="" selected>Select title</option>
            <option value="Mr">Mr.</option>
            <option value="Mrs">Mrs.</option>
            <option value="Ms">Ms.</option>
            <option value="Dr">Dr.</option>
          </select>
        </div>
        <div class="sm:col-span-8 space-y-1.5">
          <label class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold">Gender *</label>
          <div class="grid grid-cols-2 gap-3">
            <label class="flex items-center gap-2 p-2.5 rounded-xl border border-[#C5A880]/70 cursor-pointer">
              <input type="radio" name="p2-gender" value="male" class="accent-[#0B192C]" onchange="validatePassengerCard('p2')">
              <span class="text-sm font-medium">Male</span>
            </label>
            <label class="flex items-center gap-2 p-2.5 rounded-xl border border-[#C5A880]/70 cursor-pointer">
              <input type="radio" name="p2-gender" value="female" class="accent-[#0B192C]" onchange="validatePassengerCard('p2')">
              <span class="text-sm font-medium">Female</span>
            </label>
          </div>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="space-y-1.5">
          <label class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold" for="p2-firstname">First &amp; Middle Name *</label>
          <input id="p2-firstname" type="text" required placeholder="e.g. Eleanor Rose" oninput="validatePassengerCard('p2')" class="w-full px-3.5 py-2.5 rounded-xl border border-[#C5A880]/70 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C5A880]/40">
        </div>
        <div class="space-y-1.5">
          <label class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold" for="p2-lastname">Last Name *</label>
          <input id="p2-lastname" type="text" required placeholder="e.g. Wright" oninput="validatePassengerCard('p2')" class="w-full px-3.5 py-2.5 rounded-xl border border-[#C5A880]/70 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C5A880]/40">
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="space-y-1.5">
          <label class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold" for="p2-dob-date">Date of Birth *</label>
          <input id="p2-dob-date" type="date" required max="2024-12-31" onchange="syncPassengerDate('p2', 'dob', this.value); validatePassengerCard('p2')" class="w-full px-3.5 py-2.5 rounded-xl border border-[#C5A880]/70 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C5A880]/40">
          <div class="hidden" aria-hidden="true">
            <input id="p2-dob-day" type="hidden">
            <input id="p2-dob-month" type="hidden">
            <input id="p2-dob-year" type="hidden">
          </div>
        </div>
        <div class="space-y-1.5">
          <label class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold" for="p2-nationality">Nationality *</label>
          <select id="p2-nationality" required onchange="validatePassengerCard('p2')" class="w-full px-3.5 py-2.5 rounded-xl border border-[#C5A880]/70 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C5A880]/40">
            <option value="" selected>Select country</option>
            <option value="United Kingdom">United Kingdom</option>
            <option value="Egypt">Egypt</option>
            <option value="United Arab Emirates">United Arab Emirates</option>
            <option value="United States">United States</option>
            <option value="Saudi Arabia">Saudi Arabia</option>
          </select>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="space-y-1.5">
          <label class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold" for="p2-passport">Passport / Travel Document *</label>
          <input id="p2-passport" type="text" required placeholder="e.g. GB92817402" oninput="validatePassengerCard('p2')" class="uppercase tracking-wider w-full px-3.5 py-2.5 rounded-xl border border-[#C5A880]/70 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C5A880]/40">
        </div>
        <div class="space-y-1.5">
          <label class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold" for="p2-exp-date">Passport Expiry Date *</label>
          <input id="p2-exp-date" type="date" required min="2026-01-01" max="2040-12-31" onchange="syncPassengerDate('p2', 'exp', this.value); validatePassengerCard('p2')" class="w-full px-3.5 py-2.5 rounded-xl border border-[#C5A880]/70 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C5A880]/40">
          <div class="hidden" aria-hidden="true">
            <input id="p2-exp-day" type="hidden">
            <input id="p2-exp-month" type="hidden">
            <input id="p2-exp-year" type="hidden">
          </div>
        </div>
      </div>
    </div>
  </div>

<button class="w-full py-4 px-6 rounded-xl bg-[#0B192C] text-white font-headline-sm text-base font-bold shadow-sm hover:bg-[#1a2e4c] active:scale-[0.99] transition-all flex items-center justify-center gap-2 group" id="submit-review-btn" type="submit">
<span class="">Continue to Review</span>
<span class="text-base group-hover:translate-x-1 transition-transform">→</span>
</button>
<div class="flex items-center justify-center gap-2 text-on-surface-variant text-xs text-center">
<span class="">🔒</span>
<span class="">Passenger information is used solely to process your booking and travel requirements. Protected by 256-bit encryption.</span>
</div>
</form>
</div>
<!-- RIGHT SECTION (Sticky Trip Details Sidebar - 4 cols) -->

</div>
</div>

