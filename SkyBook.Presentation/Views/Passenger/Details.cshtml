@{
    ViewData["Title"] = "Passenger Details";
    Layout = "_Layout";
    ViewData["ShowBookingProgress"] = true;
    ViewData["BookingStep"] = 3;
}

@section Styles {
    <link rel="stylesheet" href="~/css/passenger-mobile.css" />
<style>@@layer base{html,body{margin:0;padding:0;}body{overscroll-behavior-y:auto;overflow-y:auto;}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}</style>
}

<div class="max-w-7xl mx-auto px-6 lg:px-12 py-10">
<!-- MAIN TWO-COLUMN SPLIT: FORM ENGINE (68%) & TRIP DETAILS (32%) -->
<div class="gap-10 items-start flex justify-center">
<!-- LEFT SECTION (Form Engine - 8 cols) -->
<div class="flex flex-col gap-8 w-full">
<!-- Header & Identity Requirements Note -->
<div class="flex flex-col gap-2">
<div class="flex items-center gap-2">
<span class="font-label-caps text-[11px] uppercase text-secondary font-bold tracking-widest">STEP 3 OF 4</span>
<span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
<span class="font-label-caps text-[11px] uppercase text-on-surface-variant font-medium tracking-widest" id="manifest-pax-summary">International Booking Manifest</span>
</div>
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
  <div>
    <h1 class="font-headline-lg text-3xl sm:text-4xl text-primary font-bold tracking-tight">Who's travelling?</h1>
    <p class="font-body-md text-on-surface-variant text-[15px]" id="manifest-pax-subtitle">
      Enter passenger details exactly as they appear on the government-issued passport or national travel ID.
    </p>
  </div>
  <button type="button" onclick="fillAllDemoPassengers()" class="self-start sm:self-auto inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-[#C5A880]/60 bg-amber-50/70 hover:bg-amber-100 text-[#785929] text-xs font-semibold shadow-2xs transition-all cursor-pointer">
    <span class="material-symbols-outlined text-[16px]">auto_fix_high</span>
    <span>Auto-fill Demo Details</span>
  </button>
</div>
</div>
<!-- Info Callout Box (Name Matching Requirement) -->
<div class="p-5 rounded-2xl bg-surface-container-low/70 border border-surface-container-low flex items-start gap-4">
<div class="w-10 h-10 rounded-xl bg-surface-container-lowest border border-surface-container-low flex items-center justify-center shrink-0 shadow-xs">
<span class="material-symbols-outlined text-on-surface-variant text-[22px]">badge</span>
</div>
<div class="flex flex-col gap-1">
<span class="font-headline-sm font-semibold text-primary text-[15px]">Name matching requirement</span>
<p class="font-body-sm text-[13px] text-on-surface-variant leading-relaxed">
              Ensure first, middle, and surnames correspond verbatim to your passport bio page. Middle names must be placed alongside first name in the indicated field. Discrepancies may result in denied boarding at security gates.
            </p>
</div>
</div>
<!-- PASSENGER CARDS CONTAINER -->
<div id="form-validation-banner" class="hidden mb-2 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 flex items-start gap-3">
  <span class="material-symbols-outlined text-rose-600 text-[20px] mt-0.5">error</span>
  <div class="flex-1 min-w-0">
    <p class="text-sm font-bold text-rose-900" id="form-validation-title">Please complete the missing details</p>
    <p class="text-xs text-rose-700 mt-0.5" id="form-validation-desc">Fill in the highlighted fields below to continue.</p>
  </div>
  <button type="button" class="text-rose-400 hover:text-rose-600" onclick="hideValidationBanner()" aria-label="Dismiss">
    <span class="material-symbols-outlined text-[18px]">close</span>
  </button>
</div>
<form class="flex flex-col gap-6" id="passenger-form" onsubmit="event.preventDefault(); handleFormSubmit();" method="post">

  <!-- DYNAMIC PASSENGER CARDS CONTAINER -->
  <div id="passenger-cards-container" class="flex flex-col gap-5"></div>

<div class="flex items-center">
  <button class="w-full py-4 px-6 rounded-xl bg-[#0B192C] text-white font-headline-sm text-base font-bold shadow-sm hover:bg-[#1a2e4c] active:scale-[0.99] transition-all flex items-center justify-center gap-2 group cursor-pointer" id="submit-review-btn" type="submit">
    <span>Continue to Payment</span>
    <span class="text-base group-hover:translate-x-1 transition-transform">→</span>
  </button>
</div>
<div class="flex items-center justify-center gap-2 text-on-surface-variant text-xs text-center">
  <span>🔒</span>
  <span>Passenger information is used solely to process your booking and travel requirements. Protected by 256-bit encryption.</span>
</div>
</form>
</div>
<!-- RIGHT SECTION (Sticky Trip Details Sidebar - 4 cols) -->

</div>
</div>

@section Scripts {
<script id="tailwind-config">tailwind.config={darkMode:"class",theme:{extend:{"colors":{"primary-container":"#0e1c2f","secondary-fixed":"#fedeb2","secondary-fixed-dim":"#e0c298","inverse-on-surface":"#f0f1f2","surface-dim":"#d9dadb","surface-variant":"#e1e3e4","on-error":"#ffffff","on-primary-container":"#77849c","on-surface-variant":"#55585d","on-tertiary-fixed":"#001c38","surface-bright":"#f8f9fa","on-secondary":"#ffffff","primary-fixed-dim":"#bac7e1","outline-variant":"#e2e4e8","primary-fixed":"#d6e3fe","on-tertiary-container":"#6886ae","on-secondary-fixed":"#281800","surface":"#f8f9fa","on-primary-fixed-variant":"#3a475c","inverse-primary":"#bac7e1","on-primary":"#ffffff","on-background":"#191c1d","on-surface":"#191c1d","tertiary":"#000000","surface-tint":"#525f75","on-tertiary":"#ffffff","on-secondary-fixed-variant":"#584323","outline":"#75777d","primary":"#0b192c","tertiary-container":"#001c38","surface-container-low":"#f6f7f9","secondary-container":"#fedeb2","tertiary-fixed":"#d3e4ff","surface-container":"#edeeef","background":"#f8f9fa","secondary":"#b4813f","on-secondary-container":"#78603e","surface-container-high":"#e7e8e9","on-primary-fixed":"#0e1c2f","error":"#ba1a1a","tertiary-fixed-dim":"#aac9f4","on-tertiary-fixed-variant":"#29486d","inverse-surface":"#2e3132","surface-container-lowest":"#ffffff","surface-container-highest":"#e1e3e4","error-container":"#ffdad6","on-error-container":"#93000a"},"borderRadius":{"DEFAULT":"0.25rem","lg":"0.5rem","xl":"0.75rem","full":"9999px"},"spacing":{"space-xs":"0.25rem","margin-mobile":"1.25rem","space-lg":"1.5rem","margin":"3rem","space-md":"1rem","space-xl":"2.5rem","gutter-mobile":"1rem","gutter":"1.5rem","space-sm":"0.5rem"},"fontFamily":{"price-lg":["Space Grotesk"],"headline-md":["Plus Jakarta Sans"],"body-md":["Plus Jakarta Sans"],"headline-lg":["Plus Jakarta Sans"],"body-sm":["Plus Jakarta Sans"],"display-hero":["Plus Jakarta Sans"],"label-caps":["Space Grotesk"],"headline-sm":["Plus Jakarta Sans"],"body-lg":["Plus Jakarta Sans"],"title-flight-code":["Space Grotesk"],"display-hero-mobile":["Plus Jakarta Sans"]},"fontSize":{"price-lg":["24px",{"lineHeight":"28px","letterSpacing":"-0.02em","fontWeight":"700"}],"headline-md":["24px",{"lineHeight":"32px","letterSpacing":"-0.015em","fontWeight":"600"}],"body-md":["15px",{"lineHeight":"22px","fontWeight":"400"}],"headline-lg":["32px",{"lineHeight":"40px","letterSpacing":"-0.02em","fontWeight":"600"}],"body-sm":["13px",{"lineHeight":"18px","fontWeight":"400"}],"display-hero":["56px",{"lineHeight":"64px","letterSpacing":"-0.03em","fontWeight":"700"}],"label-caps":["11px",{"lineHeight":"14px","letterSpacing":"0.08em","fontWeight":"600"}],"headline-sm":["20px",{"lineHeight":"28px","fontWeight":"600"}],"body-lg":["18px",{"lineHeight":"28px","fontWeight":"400"}],"title-flight-code":["28px",{"lineHeight":"32px","letterSpacing":"0.04em","fontWeight":"700"}],"display-hero-mobile":["36px",{"lineHeight":"44px","letterSpacing":"-0.02em","fontWeight":"700"}]}}}};</script>
<script>
  const DEFAULT_DEMO_PASSENGERS = [
    { title: 'Mr', firstName: 'Mohamed', lastName: 'Laban', dob: '1995-05-15', nationality: 'Egypt', passport: 'A12345678', expDate: '2032-12-31', gender: 'male' },
    { title: 'Mrs', firstName: 'Sarah', lastName: 'Laban', dob: '1997-08-20', nationality: 'Egypt', passport: 'A87654321', expDate: '2032-12-31', gender: 'female' },
    { title: 'Mr', firstName: 'Omar', lastName: 'Laban', dob: '2000-03-10', nationality: 'Egypt', passport: 'A23456789', expDate: '2033-06-15', gender: 'male' },
    { title: 'Mr', firstName: 'Youssef', lastName: 'Laban', dob: '2003-11-25', nationality: 'Egypt', passport: 'A34567890', expDate: '2034-01-10', gender: 'male' },
    { title: 'Ms', firstName: 'Layla', lastName: 'Laban', dob: '2005-07-14', nationality: 'Egypt', passport: 'A45678901', expDate: '2034-09-20', gender: 'female' },
    { title: 'Mr', firstName: 'Kareem', lastName: 'Laban', dob: '1992-04-18', nationality: 'Egypt', passport: 'A56789012', expDate: '2033-10-05', gender: 'male' },
    { title: 'Mrs', firstName: 'Nour', lastName: 'Laban', dob: '1994-09-22', nationality: 'Egypt', passport: 'A67890123', expDate: '2035-02-14', gender: 'female' },
    { title: 'Mr', firstName: 'Tariq', lastName: 'Laban', dob: '1991-01-30', nationality: 'Egypt', passport: 'A78901234', expDate: '2032-05-18', gender: 'male' },
    { title: 'Ms', firstName: 'Mona', lastName: 'Laban', dob: '1998-12-08', nationality: 'Egypt', passport: 'A89012345', expDate: '2034-11-11', gender: 'female' }
  ];

  function getEffectivePassengerCount() {
    try {
      // 1. Check seat assignments count
      const rawSeats = sessionStorage.getItem('skybook-seat-assignments');
      if (rawSeats) {
        const seatsData = JSON.parse(rawSeats);
        const seg1 = seatsData && (seatsData[1] || Object.values(seatsData)[0]);
        if (seg1 && seg1.passengers) {
          const keys = Object.keys(seg1.passengers).map(Number).filter(n => !isNaN(n) && n > 0);
          if (keys.length > 0) return Math.max(...keys);
        }
      }

      // 2. Check selected flights
      const rawFlights = sessionStorage.getItem('skybook-selected-flights');
      if (rawFlights) {
        const fData = JSON.parse(rawFlights);
        if (fData.passengerCount && Number(fData.passengerCount) > 0) {
          return Number(fData.passengerCount);
        }
      }

      // 3. Check explicit passenger count
      const rawCount = parseInt(sessionStorage.getItem('skybook_passenger_count') || '0', 10);
      if (rawCount > 0) return rawCount;

      // 4. Check search context
      const rawCtx = sessionStorage.getItem('skybook-search-context');
      if (rawCtx) {
        const ctx = JSON.parse(rawCtx);
        if (ctx.passengerCount && Number(ctx.passengerCount) > 0) {
          return Number(ctx.passengerCount);
        }
      }

      // 5. Check URL parameters
      const urlParams = new URLSearchParams(window.location.search);
      const urlPax = parseInt(urlParams.get('passengerCount') || urlParams.get('passengers') || '0', 10);
      if (urlPax > 0) return urlPax;
    } catch (e) {
      console.warn('Error reading passenger count:', e);
    }
    return 1;
  }

  (function enforcePrerequisites() {
    try {
      const paxCount = getEffectivePassengerCount();
      var rawFlights = sessionStorage.getItem('skybook-selected-flights');
      if (!rawFlights) {
        sessionStorage.setItem('skybook-selected-flights', JSON.stringify({
          flightId: 1,
          flightNumber: 'SB 101',
          route: 'Cairo (CAI) → Dubai (DXB)',
          cabin: 'Economy',
          totalPrice: 1920 * paxCount,
          passengerCount: paxCount
        }));
      }
      var rawSeats = sessionStorage.getItem('skybook-seat-assignments');
      if (!rawSeats) {
        const defaultPaxSeats = {};
        for (let p = 1; p <= paxCount; p++) {
          defaultPaxSeats[p] = {
            name: `Passenger ${p} (Adult)`,
            cabinClass: 'economy',
            seat: `${13 + p}A`,
            pos: 'Window'
          };
        }
        sessionStorage.setItem('skybook-seat-assignments', JSON.stringify({
          1: {
            aircraftId: 'A350-1000',
            flightNum: 'SB 101',
            passengers: defaultPaxSeats
          }
        }));
      }
    } catch (e) {
      console.warn('Prerequisites check:', e);
    }
  })();

  function getAssignedSeatsMap() {
    const map = {};
    try {
      const rawSeats = sessionStorage.getItem('skybook-seat-assignments');
      if (rawSeats) {
        const data = JSON.parse(rawSeats);
        const seg1 = data && (data[1] || Object.values(data)[0]);
        if (seg1 && seg1.passengers) {
          Object.keys(seg1.passengers).forEach(k => {
            if (seg1.passengers[k] && seg1.passengers[k].seat) {
              map[k] = seg1.passengers[k].seat;
            }
          });
        }
      }
    } catch (e) {}
    return map;
  }

  function getStoredManifest() {
    try {
      const raw = sessionStorage.getItem('skybook-passenger-manifest');
      return raw ? JSON.parse(raw) : null;
    } catch (e) {
      return null;
    }
  }

  function escapeHtml(str) {
    if (!str) return '';
    return String(str).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/'/g, '&#39;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function renderPassengerCards() {
    const container = document.getElementById('passenger-cards-container');
    if (!container) return;

    const paxCount = getEffectivePassengerCount();
    const assignedSeats = getAssignedSeatsMap();
    const storedManifest = getStoredManifest();

    // Update Header Badges
    const summaryBadge = document.getElementById('manifest-pax-summary');
    if (summaryBadge) {
      summaryBadge.textContent = `International Booking Manifest • ${paxCount} ${paxCount === 1 ? 'Passenger' : 'Passengers'}`;
    }
    const subtitle = document.getElementById('manifest-pax-subtitle');
    if (subtitle) {
      subtitle.textContent = `Enter passport details for all ${paxCount} passengers as they appear on official government IDs.`;
    }

    let html = '';
    for (let p = 1; p <= paxCount; p++) {
      const pKey = 'p' + p;
      const seat = assignedSeats[p] || `${13 + p}A`;
      const seatText = seat ? `Seat ${seat}` : 'Seat Unassigned';
      const stored = storedManifest ? storedManifest[pKey] : null;
      const def = stored || { title: '', firstName: '', lastName: '', dob: '', nationality: '', passport: '', expDate: '', gender: '' };
      const isInitComplete = !!(def.firstName && def.lastName && def.passport && def.dob && def.expDate && def.nationality && def.title && def.gender);
      const summaryNameText = isInitComplete 
        ? ((def.title ? def.title + '. ' : '') + def.firstName + ' ' + def.lastName)
        : 'Click to enter passenger information';
      const pNumStr = p < 10 ? '0' + p : '' + p;
      const isOpen = (p === 1); // Keep first passenger expanded initially, others neatly compact

      html += `
        <div class="rounded-2xl border border-[#C5A880] bg-white shadow-sm overflow-hidden transition-all" id="card-${pKey}">
          <button type="button" class="w-full text-left p-5 flex flex-wrap sm:flex-nowrap items-center justify-between gap-3 hover:bg-[#FBF7F0]/60 transition-colors cursor-pointer" onclick="togglePassengerAccordion('${pKey}')">
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-8 h-8 rounded-full ${p === 1 ? 'bg-[#0B192C] text-white' : 'border-2 border-[#C5A880] text-[#855D29] bg-[#FBF7F0]'} text-xs font-bold flex items-center justify-center shrink-0">${pNumStr}</div>
              <div class="min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-bold text-[#0B192C]">Passenger ${p}</span>
                  <span class="text-slate-500 text-sm">• Adult</span>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-[#F8E7CD]/70 text-[#543b17] text-xs font-medium border border-[#C5A880]/40">
                    <span class="material-symbols-outlined text-[14px]">airline_seat_recline_extra</span>
                    ${seatText}
                  </span>
                </div>
                <span class="text-sm text-slate-500" id="${pKey}-summary-name">${summaryNameText}</span>
              </div>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full ${isInitComplete ? 'bg-[#F8E7CD]/80 text-[#543b17]' : 'bg-slate-100 text-slate-600'} text-xs font-medium" id="${pKey}-status-badge">
                <span class="material-symbols-outlined text-[15px]">${isInitComplete ? 'check_circle' : 'edit'}</span>
                ${isInitComplete ? 'Details Added' : 'Incomplete'}
              </span>
              <div class="w-7 h-7 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 transition-transform duration-300" id="${pKey}-chevron" style="transform: rotate(${isOpen ? '180deg' : '0deg'});">
                <span class="material-symbols-outlined text-[18px]">expand_more</span>
              </div>
            </div>
          </button>

          <div id="${pKey}-body" class="${isOpen ? '' : 'hidden '}border-t border-[#C5A880]/40 px-5 pb-5 pt-4 space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-4">
              <div class="sm:col-span-4 space-y-1.5">
                <label class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold" for="${pKey}-title">Title *</label>
                <select id="${pKey}-title" required onchange="validatePassengerCard('${pKey}')" class="w-full px-3.5 py-2.5 rounded-xl border border-[#C5A880]/70 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C5A880]/40">
                  <option value="" ${!def.title ? 'selected' : ''} disabled>Select title</option>
                  <option value="Mr" ${def.title === 'Mr' ? 'selected' : ''}>Mr.</option>
                  <option value="Mrs" ${def.title === 'Mrs' ? 'selected' : ''}>Mrs.</option>
                  <option value="Ms" ${def.title === 'Ms' ? 'selected' : ''}>Ms.</option>
                  <option value="Dr" ${def.title === 'Dr' ? 'selected' : ''}>Dr.</option>
                </select>
              </div>
              <div class="sm:col-span-8 space-y-1.5">
                <label class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold">Gender *</label>
                <div class="grid grid-cols-2 gap-3">
                  <label class="flex items-center gap-2 p-2.5 rounded-xl border border-[#C5A880]/70 cursor-pointer">
                    <input type="radio" name="${pKey}-gender" value="male" ${def.gender === 'male' ? 'checked' : ''} class="accent-[#0B192C]" onchange="validatePassengerCard('${pKey}')">
                    <span class="text-sm font-medium">Male</span>
                  </label>
                  <label class="flex items-center gap-2 p-2.5 rounded-xl border border-[#C5A880]/70 cursor-pointer">
                    <input type="radio" name="${pKey}-gender" value="female" ${def.gender === 'female' ? 'checked' : ''} class="accent-[#0B192C]" onchange="validatePassengerCard('${pKey}')">
                    <span class="text-sm font-medium">Female</span>
                  </label>
                </div>
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold" for="${pKey}-firstname">First &amp; Middle Name *</label>
                <input id="${pKey}-firstname" type="text" required maxlength="50" value="${escapeHtml(def.firstName)}" placeholder="e.g. Alexander" oninput="validatePassengerCard('${pKey}')" class="w-full px-3.5 py-2.5 rounded-xl border border-[#C5A880]/70 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C5A880]/40">
              </div>
              <div class="space-y-1.5">
                <label class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold" for="${pKey}-lastname">Last Name *</label>
                <input id="${pKey}-lastname" type="text" required maxlength="50" value="${escapeHtml(def.lastName)}" placeholder="e.g. Wright" oninput="validatePassengerCard('${pKey}')" class="w-full px-3.5 py-2.5 rounded-xl border border-[#C5A880]/70 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C5A880]/40">
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold" for="${pKey}-dob-date">Date of Birth *</label>
                <input id="${pKey}-dob-date" type="date" required max="2024-12-31" value="${def.dob || ''}" onchange="syncPassengerDate('${pKey}', 'dob', this.value); validatePassengerCard('${pKey}')" class="w-full px-3.5 py-2.5 rounded-xl border border-[#C5A880]/70 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C5A880]/40">
                <div class="hidden" aria-hidden="true">
                  <input id="${pKey}-dob-day" type="hidden">
                  <input id="${pKey}-dob-month" type="hidden">
                  <input id="${pKey}-dob-year" type="hidden">
                </div>
              </div>
              <div class="space-y-1.5">
                <label class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold" for="${pKey}-nationality">Nationality *</label>
                <select id="${pKey}-nationality" required onchange="validatePassengerCard('${pKey}')" class="w-full px-3.5 py-2.5 rounded-xl border border-[#C5A880]/70 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C5A880]/40">
                  <option value="" ${!def.nationality ? 'selected' : ''} disabled>Select country</option>
                  <option value="Egypt" ${def.nationality === 'Egypt' ? 'selected' : ''}>Egypt</option>
                  <option value="United Kingdom" ${def.nationality === 'United Kingdom' ? 'selected' : ''}>United Kingdom</option>
                  <option value="United Arab Emirates" ${def.nationality === 'United Arab Emirates' ? 'selected' : ''}>United Arab Emirates</option>
                  <option value="United States" ${def.nationality === 'United States' ? 'selected' : ''}>United States</option>
                  <option value="Saudi Arabia" ${def.nationality === 'Saudi Arabia' ? 'selected' : ''}>Saudi Arabia</option>
                </select>
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold" for="${pKey}-passport">Passport / Travel Document *</label>
                <input id="${pKey}-passport" type="text" required maxlength="20" value="${escapeHtml(def.passport)}" placeholder="e.g. A12345678" oninput="validatePassengerCard('${pKey}')" class="uppercase tracking-wider w-full px-3.5 py-2.5 rounded-xl border border-[#C5A880]/70 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C5A880]/40">
              </div>
              <div class="space-y-1.5">
                <label class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold" for="${pKey}-exp-date">Passport Expiry Date *</label>
                <input id="${pKey}-exp-date" type="date" required min="2026-01-01" max="2040-12-31" value="${def.expDate || ''}" onchange="syncPassengerDate('${pKey}', 'exp', this.value); validatePassengerCard('${pKey}')" class="w-full px-3.5 py-2.5 rounded-xl border border-[#C5A880]/70 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#C5A880]/40">
                <div class="hidden" aria-hidden="true">
                  <input id="${pKey}-exp-day" type="hidden">
                  <input id="${pKey}-exp-month" type="hidden">
                  <input id="${pKey}-exp-year" type="hidden">
                </div>
              </div>
            </div>
          </div>
        </div>
      `;
    }

    container.innerHTML = html;

    // Validate and sync hidden inputs for all rendered cards
    for (let p = 1; p <= paxCount; p++) {
      const pKey = 'p' + p;
      const dobEl = document.getElementById(`${pKey}-dob-date`);
      const expEl = document.getElementById(`${pKey}-exp-date`);
      if (dobEl && dobEl.value) syncPassengerDate(pKey, 'dob', dobEl.value);
      if (expEl && expEl.value) syncPassengerDate(pKey, 'exp', expEl.value);
      validatePassengerCard(pKey, false);
    }
  }

  function fillAllDemoPassengers() {
    const paxCount = getEffectivePassengerCount();
    for (let p = 1; p <= paxCount; p++) {
      const pKey = 'p' + p;
      const demo = DEFAULT_DEMO_PASSENGERS[(p - 1) % DEFAULT_DEMO_PASSENGERS.length];
      const title = document.getElementById(`${pKey}-title`);
      const first = document.getElementById(`${pKey}-firstname`);
      const last = document.getElementById(`${pKey}-lastname`);
      const dob = document.getElementById(`${pKey}-dob-date`);
      const nat = document.getElementById(`${pKey}-nationality`);
      const pass = document.getElementById(`${pKey}-passport`);
      const exp = document.getElementById(`${pKey}-exp-date`);

      if (title) title.value = demo.title;
      if (first) first.value = demo.firstName;
      if (last) last.value = demo.lastName;
      if (dob) dob.value = demo.dob;
      if (nat) nat.value = demo.nationality;
      if (pass) pass.value = demo.passport;
      if (exp) exp.value = demo.expDate;

      const radios = document.querySelectorAll(`input[name="${pKey}-gender"]`);
      radios.forEach(r => {
        r.checked = (r.value === demo.gender);
      });

      syncPassengerDate(pKey, 'dob', demo.dob);
      syncPassengerDate(pKey, 'exp', demo.expDate);
      validatePassengerCard(pKey, false);
    }
    hideValidationBanner();
  }

  function togglePassengerAccordion(id) {
    const body = document.getElementById(id + '-body');
    const chevron = document.getElementById(id + '-chevron');
    if (!body || !chevron) return;

    const isHidden = body.classList.contains('hidden');
    if (isHidden) {
      body.classList.remove('hidden');
      chevron.style.transform = 'rotate(180deg)';
    } else {
      body.classList.add('hidden');
      chevron.style.transform = 'rotate(0deg)';
    }
  }

  function openPassengerCard(id) {
    const body = document.getElementById(id + '-body');
    const chevron = document.getElementById(id + '-chevron');
    if (body && body.classList.contains('hidden')) {
      body.classList.remove('hidden');
      if (chevron) chevron.style.transform = 'rotate(180deg)';
    }
  }

  function hideValidationBanner() {
    const banner = document.getElementById('form-validation-banner');
    if (banner) banner.classList.add('hidden');
  }

  function showValidationBanner(title, desc) {
    const banner = document.getElementById('form-validation-banner');
    const t = document.getElementById('form-validation-title');
    const d = document.getElementById('form-validation-desc');
    if (t) t.textContent = title;
    if (d) d.textContent = desc;
    if (banner) {
      banner.classList.remove('hidden');
      banner.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }

  function setFieldError(el, hasError) {
    if (!el) return;
    if (hasError) {
      el.classList.add('border-rose-400', 'ring-2', 'ring-rose-200');
      el.classList.remove('border-[#C5A880]/70');
    } else {
      el.classList.remove('border-rose-400', 'ring-2', 'ring-rose-200');
      if (!el.classList.contains('border-[#C5A880]/70')) {
        el.classList.add('border-[#C5A880]/70');
      }
    }
  }

  function getGenderValue(id) {
    const checked = document.querySelector('input[name="' + id + '-gender"]:checked');
    return checked ? checked.value : '';
  }

  function validatePassengerCard(id, highlight) {
    const title = document.getElementById(id + '-title');
    const first = document.getElementById(id + '-firstname');
    const last = document.getElementById(id + '-lastname');
    const dobDate = document.getElementById(id + '-dob-date');
    const nat = document.getElementById(id + '-nationality');
    const passport = document.getElementById(id + '-passport');
    const expDate = document.getElementById(id + '-exp-date');
    const badge = document.getElementById(id + '-status-badge');
    const summaryName = document.getElementById(id + '-summary-name');

    if (dobDate && dobDate.value) syncPassengerDate(id, 'dob', dobDate.value);
    if (expDate && expDate.value) syncPassengerDate(id, 'exp', expDate.value);

    const checks = [
      { el: title, ok: title && title.value },
      { el: first, ok: first && first.value.trim().length > 0 },
      { el: last, ok: last && last.value.trim().length > 0 },
      { el: dobDate, ok: dobDate && dobDate.value },
      { el: nat, ok: nat && nat.value },
      { el: passport, ok: passport && passport.value.trim().length > 0 },
      { el: expDate, ok: expDate && expDate.value },
      { el: null, ok: !!getGenderValue(id) }
    ];

    const isComplete = checks.every(c => c.ok);

    if (highlight) {
      checks.forEach(c => setFieldError(c.el, !c.ok));
      document.querySelectorAll('input[name="' + id + '-gender"]').forEach(radio => {
        const label = radio.closest('label');
        if (label) {
          if (!getGenderValue(id)) {
            label.classList.add('border-rose-400', 'ring-2', 'ring-rose-200');
          } else {
            label.classList.remove('border-rose-400', 'ring-2', 'ring-rose-200');
          }
        }
      });
    } else if (isComplete) {
      checks.forEach(c => setFieldError(c.el, false));
      document.querySelectorAll('input[name="' + id + '-gender"]').forEach(radio => {
        const label = radio.closest('label');
        if (label) label.classList.remove('border-rose-400', 'ring-2', 'ring-rose-200');
      });
    }

    if (summaryName) {
      if (isComplete && title && first && last) {
        summaryName.textContent = title.value + '. ' + first.value.trim() + ' ' + last.value.trim();
      } else if (first && first.value.trim()) {
        summaryName.textContent = first.value.trim() + (last && last.value.trim() ? ' ' + last.value.trim() : '');
      } else {
        summaryName.textContent = 'Click to enter passenger information';
      }
    }

    if (badge) {
      if (isComplete) {
        badge.className = 'inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-[#F8E7CD]/80 text-[#543b17] text-xs font-medium';
        badge.innerHTML = '<span class="material-symbols-outlined text-[15px]">check_circle</span>Details Added';
      } else {
        badge.className = 'inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-slate-100 text-slate-600 text-xs font-medium';
        badge.innerHTML = '<span class="material-symbols-outlined text-[15px]">edit</span>Incomplete';
      }
    }

    return isComplete;
  }

  function handleFormSubmit() {
    hideValidationBanner();

    const paxCount = getEffectivePassengerCount();
    let firstInvalidPax = null;

    for (let p = 1; p <= paxCount; p++) {
      const pKey = 'p' + p;
      const isValid = validatePassengerCard(pKey, true);
      if (!isValid && !firstInvalidPax) {
        firstInvalidPax = p;
      }
    }

    if (firstInvalidPax) {
      openPassengerCard('p' + firstInvalidPax);
      showValidationBanner(`Please complete Passenger ${firstInvalidPax} details`, 'Required fields are highlighted in red.');
      const cardEl = document.getElementById('card-p' + firstInvalidPax);
      if (cardEl) {
        cardEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      return;
    }

    const manifest = {};
    for (let p = 1; p <= paxCount; p++) {
      const pKey = 'p' + p;
      manifest[pKey] = {
        title: document.getElementById(`${pKey}-title`)?.value || 'Mr',
        firstName: document.getElementById(`${pKey}-firstname`)?.value.trim(),
        lastName: document.getElementById(`${pKey}-lastname`)?.value.trim(),
        dob: document.getElementById(`${pKey}-dob-date`)?.value,
        nationality: document.getElementById(`${pKey}-nationality`)?.value,
        passport: document.getElementById(`${pKey}-passport`)?.value.trim(),
        expDate: document.getElementById(`${pKey}-exp-date`)?.value,
        gender: getGenderValue(pKey) || 'male'
      };
    }

    sessionStorage.setItem('skybook-passenger-manifest', JSON.stringify(manifest));
    sessionStorage.setItem('skybook_passenger_count', paxCount);

    try {
      const rawFlights = sessionStorage.getItem('skybook-selected-flights');
      if (rawFlights) {
        const fData = JSON.parse(rawFlights);
        fData.passengerCount = paxCount;
        sessionStorage.setItem('skybook-selected-flights', JSON.stringify(fData));
      }
    } catch (e) {}

    if (window.SkyBookProgress) {
      window.SkyBookProgress.unlockStep(4);
    }

    const btn = document.getElementById('submit-review-btn');
    if (btn) {
      const isAuthed = @(User.Identity?.IsAuthenticated == true ? "true" : "false");
      if (!isAuthed) {
        btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[18px]">sync</span><span>Saving details & heading to sign in...</span>';
      } else {
        btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[18px]">sync</span><span>Proceeding to Final Step...</span>';
      }
      btn.classList.add('opacity-90');
      setTimeout(() => {
        window.location.href = '/Booking/ConfirmPayment';
      }, 300);
    }
  }

  function syncPassengerDate(passengerId, dateType, value) {
    const parts = value ? value.split('-') : ['', '', ''];
    const prefix = passengerId + '-' + dateType;
    const y = document.getElementById(prefix + '-year');
    const m = document.getElementById(prefix + '-month');
    const d = document.getElementById(prefix + '-day');
    if (y) y.value = parts[0] || '';
    if (m) m.value = parts[1] || '';
    if (d) d.value = parts[2] || '';
  }

  document.addEventListener('DOMContentLoaded', () => {
    renderPassengerCards();
  });
</script>
}