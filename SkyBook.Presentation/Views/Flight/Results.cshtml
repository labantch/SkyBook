                    ${busBadge}
                    <div>
                      <span class="text-[11px] font-extrabold text-[#0B192C] uppercase tracking-wider block">BUSINESS</span>
                      <span class="text-2xl font-extrabold text-[#0B192C] block mt-1 font-mono">$${bus.price.toLocaleString()}</span>
                      <span class="text-[11px] text-slate-500 mt-0.5 block">${bus.note}</span>
                      <ul class="mt-2.5 space-y-1.5 text-[11px] text-slate-600">
                        ${bus.perks.map(p => `<li class="flex items-center space-x-1.5"><span class="text-slate-400">✓</span><span>${p}</span></li>`).join('')}
                      </ul>
                    </div>
                    <div class="mt-4">
                      ${busBtn}
                    </div>
                  </div>

                  <!-- FIRST SUITE -->
                  ${fstCardContent}
                </div>
              </div>

            </div>

            <!-- Expandable Flight Details Drawer -->
            ${detailsDrawerHtml}
          </div>
        `;
      });

      container.innerHTML = html;
    }

    function renderAll() {
      renderSubheader();
      renderSidebar();
      renderFlightHeader();
      renderFlightCards();
    }

    document.addEventListener('DOMContentLoaded', () => {
      const savedTripMode = sessionStorage.getItem('skybook-trip-mode');
      const initialTripMode = ['round-trip', 'one-way', 'multi-city'].includes(savedTripMode) ? savedTripMode : 'round-trip';
      appState.tripMode = initialTripMode;
      setupSegmentsForMode(initialTripMode);
      try {
        applySearchContext(JSON.parse(sessionStorage.getItem('skybook-search-context') || 'null'));
      } catch (error) {
        sessionStorage.removeItem('skybook-search-context');
      }
      ['one-way', 'round-trip', 'multi-city'].forEach(mode => {
        const toggle = document.getElementById(`toggle-btn-${mode}`);
        if (toggle) {
          toggle.disabled = mode !== initialTripMode;
          toggle.setAttribute('aria-disabled', String(mode !== initialTripMode));
          toggle.className = mode === initialTripMode
            ? 'trip-toggle-btn px-3.5 py-1.5 rounded-md bg-[#0B192C] text-white font-bold shadow-sm whitespace-nowrap cursor-default'
            : 'trip-toggle-btn px-3.5 py-1.5 rounded-md font-medium text-slate-400 bg-slate-200/60 cursor-not-allowed opacity-60';
        }
      });
      const modeHeader = document.getElementById('trip-mode-header-row');
      if (modeHeader && !document.getElementById('trip-mode-lock-note')) {
        const note = document.createElement('span');
        note.id = 'trip-mode-lock-note';
        note.className = 'text-[10px] text-slate-400';
        note.textContent = 'Trip type selected from search';
        modeHeader.querySelector('div')?.appendChild(note);
      }
      renderAll();
    });
  </script>
}