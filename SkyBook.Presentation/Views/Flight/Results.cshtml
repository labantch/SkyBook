    function renderSidebar() {
      const container = document.getElementById('sidebar-segments-container');
      if (!container) return;

      let html = '';
      let totalFare = 0;

      appState.segments.forEach((seg, idx) => {
        const isCurrent = idx === appState.activeSegmentIndex;
        const isSelected = seg.selectedFlight !== null;
        if (isSelected) totalFare += seg.selectedFlight.price;

        let cardClass = isCurrent
          ? 'bg-slate-50 border-2 border-[#0B192C] shadow-sm'
          : 'bg-white hover:bg-slate-50 border border-slate-200';

        let badgeStyle = isSelected
          ? 'bg-[#0B192C] text-white'
          : (isCurrent ? 'bg-[#C5A880] text-[#0B192C]' : 'bg-slate-200 text-slate-600');

        let statusText = isCurrent ? 'Viewing' : (isSelected ? 'Edit' : 'Select');

        let descText = '';
        if (isSelected) {
          descText = `${seg.shortDate} • ${seg.selectedFlight.flightNum} • ${seg.selectedFlight.cabin} ($${seg.selectedFlight.price.toLocaleString()})`;
        } else if (isCurrent) {
          descText = `${seg.shortDate} • Select flight now`;
        } else {
          descText = `${seg.shortDate} • Not selected yet`;
        }

        html += `
          <div class="${cardClass} rounded-xl p-3.5 transition cursor-pointer group" onclick="setActiveSegment(${idx})">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-2.5">
                <span class="w-5 h-5 rounded-full ${badgeStyle} flex items-center justify-center text-[10px] font-extrabold shadow-sm">
                  ${isSelected ? '✓' : (idx + 1)}
                </span>
                <span class="font-extrabold text-xs text-[#0B192C]">${seg.title}</span>
              </div>
              <span class="text-[11px] font-bold text-[#A0825B] group-hover:underline">
                ${statusText}
              </span>
            </div>
            <div class="mt-1 text-[11px] ${isSelected ? 'text-slate-700 font-medium' : 'text-slate-500'} pl-7">
              ${descText}
            </div>
          </div>
        `;
      });

      container.innerHTML = html;

      // Update total price display
      const totalEl = document.getElementById('sidebar-total-price-val');
      if (totalEl) totalEl.textContent = '$' + totalFare.toLocaleString();

      // Update CTA
      const ctaBtn = document.getElementById('sidebar-main-cta');
      const ctaText = document.getElementById('sidebar-cta-text');
      const selectionNotice = document.getElementById('flight-selection-notice');
      const selectionNoticeText = document.getElementById('flight-selection-notice-text');
      const curSeg = appState.segments[appState.activeSegmentIndex];
      const hasSelectedFare = !!curSeg.selectedFlight;

      if (appState.tripMode === 'one-way') {
        ctaText.textContent = hasSelectedFare ? 'Continue to Seat Selection →' : 'Select Outbound Flight';
      } else if (appState.tripMode === 'round-trip') {
        if (appState.activeSegmentIndex === 0) {
          ctaText.textContent = hasSelectedFare ? 'Next: Select Return Flight →' : 'Select Outbound Flight';
        } else {
          ctaText.textContent = appState.segments.every(s => s.selectedFlight) ? 'Continue to Seat Selection →' : 'Select Return Flight';
        }
      } else if (appState.tripMode === 'multi-city') {
        if (appState.activeSegmentIndex < appState.segments.length - 1) {
          ctaText.textContent = hasSelectedFare ? `Next: Select Segment ${appState.activeSegmentIndex + 2} →` : `Select Segment ${appState.activeSegmentIndex + 1}`;
        } else {
          ctaText.textContent = hasSelectedFare ? 'Continue to Seat Selection →' : `Select Segment ${appState.activeSegmentIndex + 1}`;
        }
      }

      // Dynamic toggle for button disabled/active state
      if (!hasSelectedFare) {
        ctaBtn.disabled = true;
        ctaBtn.className = 'w-full bg-slate-200 text-slate-400 py-3.5 px-4 rounded-xl text-xs sm:text-sm font-bold transition cursor-not-allowed flex items-center justify-center space-x-2 shadow-none select-none';
        if (selectionNotice && selectionNoticeText) {
          selectionNoticeText.textContent = `Select a flight for Segment ${appState.activeSegmentIndex + 1} to continue.`;
          selectionNotice.classList.remove('hidden');
          selectionNotice.classList.add('flex');
        }
      } else {
        ctaBtn.disabled = false;
        ctaBtn.className = 'w-full bg-[#0B192C] hover:bg-[#162840] text-white py-3.5 px-4 rounded-xl text-xs sm:text-sm font-bold shadow transition transform active:scale-98 cursor-pointer flex items-center justify-center space-x-2';
        if (selectionNotice) {
          selectionNotice.classList.add('hidden');
          selectionNotice.classList.remove('flex');
        }
      }
    }

    function renderFlightHeader() {
      const curSeg = appState.segments[appState.activeSegmentIndex];
      const total = appState.segments.length;
      const breadcrumb = document.getElementById('flight-view-breadcrumb');
      const heading = document.getElementById('flight-view-heading');
      const sub = document.getElementById('flight-view-subheading');

      if (appState.tripMode === 'round-trip') {
        breadcrumb.textContent = `STEP ${appState.activeSegmentIndex + 1} OF 2 • ${curSeg.fromCity.toUpperCase()} (${curSeg.fromCode}) TO ${curSeg.toCity.toUpperCase()} (${curSeg.toCode})`;
        heading.textContent = appState.activeSegmentIndex === 0 ? 'Select Outbound Flight' : 'Select Return Flight';
      } else if (appState.tripMode === 'one-way') {
        breadcrumb.textContent = `${curSeg.fromCity.toUpperCase()} (${curSeg.fromCode}) TO ${curSeg.toCity.toUpperCase()} (${curSeg.toCode})`;
        heading.textContent = 'Select Flight';
      } else {
        breadcrumb.textContent = `SEGMENT ${appState.activeSegmentIndex + 1} OF ${total} • ${curSeg.fromCity.toUpperCase()} (${curSeg.fromCode}) TO ${curSeg.toCity.toUpperCase()} (${curSeg.toCode})`;
        heading.textContent = `Select Flight — ${curSeg.fromCity} to ${curSeg.toCity}`;
      }
      sub.textContent = `${curSeg.dateStr} • ${curSeg.fromCity} (${curSeg.fromCode}) → ${curSeg.toCity} (${curSeg.toCode})`;
    }

    function renderFlightCards() {
      const container = document.getElementById('flights-list-container');
      if (!container) return;

      const curSeg = appState.segments[appState.activeSegmentIndex];
      const raw = FLIGHT_DATABASE[curSeg.key] || [];

      // Filters
      const filtered = raw.filter(f => {
        if (appState.filters.nonstop && !f.nonstop) return false;
        if (appState.filters.depWindow === '06-12' && (f.depHour < 6 || f.depHour >= 12)) return false;
        if (appState.filters.depWindow === '12-18' && (f.depHour < 12 || f.depHour >= 18)) return false;
        if (appState.filters.depWindow === '18-24' && (f.depHour < 18 || f.depHour >= 24)) return false;

        const lowestPrice = Math.min(
          f.tiers.eco ? f.tiers.eco.price : 99999,
          f.tiers.bus ? f.tiers.bus.price : 99999,
          f.tiers.fst && !f.tiers.fst.soldOut ? f.tiers.fst.price : 99999
        );
        if (lowestPrice > appState.filters.maxBudget) return false;
        return true;
      });

      // Sorting
      filtered.sort((a, b) => {
        if (appState.filters.sortBy === 'price-low') {
          return (a.tiers.eco?.price || 9999) - (b.tiers.eco?.price || 9999);
        } else if (appState.filters.sortBy === 'dep-early') {
          return a.depHour - b.depHour;
        }
        return 0;
      });

      if (filtered.length === 0) {
        container.innerHTML = `
          <div class="bg-white rounded-2xl border border-slate-200 p-12 text-center">
            <h3 class="font-bold text-slate-800 text-sm">No Flights Found</h3>
            <p class="text-xs text-slate-500 mt-1">Try relaxing filters or adjusting departure times.</p>
            <button onclick="resetFilters()" class="mt-4 px-4 py-2 bg-[#0B192C] text-white text-xs font-bold rounded-lg shadow">Reset Filters</button>
          </div>
        `;
        return;
      }

      let html = '';
      filtered.forEach(flight => {
        const isFlightSelected = curSeg.selectedFlight && curSeg.selectedFlight.cardId === flight.id;
        const selectedTier = isFlightSelected ? curSeg.selectedFlight.tierKey : null;
        const isDetailsOpen = appState.expandedFlightId === flight.id;

        // Requirement 1: Prominent Entire Outer Flight Card Boundary Selection
        const cardBorder = isFlightSelected
          ? 'bg-white rounded-2xl border-2 border-[#0B192C] ring-1 ring-[#0B192C]/20 shadow-lg relative transition-all duration-200 overflow-visible'
          : 'bg-white rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-all duration-200 overflow-visible';

        // Outer header tag if selected
        const outerSelectionBadge = isFlightSelected
          ? `<div class="absolute -top-3 left-6 bg-[#0B192C] text-[#C5A880] text-[10px] font-extrabold uppercase tracking-widest px-3 py-0.5 rounded-full shadow flex items-center space-x-1 z-20">
               <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block animate-pulse"></span>
               <span>SELECTED FLIGHT</span>
             </div>`
          : '';

        // TIER 1: Economy
        const eco = flight.tiers.eco;
        const isEcoSelected = isFlightSelected && selectedTier === 'eco';
        const ecoCardBorderClass = isEcoSelected
          ? 'border-2 border-[#0B192C] shadow-md relative rounded-2xl bg-white'
          : 'border border-slate-200 hover:border-slate-300 rounded-2xl bg-white';
        const ecoBtn = isEcoSelected
          ? `<button class="select-fare-btn w-full py-2.5 px-4 bg-[#0B192C] text-white rounded-xl text-xs font-semibold hover:bg-slate-900 transition-colors flex items-center justify-center gap-1 cursor-pointer" type="button">Selected✓</button>`
          : `<button class="select-fare-btn w-full py-2.5 px-4 border border-slate-300 text-slate-700 rounded-xl text-xs font-semibold hover:border-slate-900 hover:text-[#0B192C] transition-colors cursor-pointer" type="button">Select Fare</button>`;
        const ecoBadge = isEcoSelected
          ? `<span class="selected-badge absolute -top-3 right-6 bg-[#0B192C] text-white text-[11px] font-bold tracking-widest px-2.5 py-0.5 rounded-md uppercase z-10 shadow-sm">SELECTED</span>`
          : ``;

        // TIER 2: Business
        const bus = flight.tiers.bus;
        const isBusSelected = isFlightSelected && selectedTier === 'bus';
        const busCardBorderClass = isBusSelected
          ? 'border-2 border-[#0B192C] shadow-md relative rounded-2xl bg-white'
          : 'border border-slate-200 hover:border-slate-300 rounded-2xl bg-white';
        const busBtn = isBusSelected
          ? `<button class="select-fare-btn w-full py-2.5 px-4 bg-[#0B192C] text-white rounded-xl text-xs font-semibold hover:bg-slate-900 transition-colors flex items-center justify-center gap-1 cursor-pointer" type="button">Selected✓</button>`
          : `<button class="select-fare-btn w-full py-2.5 px-4 border border-slate-300 text-slate-700 rounded-xl text-xs font-semibold hover:border-slate-900 hover:text-[#0B192C] transition-colors cursor-pointer" type="button">Select Fare</button>`;
        const busBadge = isBusSelected
          ? `<span class="selected-badge absolute -top-3 right-6 bg-[#0B192C] text-white text-[11px] font-bold tracking-widest px-2.5 py-0.5 rounded-md uppercase z-10 shadow-sm">SELECTED</span>`
          : ``;

        // TIER 3: First Suite
        const fst = flight.tiers.fst;
        const isFstSelected = isFlightSelected && selectedTier === 'fst';
        let fstCardContent = '';

        if (fst.soldOut) {
          fstCardContent = `
            <div class="bundle-col fare-card border border-slate-200 rounded-2xl p-4 flex flex-col justify-between bg-white opacity-70">
