              <div class="flex items-center my-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#C5A880]"></span>
                <span class="flex-1 h-px bg-slate-200"></span>
                <svg class="w-4 h-4 text-[#0B192C] mx-1" fill="currentColor" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>
