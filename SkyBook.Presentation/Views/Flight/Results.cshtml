    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') window.closeFlightInfoDrawer();
    });

    window.selectFare = function(segmentIndex, flightId, flightNum, cabinName, price, tierKey) {
      const seg = appState.segments[segmentIndex];
      if (!seg) return;

      if (seg.selectedFlight && seg.selectedFlight.cardId === flightId && seg.selectedFlight.tierKey === tierKey) {
        // Deselect if clicked again
        seg.selectedFlight = null;
      } else {
        seg.selectedFlight = {
          cardId: flightId,
          flightNum,
          cabin: cabinName,
          price,
          tierKey
        };
      }
      renderSidebar();
      renderFlightCards();
      // On mobile the primary Next button sits in the trip summary above the
      // results. Bring it back into view after a fare is chosen.
      if (seg.selectedFlight && window.matchMedia('(max-width: 1023px)').matches) {
        requestAnimationFrame(() => {
          document.getElementById('sidebar-left-column')?.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        });
      }
    };

    window.handlePrimaryAction = function() {
      const curSeg = appState.segments[appState.activeSegmentIndex];
      if (!curSeg.selectedFlight) {
        return;
      }

      if (appState.activeSegmentIndex < appState.segments.length - 1) {
        setActiveSegment(appState.activeSegmentIndex + 1);
      } else {
        const unselected = appState.segments.findIndex(s => !s.selectedFlight);
        if (unselected !== -1) {
          setActiveSegment(unselected);
          return;
        }
        // Proceed to modal
        let sumHtml = `<div class="text-left space-y-1.5 my-3 bg-slate-50 p-3 rounded-xl border border-slate-200 text-xs">`;
        let total = 0;
        appState.segments.forEach((s, i) => {
          total += s.selectedFlight.price;
          sumHtml += `<div><strong>${i + 1}. ${s.title}:</strong> ${s.selectedFlight.flightNum} (${s.selectedFlight.cabin}) — $${s.selectedFlight.price.toLocaleString()}</div>`;
        });
        sumHtml += `<div class="pt-2 border-t border-slate-200 font-bold text-[#0B192C]">Total Fare: $${total.toLocaleString()} USD</div></div>`;

        document.getElementById('modal-summary-text').innerHTML = `All flights selected successfully! Ready to choose seats:<br>${sumHtml}`;
        document.getElementById('seat-selection-modal').classList.remove('hidden');
      }
    };

    window.setDepartureWindow = function(val) {
      appState.filters.depWindow = val;
      document.querySelectorAll('.dep-window-btn').forEach(btn => {
        if (btn.getAttribute('data-window') === val) {
          btn.className = 'dep-window-btn px-3 py-1 rounded-md bg-white font-bold text-[#0B192C] shadow-sm border border-slate-200 whitespace-nowrap';
        } else {
          btn.className = 'dep-window-btn px-3 py-1 rounded-md font-medium text-slate-600 hover:text-[#0B192C] transition whitespace-nowrap';
        }
      });
      renderFlightCards();
    };

    window.handleBudgetChange = function(val) {
      appState.filters.maxBudget = Number(val);
      document.getElementById('budget-val-badge').textContent = '$' + Number(val).toLocaleString();
      renderFlightCards();
    };

    window.handleSortChange = function(val) {
      appState.filters.sortBy = val;
      renderFlightCards();
    };

    window.applyFilters = function() {
      appState.filters.nonstop = document.getElementById('filter-nonstop').checked;
      appState.filters.cabins.eco = document.getElementById('filter-cabin-eco').checked;
      appState.filters.cabins.bus = document.getElementById('filter-cabin-bus').checked;
      appState.filters.cabins.fst = document.getElementById('filter-cabin-fst').checked;
      renderFlightCards();
    };

    window.resetFilters = function() {
      appState.filters.nonstop = true;
      appState.filters.depWindow = 'all';
      appState.filters.cabins = { eco: true, bus: true, fst: true };
      appState.filters.maxBudget = 5000;
      appState.filters.sortBy = 'recommended';

      document.getElementById('filter-nonstop').checked = true;
      document.getElementById('filter-cabin-eco').checked = true;
      document.getElementById('filter-cabin-bus').checked = true;
      document.getElementById('filter-cabin-fst').checked = true;
      document.getElementById('budget-slider').value = '5000';
      document.getElementById('budget-val-badge').textContent = '$5,000';
      document.getElementById('flight-sort-select').value = 'recommended';
      setDepartureWindow('all');
    };

