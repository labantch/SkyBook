                  ${fst.perks.map(p => `<li class="flex items-center space-x-1.5"><span class="text-slate-400">✓</span><span>${p}</span></li>`).join('')}
                </ul>
              </div>
              <div class="mt-4">
                ${fstBtn}
              </div>
            </div>
          `;
        }

        const detailsDrawerHtml = ``;


        html += `
          <div class="${cardBorder}">
