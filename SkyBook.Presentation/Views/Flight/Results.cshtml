@section Scripts {
<script data-purpose="tailwind-config">
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            mono: ['"Space Grotesk"', 'monospace'],
          },
          colors: {
            brand: {
              navy: '#0B192C',
              navyLight: '#162840',
              gold: '#C5A880',
              goldLight: '#E8DCB8',
              goldDark: '#A0825B',
              bgLight: '#F8F9FA',
            }
          }
        }
      }
    };
</script>

<script>
    // Live Server Flights serialized from Database (100% Real SQL Server Data)
    const SERVER_FLIGHTS = @Html.Raw(flightsJson);

    // Dynamic Flight Database populated EXCLUSIVELY from SQL Server flights
    const FLIGHT_DATABASE = {};
    let activeCorridors = [];

    // Helper to format ISO DateTime to HH:mm (24-hour exact database time)
    function formatTime(isoStr) {
      if (!isoStr) return '00:00';
      try {
        const d = new Date(isoStr);
        if (isNaN(d.getTime())) return isoStr;
        const h = String(d.getHours()).padStart(2, '0');
        const m = String(d.getMinutes()).padStart(2, '0');
        return `${h}:${m}`;
      } catch (e) {
        return '00:00';
      }
    }

    // Helper to format ISO DateTime to Short Date
    function formatDateStr(isoStr) {
      if (!isoStr) return 'Sat, 19 Sep 2026';
      try {
        const d = new Date(isoStr);
        if (isNaN(d.getTime())) return 'Sat, 19 Sep 2026';
        return d.toLocaleDateString('en-US', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
      } catch (e) {
        return 'Sat, 19 Sep 2026';
      }
    }

    // Helper to calculate exact duration string between departure and arrival
    function calculateDuration(depIso, arrIso) {
      if (!depIso || !arrIso) return '4h 00m';
      try {
        const d1 = new Date(depIso);
        const d2 = new Date(arrIso);
        const diffMs = Math.abs(d2 - d1);
        const totalMinutes = Math.floor(diffMs / (1000 * 60));
        const hours = Math.floor(totalMinutes / 60);
        const minutes = totalMinutes % 60;
        return `${hours}h ${minutes > 0 ? minutes + 'm' : '00m'}`;
      } catch (e) {
        return '4h 00m';
      }
    }

    // Build database mapping STRICTLY from SERVER_FLIGHTS (No fake flights!)
    function initializeFlightDatabase() {
      if (!Array.isArray(SERVER_FLIGHTS) || SERVER_FLIGHTS.length === 0) {
        console.warn('No flights returned from SQL Server database.');
        return;
      }

      SERVER_FLIGHTS.forEach(f => {
        const depCode = (f.departureAirportCode || '').trim();
        const arrCode = (f.arrivalAirportCode || '').trim();
        if (!depCode || !arrCode) return;

        const routeKey = `${depCode}-${arrCode}`;
        if (!FLIGHT_DATABASE[routeKey]) {
          FLIGHT_DATABASE[routeKey] = [];
        }

        const depTime = formatTime(f.departureTime);
        const arrTime = formatTime(f.arrivalTime);
        const depDate = formatDateStr(f.departureTime);
        const arrDate = formatDateStr(f.arrivalTime);
        const duration = calculateDuration(f.departureTime, f.arrivalTime);
        const depHour = new Date(f.departureTime).getHours();

        const ecoPrice = Number(f.economyPrice || f.price || 500);
        const busPrice = Number(f.businessPrice || (ecoPrice * 2.5));
        const fstPrice = Number(f.firstClassPrice || (ecoPrice * 4));

        FLIGHT_DATABASE[routeKey].push({
          id: `db-${f.id}`,
          dbId: f.id,
          flightNum: f.flightNumber || `SKB-${f.id}`,
          aircraft: f.aircraftName || 'Airbus A350-1000 Flagship',
          status: f.status === 0 ? 'On Schedule' : 'Scheduled',
          availableSeats: (typeof f.availableSeats === 'number') ? `${f.availableSeats} Seats Available` : 'Live Inventory',
          seatsCount: (typeof f.availableSeats === 'number') ? f.availableSeats : 340,
          depTime: depTime,
          depDate: depDate,
          depCode: depCode,
          depName: f.departureAirportName || f.departureAirportCity || depCode,
          depCity: f.departureAirportCity || depCode,
          depTerminal: 'Terminal 1',
          arrTime: arrTime,
          arrDate: arrDate,
          arrNextDay: (new Date(f.arrivalTime).getDate() !== new Date(f.departureTime).getDate()) ? '+1' : '',
          arrCode: arrCode,
          arrName: f.arrivalAirportName || f.arrivalAirportCity || arrCode,
          arrCity: f.arrivalAirportCity || arrCode,
          arrTerminal: 'Terminal 2',
          duration: duration,
          depHour: isNaN(depHour) ? 0 : depHour,
          stops: (Array.isArray(f.stops) ? f.stops.slice().sort((a, b) => (a.stopOrder || 0) - (b.stopOrder || 0)) : []),
          nonstop: !(Array.isArray(f.stops) && f.stops.length > 0),
          stopCount: Array.isArray(f.stops) ? f.stops.length : 0,
          stopLabel: (Array.isArray(f.stops) && f.stops.length > 0)
            ? (f.stops.length === 1
                ? `1 Stop (${f.stops[0].airportCode || f.stops[0].airportCity || 'Transit'})`
                : `${f.stops.length} Stops (${f.stops.map(s => s.airportCode || 'Stop').join(', ')})`)
            : 'Non-Stop Direct',
          stopsRouteNames: (Array.isArray(f.stops) && f.stops.length > 0)
            ? f.stops.map(s => s.airportCity || s.airportCode).join(' ➔ ')
            : '',
          featureText: (Array.isArray(f.stops) && f.stops.length > 0)
            ? `✦ Transit via ${f.stops.map(s => s.airportCity || s.airportCode).join(' ➔ ')} • Dedicated Layover Lounge & Checked Luggage Transfer`
            : '✦ Flagship Long-Haul Intercontinental Service with High-Speed Wi-Fi',
          tiers: {
            eco: {
              name: 'Economy Horizon',
              price: ecoPrice,
              note: 'Standard Flex',
              perks: ['2x 23kg Baggage Allowance', 'Michelin-curated Dining', 'USB-C In-seat Power']
            },
            bus: {
              name: 'Business Lie-flat Pod',
              price: busPrice,
              note: 'Direct Aisle Access',
              perks: ['Fully Lie-flat Bed Suite', 'Flagship Lounge Access', 'Priority Security & Boarding']
            },
            fst: {
              name: 'First Sovereign Suite',
              price: fstPrice,
              note: 'Private Suite Door',
              perks: ['Enclosed Private Cabin Door', 'Oscietra Caviar Service', 'Complimentary Chauffeur Drive']
            }
          }
        });
      });

      // Update count badge
      const countBadge = document.getElementById('db-flights-count-badge');
      if (countBadge) {
        countBadge.textContent = SERVER_FLIGHTS.length === 1 ? '1 Live Flight' : `${SERVER_FLIGHTS.length} Live Flights`;
      }

      // Collect available corridors
      activeCorridors = Object.keys(FLIGHT_DATABASE).map(k => {
        const [from, to] = k.split('-');
        const sample = FLIGHT_DATABASE[k][0];
        return {
          key: k,
          fromCode: from,
          fromCity: sample.depCity,
          toCode: to,
          toCity: sample.arrCity,
          minPrice: Math.min(...FLIGHT_DATABASE[k].map(f => f.tiers.eco.price)),
          flightCount: FLIGHT_DATABASE[k].length
        };
      });

      calibrateBudgetSlider();
    }

    // Calibrate Budget Slider to Real Flight Prices
    function calibrateBudgetSlider() {
      let minP = 999999;
      let maxP = 0;

      Object.values(FLIGHT_DATABASE).forEach(flights => {
        flights.forEach(f => {
          const eco = f.tiers.eco.price;
          const fst = f.tiers.fst.price;
          if (eco < minP) minP = eco;
          if (fst > maxP) maxP = fst;
        });
      });

      if (minP === 999999) minP = 500;
      if (maxP === 0) maxP = 25000;

      let sliderCeiling = Math.ceil(maxP * 1.15 / 1000) * 1000;
      let sliderFloor = Math.floor(minP * 0.8 / 100) * 100;
      if (sliderFloor < 0) sliderFloor = 0;
      if (sliderCeiling <= sliderFloor) sliderCeiling = sliderFloor + 1000;

      const slider = document.getElementById('budget-slider');
      const badge = document.getElementById('budget-val-badge');
      if (slider && badge) {
        slider.min = sliderFloor;
        slider.max = sliderCeiling;
        slider.value = sliderCeiling;
        badge.textContent = '$' + sliderCeiling.toLocaleString();
        appState.filters.maxBudget = sliderCeiling;
      }
    }

    // Application State
    const appState = {
      tripMode: 'round-trip',
      activeSegmentIndex: 0,
      expandedFlightId: null,
      passengerSummary: '1 Passenger, Business Class',
      passengerCount: 1,
      searchedCabin: 'bus',
      filters: {
        nonstop: false,
        depWindow: 'all',
        cabins: { eco: true, bus: true, fst: true },
        maxBudget: 35000,
        sortBy: 'recommended'
      },
      segments: []
    };

    function selectCorridor(routeKey) {
      const [from, to] = routeKey.split('-');
      const flights = FLIGHT_DATABASE[routeKey];
      if (!flights || !flights.length) return;

      const sample = flights[0];
      const curSeg0 = appState.segments[0] || {};
      
      // Update primary segment preserving search dates
      appState.segments[0] = {
        key: routeKey,
        fromCode: from,
        fromCity: sample.depCity,
        toCode: to,
        toCity: sample.arrCity,
        dateStr: curSeg0.dateStr || sample.depDate,
        shortDate: curSeg0.shortDate || sample.depDate,
        title: `${from} → ${to}`,
        selectedFlight: null
      };

      if (appState.tripMode === 'round-trip') {
        const returnKey = `${to}-${from}`;
        const hasReturnInDb = !!FLIGHT_DATABASE[returnKey];
        const returnSample = hasReturnInDb ? FLIGHT_DATABASE[returnKey][0] : null;
        const curSeg1 = appState.segments[1] || {};

        appState.segments[1] = {
          key: returnKey,
          fromCode: to,
          fromCity: sample.arrCity,
          toCode: from,
          toCity: sample.depCity,
          dateStr: curSeg1.dateStr || (returnSample ? returnSample.depDate : 'Return Date'),
          shortDate: curSeg1.shortDate || (returnSample ? returnSample.depDate : 'Return Date'),
          title: `${to} → ${from}`,
          selectedFlight: null
        };
      } else if (appState.tripMode === 'one-way') {
        appState.segments = [appState.segments[0]];
      }

      appState.activeSegmentIndex = 0;
      dismissRouteNotice();
      renderAll();
    }

    function setupSegmentsForMode(mode, originCode, originCity, destCode, destCity, depDateLabel, depShortDate, retDateLabel, retShortDate) {
      // Use searched codes if provided, otherwise fall back to first DB corridor or placeholder
      const hasCodes = originCode && destCode;
      const defaultKey = hasCodes ? `${originCode}-${destCode}` : (activeCorridors.length > 0 ? activeCorridors[0].key : 'CAI-DXB');
      const [defFrom, defTo] = defaultKey.split('-');
      const sample = (FLIGHT_DATABASE[defaultKey] && FLIGHT_DATABASE[defaultKey][0]) || null;
      const fromCity = (hasCodes ? originCity : (sample ? sample.depCity : defFrom)) || defFrom;
      const toCity = (hasCodes ? destCity : (sample ? sample.arrCity : defTo)) || defTo;

      if (mode === 'one-way') {
        appState.segments = [
          {
            key: defaultKey,
            fromCode: defFrom,
            fromCity: fromCity,
            toCode: defTo,
            toCity: toCity,
            dateStr: depDateLabel || 'Saturday, 2026 • Oct 24',
            shortDate: depShortDate || 'Oct 24',
            title: `${defFrom} → ${defTo}`,
            selectedFlight: null
          }
        ];
      } else if (mode === 'round-trip') {
        const returnKey = `${defTo}-${defFrom}`;
        appState.segments = [
          {
            key: defaultKey,
            fromCode: defFrom,
            fromCity: fromCity,
            toCode: defTo,
            toCity: toCity,
            dateStr: depDateLabel || 'Saturday, 2026 • Oct 24',
            shortDate: depShortDate || 'Oct 24',
            title: `${defFrom} → ${defTo}`,
            selectedFlight: null
          },
          {
            key: returnKey,
            fromCode: defTo,
            fromCity: toCity,
            toCode: defFrom,
            toCity: fromCity,
            dateStr: retDateLabel || 'Monday, 2026 • Nov 02',
            shortDate: retShortDate || 'Nov 02',
            title: `${defTo} → ${defFrom}`,
            selectedFlight: null
          }
        ];
      } else if (mode === 'multi-city') {
        appState.segments = [
          {
            key: defaultKey,
            fromCode: defFrom,
            fromCity: fromCity,
            toCode: defTo,
            toCity: toCity,
            dateStr: depDateLabel || 'Saturday, 2026 • Oct 24',
            shortDate: depShortDate || 'Oct 24',
            title: `${defFrom} → ${defTo}`,
            selectedFlight: null
          }
        ];
      }
      appState.activeSegmentIndex = 0;
    }

    function showRouteNotice(message) {
      const banner = document.getElementById('route-search-notice-banner');
      const text = document.getElementById('route-search-notice-text');
      if (banner && text) {
        text.innerHTML = message;
        banner.classList.remove('hidden');
        banner.classList.add('flex');
      }
    }

    window.dismissRouteNotice = function() {
      const banner = document.getElementById('route-search-notice-banner');
      if (banner) {
        banner.classList.add('hidden');
        banner.classList.remove('flex');
      }
    };

    function applySearchContext(context) {
      if (!context) return;

      // 1. Ingest Trip Mode
      const tripMode = context.mode || sessionStorage.getItem('skybook-trip-mode') || 'round-trip';
      appState.tripMode = tripMode;
      sessionStorage.setItem('skybook-trip-mode', tripMode);

      // 2. Ingest Passengers and Cabin
      if (context.passengers) {
        appState.passengerSummary = context.passengers;
      }
      appState.passengerCount = context.passengerCount || 1;
      if (context.cabin) {
        const cab = context.cabin.toLowerCase();
        if (cab.includes('bus')) appState.searchedCabin = 'bus';
        else if (cab.includes('first')) appState.searchedCabin = 'fst';
        else if (cab.includes('eco')) appState.searchedCabin = 'eco';
      }

      // 3. Ingest Search Dates
      const depDateLabel = (context.departure && context.departureSub) 
        ? `${context.departureSub} • ${context.departure}` 
        : (context.departure || 'Saturday, 2026 • Oct 24');
      const depShortDate = context.departure || 'Oct 24';

      const retDateLabel = (context.returnDate && context.returnSub) 
        ? `${context.returnSub} • ${context.returnDate}` 
        : (context.returnDate || 'Monday, 2026 • Nov 02');
      const retShortDate = context.returnDate || 'Nov 02';

      // 4. Ingest Origin and Destination
      const originCode = (context.originCode || '').trim();
      const originCity = context.originCity || originCode;
      const destCode = (context.destinationCode || '').trim();
      const destCity = context.destinationCity || destCode;

      const outboundKey = `${originCode}-${destCode}`;

      // Check if searched route exists in the FLIGHT_DATABASE
      if (originCode && destCode && FLIGHT_DATABASE[outboundKey] && FLIGHT_DATABASE[outboundKey].length > 0) {
        // Route found — set segments accurately
        const sample = FLIGHT_DATABASE[outboundKey][0];
        appState.segments[0] = {
          key: outboundKey,
          fromCode: originCode,
          fromCity: sample.depCity || originCity,
          toCode: destCode,
          toCity: sample.arrCity || destCity,
          dateStr: depDateLabel,
          shortDate: depShortDate,
          title: `${originCode} → ${destCode}`,
          selectedFlight: null
        };

        if (tripMode === 'round-trip') {
          const returnKey = `${destCode}-${originCode}`;
          const retSample = (FLIGHT_DATABASE[returnKey] && FLIGHT_DATABASE[returnKey][0]) || null;
          appState.segments[1] = {
            key: returnKey,
            fromCode: destCode,
            fromCity: retSample ? retSample.depCity : destCity,
            toCode: originCode,
            toCity: retSample ? retSample.arrCity : originCity,
            dateStr: retDateLabel,
            shortDate: retShortDate,
            title: `${destCode} → ${originCode}`,
            selectedFlight: null
          };
        } else if (tripMode === 'one-way') {
          appState.segments = [appState.segments[0]];
        }
        dismissRouteNotice();
      } else if (originCode && destCode) {
        // Route searched but NO flights found in DB — show empty state
        appState.noResultsRoute = { originCode, originCity, destCode, destCity };
        appState.segments[0] = {
          key: outboundKey,
          fromCode: originCode,
          fromCity: originCity,
          toCode: destCode,
          toCity: destCity,
          dateStr: depDateLabel,
          shortDate: depShortDate,
          title: `${originCode} → ${destCode}`,
          selectedFlight: null
        };
        if (tripMode === 'round-trip') {
          const returnKey = `${destCode}-${originCode}`;
          appState.segments[1] = {
            key: returnKey,
            fromCode: destCode,
            fromCity: destCity,
            toCode: originCode,
            toCity: originCity,
            dateStr: retDateLabel,
            shortDate: retShortDate,
            title: `${destCode} → ${originCode}`,
            selectedFlight: null
          };
        } else if (tripMode === 'one-way') {
          appState.segments = [appState.segments[0]];
        }
        dismissRouteNotice();
      } else {
        // No origin/dest — just use first available corridor from DB
        appState.noResultsRoute = null;
        if (activeCorridors.length > 0) {
          selectCorridor(activeCorridors[0].key);
          return;
        }
      }

      // Update Trip Mode toggle buttons in UI
      ['one-way', 'round-trip', 'multi-city'].forEach(m => {
        const btn = document.getElementById('toggle-btn-' + m);
        if (!btn) return;
        if (m === tripMode) {
          btn.className = 'trip-toggle-btn px-4 py-1.5 rounded-md bg-[#0B192C] text-white font-bold shadow-sm whitespace-nowrap cursor-pointer';
        } else {
          btn.className = 'trip-toggle-btn px-4 py-1.5 rounded-md font-medium text-slate-600 hover:text-[#0B192C] transition whitespace-nowrap cursor-pointer';
        }
      });
    }

    window.setTripMode = function(newMode) {
      if (appState.tripMode === newMode) return;
      appState.tripMode = newMode;
      sessionStorage.setItem('skybook-trip-mode', newMode);

      ['one-way', 'round-trip', 'multi-city'].forEach(m => {
        const btn = document.getElementById('toggle-btn-' + m);
        if (!btn) return;
        if (m === newMode) {
          btn.className = 'trip-toggle-btn px-4 py-1.5 rounded-md bg-[#0B192C] text-white font-bold shadow-sm whitespace-nowrap cursor-pointer';
        } else {
          btn.className = 'trip-toggle-btn px-4 py-1.5 rounded-md font-medium text-slate-600 hover:text-[#0B192C] transition whitespace-nowrap cursor-pointer';
        }
      });

      let ctx = null;
      try { ctx = JSON.parse(sessionStorage.getItem('skybook-search-context') || 'null'); } catch (e) {}
      if (ctx) ctx.mode = newMode;

      const seg0 = appState.segments[0] || {};
      const oCode = ctx?.originCode || seg0.fromCode || 'CAI';
      const oCity = ctx?.originCity || seg0.fromCity || 'Cairo';
      const dCode = ctx?.destinationCode || seg0.toCode || 'DXB';
      const dCity = ctx?.destinationCity || seg0.toCity || 'Dubai';
      const dep = ctx?.departure || seg0.shortDate || 'Oct 24';
      const depSub = ctx?.departureSub || 'Saturday, 2026';
      const ret = ctx?.returnDate || 'Nov 02';
      const retSub = ctx?.returnSub || 'Monday, 2026';

      setupSegmentsForMode(newMode, oCode, oCity, dCode, dCity, depSub ? `${depSub} • ${dep}` : dep, dep, retSub ? `${retSub} • ${ret}` : ret, ret);
      try {
        if (ctx) applySearchContext(ctx);
      } catch (e) {}
      renderAll();
    };

    window.setActiveSegment = function(idx) {
      if (idx >= 0 && idx < appState.segments.length) {
        appState.activeSegmentIndex = idx;
        renderAll();
      }
    };

    function findFlightById(flightId) {
      for (const key of Object.keys(FLIGHT_DATABASE)) {
        const found = FLIGHT_DATABASE[key].find(f => f.id === flightId);
        if (found) return found;
      }
      return null;
    }

    window.closeFlightInfoDrawer = function() {
      const overlay = document.getElementById('flight-info-overlay');
      const drawer = document.getElementById('flight-info-drawer');
      if (!overlay || !drawer) return;
      overlay.classList.add('opacity-0');
      drawer.classList.add('translate-x-full');
      setTimeout(() => {
        overlay.classList.add('hidden');
        document.body.style.overflow = '';
