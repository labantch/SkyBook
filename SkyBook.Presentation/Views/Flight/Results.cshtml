              <div class="text-sm font-bold text-slate-800">${flight.arrCode}</div>
              <div class="text-[11px] text-slate-500">${flight.arrName}</div>
              <div class="text-[11px] text-slate-400">${flight.arrTerminal || ''}</div>
              <div class="text-[11px] text-slate-400 mt-1">${flight.arrDate}</div>
            </div>
          </div>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-4 space-y-1">
          <p class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400">Aircraft</p>
