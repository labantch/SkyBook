@{
    ViewData["Title"] = "Flight Results";
    Layout = "_Layout";
    ViewData["ShowBookingProgress"] = true;
    ViewData["BookingStep"] = 1;
}

@section Styles {
<style data-purpose="custom-layout">
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: #0F172A;
      background-color: #F8F9FA;
    }
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #F1F5F9;
    }
    ::-webkit-scrollbar-thumb {
      background: #CBD5E1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94A3B8;
    }
    .bundle-col {
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
  </style>
}

<!-- STICKY TOP FILTER BAR (Clean, Single Horizontal Line, Unsquished) -->
<div class="w-full flex flex-col sm:flex-row items-center justify-between pb-3 mb-3 border-b border-slate-200/80 gap-3" id="trip-mode-header-row"><div class="flex items-center space-x-2"><span class="w-2 h-2 rounded-full bg-[#C5A880]"></span><span class="text-xs font-bold uppercase tracking-wider text-[#0B192C]">Trip Type</span></div><div class="inline-flex rounded-lg border border-slate-200 bg-slate-100 p-0.5 text-xs shadow-sm"><button class="trip-toggle-btn px-3.5 py-1.5 rounded-md font-medium text-slate-600 hover:text-[#0B192C] transition whitespace-nowrap cursor-pointer" id="toggle-btn-one-way" onclick="setTripMode('one-way')" type="button">One Way</button><button class="trip-toggle-btn px-3.5 py-1.5 rounded-md bg-[#0B192C] text-white font-bold shadow-sm whitespace-nowrap cursor-pointer" id="toggle-btn-round-trip" onclick="setTripMode('round-trip')" type="button">Round Trip</button><button class="trip-toggle-btn px-3.5 py-1.5 rounded-md font-medium text-slate-600 hover:text-[#0B192C] transition whitespace-nowrap cursor-pointer" id="toggle-btn-multi-city" onclick="setTripMode('multi-city')" type="button">Multi-City</button></div></div><div class="w-full sticky bg-white shadow-sm border border-slate-200 rounded-xl py-3 px-4 mb-7 transition-all" id="horizontal-refine-bar" style="top: 0px; z-index: 40;">
<div class="flex items-center justify-between gap-4 text-xs flex-nowrap overflow-x-auto">
<!-- Filters Group -->
<div class="flex items-center space-x-2 shrink-0">
<div class="flex items-center space-x-1.5 text-[#0B192C] font-extrabold">
<svg class="w-4 h-4 text-[#A0825B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
<path d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
</svg>
<span class="text-xs font-bold text-[#0B192C]">Filters</span>
</div>
<span class="h-4 w-px bg-slate-200 mx-1"></span>
<label class="flex items-center space-x-1.5 cursor-pointer select-none">
<input checked="" class="w-3.5 h-3.5 rounded text-[#0B192C] focus:ring-[#0B192C] border-slate-300 cursor-pointer" id="filter-nonstop" onchange="applyFilters()" type="checkbox">
<span class="font-medium text-slate-700 text-xs whitespace-nowrap">Non-stop only</span>
</label>
</div>
<!-- Departure Window Buttons -->
<div class="flex items-center space-x-2 shrink-0">
<span class="text-xs font-medium text-slate-600 whitespace-nowrap" id="filter-dep-label">Cairo Departure Window</span>
<div class="inline-flex rounded-lg border border-slate-200 bg-slate-100 p-0.5 text-xs" id="dep-window-group">
<button class="dep-window-btn px-3 py-1 rounded-md bg-white font-bold text-[#0B192C] shadow-sm border border-slate-200 whitespace-nowrap" data-window="all" onclick="setDepartureWindow('all')" type="button">All</button>
<button class="dep-window-btn px-3 py-1 rounded-md font-medium text-slate-600 hover:text-[#0B192C] transition whitespace-nowrap" data-window="06-12" onclick="setDepartureWindow('06-12')" type="button">06–12</button>
<button class="dep-window-btn px-3 py-1 rounded-md font-medium text-slate-600 hover:text-[#0B192C] transition whitespace-nowrap" data-window="12-18" onclick="setDepartureWindow('12-18')" type="button">12–18</button>
<button class="dep-window-btn px-3 py-1 rounded-md font-medium text-slate-600 hover:text-[#0B192C] transition whitespace-nowrap" data-window="18-24" onclick="setDepartureWindow('18-24')" type="button">18–24</button>
</div>
</div>
<!-- Cabin Selection -->
<div class="flex items-center space-x-2 shrink-0">
<span class="text-xs font-medium text-slate-600 whitespace-nowrap">Cabin:</span>
<div class="flex items-center space-x-2 text-xs">
<label class="flex items-center space-x-1 cursor-pointer select-none">
<input checked="" class="w-3.5 h-3.5 rounded text-[#0B192C] focus:ring-[#0B192C] border-slate-300 cursor-pointer" id="filter-cabin-eco" onchange="applyFilters()" type="checkbox">
<span class="text-slate-700">Eco</span>
</label>
<label class="flex items-center space-x-1 cursor-pointer select-none">
<input checked="" class="w-3.5 h-3.5 rounded text-[#0B192C] focus:ring-[#0B192C] border-slate-300 cursor-pointer" id="filter-cabin-bus" onchange="applyFilters()" type="checkbox">
<span class="text-slate-700">Bus</span>
</label>
<label class="flex items-center space-x-1 cursor-pointer select-none">
<input checked="" class="w-3.5 h-3.5 rounded text-[#0B192C] focus:ring-[#0B192C] border-slate-300 cursor-pointer" id="filter-cabin-fst" onchange="applyFilters()" type="checkbox">
<span class="text-slate-700">First</span>
</label>
</div>
</div>
<!-- Budget Slider -->
<div class="flex items-center space-x-2.5 shrink-0">
<span class="text-xs font-medium text-slate-600 whitespace-nowrap">Budget:</span>
<input class="w-24 accent-[#0B192C] h-1.5 bg-slate-200 rounded appearance-none cursor-pointer" id="budget-slider" max="5000" min="800" oninput="handleBudgetChange(this.value)" step="50" type="range" value="4500">
<span class="font-mono font-bold text-xs text-[#0B192C] bg-slate-100 px-2.5 py-1 rounded border border-slate-200 whitespace-nowrap" id="budget-val-badge">$4,500</span>
</div>
<!-- Reset CTA -->
<div class="flex items-center shrink-0 pl-2 border-l border-slate-200">
<button class="text-xs font-medium text-slate-500 hover:text-[#0B192C] underline transition-colors cursor-pointer" onclick="resetFilters()" type="button">Reset</button>
</div>
</div>
</div>
<!-- TWO-COLUMN LAYOUT -->
<div class="flex flex-col lg:flex-row items-start gap-8">
<!-- LEFT COLUMN: Sticky Trip Summary & Total -->
<aside class="w-full lg:w-80 flex-shrink-0 self-start lg:sticky space-y-4" id="sidebar-left-column" style="top: 130px;">
<div class="bg-white p-5 rounded-2xl border-2 border-[#0B192C] shadow-sm space-y-4" data-purpose="sidebar-trip-summary">
<!-- Header -->
<div class="flex items-center justify-between pb-3 border-b border-slate-100">
<div class="flex items-center space-x-2">
<span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
<h3 class="font-bold text-sm text-[#0B192C] tracking-tight">Trip Summary &amp; Total</h3>
</div>
<span class="text-[10px] font-bold uppercase tracking-wider text-[#A0825B] bg-[#C5A880]/10 px-2 py-0.5 rounded-full">1 Adult</span>
</div>
<!-- Segments List Container -->
<div class="space-y-3" id="sidebar-segments-container">
          <div class="bg-slate-50 border-2 border-[#0B192C] shadow-sm rounded-xl p-3.5 transition cursor-pointer group" onclick="setActiveSegment(0)">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-2.5">
                <span class="w-5 h-5 rounded-full bg-[#0B192C] text-white flex items-center justify-center text-[10px] font-extrabold shadow-sm">
                  ✓
                </span>
                <span class="font-extrabold text-xs text-[#0B192C]">CAI → DXB</span>
              </div>
              <span class="text-[11px] font-bold text-[#A0825B] group-hover:underline">
                Viewing
              </span>
            </div>
            <div class="mt-1 text-[11px] text-slate-700 font-medium pl-7">
              Fri 11 Sep • SB 918 • Business Lie-flat Pod ($2,580)
            </div>
          </div>
        </div>
<!-- Total & Primary Action CTA -->
<div class="pt-4 border-t border-slate-100 space-y-3">
<div class="flex items-baseline justify-between">
<span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Total Trip Fare (1 Adult)</span>
<div class="flex items-baseline space-x-1">
<span class="text-2xl font-extrabold text-[#0B192C] font-mono" id="sidebar-total-price-val">$2,580</span>
<span class="text-xs font-semibold text-slate-500 font-sans">USD</span>
</div>
</div>
<button class="w-full bg-[#0B192C] hover:bg-[#162840] text-white py-3.5 px-4 rounded-xl text-xs sm:text-sm font-bold shadow transition transform active:scale-98 cursor-pointer flex items-center justify-center space-x-2" id="sidebar-main-cta" onclick="handlePrimaryAction()" type="button">
<span class="" id="sidebar-cta-text">Continue to Seat Selection →</span>
</button>
<div class="hidden items-center gap-2 rounded-lg border border-[#C5A880]/50 bg-[#FFF8E7] px-3 py-2 text-[11px] font-semibold text-[#785929]" id="flight-selection-notice" role="status">
<span class="material-symbols-outlined text-[16px]">info</span>
<span id="flight-selection-notice-text">Select a flight to continue.</span>
</div>
</div>
</div>
</aside>
<!-- RIGHT COLUMN: Section Header & Flight Cards -->
<section class="flex-1 w-full min-w-0 space-y-6" data-purpose="flight-selection-center-area">
<!-- Step Breadcrumbs & Title Bar -->
<div class="flex flex-col sm:flex-row sm:items-end justify-between pb-3 border-b border-slate-200 gap-3">
<div>
<div class="text-[11px] font-extrabold uppercase tracking-widest text-[#A0825B]" id="flight-view-breadcrumb">CAIRO (CAI) TO DUBAI (DXB)</div>
<h2 class="text-2xl font-extrabold text-[#0B192C] tracking-tight mt-1" id="flight-view-heading">Select Flight</h2>
<p class="text-xs text-slate-500 font-medium mt-0.5" id="flight-view-subheading">Friday, 11 Sep 2026 • Cairo (CAI) → Dubai (DXB)</p>
</div>
<div class="flex flex-col items-start sm:items-end gap-2 self-start sm:self-auto"><div class="flex items-center space-x-2"><label class="text-xs font-medium text-slate-500 whitespace-nowrap" for="flight-sort-select">Sort by:</label><select class="text-xs font-bold text-slate-800 bg-white border border-slate-300 rounded-lg py-1.5 pl-3 pr-8 focus:ring-[#0B192C] focus:border-[#0B192C] shadow-sm cursor-pointer" id="flight-sort-select" onchange="handleSortChange(this.value)"><option selected="" value="recommended">Recommended</option><option value="price-low">Lowest Price</option><option value="dep-early">Departure Time (Earliest)</option></select></div><div class="flex items-center space-x-1.5 text-xs"><span class="text-slate-500 font-medium">Currency:</span><div class="relative inline-block"><button class="inline-flex items-center space-x-1 font-bold text-slate-700 hover:text-[#0B192C] bg-slate-100 hover:bg-slate-200 px-2.5 py-1 rounded-md transition border border-slate-200 cursor-pointer" type="button"><span class="text-[#0B192C]" id="selected-currency-label">USD ($)</span><svg class="w-3 h-3 text-slate-500 transition-transform" fill="none" id="currency-chevron" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg></button></div></div></div>
</div>
<!-- Flights List Container -->
<div class="space-y-6" id="flights-list-container">
          <div class="bg-white rounded-2xl border-2 border-[#0B192C] ring-1 ring-[#0B192C]/20 shadow-lg relative transition-all duration-200 overflow-visible">
            <div class="absolute -top-3 left-6 bg-[#0B192C] text-[#C5A880] text-[10px] font-extrabold uppercase tracking-widest px-3 py-0.5 rounded-full shadow flex items-center space-x-1 z-20">
               <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block animate-pulse"></span>
               <span class="">SELECTED FLIGHT</span>
             </div>
            <div class="p-6 grid grid-cols-1 xl:grid-cols-12 gap-6 items-center">

              <!-- Left Side: Flight Timing & Badges -->
              <div class="xl:col-span-5 space-y-4">
                <div class="flex items-center space-x-2">
                  <span class="px-2.5 py-0.5 rounded bg-slate-100 font-mono text-xs font-bold text-slate-800">SB 918</span>
                  <span class="text-xs text-slate-500">• Boeing 777-300ER</span>
                  <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full">On Schedule</span>
                </div>

                <div class="flex items-center space-x-4">
                  <!-- CAI -->
                  <div>
                    <div class="text-2xl font-extrabold text-[#0B192C] font-mono">14:20</div>
                    <div class="text-xs font-bold text-slate-800">CAI</div>
                    <div class="text-[11px] text-slate-400">Cairo Intl Terminal 2</div>
                  </div>
                  <!-- Center Plane Graphic -->
                  <div class="flex-grow flex flex-col items-center px-1">
                    <span class="text-[11px] font-bold text-slate-500 uppercase">3h 35m</span>
                    <div class="relative w-full flex items-center my-1.5">
                      <div class="h-0.5 w-full bg-slate-300"></div>
                      <svg class="w-3.5 h-3.5 text-[#C5A880] absolute left-1/2 -translate-x-1/2 -top-1.5 transform rotate-90" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"></path>
                      </svg>
                    </div>
                    <span class="text-[11px] text-emerald-600 font-bold">Non-stop Direct</span>
                  </div>
                  <!-- DXB -->
                  <div class="text-right">
                    <div class="text-2xl font-extrabold text-[#0B192C] font-mono">
                      19:55 
                    </div>
                    <div class="text-xs font-bold text-slate-800">DXB</div>
                    <div class="text-[11px] text-slate-400">Dubai Intl Terminal 3</div>
                  </div>
                </div>

                <div class="text-xs text-slate-600 font-medium">
                  ✦ Same-day convenient afternoon arrival
                </div>

                <!-- Flight Details Trigger -->
                <div>
                  <button type="button" onclick="toggleFlightDetails('sb918')" class="inline-flex items-center space-x-1 text-xs font-bold text-[#0B192C] hover:text-[#A0825B] transition-colors py-1 cursor-pointer">
                    <span class="underline underline-offset-4 decoration-slate-300">Flight Details</span>
                    <svg class="w-3.5 h-3.5 text-[#C5A880] transition-transform " fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </button>
                </div>
              </div>

              <!-- Right Side: 3 Fare Columns (Grid 3 cols) -->
              <div class="xl:col-span-7">
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 pt-2">
                  <!-- ECONOMY -->
                  <div class="bundle-col fare-card border border-slate-200 hover:border-slate-300 rounded-2xl bg-white p-4 flex flex-col justify-between cursor-pointer" onclick="selectFare(0, 'sb918', 'SB 918', 'Economy Horizon', 1290, 'eco')">
                    
                    <div>
                      <span class="text-[11px] font-extrabold text-[#0B192C] uppercase tracking-wider block">ECONOMY</span>
                      <span class="text-2xl font-extrabold text-[#0B192C] block mt-1 font-mono">$1,290</span>
                      <span class="text-[11px] text-emerald-700 font-bold mt-0.5 block">Standard flex</span>
                      <ul class="mt-2.5 space-y-1.5 text-[11px] text-slate-600">
                        <li class="flex items-center space-x-1.5"><span class="text-slate-400">✓</span><span class="">2x 23kg Baggage</span></li><li class="flex items-center space-x-1.5"><span class="text-slate-400">✓</span><span class="">Meal included</span></li>
                      </ul>
                    </div>
                    <div class="mt-4">
                      <button class="select-fare-btn w-full py-2.5 px-4 border border-slate-300 text-slate-700 rounded-xl text-xs font-semibold hover:border-slate-900 hover:text-[#0B192C] transition-colors cursor-pointer" type="button">Select Fare</button>
                    </div>
                  </div>

                  <!-- BUSINESS -->
                  <div class="bundle-col fare-card border-2 border-[#0B192C] shadow-md relative rounded-2xl bg-white p-4 flex flex-col justify-between cursor-pointer" onclick="selectFare(0, 'sb918', 'SB 918', 'Business Lie-flat Pod', 2580, 'bus')">
                    <span class="selected-badge absolute -top-3 right-6 bg-[#0B192C] text-white text-[11px] font-bold tracking-widest px-2.5 py-0.5 rounded-md uppercase z-10 shadow-sm">SELECTED</span>
                    <div>
                      <span class="text-[11px] font-extrabold text-[#0B192C] uppercase tracking-wider block">BUSINESS</span>
                      <span class="text-2xl font-extrabold text-[#0B192C] block mt-1 font-mono">$2,580</span>
                      <span class="text-[11px] text-slate-500 mt-0.5 block">Only 2 seats left</span>
                      <ul class="mt-2.5 space-y-1.5 text-[11px] text-slate-600">
                        <li class="flex items-center space-x-1.5"><span class="text-slate-400">✓</span><span class="">Lie-flat seating</span></li><li class="flex items-center space-x-1.5"><span class="text-slate-400">✓</span><span class="">Lounge &amp; Fast Track</span></li>
                      </ul>
                    </div>
                    <div class="mt-4">
                      <button class="select-fare-btn w-full py-2.5 px-4 bg-[#0B192C] text-white rounded-xl text-xs font-semibold hover:bg-slate-900 transition-colors flex items-center justify-center gap-1 cursor-pointer" type="button">Selected✓</button>
                    </div>
                  </div>

                  <!-- FIRST SUITE -->
                  
            <div class="bundle-col fare-card border border-slate-200 rounded-2xl p-4 flex flex-col justify-between bg-white opacity-70">
              <div>
                <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">FIRST SUITE</span>
                <span class="text-2xl font-extrabold text-slate-400 block mt-1 font-mono">—</span>
                <span class="text-[11px] text-rose-600 font-bold uppercase tracking-wider mt-1 block">SOLD OUT</span>
                <p class="text-[11px] text-slate-400 mt-2">Fully booked for this departure.</p>
              </div>
              <button class="mt-4 w-full py-2.5 rounded-xl bg-slate-100 text-slate-400 text-xs font-bold cursor-not-allowed" disabled="" type="button">
                Unavailable
              </button>
            </div>
          
                </div>
              </div>

            </div>

            <!-- Expandable Flight Details Drawer -->
            
          <div class="border-t border-slate-200 bg-[#FBFBFB] rounded-b-2xl hidden">
            <div class="p-6 space-y-6">
              <!-- Header info line -->
              <div class="flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center space-x-3 text-xs">
                  <span class="px-2.5 py-1 rounded bg-[#0B192C] text-white font-mono font-bold text-xs">SB 918 Flight Information</span>
                  <span class="font-bold text-slate-700">Boeing 777-300ER</span>
                  <span class="text-emerald-700 bg-emerald-100 font-semibold px-2 py-0.5 rounded text-[11px]">On Schedule</span>
                </div>
                <div class="flex items-center space-x-1.5 text-xs text-slate-500">
                  <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  <span class="">Seat Availability: <strong class="text-slate-800">9 seats left</strong></span>
                </div>
              </div>

              <!-- Flight Timeline & Route Schedule Box -->
              <div class="bg-white rounded-xl p-5 border border-slate-200">
                <div class="text-[11px] font-extrabold uppercase tracking-wider text-[#A0825B] mb-4 flex items-center space-x-2">
                  <svg class="w-3.5 h-3.5 text-[#C5A880]" fill="currentColor" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"></path></svg>
                  <span class="">FLIGHT TIMELINE &amp; ROUTE SCHEDULE</span>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center">
                  <!-- Departure -->
                  <div class="md:col-span-4">
                    <div class="flex items-center justify-between text-xs text-slate-400 font-semibold uppercase">
                      <span class="">DEPARTURE</span>
                      <span class="text-slate-700 font-bold">Fri 11 Sep 2026</span>
                    </div>
                    <div class="text-2xl font-extrabold text-[#0B192C] font-mono mt-1">14:20</div>
                    <div class="text-xs font-bold text-slate-800 mt-0.5">Cairo Intl (CAI)</div>
                    <div class="text-xs text-slate-400">Terminal 2</div>
                  </div>

                  <!-- Flight path line -->
                  <div class="md:col-span-4 flex flex-col items-center justify-center text-center px-4">
                    <span class="text-[11px] font-bold text-slate-600">3h 35m</span>
                    <div class="relative w-full flex items-center my-2">
                      <div class="h-0.5 w-full bg-slate-300"></div>
                      <span class="w-2 h-2 rounded-full bg-[#0B192C] absolute left-0"></span>
                      <svg class="w-3.5 h-3.5 text-[#C5A880] absolute left-1/2 -translate-x-1/2 -top-1.5 transform rotate-90" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"></path>
                      </svg>
                      <span class="w-2 h-2 rounded-full bg-[#C5A880] absolute right-0"></span>
                    </div>
                    <span class="text-xs text-emerald-600 font-bold">Non-stop Direct</span>
                    <div class="flex items-center space-x-2 text-[10px] text-slate-500 mt-2 font-medium">
                      <span class="">📶 Starlink aloft</span>
                      <span class="">•</span>
                      <span class="">⚡ USB-C / AC power</span>
                    </div>
                  </div>

                  <!-- Arrival -->
                  <div class="md:col-span-4 text-right">
