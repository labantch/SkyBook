    window.selectFare = function(segmentIndex, flightId, flightNum, cabinName, price, tierKey) {
      const seg = appState.segments[segmentIndex];
      if (!seg) return;

      const flightObj = findFlightById(flightId);
      const dbId = flightObj ? flightObj.dbId : 0;

      if (seg.selectedFlight && seg.selectedFlight.cardId === flightId && seg.selectedFlight.tierKey === tierKey) {
        seg.selectedFlight = null;
      } else {
        seg.selectedFlight = {
          cardId: flightId,
          dbId: dbId,
          flightNum: flightNum,
          cabin: cabinName,
          price: price,
          tierKey: tierKey,
          aircraft: flightObj ? flightObj.aircraft : 'Airbus A350-1000 Flagship',
          depTime: flightObj ? flightObj.depTime : '00:00',
          arrTime: flightObj ? flightObj.arrTime : '14:30',
          duration: flightObj ? flightObj.duration : '4h 00m'
        };
      }

      // Check if all flight segments are selected
      if (appState.segments.every(s => s.selectedFlight != null)) {
        const paxCount = appState.passengerCount || 1;
        const total = appState.segments.reduce((sum, s) => sum + (s.selectedFlight ? (s.selectedFlight.price * paxCount) : 0), 0);
        sessionStorage.setItem('skybook-selected-flights', JSON.stringify({
          segments: appState.segments,
          totalPrice: total,
          passengerSummary: appState.passengerSummary || '1 Passenger, Business Class',
          passengerCount: paxCount,
          tripMode: appState.tripMode
        }));

        // Unlock Step 2: Seats in top progress bar
        if (window.SkyBookProgress) {
          window.SkyBookProgress.unlockStep(2);
        } else {
          const step2 = document.getElementById('skybook-step-btn-2') || document.querySelector('#skybook-booking-progress .skybook-step:nth-child(3)');
          if (step2 && step2.classList.contains('skybook-disabled')) {
            step2.outerHTML = '<a id="skybook-step-btn-2" data-step-index="1" class="skybook-step skybook-unlocked" href="/Booking/SelectSeats" title="Go to Seats">' +
              '<span class="skybook-step-number">2</span><span>SEATS</span></a>';
          }
        }
      } else {
        sessionStorage.removeItem('skybook-selected-flights');
        // Re-lock Step 2, 3, 4
        if (window.SkyBookProgress) {
          window.SkyBookProgress.lockStep(2);
          window.SkyBookProgress.lockStep(3);
          window.SkyBookProgress.lockStep(4);
        } else {
          const step2 = document.getElementById('skybook-step-btn-2') || document.querySelector('#skybook-booking-progress a[href*="SelectSeats"]');
          if (step2) {
            step2.outerHTML = '<span id="skybook-step-btn-2" data-step-index="1" class="skybook-step skybook-disabled" title="Locked - Complete flight selection first" aria-disabled="true">' +
              '<span class="skybook-step-number">2</span><span>SEATS</span></span>';
          }
        }
      }

      renderSidebar();
      renderFlightCards();

      if (seg.selectedFlight && window.matchMedia('(max-width: 1023px)').matches) {
        requestAnimationFrame(() => {
          document.getElementById('sidebar-left-column')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }
    };

    window.handlePrimaryAction = function() {
      const curSeg = appState.segments[appState.activeSegmentIndex];
      if (!curSeg || !curSeg.selectedFlight) {
        // Disallow proceeding without completing flight selection!
        return;
      }

      if (appState.activeSegmentIndex < appState.segments.length - 1) {
        setActiveSegment(appState.activeSegmentIndex + 1);
        window.scrollTo({ top: 120, behavior: 'smooth' });
      } else {
        const unselected = appState.segments.findIndex(s => !s.selectedFlight);
        if (unselected !== -1) {
          setActiveSegment(unselected);
          window.scrollTo({ top: 120, behavior: 'smooth' });
          return;
        }

        const paxCount = appState.passengerCount || 1;
        const total = appState.segments.reduce((sum, s) => sum + (s.selectedFlight ? (s.selectedFlight.price * paxCount) : 0), 0);
        sessionStorage.setItem('skybook-selected-flights', JSON.stringify({
          segments: appState.segments,
          totalPrice: total,
          passengerSummary: appState.passengerSummary || '1 Passenger, Business Class',
          passengerCount: paxCount,
          tripMode: appState.tripMode
        }));

        const firstSelected = appState.segments[0].selectedFlight;
        const flightParam = firstSelected && firstSelected.dbId ? `?flightId=${firstSelected.dbId}&cabinClass=${firstSelected.tierKey}` : '';
        window.location.href = `/Booking/SelectSeats${flightParam}`;
      }
    };

    window.setDepartureWindow = function(val) {
      appState.filters.depWindow = val;
      document.querySelectorAll('.dep-window-btn').forEach(btn => {
        if (btn.getAttribute('data-window') === val) {
          btn.className = 'dep-window-btn px-3 py-1 rounded-md bg-white font-bold text-[#0B192C] shadow-sm border border-slate-200 whitespace-nowrap';
        } else {
          btn.className = 'dep-window-btn px-3 py-1 rounded-md font-medium text-slate-600 hover:text-[#0B192C] transition whitespace-nowrap';
        }
      });
      renderFlightCards();
    };

    window.handleBudgetChange = function(val) {
      appState.filters.maxBudget = Number(val);
      document.getElementById('budget-val-badge').textContent = '$' + Number(val).toLocaleString();
      renderFlightCards();
    };

    window.handleSortChange = function(val) {
      appState.filters.sortBy = val;
      renderFlightCards();
    };

    window.applyFilters = function() {
      appState.filters.nonstop = document.getElementById('filter-nonstop')?.checked ?? true;
      appState.filters.cabins.eco = document.getElementById('filter-cabin-eco')?.checked ?? true;
      appState.filters.cabins.bus = document.getElementById('filter-cabin-bus')?.checked ?? true;
      appState.filters.cabins.fst = document.getElementById('filter-cabin-fst')?.checked ?? true;
      renderFlightCards();
    };

    window.resetFilters = function() {
      appState.filters.nonstop = false;
      appState.filters.depWindow = 'all';
      appState.filters.cabins = { eco: true, bus: true, fst: true };
      
      const slider = document.getElementById('budget-slider');
      const maxVal = slider ? Number(slider.max) : 35000;
      appState.filters.maxBudget = maxVal;
      appState.filters.sortBy = 'recommended';

      const chkNonstop = document.getElementById('filter-nonstop');
      const chkEco = document.getElementById('filter-cabin-eco');
      const chkBus = document.getElementById('filter-cabin-bus');
      const chkFst = document.getElementById('filter-cabin-fst');
      const sortSel = document.getElementById('flight-sort-select');

      if (chkNonstop) chkNonstop.checked = false;
      if (chkEco) chkEco.checked = true;
      if (chkBus) chkBus.checked = true;
      if (chkFst) chkFst.checked = true;
      if (slider) slider.value = maxVal;
      const budgetBadge = document.getElementById('budget-val-badge');
      if (budgetBadge) budgetBadge.textContent = '$' + maxVal.toLocaleString();
      if (sortSel) sortSel.value = 'recommended';
      setDepartureWindow('all');
    };

    function renderSidebar() {
      const container = document.getElementById('sidebar-segments-container');
      if (!container) return;

      let html = '';
      const paxCount = appState.passengerCount || 1;
      let totalFare = 0;

      appState.segments.forEach((seg, idx) => {
        const isCurrent = idx === appState.activeSegmentIndex;
        const isSelected = seg.selectedFlight !== null;
        if (isSelected) totalFare += (seg.selectedFlight.price * paxCount);

        let cardClass = isCurrent
          ? 'bg-slate-50 border-2 border-[#0B192C] shadow-sm'
          : 'bg-white hover:bg-slate-50 border border-slate-200';

        let badgeStyle = isSelected
          ? 'bg-[#0B192C] text-white'
          : (isCurrent ? 'bg-[#C5A880] text-[#0B192C]' : 'bg-slate-200 text-slate-600');

        let statusText = isCurrent ? 'Viewing' : (isSelected ? 'Edit' : 'Select');

        let descText = '';
        if (isSelected) {
          const fareNote = paxCount > 1 
            ? `$${seg.selectedFlight.price.toLocaleString()} × ${paxCount} = $${(seg.selectedFlight.price * paxCount).toLocaleString()}` 
            : `$${seg.selectedFlight.price.toLocaleString()}`;
          descText = `${seg.shortDate} • ${seg.selectedFlight.flightNum} • ${seg.selectedFlight.cabin} (${fareNote})`;
        } else if (isCurrent) {
          descText = `${seg.shortDate} • Select flight now`;
        } else {
          descText = `${seg.shortDate} • Not selected yet`;
        }

        html += `
          <div class="${cardClass} rounded-xl p-3.5 transition cursor-pointer group" onclick="setActiveSegment(${idx})">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-2.5">
                <span class="w-5 h-5 rounded-full ${badgeStyle} flex items-center justify-center text-[10px] font-extrabold shadow-sm">
                  ${isSelected ? '✓' : (idx + 1)}
                </span>
                <span class="font-extrabold text-xs text-[#0B192C]">${seg.title}</span>
              </div>
              <span class="text-[11px] font-bold text-[#A0825B] group-hover:underline">
                ${statusText}
              </span>
            </div>
            <div class="mt-1 text-[11px] ${isSelected ? 'text-slate-700 font-medium' : 'text-slate-500'} pl-7">
              ${descText}
            </div>
          </div>
        `;
      });

      container.innerHTML = html;

      const totalEl = document.getElementById('sidebar-total-price-val');
      if (totalEl) totalEl.textContent = '$' + totalFare.toLocaleString();

      const paxBadge = document.getElementById('sidebar-pax-badge');
      if (paxBadge) paxBadge.textContent = appState.passengerSummary || '1 Passenger, Business Class';

      const paxLabel = document.getElementById('sidebar-total-pax-label');
      if (paxLabel) paxLabel.textContent = `Total Trip Fare (${appState.passengerSummary || '1 Passenger, Business Class'})`;

      const ctaBtn = document.getElementById('sidebar-main-cta');
      const ctaText = document.getElementById('sidebar-cta-text');
      const selectionNotice = document.getElementById('flight-selection-notice');
      const selectionNoticeText = document.getElementById('flight-selection-notice-text');
      const curSeg = appState.segments[appState.activeSegmentIndex];
      const hasSelectedFare = curSeg && !!curSeg.selectedFlight;
      const allSegmentsSelected = appState.segments.every(s => s.selectedFlight != null);

      if (appState.tripMode === 'one-way') {
        ctaText.textContent = hasSelectedFare ? 'Continue to Seat Selection →' : 'Select Flight to Continue';
      } else if (appState.tripMode === 'round-trip') {
        if (appState.activeSegmentIndex === 0) {
          ctaText.textContent = hasSelectedFare ? 'Next: Select Return Flight →' : 'Select Outbound Flight';
        } else {
          ctaText.textContent = allSegmentsSelected ? 'Continue to Seat Selection →' : 'Select Return Flight';
        }
      } else if (appState.tripMode === 'multi-city') {
        if (appState.activeSegmentIndex < appState.segments.length - 1) {
          ctaText.textContent = hasSelectedFare ? `Next: Select Segment ${appState.activeSegmentIndex + 2} →` : `Select Segment ${appState.activeSegmentIndex + 1}`;
        } else {
          ctaText.textContent = allSegmentsSelected ? 'Continue to Seat Selection →' : `Select Segment ${appState.activeSegmentIndex + 1}`;
        }
      }

      if (!hasSelectedFare) {
        ctaBtn.disabled = true;
        ctaBtn.className = 'w-full bg-slate-200 text-slate-400 py-3.5 px-4 rounded-xl text-xs sm:text-sm font-bold transition cursor-not-allowed flex items-center justify-center space-x-2 shadow-none select-none';
        if (selectionNotice && selectionNoticeText) {
          selectionNoticeText.textContent = `Select a flight for ${curSeg?.title || 'this segment'} to continue.`;
          selectionNotice.classList.remove('hidden');
          selectionNotice.classList.add('flex');
        }
      } else {
        ctaBtn.disabled = false;
        ctaBtn.className = 'w-full bg-[#0B192C] hover:bg-[#162840] text-white py-3.5 px-4 rounded-xl text-xs sm:text-sm font-bold shadow transition transform active:scale-98 cursor-pointer flex items-center justify-center space-x-2';
        if (selectionNotice) {
          selectionNotice.classList.add('hidden');
          selectionNotice.classList.remove('flex');
        }
      }
    }

    function renderFlightHeader() {
      const curSeg = appState.segments[appState.activeSegmentIndex];
      if (!curSeg) return;

      const total = appState.segments.length;
      const breadcrumb = document.getElementById('flight-view-breadcrumb');
      const heading = document.getElementById('flight-view-heading');
      const sub = document.getElementById('flight-view-subheading');

      const fromCityDisp = curSeg.fromCity || curSeg.fromCode || 'ORIGIN';
      const toCityDisp = curSeg.toCity || curSeg.toCode || 'DESTINATION';

      if (appState.tripMode === 'round-trip') {
        breadcrumb.textContent = `STEP ${appState.activeSegmentIndex + 1} OF 2 • ${fromCityDisp.toUpperCase()} (${curSeg.fromCode}) TO ${toCityDisp.toUpperCase()} (${curSeg.toCode})`;
        heading.textContent = appState.activeSegmentIndex === 0 ? 'Select Outbound Flight' : 'Select Return Flight';
      } else if (appState.tripMode === 'one-way') {
        breadcrumb.textContent = `${fromCityDisp.toUpperCase()} (${curSeg.fromCode}) TO ${toCityDisp.toUpperCase()} (${curSeg.toCode})`;
        heading.textContent = 'Select Flight';
      } else {
        breadcrumb.textContent = `SEGMENT ${appState.activeSegmentIndex + 1} OF ${total} • ${fromCityDisp.toUpperCase()} (${curSeg.fromCode}) TO ${toCityDisp.toUpperCase()} (${curSeg.toCode})`;
        heading.textContent = `Select Flight — ${fromCityDisp} to ${toCityDisp}`;
      }
      sub.textContent = `${curSeg.dateStr} • ${fromCityDisp} (${curSeg.fromCode}) → ${toCityDisp} (${curSeg.toCode})`;

      const depLabel = document.getElementById('filter-dep-label');
      if (depLabel) {
        depLabel.textContent = `${fromCityDisp} Departure Window`;
      }
    }

    function renderFlightCards() {
      const container = document.getElementById('flights-list-container');
      if (!container) return;

      const curSeg = appState.segments[appState.activeSegmentIndex];
      if (!curSeg) return;

      // Active cabin filters
      const activeCabins = [];
      if (appState.filters.cabins.eco) activeCabins.push('eco');
      if (appState.filters.cabins.bus) activeCabins.push('bus');
      if (appState.filters.cabins.fst) activeCabins.push('fst');

      if (activeCabins.length === 0) {
        container.innerHTML = `
          <div class="bg-white rounded-2xl border border-slate-200 p-10 text-center shadow-sm space-y-4">
            <div class="w-14 h-14 rounded-full bg-amber-50 border border-amber-200 text-amber-600 flex items-center justify-center mx-auto">
              <span class="material-symbols-outlined text-[30px]">tune</span>
            </div>
            <div class="space-y-1">
              <h3 class="font-bold text-slate-900 text-lg">No Cabins Selected</h3>
              <p class="text-sm text-slate-600 max-w-md mx-auto">
                Please select at least one cabin class (Economy, Business, or First Class) in the filters above to view available flights.
              </p>
            </div>
            <div class="pt-2">
              <button type="button" onclick="resetFilters()" class="inline-flex items-center space-x-2 px-5 py-2.5 bg-[#0B192C] hover:bg-[#162840] text-white rounded-xl text-xs font-bold shadow transition cursor-pointer">
                <span>Reset Filters</span>
              </button>
            </div>
          </div>
        `;
        return;
      }

      // STRICTLY GET FROM DATABASE MAPPING
      const raw = FLIGHT_DATABASE[curSeg.key] || [];

      // Filter
      const filtered = raw.filter(f => {
        if (appState.filters.nonstop && !f.nonstop) return false;
        if (appState.filters.depWindow === '06-12' && (f.depHour < 6 || f.depHour >= 12)) return false;
        if (appState.filters.depWindow === '12-18' && (f.depHour < 12 || f.depHour >= 18)) return false;
        if (appState.filters.depWindow === '18-24' && (f.depHour < 18 || f.depHour >= 24)) return false;

        const visiblePrices = activeCabins
          .map(k => f.tiers[k]?.price)
          .filter(p => typeof p === 'number');

        if (visiblePrices.length === 0) return false;
        const lowestPrice = Math.min(...visiblePrices);
        if (lowestPrice > appState.filters.maxBudget) return false;
        return true;
      });

      // Sort
      function getLowestVisiblePrice(flight) {
        const prices = [];
        if (appState.filters.cabins.eco && flight.tiers.eco) prices.push(flight.tiers.eco.price);
        if (appState.filters.cabins.bus && flight.tiers.bus) prices.push(flight.tiers.bus.price);
        if (appState.filters.cabins.fst && flight.tiers.fst) prices.push(flight.tiers.fst.price);
        return prices.length > 0 ? Math.min(...prices) : 999999;
      }

      filtered.sort((a, b) => {
        if (appState.filters.sortBy === 'price-low') {
          return getLowestVisiblePrice(a) - getLowestVisiblePrice(b);
        } else if (appState.filters.sortBy === 'dep-early') {
          return (a.depHour || 0) - (b.depHour || 0);
        }
        return 0;
      });

      if (filtered.length === 0) {
        // No flights found for this route
        const noResultsFrom = curSeg.fromCity ? `${curSeg.fromCity} (${curSeg.fromCode})` : curSeg.fromCode;
        const noResultsTo = curSeg.toCity ? `${curSeg.toCity} (${curSeg.toCode})` : curSeg.toCode;
        const searchDate = curSeg.dateStr || curSeg.shortDate || 'selected date';
        const searchPax = appState.passengerSummary || `${appState.passengerCount || 1} Passenger`;
        container.innerHTML = `
          <div class="bg-white rounded-2xl border border-slate-200 p-10 text-center shadow-sm space-y-5">
            <div class="w-14 h-14 rounded-full bg-slate-100 border border-slate-200 text-slate-400 flex items-center justify-center mx-auto">
              <span class="material-symbols-outlined text-[30px]">flight_takeoff</span>
            </div>
            <div class="space-y-2">
              <h3 class="font-bold text-slate-900 text-lg">No Flights Found</h3>
              <p class="text-sm text-slate-600 max-w-md mx-auto">
                No scheduled flights found for <strong class="text-[#0B192C]">${noResultsFrom} → ${noResultsTo}</strong> on <strong class="text-[#0B192C]">${searchDate}</strong> for <strong class="text-[#0B192C]">${searchPax}</strong>.
              </p>
              <p class="text-xs text-slate-400 max-w-sm mx-auto">Try adjusting your filters or departure date to check other flights in the database.</p>
            </div>
            <div class="pt-2 flex flex-wrap items-center justify-center gap-3">
              <a href="/" class="inline-flex items-center space-x-2 px-5 py-2.5 bg-[#0B192C] hover:bg-[#162840] text-white rounded-xl text-xs font-bold shadow transition cursor-pointer">
                <span class="material-symbols-outlined text-[16px]">edit_calendar</span>
                <span>Modify Search</span>
              </a>
              <button type="button" onclick="resetFilters()" class="inline-flex items-center space-x-2 px-5 py-2.5 border border-slate-300 hover:border-slate-500 text-slate-700 rounded-xl text-xs font-bold transition cursor-pointer bg-white">
                <span>Reset Filters</span>
              </button>
            </div>
          </div>
        `;
        return;
      }

      let html = '';
      filtered.forEach(flight => {
        const isFlightSelected = curSeg.selectedFlight && curSeg.selectedFlight.cardId === flight.id;
        const selectedTier = isFlightSelected ? curSeg.selectedFlight.tierKey : null;

        const cardBorder = isFlightSelected
          ? 'bg-white rounded-2xl border-2 border-[#0B192C] ring-2 ring-[#0B192C]/20 shadow-lg relative transition-all duration-200 overflow-visible'
          : 'bg-white rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-md transition-all duration-200 overflow-visible';

        const outerSelectionBadge = isFlightSelected
          ? `<div class="absolute -top-3 left-6 bg-[#0B192C] text-[#C5A880] text-[10px] font-extrabold uppercase tracking-widest px-3 py-0.5 rounded-full shadow flex items-center space-x-1.5 z-20">
               <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block animate-pulse"></span>
               <span>SELECTED FLIGHT</span>
             </div>`
          : '';

        // TIER 1: Economy
        const eco = flight.tiers.eco;
        const isEcoSelected = isFlightSelected && selectedTier === 'eco';
        const isEcoSearched = appState.searchedCabin === 'eco';
        const ecoCardBorderClass = isEcoSelected
          ? 'border-2 border-[#0B192C] shadow-md relative rounded-xl bg-white ring-1 ring-[#0B192C]/10'
          : (isEcoSearched ? 'border-2 border-[#C5A880] shadow-sm relative rounded-xl bg-white ring-1 ring-[#C5A880]/30' : 'border border-slate-200 hover:border-slate-300 rounded-xl bg-white');
        const ecoBtn = isEcoSelected
          ? `<button class="select-fare-btn w-full py-2 px-3 bg-[#0B192C] text-white rounded-lg text-xs font-bold hover:bg-slate-900 transition-colors flex items-center justify-center gap-1 cursor-pointer" type="button" onclick="selectFare(${appState.activeSegmentIndex}, '${flight.id}', '${flight.flightNum}', '${eco.name}', ${eco.price}, 'eco'); event.stopPropagation();">Selected ✓</button>`
          : `<button class="select-fare-btn w-full py-2 px-3 border border-slate-300 text-slate-700 rounded-lg text-xs font-semibold hover:border-slate-900 hover:text-[#0B192C] transition-colors cursor-pointer" type="button" onclick="selectFare(${appState.activeSegmentIndex}, '${flight.id}', '${flight.flightNum}', '${eco.name}', ${eco.price}, 'eco'); event.stopPropagation();">Select Fare</button>`;
        const ecoBadge = isEcoSelected
          ? `<span class="selected-badge absolute -top-2.5 right-4 bg-[#0B192C] text-white text-[10px] font-bold tracking-wider px-2 py-0.5 rounded uppercase z-10 shadow-sm">SELECTED</span>`
          : (isEcoSearched ? `<span class="selected-badge absolute -top-2.5 right-4 bg-[#C5A880] text-[#0B192C] text-[10px] font-extrabold tracking-wider px-2 py-0.5 rounded uppercase z-10 shadow-sm">SEARCHED CABIN</span>` : ``);

        const ecoHtml = `
          <div class="bundle-col fare-card ${ecoCardBorderClass} p-4 flex flex-col justify-between cursor-pointer" onclick="selectFare(${appState.activeSegmentIndex}, '${flight.id}', '${flight.flightNum}', '${eco.name}', ${eco.price}, 'eco')">
            ${ecoBadge}
            <div>
              <span class="text-[10px] font-extrabold text-[#0B192C] uppercase tracking-wider block">ECONOMY</span>
              <span class="text-2xl font-extrabold text-[#0B192C] block mt-1 font-mono">$${eco.price.toLocaleString()}</span>
              <span class="text-[10px] text-emerald-700 font-bold mt-0.5 block">${eco.note}</span>
              <ul class="mt-2.5 space-y-1 text-[11px] text-slate-600">
                ${eco.perks.map(p => `<li class="flex items-center space-x-1.5"><span class="text-slate-400">✓</span><span class="truncate">${p}</span></li>`).join('')}
              </ul>
            </div>
            <div class="mt-4">
              ${ecoBtn}
            </div>
          </div>
        `;

        // TIER 2: Business
        const bus = flight.tiers.bus;
        const isBusSelected = isFlightSelected && selectedTier === 'bus';
        const isBusSearched = appState.searchedCabin === 'bus';
        const busCardBorderClass = isBusSelected
          ? 'border-2 border-[#0B192C] shadow-md relative rounded-xl bg-white ring-1 ring-[#0B192C]/10'
          : (isBusSearched ? 'border-2 border-[#C5A880] shadow-sm relative rounded-xl bg-white ring-1 ring-[#C5A880]/30' : 'border border-slate-200 hover:border-slate-300 rounded-xl bg-white');
        const busBtn = isBusSelected
          ? `<button class="select-fare-btn w-full py-2 px-3 bg-[#0B192C] text-white rounded-lg text-xs font-bold hover:bg-slate-900 transition-colors flex items-center justify-center gap-1 cursor-pointer" type="button" onclick="selectFare(${appState.activeSegmentIndex}, '${flight.id}', '${flight.flightNum}', '${bus.name}', ${bus.price}, 'bus'); event.stopPropagation();">Selected ✓</button>`
          : `<button class="select-fare-btn w-full py-2 px-3 border border-slate-300 text-slate-700 rounded-lg text-xs font-semibold hover:border-slate-900 hover:text-[#0B192C] transition-colors cursor-pointer" type="button" onclick="selectFare(${appState.activeSegmentIndex}, '${flight.id}', '${flight.flightNum}', '${bus.name}', ${bus.price}, 'bus'); event.stopPropagation();">Select Fare</button>`;
        const busBadge = isBusSelected
          ? `<span class="selected-badge absolute -top-2.5 right-4 bg-[#0B192C] text-white text-[10px] font-bold tracking-wider px-2 py-0.5 rounded uppercase z-10 shadow-sm">SELECTED</span>`
          : (isBusSearched ? `<span class="selected-badge absolute -top-2.5 right-4 bg-[#C5A880] text-[#0B192C] text-[10px] font-extrabold tracking-wider px-2 py-0.5 rounded uppercase z-10 shadow-sm">SEARCHED CABIN</span>` : ``);

        const busHtml = `
          <div class="bundle-col fare-card ${busCardBorderClass} p-4 flex flex-col justify-between cursor-pointer" onclick="selectFare(${appState.activeSegmentIndex}, '${flight.id}', '${flight.flightNum}', '${bus.name}', ${bus.price}, 'bus')">
            ${busBadge}
            <div>
              <span class="text-[10px] font-extrabold text-[#0B192C] uppercase tracking-wider block">BUSINESS</span>
              <span class="text-2xl font-extrabold text-[#0B192C] block mt-1 font-mono">$${bus.price.toLocaleString()}</span>
              <span class="text-[10px] text-slate-500 mt-0.5 block">${bus.note}</span>
              <ul class="mt-2.5 space-y-1 text-[11px] text-slate-600">
                ${bus.perks.map(p => `<li class="flex items-center space-x-1.5"><span class="text-slate-400">✓</span><span class="truncate">${p}</span></li>`).join('')}
              </ul>
            </div>
            <div class="mt-4">
              ${busBtn}
            </div>
          </div>
        `;

        // TIER 3: First Suite
        const fst = flight.tiers.fst;
        const isFstSelected = isFlightSelected && selectedTier === 'fst';
        const isFstSearched = appState.searchedCabin === 'fst';
        const fstCardBorderClass = isFstSelected
          ? 'border-2 border-[#0B192C] shadow-md relative rounded-xl bg-white ring-1 ring-[#0B192C]/10'
          : (isFstSearched ? 'border-2 border-[#C5A880] shadow-sm relative rounded-xl bg-white ring-1 ring-[#C5A880]/30' : 'border border-slate-200 hover:border-slate-300 rounded-xl bg-white');
        const fstBtn = isFstSelected
          ? `<button class="select-fare-btn w-full py-2 px-3 bg-[#0B192C] text-white rounded-lg text-xs font-bold hover:bg-slate-900 transition-colors flex items-center justify-center gap-1 cursor-pointer" type="button" onclick="selectFare(${appState.activeSegmentIndex}, '${flight.id}', '${flight.flightNum}', '${fst.name}', ${fst.price}, 'fst'); event.stopPropagation();">Selected ✓</button>`
          : `<button class="select-fare-btn w-full py-2 px-3 border border-slate-300 text-slate-700 rounded-lg text-xs font-semibold hover:border-slate-900 hover:text-[#0B192C] transition-colors cursor-pointer" type="button" onclick="selectFare(${appState.activeSegmentIndex}, '${flight.id}', '${flight.flightNum}', '${fst.name}', ${fst.price}, 'fst'); event.stopPropagation();">Select Fare</button>`;
        const fstBadge = isFstSelected
          ? `<span class="selected-badge absolute -top-2.5 right-4 bg-[#0B192C] text-white text-[10px] font-bold tracking-wider px-2 py-0.5 rounded uppercase z-10 shadow-sm">SELECTED</span>`
          : (isFstSearched ? `<span class="selected-badge absolute -top-2.5 right-4 bg-[#C5A880] text-[#0B192C] text-[10px] font-extrabold tracking-wider px-2 py-0.5 rounded uppercase z-10 shadow-sm">SEARCHED CABIN</span>` : ``);

        const fstHtml = `
          <div class="bundle-col fare-card ${fstCardBorderClass} p-4 flex flex-col justify-between cursor-pointer" onclick="selectFare(${appState.activeSegmentIndex}, '${flight.id}', '${flight.flightNum}', '${fst.name}', ${fst.price}, 'fst')">
            ${fstBadge}
            <div>
              <span class="text-[10px] font-extrabold text-[#A0825B] uppercase tracking-wider block">FIRST SUITE</span>
              <span class="text-2xl font-extrabold text-[#0B192C] block mt-1 font-mono">$${fst.price.toLocaleString()}</span>
              <span class="text-[10px] text-amber-800 font-bold mt-0.5 block">${fst.note}</span>
              <ul class="mt-2.5 space-y-1 text-[11px] text-slate-600">
                ${fst.perks.map(p => `<li class="flex items-center space-x-1.5"><span class="text-slate-400">✓</span><span class="truncate">${p}</span></li>`).join('')}
              </ul>
            </div>
            <div class="mt-4">
              ${fstBtn}
            </div>
          </div>
        `;

        const gridColsClass = activeCabins.length === 3 ? 'sm:grid-cols-3' : (activeCabins.length === 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-1');

        html += `
          <div class="${cardBorder}">
            ${outerSelectionBadge}
            <div class="p-6 grid grid-cols-1 xl:grid-cols-12 gap-6 items-center">

              <!-- Left Side: Flight Timing, Departure, Arrival & Aircraft (xl:col-span-4) -->
              <div class="xl:col-span-4 space-y-4">
                <div class="flex items-center space-x-2 flex-wrap gap-y-1">
                  <span class="px-2.5 py-0.5 rounded bg-slate-100 font-mono text-xs font-bold text-slate-800">${flight.flightNum}</span>
                  <span class="text-xs text-slate-500 font-medium">• ${flight.aircraft}</span>
                  <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full">${flight.status} • ${flight.availableSeats}</span>
                  ${!flight.nonstop ? `
                    <span class="inline-flex items-center gap-1 text-[10px] font-extrabold text-amber-800 bg-amber-100/90 border border-amber-300/80 px-2 py-0.5 rounded-md shadow-xs">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                      <span>${flight.stopCount === 1 ? '1 STOP' : `${flight.stopCount} STOPS`}</span>
                    </span>
                  ` : ''}
                </div>

                <div class="flex items-center space-x-4">
                  <!-- Origin (Real Database Time) -->
                  <div>
                    <div class="text-3xl font-extrabold text-[#0B192C] font-mono tracking-tight">${flight.depTime}</div>
                    <div class="text-xs font-bold text-slate-800 mt-0.5">${flight.depCode}</div>
                    <div class="text-[11px] text-slate-500 truncate max-w-[130px]">${flight.depCity}</div>
                    <div class="text-[11px] font-semibold text-[#A0825B] mt-1">${flight.depDate}</div>
                  </div>

                  <!-- Graphic Route Line with Computed Duration -->
                  <div class="flex-grow flex flex-col items-center px-2">
                    <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">${flight.duration}</span>
                    <div class="relative w-full flex items-center my-1.5">
                      <div class="h-0.5 w-full bg-slate-200"></div>
                      ${!flight.nonstop && flight.stops && flight.stops.length > 0 ? `
                        <div class="absolute inset-0 flex items-center justify-around pointer-events-none px-4">
                          ${flight.stops.map(s => `
                            <div class="relative pointer-events-auto" title="Stop: ${s.airportCity || s.airportCode} (${s.airportCode})">
                              <div class="w-2.5 h-2.5 rounded-full bg-amber-500 border-2 border-white ring-1 ring-amber-400 shadow-sm cursor-help"></div>
                            </div>
                          `).join('')}
                        </div>
                      ` : `
                        <svg class="w-4 h-4 text-[#C5A880] absolute left-1/2 -translate-x-1/2 -top-1.5 transform rotate-90" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"></path>
                        </svg>
                      `}
                    </div>
                    ${flight.nonstop ? `
                      <span class="text-[10px] text-emerald-600 font-bold">Non-Stop Direct</span>
                    ` : `
                      <span class="inline-flex items-center gap-1 text-[10px] font-extrabold text-amber-700 bg-amber-50 border border-amber-200/90 px-2 py-0.5 rounded-md shadow-xs">
                        <svg class="w-3 h-3 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span>${flight.stopLabel}</span>
                      </span>
                    `}
                  </div>

                  <!-- Destination (Real Database Time) -->
                  <div class="text-right">
                    <div class="text-3xl font-extrabold text-[#0B192C] font-mono tracking-tight">
                      ${flight.arrTime} ${flight.arrNextDay ? `<span class="text-xs font-semibold text-amber-600 font-sans">${flight.arrNextDay}</span>` : ''}
                    </div>
                    <div class="text-xs font-bold text-slate-800 mt-0.5">${flight.arrCode}</div>
                    <div class="text-[11px] text-slate-500 truncate max-w-[130px]">${flight.arrCity}</div>
                    <div class="text-[11px] font-semibold text-[#A0825B] mt-1">${flight.arrDate}</div>
                  </div>
                </div>

                <div class="text-xs text-slate-600 font-medium">
                  ${flight.featureText}
                </div>

                <!-- Flight Details Trigger -->
                <div>
                  <button type="button" onclick="toggleFlightDetails('${flight.id}')" class="inline-flex items-center space-x-1 text-xs font-bold text-[#0B192C] hover:text-[#A0825B] transition-colors py-1 cursor-pointer">
                    <span class="underline underline-offset-4 decoration-slate-300">View Flight Details &amp; Amenities</span>
                    <svg class="w-3.5 h-3.5 text-[#C5A880]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </button>
                </div>
              </div>

              <!-- Right Side: Fare Columns based on filter (xl:col-span-8) -->
              <div class="xl:col-span-8">
                <div class="grid grid-cols-1 ${gridColsClass} gap-3.5">
                  ${appState.filters.cabins.eco ? ecoHtml : ''}
                  ${appState.filters.cabins.bus ? busHtml : ''}
                  ${appState.filters.cabins.fst ? fstHtml : ''}
                </div>
              </div>

            </div>
          </div>
        `;
      });

      container.innerHTML = html;
    }

    function updateRecapStrip() {
      const recapMode = document.getElementById('recap-trip-mode');
      const recapOrigCode = document.getElementById('recap-origin-code');
      const recapOrigCity = document.getElementById('recap-origin-city');
      const recapDestCode = document.getElementById('recap-dest-code');
      const recapDestCity = document.getElementById('recap-dest-city');
      const recapDates = document.getElementById('recap-dates');
      const recapPax = document.getElementById('recap-pax');

      const seg0 = appState.segments[0];
      const seg1 = appState.segments[1];

      if (recapMode) {
        let modeLabel = 'Round Trip';
        if (appState.tripMode === 'one-way') modeLabel = 'One Way';
        else if (appState.tripMode === 'multi-city') modeLabel = 'Multi-City';
        recapMode.textContent = modeLabel;
      }
      if (recapOrigCode && seg0) recapOrigCode.textContent = seg0.fromCode;
      if (recapOrigCity && seg0) recapOrigCity.textContent = seg0.fromCity ? `(${seg0.fromCity})` : '';
      if (recapDestCode && seg0) recapDestCode.textContent = seg0.toCode;
      if (recapDestCity && seg0) recapDestCity.textContent = seg0.toCity ? `(${seg0.toCity})` : '';
      if (recapDates) {
        if (appState.tripMode === 'round-trip' && seg1) {
          const d0 = seg0?.shortDate || 'Depart';
          const d1 = seg1?.shortDate || 'Return';
          const hasYear = /\b20\d{2}\b/.test(d0) || /\b20\d{2}\b/.test(d1);
          recapDates.textContent = hasYear ? `${d0} – ${d1}` : `${d0} – ${d1}, 2026`;
        } else if (seg0) {
          const d0 = seg0.shortDate || 'Depart';
          const hasYear = /\b20\d{2}\b/.test(d0);
          recapDates.textContent = hasYear ? d0 : `${d0}, 2026`;
        }
      }
      if (recapPax) recapPax.textContent = appState.passengerSummary || '1 Passenger, Business Class';
    }

    function renderAll() {
      updateRecapStrip();
      renderSidebar();
      renderFlightHeader();
      renderFlightCards();
    }

    // Keyboard ESC closes drawer
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') window.closeFlightInfoDrawer();
    });

    document.addEventListener('DOMContentLoaded', () => {
      initializeFlightDatabase();

      const urlParams = new URLSearchParams(window.location.search);
      let storedContext = null;
      try {
        storedContext = JSON.parse(sessionStorage.getItem('skybook-search-context') || 'null');
      } catch (error) {
        console.warn('Could not parse search context:', error);
      }

      const activeMode = urlParams.get('mode') || urlParams.get('tripMode') || storedContext?.mode || sessionStorage.getItem('skybook-trip-mode') || 'round-trip';
      const validMode = ['round-trip', 'one-way', 'multi-city'].includes(activeMode) ? activeMode : 'round-trip';

      appState.tripMode = validMode;
      sessionStorage.setItem('skybook-trip-mode', validMode);

      // Resolve origin/destination from URL first, then sessionStorage, then fallback to empty
      const originCode = (urlParams.get('origin') || urlParams.get('originCode') || storedContext?.originCode || '').trim();
      const originCity = urlParams.get('originCity') || storedContext?.originCity || originCode;
      const destinationCode = (urlParams.get('destination') || urlParams.get('destinationCode') || storedContext?.destinationCode || '').trim();
      const destinationCity = urlParams.get('destinationCity') || storedContext?.destinationCity || destinationCode;
      const departure = urlParams.get('departure') || urlParams.get('departureDate') || storedContext?.departure || 'Oct 24';
      const departureSub = urlParams.get('departureSub') || storedContext?.departureSub || 'Saturday, 2026';
      const returnDate = urlParams.get('return') || urlParams.get('returnDate') || storedContext?.returnDate || 'Nov 02';
      const returnSub = urlParams.get('returnSub') || storedContext?.returnSub || 'Monday, 2026';
      const depDateLabel = departureSub ? `${departureSub} • ${departure}` : departure;
      const retDateLabel = returnSub ? `${returnSub} • ${returnDate}` : returnDate;

      setupSegmentsForMode(validMode, originCode, originCity, destinationCode, destinationCity, depDateLabel, departure, retDateLabel, returnDate);

      const passengerCount = parseInt(urlParams.get('passengerCount') || storedContext?.passengerCount || '1', 10);
      const depDate = urlParams.get('depDate') || storedContext?.depDate || '';
      const retDate = urlParams.get('retDate') || storedContext?.retDate || '';

      const context = {
        mode: validMode,
        originCode: originCode,
        originCity: originCity,
        destinationCode: destinationCode,
        destinationCity: destinationCity,
        departure: departure,
        departureSub: departureSub,
        depDate: depDate,
        returnDate: returnDate,
        returnSub: returnSub,
        retDate: retDate,
        passengers: urlParams.get('passengers') || storedContext?.passengers || (passengerCount === 1 ? '1 Passenger, Business Class' : `${passengerCount} Passengers, Business Class`),
        passengerCount: passengerCount,
        cabin: urlParams.get('cabin') || storedContext?.cabin || 'Business Class'
      };

      sessionStorage.removeItem('skybook-selected-flights');
      sessionStorage.removeItem('skybook-seat-assignments');
      sessionStorage.removeItem('skybook-passenger-manifest');

      sessionStorage.setItem('skybook-search-context', JSON.stringify(context));
      applySearchContext(context);

      renderAll();
    });
</script>
}