@model IEnumerable<SkyBook.Business.ViewModels.FlightVM>
@inject SkyBook.Business.Interfaces.IFlightService FlightService
@{
    ViewData["Title"] = "Flight Results";
    Layout = "_Layout";
    ViewData["ShowBookingProgress"] = true;
    ViewData["BookingStep"] = 1;

    var modelFlights = Model?.ToList() ?? new List<SkyBook.Business.ViewModels.FlightVM>();
    var availableFlights = modelFlights;

    var flightsJson = System.Text.Json.JsonSerializer.Serialize(
        availableFlights,
        new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }
    );

    var qMode = Context.Request.Query["mode"].ToString();
    if (string.IsNullOrWhiteSpace(qMode)) qMode = Context.Request.Query["tripMode"].ToString();
    if (string.IsNullOrWhiteSpace(qMode)) qMode = "round-trip";

    var qOrigin = Context.Request.Query["origin"].ToString();
    if (string.IsNullOrWhiteSpace(qOrigin)) qOrigin = Context.Request.Query["originCode"].ToString();
    if (string.IsNullOrWhiteSpace(qOrigin)) qOrigin = "CAI";

    var qOriginCity = Context.Request.Query["originCity"].ToString();
    if (string.IsNullOrWhiteSpace(qOriginCity)) qOriginCity = qOrigin == "CAI" ? "Cairo" : qOrigin;

    var qDest = Context.Request.Query["destination"].ToString();
    if (string.IsNullOrWhiteSpace(qDest)) qDest = Context.Request.Query["destinationCode"].ToString();
    if (string.IsNullOrWhiteSpace(qDest)) qDest = "DXB";

    var qDestCity = Context.Request.Query["destinationCity"].ToString();
    if (string.IsNullOrWhiteSpace(qDestCity)) qDestCity = qDest == "DXB" ? "Dubai" : qDest;

    var qDep = Context.Request.Query["departure"].ToString();
    if (string.IsNullOrWhiteSpace(qDep)) qDep = "Oct 24";

    var qRet = Context.Request.Query["return"].ToString();
    if (string.IsNullOrWhiteSpace(qRet)) qRet = "Nov 02";

    var qPax = Context.Request.Query["passengers"].ToString();
    if (string.IsNullOrWhiteSpace(qPax)) qPax = "1 Passenger, Business Class";
}

@section Styles {
<style data-purpose="custom-layout">
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: #0F172A;
      background-color: #F8F9FA;
    }
    /* Stretch global header and booking progress bar to eliminate empty side gaps */
    #skybook-global-header .skybook-header-inner,
    #skybook-booking-progress .skybook-progress-inner {
      max-width: 1680px !important;
      width: 100% !important;
      padding-left: 24px !important;
      padding-right: 24px !important;
    }
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #F1F5F9;
    }
    ::-webkit-scrollbar-thumb {
      background: #CBD5E1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94A3B8;
    }
    .bundle-col {
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .bundle-col:hover {
      transform: translateY(-2px);
    }
</style>
}

@section HeadScripts {
<script>
    sessionStorage.removeItem('skybook-selected-flights');
    sessionStorage.removeItem('skybook-seat-assignments');
    sessionStorage.removeItem('skybook-passenger-manifest');
</script>
}

<!-- WIDE LUXURY CONTAINER (1680px, no awkward left/right empty gaps) -->
