    function applySearchContext(context) {
      if (!context || !context.originCode || !context.destinationCode) return;
      const requestedKey = `${context.originCode}-${context.destinationCode}`;
      if (!FLIGHT_DATABASE[requestedKey] || !appState.segments[0]) return;

      appState.segments[0].key = requestedKey;
      appState.segments[0].fromCode = context.originCode;
      appState.segments[0].fromCity = context.originCity;
      appState.segments[0].toCode = context.destinationCode;
      appState.segments[0].toCity = context.destinationCity;
      appState.segments[0].title = `${context.originCode} → ${context.destinationCode}`;

      if (appState.tripMode === 'round-trip') {
        const returnKey = `${context.destinationCode}-${context.originCode}`;
        if (FLIGHT_DATABASE[returnKey] && appState.segments[1]) {
          appState.segments[1].key = returnKey;
          appState.segments[1].fromCode = context.destinationCode;
          appState.segments[1].fromCity = context.destinationCity;
          appState.segments[1].toCode = context.originCode;
          appState.segments[1].toCity = context.originCity;
          appState.segments[1].title = `${context.destinationCode} → ${context.originCode}`;
        }
      }
    }

    window.setTripMode = function(newMode) {
      if (appState.tripMode === newMode) return;
      appState.tripMode = newMode;

      ['one-way', 'round-trip', 'multi-city'].forEach(m => {
        const btn = document.getElementById('toggle-btn-' + m);
        if (!btn) return;
        if (m === newMode) {
          btn.className = 'trip-toggle-btn px-3.5 py-1.5 rounded-lg font-bold transition bg-[#C5A880] text-[#0B192C] shadow-sm';
        } else {
          btn.className = 'trip-toggle-btn px-3.5 py-1.5 rounded-lg font-bold transition text-slate-300 hover:text-white';
        }
      });

      setupSegmentsForMode(newMode);
      renderAll();
    };

    window.setActiveSegment = function(idx) {
      if (idx >= 0 && idx < appState.segments.length) {
        appState.activeSegmentIndex = idx;
        renderAll();
      }
    };

    window.selectCurrency = function(curr) {
      document.getElementById('selected-currency-label').textContent = curr;
      const dd = document.getElementById('currency-dropdown');
      if (dd) dd.classList.add('hidden');
      const chev = document.getElementById('currency-chevron');
      if (chev) chev.style.transform = 'rotate(0deg)';
    };

    function findFlightById(flightId) {
      for (const key of Object.keys(FLIGHT_DATABASE)) {
        const found = FLIGHT_DATABASE[key].find(f => f.id === flightId);
        if (found) return found;
      }
      return null;
    }

    window.closeFlightInfoDrawer = function() {
      const overlay = document.getElementById('flight-info-overlay');
      const drawer = document.getElementById('flight-info-drawer');
      if (!overlay || !drawer) return;
      overlay.classList.add('opacity-0');
      drawer.classList.add('translate-x-full');
      setTimeout(() => {
        overlay.classList.add('hidden');
        document.body.style.overflow = '';
      }, 300);
    };

