          <button class="dep-window-btn px-3 py-1 rounded-md font-medium text-slate-600 hover:text-[#0B192C] transition whitespace-nowrap" data-window="18-24" onclick="setDepartureWindow('18-24')" type="button">18–24</button>
        </div>
      </div>

      <!-- Cabin Selection -->
      <div class="flex items-center space-x-2 shrink-0">
        <span class="text-xs font-medium text-slate-600 whitespace-nowrap">Cabin:</span>
        <div class="flex items-center space-x-2 text-xs">
          <label class="flex items-center space-x-1 cursor-pointer select-none">
            <input checked class="w-3.5 h-3.5 rounded text-[#0B192C] focus:ring-[#0B192C] border-slate-300 cursor-pointer" id="filter-cabin-eco" onchange="applyFilters()" type="checkbox">
            <span class="text-slate-700">Eco</span>
          </label>
          <label class="flex items-center space-x-1 cursor-pointer select-none">
            <input checked class="w-3.5 h-3.5 rounded text-[#0B192C] focus:ring-[#0B192C] border-slate-300 cursor-pointer" id="filter-cabin-bus" onchange="applyFilters()" type="checkbox">
            <span class="text-slate-700">Bus</span>
          </label>
          <label class="flex items-center space-x-1 cursor-pointer select-none">
            <input checked class="w-3.5 h-3.5 rounded text-[#0B192C] focus:ring-[#0B192C] border-slate-300 cursor-pointer" id="filter-cabin-fst" onchange="applyFilters()" type="checkbox">
            <span class="text-slate-700">First</span>
          </label>
        </div>
      </div>

      <!-- Budget Slider (Calibrated to DB prices) -->
      <div class="flex items-center space-x-2.5 shrink-0">
        <span class="text-xs font-medium text-slate-600 whitespace-nowrap">Budget:</span>
        <input class="w-32 accent-[#0B192C] h-1.5 bg-slate-200 rounded appearance-none cursor-pointer" id="budget-slider" max="30000" min="500" oninput="handleBudgetChange(this.value)" step="100" type="range" value="30000">
        <span class="font-mono font-bold text-xs text-[#0B192C] bg-slate-100 px-2.5 py-1 rounded border border-slate-200 whitespace-nowrap" id="budget-val-badge">$30,000</span>
      </div>

      <!-- Reset CTA -->
      <div class="flex items-center shrink-0 pl-2 border-l border-slate-200">
        <button class="text-xs font-medium text-slate-500 hover:text-[#0B192C] underline transition-colors cursor-pointer" onclick="resetFilters()" type="button">Reset</button>
      </div>
    </div>
  </div>

  <!-- ROUTE NOTICE BANNER (Only displayed if searched corridor is not in database) -->
  <div class="hidden rounded-xl border border-amber-200 bg-amber-50 p-4 text-xs text-amber-900 items-center justify-between shadow-sm" id="route-search-notice-banner">
    <div class="flex items-center space-x-2.5">
      <span class="material-symbols-outlined text-amber-600 text-[20px]">info</span>
      <span id="route-search-notice-text">No direct scheduled flights found for this corridor.</span>
    </div>
    <button type="button" onclick="dismissRouteNotice()" class="text-amber-700 hover:text-amber-950 font-bold underline ml-4 cursor-pointer">Dismiss</button>
  </div>

  <!-- TWO-COLUMN MAIN CONTENT LAYOUT (1680px layout) -->
  <div class="flex flex-col lg:flex-row items-start gap-8 w-full">
    
    <!-- LEFT COLUMN: Sticky Trip Summary & Total (380px width) -->
    <aside class="w-full lg:w-[360px] xl:w-[380px] flex-shrink-0 self-start lg:sticky space-y-4" id="sidebar-left-column" style="top: 156px;">
      <div class="bg-white p-5 rounded-2xl border-2 border-[#0B192C] shadow-sm space-y-4" data-purpose="sidebar-trip-summary">
        <!-- Header -->
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
          <div class="flex items-center space-x-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <h3 class="font-bold text-sm text-[#0B192C] tracking-tight">Trip Summary &amp; Total</h3>
          </div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-[#A0825B] bg-[#C5A880]/10 px-2 py-0.5 rounded-full" id="sidebar-pax-badge">1 Passenger, Business Class</span>
        </div>

        <!-- Segments List Container -->
        <div class="space-y-3" id="sidebar-segments-container">
          <!-- Dynamically Rendered -->
        </div>

        <!-- Total & Primary Action CTA -->
        <div class="pt-4 border-t border-slate-100 space-y-3">
          <div class="flex items-baseline justify-between">
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider" id="sidebar-total-pax-label">Total Trip Fare</span>
            <div class="flex items-baseline space-x-1">
              <span class="text-2xl font-extrabold text-[#0B192C] font-mono" id="sidebar-total-price-val">$0</span>
              <span class="text-xs font-semibold text-slate-500 font-sans">USD</span>
            </div>
          </div>
          <button class="w-full bg-[#0B192C] hover:bg-[#162840] text-white py-3.5 px-4 rounded-xl text-xs sm:text-sm font-bold shadow transition transform active:scale-98 cursor-pointer flex items-center justify-center space-x-2" id="sidebar-main-cta" onclick="handlePrimaryAction()" type="button">
            <span id="sidebar-cta-text">Continue to Seat Selection →</span>
          </button>
          <div class="hidden items-center gap-2 rounded-lg border border-[#C5A880]/50 bg-[#FFF8E7] px-3 py-2 text-[11px] font-semibold text-[#785929]" id="flight-selection-notice" role="status">
            <span class="material-symbols-outlined text-[16px]">info</span>
            <span id="flight-selection-notice-text">Select a flight to continue.</span>
          </div>
        </div>
      </div>
    </aside>

    <!-- RIGHT COLUMN: Section Header & Flight Cards -->
    <section class="flex-1 w-full min-w-0 space-y-6" data-purpose="flight-selection-center-area">
      <!-- Step Breadcrumbs & Title Bar -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between pb-3 border-b border-slate-200 gap-3">
        <div>
          <div class="text-[11px] font-extrabold uppercase tracking-widest text-[#A0825B]" id="flight-view-breadcrumb">SELECT FLIGHT</div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0B192C] tracking-tight mt-1" id="flight-view-heading">Available Flights</h2>
          <p class="text-xs sm:text-sm text-slate-500 font-medium mt-0.5" id="flight-view-subheading">Live database inventory for your journey</p>
        </div>
        <div class="flex items-center space-x-2 self-start sm:self-auto">
          <label class="text-xs font-medium text-slate-500 whitespace-nowrap" for="flight-sort-select">Sort by:</label>
          <select class="text-xs font-bold text-slate-800 bg-white border border-slate-300 rounded-lg py-1.5 pl-3 pr-8 focus:ring-[#0B192C] focus:border-[#0B192C] shadow-sm cursor-pointer" id="flight-sort-select" onchange="handleSortChange(this.value)">
            <option selected value="recommended">Recommended</option>
            <option value="price-low">Lowest Price</option>
            <option value="dep-early">Departure Time (Earliest)</option>
          </select>
        </div>
      </div>

      <!-- Flights List Container -->
      <div class="space-y-6" id="flights-list-container">
        <!-- Loading State -->
        <div class="bg-white rounded-2xl border border-slate-200 p-8 text-center animate-pulse">
          <div class="h-6 bg-slate-200 rounded w-1/3 mx-auto mb-4"></div>
          <div class="h-4 bg-slate-100 rounded w-1/2 mx-auto"></div>
        </div>
      </div>
    </section>

  </div>

</div>

<!-- FLYOUT FLIGHT DETAILS SLIDE-OVER DRAWER -->
<div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden opacity-0 transition-opacity duration-300" id="flight-info-overlay" onclick="closeFlightInfoDrawer()"></div>
<div class="fixed top-0 right-0 bottom-0 w-full max-w-xl bg-white shadow-2xl z-50 transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col" id="flight-info-drawer">
  <div class="p-6 border-b border-slate-200 flex items-center justify-between bg-[#0B192C] text-white">
    <div>
      <h3 class="text-base font-extrabold font-mono text-[#C5A880]" id="flight-info-title">Flight Dossier</h3>
      <p class="text-xs text-slate-300">SkyBook Luxury Flagship Fleet Specifications</p>
    </div>
    <button type="button" onclick="closeFlightInfoDrawer()" class="text-slate-300 hover:text-white p-1 rounded-lg">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
  </div>
  <div class="p-6 overflow-y-auto flex-1 space-y-6" id="flight-info-body">
    <!-- Dynamic details inserted here -->
  </div>
