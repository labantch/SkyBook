                    <div class="text-2xl font-extrabold text-[#0B192C] font-mono">${flight.depTime}</div>
                    <div class="text-xs font-bold text-slate-800">${flight.depCode}</div>
                    <div class="text-[11px] text-slate-400">${flight.depName} ${flight.depTerminal}</div>
                  </div>
                  <!-- Center Plane Graphic -->
