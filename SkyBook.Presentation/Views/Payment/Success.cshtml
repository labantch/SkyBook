@model dynamic
@{
    ViewData["Title"] = "Payment Successful - Boarding Pass";
}

<style>
    body {
        background-color: #f8f9fa;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .boarding-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        border: 1px solid #e0e0e0;
        overflow: hidden;
        max-width: 700px;
        margin: 40px auto;
    }

    .boarding-header {
        background: linear-gradient(135deg, #1a1a1a 0%, #2c2c2c 100%);
        color: #d4af37;
        padding: 25px 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 3px solid #d4af37;
    }

        .boarding-header h2 {
            margin: 0;
            font-size: 1.6rem;
            font-weight: 700;
            letter-spacing: 1px;
        }

    .status-badge {
        background-color: #28a745;
        color: white;
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    .boarding-body {
        padding: 30px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .info-item label {
        display: block;
        font-size: 0.8rem;
        color: #777;
        text-transform: uppercase;
        margin-bottom: 4px;
        font-weight: 600;
    }

    .info-item span {
        font-size: 1.1rem;
        color: #222;
        font-weight: 600;
    }

    .divider {
        border-top: 2px dashed #e0e0e0;
        margin: 25px 0;
        position: relative;
    }

    .action-btns {
        text-align: center;
        margin-top: 30px;
    }

    .btn-gold {
        background: linear-gradient(135deg, #d4af37 0%, #aa820a 100%);
        color: white;
        padding: 12px 35px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
    }

        .btn-gold:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(212, 175, 55, 0.4);
        }
</style>

<div class="container">
    <div class="boarding-card">
        <div class="boarding-header">
            <div>
                <h2>SKYBOOK LUXURY AIRWAYS</h2>
                <small style="color: #ccc;">BOARDING PASS / CONFIRMATION</small>
            </div>
            <span class="status-badge">Payment Successful</span>
        </div>
        <div class="boarding-body">
            <div style="text-align: center; margin-bottom: 25px;">
                <div style="font-size: 3rem; color: #d4af37;">✓</div>
                <h3 style="color: #1a1a1a; font-weight: 700;">Thank You for Your Booking!</h3>
                <p style="color: #666;">Your transaction was completed successfully and your ticket is being issued.</p>
            </div>

            <div class="divider"></div>

            <div class="info-grid">
                <div class="info-item">
                    <label>Payment Status</label>
                    <span style="color: #28a745;">Confirmed (Paid)</span>
                </div>
                <div class="info-item">
                    <label>Transaction Time</label>
                    <span>@DateTime.Now.ToString("dd MMM yyyy, HH:mm")</span>
                </div>
            </div>

            <div class="action-btns">
                <a href="/Booking/MyBookings" class="btn-gold">Go to My Bookings</a>
            </div>
        </div>
    </div>
</div>