@model SkyBook.Business.ViewModels.RegisterVM
@{
    ViewData["Title"] = "Create Account";
    Layout = "_Layout";
}

<div class="min-h-[calc(100vh-5rem)] flex items-center justify-center p-6 bg-[#F8F9FA]">
  <div class="w-full max-w-xl bg-white rounded-xl p-8 shadow-xl">
    <div class="flex flex-col items-center text-center mb-6">
      <p class="text-[11px] font-bold uppercase tracking-widest text-[#C5A880] mb-1">Welcome to SkyBook</p>
      <h1 class="text-2xl font-bold text-[#0B192C]">Create your account</h1>
      <p class="text-sm text-slate-500 mt-1">Enter your details to create an account and join SkyBook.</p>
    </div>
    <div class="w-full bg-slate-100 p-1.5 rounded-lg flex mb-6">
      <a href="@Url.Action("Login", "Account", new { returnUrl = ViewData["ReturnUrl"] })" class="flex-1 py-2 text-center rounded-md text-xs font-semibold text-slate-500 hover:text-[#0B192C]">Log In</a>
      <a href="@Url.Action("Register", "Account", new { returnUrl = ViewData["ReturnUrl"] })" class="flex-1 py-2 text-center rounded-md text-xs font-bold bg-white text-[#0B192C] shadow-sm">Create Account</a>
    </div>

    @if (ViewData["ReturnUrl"] != null && ViewData["ReturnUrl"]!.ToString()!.Contains("ConfirmPayment", StringComparison.OrdinalIgnoreCase))
    {
      <div class="mb-5 p-3.5 rounded-xl bg-amber-50 border border-amber-200/80 text-amber-900 flex items-start gap-3 shadow-xs">
        <span class="material-symbols-outlined text-amber-600 text-[20px] shrink-0 mt-0.5">lock</span>
        <div class="text-xs leading-relaxed">
          <span class="font-bold block text-amber-950 text-[13px] mb-0.5">Create an account to complete your booking</span>
          <span>Your selected flights, seats, and passenger details are safely saved. Once your account is created, you will proceed directly to payment.</span>
        </div>
      </div>
    }

 @if (!ViewData.ModelState.IsValid)
    {
      <div class="mb-4 p-3 rounded-lg bg-rose-50 border border-rose-200 text-rose-700 text-sm" role="alert">
        <ul class="list-disc list-inside space-y-1">
          @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
          {
            <li>@error.ErrorMessage</li>
          }
        </ul>
      </div>
    }

  <form class="flex flex-col gap-space-md" id="form-signup" method="post" asp-action="Register" asp-controller="Account" asp-route-returnUrl="@ViewData["ReturnUrl"]">
      @Html.AntiForgeryToken()
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
        <div class="flex flex-col gap-space-xs">
          <label class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider" for="signup-fullname">Full Name</label>
          <input class="w-full px-space-md py-3.5 bg-surface-container-low rounded-lg text-on-surface font-body-md text-body-md placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest focus:shadow-md transition duration-150"
                 id="signup-fullname" name="FullName" maxlength="100"
                 placeholder="Alexander Wright" required type="text"
                 value="@(Model?.FullName ?? "")" />
        </div>
        <div class="flex flex-col gap-space-xs">
          <label class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider" for="signup-email">Email Address</label>
          <div class="relative flex items-center">
            <span class="material-symbols-outlined absolute left-3.5 text-outline text-headline-sm pointer-events-none">mail</span>
            <input class="w-full pl-11 pr-space-md py-3.5 bg-surface-container-low rounded-lg text-on-surface font-body-md text-body-md placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest focus:shadow-md transition duration-150"
                   id="signup-email" name="Email" maxlength="256"
                   placeholder="alexander.wright@@luxurytravel.com" required type="email"
                   value="@(Model?.Email ?? "")" />
          </div>
        </div>
      </div>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
        <div class="flex flex-col gap-space-xs">
          <label class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider" for="signup-residence">Country of Residence</label>
          <div class="relative flex items-center">
            <span class="material-symbols-outlined absolute left-3.5 text-outline text-headline-sm pointer-events-none">public</span>
            <select class="w-full pl-11 pr-space-md py-3.5 bg-surface-container-low rounded-lg text-on-surface font-body-md text-body-md appearance-none focus:outline-none focus:bg-surface-container-lowest focus:shadow-md transition duration-150 cursor-pointer"
                    id="signup-residence" name="Country" required>
              @{
                var countries = new[] {
                  "United States","United Kingdom","Switzerland","United Arab Emirates",
                  "Singapore","Japan","Monaco","Saudi Arabia","France","Germany",
                  "Italy","Spain","Canada","Australia","South Africa","Egypt",
                  "India","China","Brazil","Mexico","Netherlands","Sweden",
                  "Norway","Belgium","Austria","New Zealand","South Korea",
                  "Turkey","Indonesia","Malaysia","Thailand","Vietnam","Philippines",
                  "Pakistan","Bangladesh","Nigeria","Kenya","Argentina","Chile",
                  "Colombia","Ireland","Portugal","Greece","Poland","Czech Republic",
                  "Denmark","Finland"
                };
                var selected = Model?.Country ?? "";
              }
              <option value="" disabled selected="@(string.IsNullOrEmpty(selected) ? "selected" : null)">Select country…</option>
              @foreach (var c in countries)
              {
                <option value="@c" selected="@(c == selected ? "selected" : null)">@c</option>
              }
            </select>
            <span class="material-symbols-outlined absolute right-3 text-outline pointer-events-none">expand_more</span>
          </div>
        </div>

<div class="flex flex-col gap-space-xs">
          <label class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider" for="signup-phone">Mobile Number <span class="normal-case text-xs font-normal">(optional)</span></label>
          <input class="w-full px-space-md py-3.5 bg-surface-container-low rounded-lg text-on-surface font-body-md text-body-md placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest focus:shadow-md transition duration-150"
                 id="signup-phone" name="PhoneNumber" maxlength="50"
                 placeholder="+1 (555) 019-2834" type="tel"
                 value="@(Model?.PhoneNumber ?? "")" />
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
        <div class="flex flex-col gap-space-xs">
          <label class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider" for="signup-password">Create Password</label>
          <div class="relative flex items-center">
            <input class="w-full px-space-md pr-12 py-3.5 bg-surface-container-low rounded-lg text-on-surface font-body-md text-body-md placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest focus:shadow-md transition duration-150"
                   id="signup-password" name="Password" maxlength="100"
                   placeholder="Min. 6 characters" required type="password" />
            <button class="absolute right-3.5 text-outline hover:text-on-surface focus:outline-none" onclick="togglePasswordVisibility('signup-password', this)" type="button">
              <span class="material-symbols-outlined text-headline-sm">visibility</span>
            </button>
          </div>
        </div>

<div class="flex flex-col gap-space-xs">
          <label class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider" for="signup-confirm-password">Confirm Password</label>
          <div class="relative flex items-center">
            <input class="w-full px-space-md pr-12 py-3.5 bg-surface-container-low rounded-lg text-on-surface font-body-md text-body-md placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest focus:shadow-md transition duration-150"
                   id="signup-confirm-password" name="ConfirmPassword" maxlength="100"
                   placeholder="Re-enter password" required type="password" />
            <button class="absolute right-3.5 text-outline hover:text-on-surface focus:outline-none" onclick="togglePasswordVisibility('signup-confirm-password', this)" type="button">
              <span class="material-symbols-outlined text-headline-sm">visibility</span>
            </button>
          </div>
        </div>
      </div>
      <div class="flex items-start gap-space-sm pt-space-xs">
        <input class="w-4 h-4 mt-1 rounded text-primary accent-primary bg-surface-container-low focus:ring-0 cursor-pointer"
               id="terms-checkbox" required type="checkbox" />
        <label class="font-body-sm text-body-sm text-on-surface-variant select-none" for="terms-checkbox">
          I accept the <a class="text-secondary underline hover:text-on-surface" href="javascript:void(0)">Terms and Conditions</a> and Privacy Policy.
        </label>
      </div>

<button class="w-full mt-space-sm py-4 px-space-lg rounded-lg bg-primary text-on-primary font-headline-sm text-headline-sm font-semibold tracking-wide shadow-md hover:bg-on-secondary-fixed-variant hover:shadow-lg transition-all duration-200 flex items-center justify-center gap-space-sm group"
              type="submit" id="register-submit-btn">
        <span>Create Account</span>
        <span class="material-symbols-outlined text-headline-sm group-hover:translate-x-1 transition-transform">arrow_forward</span>
      </button>
      <p class="text-center text-xs text-slate-400 mt-2">
        Already have an account? <a href="@Url.Action("Login", "Account", new { returnUrl = ViewData["ReturnUrl"] })" class="text-secondary font-semibold hover:underline">Log in here</a>
      </p>
    </form>
  </div>
</div>

@section Scripts {
<script id="tailwind-config">tailwind.config={darkMode:"class",theme:{extend:{colors:{"surface-container-low":"#f3f4f5","on-secondary":"#ffffff","on-secondary-fixed":"#281800","surface-bright":"#f8f9fa","secondary-container":"#fedeb2","on-surface-variant":"#44474c","on-primary-fixed-variant":"#3a475c","on-secondary-fixed-variant":"#584323","primary-fixed-dim":"#bac7e1","inverse-primary":"#bac7e1","primary-container":"#0e1c2f","on-background":"#191c1d","error-container":"#ffdad6","primary-fixed":"#d6e3fe","on-tertiary-fixed":"#001c38","on-tertiary-fixed-variant":"#29486d","tertiary-fixed":"#d3e4ff","outline-variant":"#c5c6cd","surface":"#f8f9fa","secondary":"#725b38","surface-container-high":"#e7e8e9","on-tertiary":"#ffffff","on-surface":"#191c1d","tertiary-fixed-dim":"#aac9f4","on-error-container":"#93000a","surface-container-highest":"#e1e3e4","primary":"#000000","on-primary":"#ffffff","on-primary-fixed":"#0e1c2f","surface-variant":"#e1e3e4","on-error":"#ffffff","on-primary-container":"#77849c","inverse-on-surface":"#f0f1f2","surface-container-lowest":"#ffffff","tertiary-container":"#001c38","error":"#ba1a1a","outline":"#75777d","background":"#f8f9fa","tertiary":"#000000","on-secondary-container":"#78603e","inverse-surface":"#2e3132","surface-dim":"#d9dadb","secondary-fixed":"#fedeb2","surface-tint":"#525f75","surface-container":"#edeeef","on-tertiary-container":"#6886ae","secondary-fixed-dim":"#e0c298"},borderRadius:{DEFAULT:"0.25rem",lg:"0.5rem",xl:"0.75rem",full:"9999px"},spacing:{"space-lg":"1.5rem","space-sm":"0.5rem","space-md":"1rem","space-xs":"0.25rem",margin:"3rem","margin-mobile":"1.25rem","gutter-mobile":"1rem",gutter:"1.5rem","space-xl":"2.5rem"},fontFamily:{"display-hero":["Plus Jakarta Sans"],"body-lg":["Plus Jakarta Sans"],"display-hero-mobile":["Plus Jakarta Sans"],"title-flight-code":["Space Grotesk"],"headline-lg":["Plus Jakarta Sans"],"label-caps":["Space Grotesk"],"body-sm":["Plus Jakarta Sans"],"price-lg":["Space Grotesk"],"headline-sm":["Plus Jakarta Sans"],"body-md":["Plus Jakarta Sans"],"headline-md":["Plus Jakarta Sans"]},fontSize:{"display-hero":["56px",{lineHeight:"64px",letterSpacing:"-0.03em",fontWeight:"700"}],"body-lg":["18px",{lineHeight:"28px",fontWeight:"400"}],"display-hero-mobile":["36px",{lineHeight:"44px",letterSpacing:"-0.02em",fontWeight:"700"}],"title-flight-code":["28px",{lineHeight:"32px",letterSpacing:"0.04em",fontWeight:"700"}],"headline-lg":["32px",{lineHeight:"40px",letterSpacing:"-0.02em",fontWeight:"600"}],"label-caps":["11px",{lineHeight:"14px",letterSpacing:"0.08em",fontWeight:"600"}],"body-sm":["13px",{lineHeight:"18px",fontWeight:"400"}],"price-lg":["24px",{lineHeight:"28px",letterSpacing:"-0.02em",fontWeight:"700"}],"headline-sm":["20px",{lineHeight:"28px",fontWeight:"600"}],"body-md":["15px",{lineHeight:"22px",fontWeight:"400"}],"headline-md":["24px",{lineHeight:"32px",letterSpacing:"-0.015em",fontWeight:"600"}]}}}};
</script>

<script>
  function togglePasswordVisibility(inputId, btn) {
    const input = document.getElementById(inputId);
    const icon = btn.querySelector('.material-symbols-outlined');
    if (input.type === 'password') {
      input.type = 'text';
      icon.textContent = 'visibility_off';
    } else {
      input.type = 'password';
      icon.textContent = 'visibility';
    }
  }
  // Show loading state on submit
  document.getElementById('form-signup').addEventListener('submit', function(e) {
    const btn = document.getElementById('register-submit-btn');
    btn.disabled = true;
    btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-headline-sm">progress_activity</span><span>Creating account…</span>';
  });
</script>
}