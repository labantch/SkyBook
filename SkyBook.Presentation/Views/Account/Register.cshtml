@{
    ViewData["Title"] = "Create Account";
    Layout = "_Layout";
}


<div class="min-h-[calc(100vh-5rem)] flex items-center justify-center p-6 bg-[#F8F9FA]">
  <div class="w-full max-w-xl bg-white rounded-xl p-8 shadow-xl">
    <div class="flex flex-col items-center text-center mb-6">
      <p class="text-[11px] font-bold uppercase tracking-widest text-[#C5A880] mb-1">Welcome to SkyBook</p>
      <h1 class="text-2xl font-bold text-[#0B192C]">Create your account</h1>
      <p class="text-sm text-slate-500 mt-1">Enter your details to create an account and join SkyBook.</p>
    </div>
    <div class="w-full bg-slate-100 p-1.5 rounded-lg flex mb-6">
      <a href="@Url.Action("Login", "Account")" class="flex-1 py-2 text-center rounded-md text-xs font-semibold text-slate-500 hover:text-[#0B192C]">Log In</a>
      <a href="@Url.Action("Register", "Account")" class="flex-1 py-2 text-center rounded-md text-xs font-bold bg-white text-[#0B192C] shadow-sm">Create Account</a>
    </div>
<form class="flex flex-col gap-space-md" id="form-signup" onsubmit="handleAuthSubmit(event);" method="post">
<div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
<div class="flex flex-col gap-space-xs">
<label class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider" for="signup-first-name">First Name</label>
<input class="w-full px-space-md py-3.5 bg-surface-container-low rounded-lg text-on-surface font-body-md text-body-md placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest focus:shadow-md transition duration-150" id="signup-first-name" placeholder="Alexander" required="" type="text">
</div>
<div class="flex flex-col gap-space-xs">
<label class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider" for="signup-last-name">Last Name</label>
<input class="w-full px-space-md py-3.5 bg-surface-container-low rounded-lg text-on-surface font-body-md text-body-md placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest focus:shadow-md transition duration-150" id="signup-last-name" placeholder="Wright" required="" type="text">
</div>
</div>
<div class="flex flex-col gap-space-xs">
<label class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider" for="signup-email">Corporate or Personal Email</label>
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-3.5 text-outline text-headline-sm pointer-events-none">mail</span>
<input class="w-full pl-11 pr-space-md py-3.5 bg-surface-container-low rounded-lg text-on-surface font-body-md text-body-md placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest focus:shadow-md transition duration-150" id="signup-email" placeholder="alexander.wright@@luxurytravel.com" required="" type="email">
</div>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
<div class="flex flex-col gap-space-xs">
<label class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider" for="signup-residence">Country of Residence</label>
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-3.5 text-outline text-headline-sm pointer-events-none">public</span>
<select class="w-full pl-11 pr-space-md py-3.5 bg-surface-container-low rounded-lg text-on-surface font-body-md text-body-md appearance-none focus:outline-none focus:bg-surface-container-lowest focus:shadow-md transition duration-150 cursor-pointer" id="signup-residence">
<option>United States</option>
<option>United Kingdom</option>
<option>Switzerland</option>
<option>United Arab Emirates</option>
<option>Singapore</option>
<option>Japan</option>
<option>Monaco</option>
</select>
<span class="material-symbols-outlined absolute right-3 text-outline pointer-events-none">expand_more</span>
</div>
</div>
<div class="flex flex-col gap-space-xs">
<label class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider" for="signup-phone">Mobile Number</label>
<div class="relative flex items-center">

