@model SkyBook.Business.ViewModels.LoginVM
@{
    ViewData["Title"] = "Log In";
    Layout = "_Layout";
}

<div class="min-h-[calc(100vh-5rem)] flex items-center justify-center p-6 bg-[#F8F9FA]">
  <div class="w-full max-w-xl bg-white rounded-xl p-8 shadow-xl">
    <div class="flex flex-col items-center text-center mb-6">
      <p class="text-[11px] font-bold uppercase tracking-widest text-[#C5A880] mb-1">Welcome to SkyBook</p>
      <h1 class="text-2xl font-bold text-[#0B192C]">Sign in to your account</h1>
      <p class="text-sm text-slate-500 mt-1">Enter your credentials to access your flights and account.</p>
    </div>
    <div class="w-full bg-slate-100 p-1.5 rounded-lg flex mb-6">
      <a href="@Url.Action("Login", "Account", new { returnUrl = ViewData["ReturnUrl"] })" class="flex-1 py-2 text-center rounded-md text-xs font-bold bg-white text-[#0B192C] shadow-sm">Log In</a>
      <a href="@Url.Action("Register", "Account", new { returnUrl = ViewData["ReturnUrl"] })" class="flex-1 py-2 text-center rounded-md text-xs font-semibold text-slate-500 hover:text-[#0B192C]">Create Account</a>
    </div>

    @if (ViewData["ReturnUrl"] != null && ViewData["ReturnUrl"]!.ToString()!.Contains("ConfirmPayment", StringComparison.OrdinalIgnoreCase))
    {
      <div class="mb-5 p-3.5 rounded-xl bg-amber-50 border border-amber-200/80 text-amber-900 flex items-start gap-3 shadow-xs">
        <span class="material-symbols-outlined text-amber-600 text-[20px] shrink-0 mt-0.5">lock</span>
        <div class="text-xs leading-relaxed">
          <span class="font-bold block text-amber-950 text-[13px] mb-0.5">Sign in required to complete your booking</span>
          <span>Your selected flights, seats, and passenger details are safely saved. Sign in or create an account to proceed directly to payment.</span>
        </div>
      </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
      <div class="mb-4 p-3 rounded-lg bg-rose-50 border border-rose-200 text-rose-700 text-sm" role="alert">
        <ul class="list-disc list-inside space-y-1">
          @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
          {
            <li>@error.ErrorMessage</li>
          }
        </ul>
      </div>
    }

    <form class="flex flex-col gap-space-md" id="form-login" method="post"
          asp-action="Login" asp-controller="Account"
          asp-route-returnUrl="@ViewData["ReturnUrl"]">
      @Html.AntiForgeryToken()

      <div class="flex flex-col gap-space-xs">
        <label class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider" for="login-email">Email Address</label>
        <div class="relative flex items-center">
          <span class="material-symbols-outlined absolute left-3.5 text-outline text-headline-sm pointer-events-none">mail</span>
          <input class="w-full pl-11 pr-space-md py-3.5 bg-surface-container-low rounded-lg text-on-surface font-body-md text-body-md placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest focus:shadow-md transition duration-150"
                 id="login-email" name="Email" type="email"
                 placeholder="e.g. alexander.wright@@luxurytravel.com"
                 value="@(Model?.Email ?? "")" required />
        </div>
      </div>

      <div class="flex flex-col gap-space-xs">
        <div class="flex items-center justify-between">
          <label class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider" for="login-password">Password</label>
          <a class="font-label-caps text-label-caps text-secondary hover:text-on-secondary-fixed-variant transition" href="javascript:void(0)">Forgot password?</a>
        </div>
        <div class="relative flex items-center">
          <span class="material-symbols-outlined absolute left-3.5 text-outline text-headline-sm pointer-events-none">vpn_key</span>
          <input class="w-full pl-11 pr-12 py-3.5 bg-surface-container-low rounded-lg text-on-surface font-body-md text-body-md placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest focus:shadow-md transition duration-150"
                 id="login-password" name="Password" type="password"
                 placeholder="••••••••••••" required />
          <button class="absolute right-3.5 text-outline hover:text-on-surface focus:outline-none"
                  onclick="togglePasswordVisibility('login-password', this)" type="button">
            <span class="material-symbols-outlined text-headline-sm">visibility</span>
          </button>
        </div>
      </div>

      <div class="flex items-center justify-between pt-space-xs">
        <label class="flex items-center gap-space-sm cursor-pointer select-none">
          <input class="w-4 h-4 rounded text-primary accent-primary bg-surface-container-low focus:ring-0 cursor-pointer"
                 type="checkbox" name="RememberMe" id="remember-me" value="true" />
          <span class="font-body-sm text-body-sm text-on-surface-variant">Remember this verified terminal</span>
        </label>
      </div>

      <button class="w-full mt-space-sm py-4 px-space-lg rounded-lg bg-primary text-on-primary font-headline-sm text-headline-sm font-semibold tracking-wide shadow-md hover:bg-on-secondary-fixed-variant hover:shadow-lg transition-all duration-200 flex items-center justify-center gap-space-sm group"
              type="submit" id="login-submit-btn">
        <span>Sign In to SkyBook</span>
        <span class="material-symbols-outlined text-headline-sm group-hover:translate-x-1 transition-transform">flight_takeoff</span>
      </button>

      <p class="text-center text-xs text-slate-400 mt-2">
        Don't have an account? <a href="@Url.Action("Register", "Account", new { returnUrl = ViewData["ReturnUrl"] })" class="text-secondary font-semibold hover:underline">Create one here</a>
      </p>
    </form>
  </div>
</div>

@section Scripts {
