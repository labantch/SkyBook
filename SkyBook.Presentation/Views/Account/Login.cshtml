 Jakarta Sans"],"body-md":["Plus Jakarta Sans"],"headline-md":["Plus Jakarta Sans"]},fontSize:{"display-hero":["56px",{lineHeight:"64px",letterSpacing:"-0.03em",fontWeight:"700"}],"body-lg":["18px",{lineHeight:"28px",fontWeight:"400"}],"display-hero-mobile":["36px",{lineHeight:"44px",letterSpacing:"-0.02em",fontWeight:"700"}],"title-flight-code":["28px",{lineHeight:"32px",letterSpacing:"0.04em",fontWeight:"700"}],"headline-lg":["32px",{lineHeight:"40px",letterSpacing:"-0.02em",fontWeight:"600"}],"label-caps":["11px",{lineHeight:"14px",letterSpacing:"0.08em",fontWeight:"600"}],"body-sm":["13px",{lineHeight:"18px",fontWeight:"400"}],"price-lg":["24px",{lineHeight:"28px",letterSpacing:"-0.02em",fontWeight:"700"}],"headline-sm":["20px",{lineHeight:"28px",fontWeight:"600"}],"body-md":["15px",{lineHeight:"22px",fontWeight:"400"}],"headline-md":["24px",{lineHeight:"32px",letterSpacing:"-0.015em",fontWeight:"600"}]}}}};</script>
<script>
  function switchAuthMode(mode) {
    const loginBtn = document.getElementById('toggle-login');
    const signupBtn = document.getElementById('toggle-signup');
    const loginForm = document.getElementById('form-login');
    const signupForm = document.getElementById('form-signup');

    if (mode === 'login') {
      loginBtn.className = 'flex-1 py-space-sm px-space-md text-center rounded-md font-label-caps text-label-caps transition-all duration-200 bg-surface-container-lowest text-on-surface shadow-sm';
      signupBtn.className = 'flex-1 py-space-sm px-space-md text-center rounded-md font-label-caps text-label-caps transition-all duration-200 text-on-surface-variant hover:text-on-surface';
      loginForm.classList.remove('hidden');
      signupForm.classList.add('hidden');
    } else {
      signupBtn.className = 'flex-1 py-space-sm px-space-md text-center rounded-md font-label-caps text-label-caps transition-all duration-200 bg-surface-container-lowest text-on-surface shadow-sm';
      loginBtn.className = 'flex-1 py-space-sm px-space-md text-center rounded-md font-label-caps text-label-caps transition-all duration-200 text-on-surface-variant hover:text-on-surface';
      signupForm.classList.remove('hidden');
      loginForm.classList.add('hidden');
    }
  }

  function togglePasswordVisibility(inputId, btn) {
    const input = document.getElementById(inputId);
    const icon = btn.querySelector('.material-symbols-outlined');
    if (input.type === 'password') {
      input.type = 'text';
      icon.textContent = 'visibility_off';
    } else {
      input.type = 'password';
      icon.textContent = 'visibility';
    }
  }

  // Demo-only role check: in the real MVC app this happens server-side against
  // the Users table / an auth role claim, not against a hardcoded email list.
  const ADMIN_EMAILS = ['admin@@skybook.com'];

  function handleAuthSubmit(event) {
    event.preventDefault();
    const isLoginForm = event.target && event.target.id === 'form-login';
    const emailInput = document.getElementById(isLoginForm ? 'login-email' : 'signup-email');
    const email = ((emailInput && emailInput.value) || '').trim().toLowerCase();
    const isAdmin = isLoginForm && ADMIN_EMAILS.includes(email);

    let firstName = '';
    let lastName = '';
    if (!isLoginForm) {
      firstName = (document.getElementById('signup-first-name')?.value || '').trim();
      lastName = (document.getElementById('signup-last-name')?.value || '').trim();
    } else {
      // Prefer previously saved name for this email; else derive from email
      const savedEmail = (localStorage.getItem('skybook-user-email') || '').toLowerCase();
      if (savedEmail && savedEmail === email && localStorage.getItem('skybook-user-name')) {
        const parts = localStorage.getItem('skybook-user-name').split(' ');
        firstName = parts[0] || '';
        lastName = parts.slice(1).join(' ') || '';
      } else {
        const local = email.split('@@')[0] || 'Guest';
        const bits = local.replace(/[._]+/g, ' ').split(' ').filter(Boolean);
        firstName = bits[0] ? bits[0].charAt(0).toUpperCase() + bits[0].slice(1) : 'Guest';
        lastName = bits[1] ? bits[1].charAt(0).toUpperCase() + bits[1].slice(1) : '';
      }
    }

    const fullName = (firstName + ' ' + lastName).trim() || 'SkyBook Guest';
    const initials = fullName.split(' ').filter(Boolean).map(p => p[0]).join('').slice(0, 2).toUpperCase();

    localStorage.setItem('skybook-authenticated', 'true');
    localStorage.setItem('skybook-role', isAdmin ? 'admin' : 'user');
    localStorage.setItem('skybook-user-email', email);
    localStorage.setItem('skybook-user-name', fullName);
    localStorage.setItem('skybook-user-initials', initials || 'SB');
    const authUser = {
      name: fullName,
      email: email,
      role: isAdmin ? 'Admin' : 'Passenger',
      initials: initials || 'SB'
    };
    localStorage.setItem('skybook-auth-user', JSON.stringify(authUser));
    sessionStorage.removeItem('skybook-return-to');

    if (isAdmin) {
      window.location.href = '/Admin/AdminDashboard';
      return;
    }

    let returnTo = new URLSearchParams(window.location.search).get('returnTo') || '/';
    if (returnTo === 'management.html' || returnTo === 'index.html' || (returnTo.startsWith('/Admin') && !isAdmin)) {
      returnTo = '/';
    }
    window.location.href = returnTo;
  }

  document.addEventListener('DOMContentLoaded', () => {
    const params = new URLSearchParams(window.location.search);
    if (params.has('returnTo') || params.get('mode') === 'login') {
      switchAuthMode('login');
      document.getElementById('auth-heading').textContent = params.has('returnTo') ? 'Log in to continue' : 'Sign in to your account';
      document.getElementById('auth-subtitle').textContent = params.has('returnTo') ? 'Sign in to save your booking and continue securely to payment.' : 'Enter your credentials to access your flights and account.';
    } else if (params.get('mode') === 'signup') {
      switchAuthMode('signup');
      document.getElementById('auth-heading').textContent = 'Create your account';
      document.getElementById('auth-subtitle').textContent = 'Enter your details to create an account and join SkyBook.';
    }
  });
</script>
<script>
function selectCountry(flag, code, name) {
  const flagEl = document.getElementById('selected-country-flag');
  const codeEl = document.getElementById('selected-country-code');
  const menu = document.getElementById('country-dropdown-menu');
  if (flagEl) flagEl.textContent = flag;
  if (codeEl) codeEl.textContent = code;
  if (menu) menu.classList.add('hidden');
}

function filterCountries(query) {
  const q = query.toLowerCase().trim();
  const items = document.querySelectorAll('#country-list-items .country-option');
  items.forEach(item => {
    const text = item.textContent.toLowerCase();
    if (text.includes(q)) {
      item.style.display = 'flex';
    } else {
      item.style.display = 'none';
    }
  });
}

document.addEventListener('click', function(e) {
  const menu = document.getElementById('country-dropdown-menu');
  const btn = document.getElementById('country-picker-btn');
  if (menu && !menu.classList.contains('hidden')) {
    if (!menu.contains(e.target) && !btn.contains(e.target)) {
      menu.classList.add('hidden');
    }
  }
});
</script>
}
